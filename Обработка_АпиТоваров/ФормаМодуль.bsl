// ============================================================================
// Модуль формы обработки "УправлениеМеню"
// Загрузка товаров и групп из API, отображение с фильтром по группам.
// ============================================================================

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Только заполнить настройки полей.
	// Колонки и данные — по кнопке "Загрузить".
	ЗаполнитьНастройкуПолей();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Загрузить(Команда)
	
	СоздатьКолонкиИЗагрузитьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПере(Команда)
	
	ТекущиеДанные = Элементы.ТаблицаТоваров.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ВводЦеныЗавершение", ЭтотОбъект);
	ПоказатьВводЧисла(Оповещение, 0, "Введите новую цену для: " + ТекущиеДанные.name, 15, 2);
	
КонецПроцедуры

&НаКлиенте
Процедура ВводЦеныЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат; // Отмена
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ТаблицаТоваров.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СсылкаДок = СоздатьДокументПереоценкиНаСервере(ТекущиеДанные.id, Результат);
	
	// Обновить НоваяЦена в текущей строке таблицы
	ТекущиеДанные.НоваяЦена = Результат;
	
	Если ЗначениеЗаполнено(СсылкаДок) Тогда
		ПоказатьЗначение(, СсылкаДок);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ФильтрГруппаПриИзменении(Элемент)
	
	ПрименитьФильтрНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПолейВключеноПриИзменении(Элемент)
	
	ПрименитьНастройкуПолейНаСервере();
	
КонецПроцедуры

// Переключает видимость колонок таблицы Товары по флагам Включено.
&НаСервере
Процедура ПрименитьНастройкуПолейНаСервере()
	
	Для Каждого Стр Из Объект.НастройкаПолей Цикл
		ИмяЭлемента = "ТаблицаТоваров" + Стр.Имя;
		ЭлементФормы = Элементы.Найти(ИмяЭлемента);
		Если ЭлементФормы <> Неопределено Тогда
			ЭлементФормы.Видимость = Стр.Включено;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// -------------------------------------------------------
// Загрузка данных
// -------------------------------------------------------

// Основная процедура загрузки. На вход — готовые ТЗ.
// ТЗТоваров: колонки = ключи JSON товаров (id, groupId, name, price, ...)
// ТЗГрупп:   колонки = ключи JSON групп (id, name, ordering)
&НаСервере
Процедура ЗагрузитьДанныеНаСервере(ТЗТоваров, ТЗГрупп)
	
	// --- Заполнение фильтра из ТЗ групп ---
	СоответствиеГрупп = Новый Соответствие;
	ЭлементФильтра = Элементы.ФильтрГруппа;
	ЭлементФильтра.РежимВыбораИзСписка = Истина;
	ЭлементФильтра.КнопкаВыпадающегоСписка = Истина;
	
	СписокВыбора = ЭлементФильтра.СписокВыбора;
	СписокВыбора.Очистить();
	СписокВыбора.Добавить(0, "<Все группы>");
	
	Для Каждого СтрокаГруппы Из ТЗГрупп Цикл
		ИмяГруппы = БезопасноеЗначениеСтрока(СтрокаГруппы.name);
		СписокВыбора.Добавить(СтрокаГруппы.id, ИмяГруппы);
		СоответствиеГрупп.Вставить(СтрокаГруппы.id, ИмяГруппы);
	КонецЦикла;
	
	ФильтрГруппа = 0;
	
	// --- Формирование внутренней ТЗ (обогащение groupName, конвертация единиц) ---
	ВсеТовары = СоздатьТЗТоваров();
	
	Для Каждого СтрокаТовара Из ТЗТоваров Цикл
		НС = ВсеТовары.Добавить();
		ЗаполнитьЗначенияСвойств(НС, СтрокаТовара);
		НС.name        = БезопасноеЗначениеСтрока(НС.name);
		НС.groupName   = БезопасноеЗначениеСтрока(
			СоответствиеГрупп.Получить(НС.groupId));
		НС.uktZed      = БезопасноеЗначениеСтрока(НС.uktZed);
		НС.barcode     = БезопасноеЗначениеСтрока(НС.barcode);
		НС.cookingTime = БезопасноеЗначениеСтрока(НС.cookingTime);
		НС.servingTime = БезопасноеЗначениеСтрока(НС.servingTime);
		НС.price       = НС.price / 100;  // копейки → грн
		НС.tax         = НС.tax / 100;    // сотые → %
	КонецЦикла;
	
	// --- Создать элементы справочника ТМЦ ---
	СоздатьТМЦИзТоваров(ВсеТовары);
	
	// --- Заполнить НоваяЦена из регистра Цены ---
	ЗаполнитьЦеныИзРегистра(ВсеТовары);
	
	// --- Сохранить полный набор во временное хранилище ---
	АдресВсехТоваров = ПоместитьВоВременноеХранилище(ВсеТовары, УникальныйИдентификатор);
	
	// --- Отобразить все ---
	ЗаполнитьОтображение(ВсеТовары);
	
КонецПроцедуры

// Создаёт элементы справочника ТМЦ для товаров, которых ещё нет (по Код = id).
&НаСервере
Процедура СоздатьТМЦИзТоваров(ТЗТоваров)
	
	// Собрать коды для пакетной проверки
	МассивКодов = Новый Массив;
	Для Каждого Стр Из ТЗТоваров Цикл
		МассивКодов.Добавить(Строка(Стр.id));
	КонецЦикла;
	
	// Найти уже существующие
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ТМЦ.Код КАК Код
		|ИЗ
		|	Справочник.ТМЦ КАК ТМЦ
		|ГДЕ
		|	ТМЦ.Код В (&МассивКодов)";
	Запрос.УстановитьПараметр("МассивКодов", МассивКодов);
	
	СуществующиеКоды = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СуществующиеКоды.Вставить(Выборка.Код, Истина);
	КонецЦикла;
	
	// Создать недостающие
	Для Каждого Стр Из ТЗТоваров Цикл
		Код = Строка(Стр.id);
		Если СуществующиеКоды.Получить(Код) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НовыйЭлемент = Справочники.ТМЦ.СоздатьЭлемент();
		НовыйЭлемент.Код = Код;
		НовыйЭлемент.Наименование = Стр.name;
		НовыйЭлемент.Записать();
	КонецЦикла;
	
КонецПроцедуры

// Заполняет колонку НоваяЦена из регистра сведений Цены (измерение Номенклатура, ресурс Цена).
// Поиск ТМЦ по Код = id товара.
&НаСервере
Процедура ЗаполнитьЦеныИзРегистра(ВсеТовары)
	
	// Собрать коды товаров
	МассивКодов = Новый Массив;
	Для Каждого Стр Из ВсеТовары Цикл
		МассивКодов.Добавить(Строка(Стр.id));
	КонецЦикла;
	
	// Получить ссылки ТМЦ и цены одним запросом
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ТМЦ.Код КАК Код,
		|	Цены.Цена КАК Цена
		|ИЗ
		|	Справочник.ТМЦ КАК ТМЦ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Цены.СрезПоследних КАК Цены
		|		ПО Цены.Номенклатура = ТМЦ.Ссылка
		|ГДЕ
		|	ТМЦ.Код В (&МассивКодов)";
	Запрос.УстановитьПараметр("МассивКодов", МассивКодов);
	
	СоответствиеЦен = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Цена) Тогда
			СоответствиеЦен.Вставить(Выборка.Код, Выборка.Цена);
		КонецЕсли;
	КонецЦикла;
	
	// Заполнить колонку
	Для Каждого Стр Из ВсеТовары Цикл
		Цена = СоответствиеЦен.Получить(Строка(Стр.id));
		Если Цена <> Неопределено Тогда
			Стр.НоваяЦена = Цена;
		Иначе
			Стр.НоваяЦена = 0;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Создание документа Переоценка с выбранным товаром.
// Находит ТМЦ по Код = КодТовара, создаёт документ, записывает (без проведения), возвращает ссылку.
&НаСервере
Функция СоздатьДокументПереоценкиНаСервере(КодТовара, НоваяЦена)
	
	// Найти номенклатуру по коду
	ТМЦСсылка = Справочники.ТМЦ.НайтиПоКоду(Строка(КодТовара));
	Если НЕ ЗначениеЗаполнено(ТМЦСсылка) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "ТМЦ с кодом " + КодТовара + " не найден.";
		Сообщение.Сообщить();
		Возврат Неопределено;
	КонецЕсли;
	
	// TODO: Адаптировать под реальную структуру документа Переоценка.
	// Предполагается: ТЧ "Товары" с колонками "Номенклатура" и "Цена".
	ДокОбъект = Документы.Переоценка.СоздатьДокумент();
	ДокОбъект.Дата = ТекущаяДата();
	
	НоваяСтрока = ДокОбъект.Товары.Добавить();
	НоваяСтрока.Номенклатура = ТМЦСсылка;
	НоваяСтрока.Цена = НоваяЦена;
	
	ДокОбъект.Записать();
	
	Возврат ДокОбъект.Ссылка;
	
КонецФункции

&НаСервере
Функция СоздатьТЗТоваров()
	
	ТЗ = Новый ТаблицаЗначений;
	
	Для Каждого СтрокаНастройки Из Объект.НастройкаПолей Цикл
		ОТ = ПолучитьТипКолонки(СтрокаНастройки.Имя);
		ТЗ.Колонки.Добавить(СтрокаНастройки.Имя, ОТ);
	КонецЦикла;
	
	Возврат ТЗ;
	
КонецФункции

// -------------------------------------------------------
// Фильтрация
// -------------------------------------------------------

&НаСервере
Процедура ПрименитьФильтрНаСервере()
	
	Если НЕ ЗначениеЗаполнено(АдресВсехТоваров) Тогда
		Возврат;
	КонецЕсли;
	
	ВсеТовары = ПолучитьИзВременногоХранилища(АдресВсехТоваров);
	
	Если ФильтрГруппа = 0 Тогда
		ЗаполнитьОтображение(ВсеТовары);
	Иначе
		Отфильтровано = ВсеТовары.Скопировать(
			Новый Структура("groupId", ФильтрГруппа));
		ЗаполнитьОтображение(Отфильтровано);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОтображение(ТЗИсточник)
	
	Объект.Товары.Очистить();
	
	Для Каждого Стр Из ТЗИсточник Цикл
		НС = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Стр);
	КонецЦикла;
	
КонецПроцедуры

// -------------------------------------------------------
// Настройка полей (видимость колонок)
// -------------------------------------------------------

&НаСервере
Процедура ЗаполнитьНастройкуПолей()
	
	Объект.НастройкаПолей.Очистить();
	
	ДобавитьНастройкуПоля("id",            "ID",                   Истина);
	ДобавитьНастройкуПоля("groupId",       "ID группы",            Ложь);
	ДобавитьНастройкуПоля("groupName",     "Группа",               Истина);
	ДобавитьНастройкуПоля("name",          "Наименование",         Истина);
	ДобавитьНастройкуПоля("price",         "Цена API",             Истина);
	ДобавитьНастройкуПоля("НоваяЦена",    "Новая цена",           Истина);
	ДобавитьНастройкуПоля("cookingZoneId", "Зона приготовления",   Ложь);
	ДобавитьНастройкуПоля("excisable",     "Подакцизный",          Истина);
	ДобавитьНастройкуПоля("exciseStamp",   "Акцизная марка",       Ложь);
	ДобавитьНастройкуПоля("weighted",      "Весовой",              Ложь);
	ДобавитьНастройкуПоля("articleN",      "Артикул",              Ложь);
	ДобавитьНастройкуПоля("uktZed",        "УКТЗЕД",               Ложь);
	ДобавитьНастройкуПоля("barcode",       "Штрихкод",             Ложь);
	ДобавитьНастройкуПоля("tax",           "Налог %",              Истина);
	ДобавитьНастройкуПоля("taxGroup",      "Налоговая группа",     Ложь);
	ДобавитьНастройкуПоля("ordering",      "Порядок",              Ложь);
	ДобавитьНастройкуПоля("maxDiscount",   "Макс. скидка",         Ложь);
	ДобавитьНастройкуПоля("cookingTime",   "Время приготовления",  Ложь);
	ДобавитьНастройкуПоля("servingTime",   "Время подачи",         Ложь);
	ДобавитьНастройкуПоля("discountBan",   "Запрет скидки",        Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьНастройкуПоля(Имя, Заголовок, Включено)
	
	НС = Объект.НастройкаПолей.Добавить();
	НС.Имя       = Имя;
	НС.Заголовок = Заголовок;
	НС.Включено  = Включено;
	
КонецПроцедуры

// -------------------------------------------------------
// Динамическое создание колонок таблицы Товары
// -------------------------------------------------------

// Создаёт реквизиты + таблицу + элементы-колонки (однократно).
// Видимость — по флагу Включено. Переключается через ПрименитьНастройкуПолейНаСервере.
&НаСервере
Процедура ИнициализироватьТаблицуТоваров()
	
	// Проверка: колонки уже были созданы?
	Если Элементы.Найти("ТаблицаТоваровid") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Добавить ВСЕ реквизиты в ТЧ "Объект.Товары"
	МассивДобавляемых = Новый Массив;
	Для Каждого Стр Из Объект.НастройкаПолей Цикл
		ОТ = ПолучитьТипКолонки(Стр.Имя);
		МассивДобавляемых.Добавить(
			Новый РеквизитФормы(Стр.Имя, ОТ, "Объект.Товары", Стр.Заголовок));
	КонецЦикла;
	ИзменитьРеквизиты(МассивДобавляемых);
	
	// Скрыть элемент "Товары" из конфигуратора (если есть)
	СтраницаТовары = Элементы.Найти("Товары");
	
	// Создать СВОЙ элемент таблицы внутри страницы "Товары"
	Если СтраницаТовары <> Неопределено Тогда
		ЭлементТаблицы = Элементы.Добавить("ТаблицаТоваров", Тип("ТаблицаФормы"), СтраницаТовары);
	Иначе
		ЭлементТаблицы = Элементы.Добавить("ТаблицаТоваров", Тип("ТаблицаФормы"));
	КонецЕсли;
	ЭлементТаблицы.ПутьКДанным = "Объект.Товары";
	ЭлементТаблицы.ТолькоПросмотр = Ложь;
	ЭлементТаблицы.ИзменятьСоставСтрок = Ложь;
	
	// Создать ВСЕ элементы-колонки, видимость по флагу Включено
	Для Каждого Стр Из Объект.НастройкаПолей Цикл
		ИмяЭлемента = "ТаблицаТоваров" + Стр.Имя;
		Колонка = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ЭлементТаблицы);
		Колонка.ПутьКДанным = "Объект.Товары." + Стр.Имя;
		Колонка.Заголовок = Стр.Заголовок;
		Колонка.Видимость = Стр.Включено;
		
		// НоваяЦена — редактируемая
		Если Стр.Имя = "НоваяЦена" Тогда
			Колонка.ТолькоПросмотр = Ложь;
		Иначе
			Колонка.ТолькоПросмотр = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Кнопка "Загрузить": инициализация + видимость + загрузка данных.
&НаСервере
Процедура СоздатьКолонкиИЗагрузитьНаСервере()
	
	ИнициализироватьТаблицуТоваров();
	ПрименитьНастройкуПолейНаСервере();
	ЗагрузитьИзAPI();
	
КонецПроцедуры

// -------------------------------------------------------
// Загрузка из API
// -------------------------------------------------------

&НаСервере
Процедура ЗагрузитьИзAPI()
	
	Если НЕ ЗначениеЗаполнено(Заведение) Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Заполните заведение.";
		Сообщение.Сообщить();
		
		Возврат;
		
	КонецЕсли;
	
	ТЗТоваров = ВВП.ПолучитьИнформациюМеню(Заведение);
	ТЗГрупп   = ВВП.ПолучитьИнформациюГрупп(Заведение);
	ЗагрузитьДанныеНаСервере(ТЗТоваров, ТЗГрупп);
	
КонецПроцедуры

// -------------------------------------------------------
// Вспомогательные
// -------------------------------------------------------

&НаСервереБезКонтекста
Функция ПолучитьТипКолонки(Знач ИмяКолонки)
	
	Если ИмяКолонки = "id" ИЛИ ИмяКолонки = "groupId"
		ИЛИ ИмяКолонки = "cookingZoneId" ИЛИ ИмяКолонки = "articleN"
		ИЛИ ИмяКолонки = "taxGroup" ИЛИ ИмяКолонки = "ordering" Тогда
		Возврат Новый ОписаниеТипов("Число");
		
	ИначеЕсли ИмяКолонки = "price" ИЛИ ИмяКолонки = "tax"
		ИЛИ ИмяКолонки = "maxDiscount" ИЛИ ИмяКолонки = "НоваяЦена" Тогда
		Возврат Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
		
	ИначеЕсли ИмяКолонки = "excisable" ИЛИ ИмяКолонки = "exciseStamp"
		ИЛИ ИмяКолонки = "weighted" ИЛИ ИмяКолонки = "discountBan" Тогда
		Возврат Новый ОписаниеТипов("Булево");
		
	ИначеЕсли ИмяКолонки = "name" ИЛИ ИмяКолонки = "groupName" Тогда
		Возврат Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(300));
		
	Иначе
		Возврат Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150));
		
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция БезопасноеЗначениеСтрока(Значение)
	
	Если Значение = Null ИЛИ Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	// Очистка недопустимых XML-символов (0x00-0x08, 0x0B, 0x0C, 0x0E-0x1F)
	Результат = Строка(Значение);
	Для Код = 0 По 8 Цикл
		Результат = СтрЗаменить(Результат, Символ(Код), "");
	КонецЦикла;
	Результат = СтрЗаменить(Результат, Символ(11), "");
	Результат = СтрЗаменить(Результат, Символ(12), "");
	Для Код = 14 По 31 Цикл
		Результат = СтрЗаменить(Результат, Символ(Код), "");
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
