
#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура УстановитьНаценкуДочернимКлиент(Команда)
	
	Процент = Объект.ПроцентНаценки;
	
	Если НЕ ЗначениеЗаполнено(Процент) Тогда
		Ждать ПредупреждениеАсинх("Укажите процент наценки!");
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = "Установить наценку " + Формат(Процент, "ЧД=10; ЧЦ=2; ЧГ=") + "% для всех дочерних элементов?";
	
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Количество = УстановитьНаценкуДочернимНаСервере();
	
	Ждать ПредупреждениеАсинх("Наценка " + Формат(Процент, "ЧД=10; ЧЦ=2; ЧГ=") + "% установлена для " + Количество + " элементов.");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

&НаСервере
Функция УстановитьНаценкуДочернимНаСервере()
	
	СсылкаГруппы = Объект.Ref;
	Процент = Объект.ПроцентНаценки;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|Спр.Ссылка КАК Ссылка
		|ИЗ
		|Справочник.Номенклатура КАК Спр
		|ГДЕ
		|Спр.Родитель В ИЕРАРХИИ(&Группа)
		|И НЕ Спр.ЭтоГруппа
		|И НЕ Спр.ПометкаУдаления";
	Запрос.УстановитьПараметр("Группа", СсылкаГруппы);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	КоличествоОбновленных = 0;
	
	НачатьТранзакцию();
	Попытка
		Пока Выборка.Следующий() Цикл
			ОбъектНом = Выборка.Ссылка.ПолучитьОбъект();
			ОбъектНом.ПроцентНаценки = Процент;
			ОбъектНом.Записать();
			КоличествоОбновленных = КоличествоОбновленных + 1;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Формат(КоличествоОбновленных, "ЧГ=");
	
КонецФункции

#КонецОбласти
