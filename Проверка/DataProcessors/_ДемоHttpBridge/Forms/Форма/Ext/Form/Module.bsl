#Область ОбработчикиСобытийФормы

&НаКлиенте
Асинх Процедура ПриОткрытии(Отказ)
	
	РезультатОперации = Ждать HttpBridgeКлиент.ВерсияАсинх();
	Если РезультатОперации.Результат Тогда
		Версия = РезультатОперации.Версия;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура Put(Команда)
	
	Если ТелоКакДвоичныеДанные Тогда
		ТелоДляПередачи = ПолучитьДвоичныеДанныеИзСтроки(Тело, "utf-8");
	Иначе
		ТелоДляПередачи = Строка(Тело);
	КонецЕсли;
	
	Результат = Ждать HttpBridgeКлиент.PutАсинх(Адрес, ТелоДляПередачи, ЗаголовкиЗапроса());
	Если Не Результат.Результат Тогда       
		Сообщить(Результат.ОписаниеОшибки);
	КонецЕсли;
	КодОтвета = Результат.КодОтвета;
	Ответ = Результат.Ответ;
	
КонецПроцедуры

