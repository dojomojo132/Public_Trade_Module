////////////////////////////////////////////////////////////////////////////////
// Вчсн_ДрайверПРРО: Драйвер ПРРО Вчасно.Каса (Device Manager)
//
// Реализует интерфейс драйвера ПРРО для PTM_Fiscal:
//   Чеки:  ОткрытьЧек() -> ДобавитьПозицию() -> ЗакрытьЧек()
//   Смена: ОткрытьСмену(), ЗакрытьСмену(), XОтчет()
//   Касса: ВнесениеВыемка()
//   Диагностика: ПолучитьСтатус()
//
// Протокол: HTTP POST -> localhost:3939/dm/execute (JSON)
// Совместимость параметров: принимает как Host/Port/Device,
//   так и АдресСервера из PTM_Fiscal (формат "host:port/device")

#Область ПрограммныйИнтерфейс

// Открывает фискальный чек.
// Возвращает контекст чека, который нужно передавать в ДобавитьПозицию и ЗакрытьЧек.
//
// Параметры:
//  ПараметрыОборудования - Структура - параметры кассового оборудования:
//    * АдресСервера - Строка - адрес в формате "host:port/device" (из PTM_Fiscal)
//    * Host - Строка - адрес Device Manager (по умолчанию "localhost")
//    * Port - Число - порт Device Manager (по умолчанию 3939)
//    * Device - Строка - имя устройства ПРРО в Device Manager
//    * SecureConnection - Булево - использовать HTTPS
//    * НалоговаяГруппа - Число - номер налоговой группы в Вчасно.Каса (по умолчанию 1)
//  ТипОперации - Строка - тип операции ("Продажа", "Возврат")
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Ошибка (Строка), КонтекстЧека (Структура)
//
Функция ОткрытьЧек(ПараметрыОборудования, ТипОперации) Экспорт
	
	Результат = Новый Структура("Успех, Ошибка, КонтекстЧека", Истина, "", Неопределено);
	
	// Инициализировать параметры подключения
	ЛокальныеПараметры = ИнициализироватьПараметрыПодключения(ПараметрыОборудования);
	
	Если ПустаяСтрока(ЛокальныеПараметры.Device) Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = "Не задано имя устройства ПРРО (Device) в параметрах оборудования.";
		Возврат Результат;
	КонецЕсли;
	
	// Определить task по типу операции: 1=продажа, 2=возврат
	ТипЗадания = ?(ВРег(ТипОперации) = "ВОЗВРАТ", 2, 1);
	
	// Инициализировать контекст чека
	КонтекстЧека = Новый Структура;
	КонтекстЧека.Вставить("ПараметрыПодключения", ЛокальныеПараметры);
	КонтекстЧека.Вставить("task", ТипЗадания);
	КонтекстЧека.Вставить("receipt", Новый Структура);
	КонтекстЧека.receipt.Вставить("rows", Новый Массив);
	КонтекстЧека.receipt.Вставить("pays", Новый Массив);
	
	Результат.КонтекстЧека = КонтекстЧека;
	Возврат Результат;
	
КонецФункции

// Добавляет позицию в открытый фискальный чек.
//
// Параметры:
//  КонтекстЧека - Структура - контекст, полученный из ОткрытьЧек()
//  Номенклатура - Строка - наименование номенклатуры
//  Количество - Число - количество
//  Цена - Число - цена за единицу
//  Сумма - Число - сумма позиции
//  АкцизнаяМарка - Строка - акцизная марка (может быть пустой)
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Ошибка (Строка)
//
Функция ДобавитьПозицию(КонтекстЧека, ДанныеПозиции) Экспорт
	
	Результат = Новый Структура("Успех, Ошибка", Истина, "");
	
	Если КонтекстЧека = Неопределено Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = "Чек не открыт. Сначала вызовите ОткрытьЧек().";
		Возврат Результат;
	КонецЕсли;
	
	// Сформировать строку чека в формате Vchasno Kasa API
	ФискСтрока = Новый Структура;
	ФискСтрока.Вставить("code", ДанныеПозиции.КодУКТЗЕД);
	ФискСтрока.Вставить("name", Строка(ДанныеПозиции.Номенклатура));
	ФискСтрока.Вставить("cnt", ДанныеПозиции.Количество);
	ФискСтрока.Вставить("price", ДанныеПозиции.Цена);
	ФискСтрока.Вставить("cost", Окр(ДанныеПозиции.Количество * ДанныеПозиции.Цена, 2));
	ФискСтрока.Вставить("disc", Окр(ДанныеПозиции.Количество * ДанныеПозиции.Цена, 2) - ДанныеПозиции.Сумма);
	ФискСтрока.Вставить("taxgrp", Строка(ДанныеПозиции.НалоговаяГруппа));
	
	// Акцизная марка
	Если НЕ ПустаяСтрока(ДанныеПозиции.АкцизнаяМарка) Тогда
		ФискСтрока.Вставить("code_a", ДанныеПозиции.АкцизнаяМарка);
	КонецЕсли;
	
	КонтекстЧека.receipt.rows.Добавить(ФискСтрока);
	
	Возврат Результат;
	
КонецФункции

// Закрывает фискальный чек и возвращает фискальный номер.
//
// Параметры:
//  КонтекстЧека - Структура - контекст, полученный из ОткрытьЧек()
//  Сумма - Число - сумма оплаты
//  ВидОплаты - Строка - вид оплаты ("Наличные", "Безналичные")
//
// Возвращаемое значение:
//  Структура - Успех (Булево), ФискальныйНомер (Строка), Ошибка (Строка)
//
Функция ЗакрытьЧек(КонтекстЧека, Сумма, ВидОплаты) Экспорт
	
	Результат = Новый Структура("Успех, ФискальныйНомер, Ошибка", Ложь, "", "");
	
	Если КонтекстЧека = Неопределено Тогда
		Результат.Ошибка = "Чек не открыт. Сначала вызовите ОткрытьЧек().";
		Возврат Результат;
	КонецЕсли;
	
	// Итоговая сумма чека
	КонтекстЧека.receipt.Вставить("sum", Сумма);
	
	// Сформировать оплату
	Оплата = Новый Структура;
	Если ВРег(ВидОплаты) = "БЕЗНАЛИЧНЫЕ" Тогда
		Оплата.Вставить("paytype", 1); // карта (1 = безналичные)
	Иначе
		Оплата.Вставить("paytype", 0); // наличные
	КонецЕсли;
	Оплата.Вставить("sum", Сумма);
	КонтекстЧека.receipt.pays.Добавить(Оплата);
	
	// Сформировать фискальные данные
	ФискальныеДанные = Новый Структура;
	ФискальныеДанные.Вставить("task", КонтекстЧека.task);
	ФискальныеДанные.Вставить("receipt", КонтекстЧека.receipt);
	
	// Сформировать JSON-запрос
	ТелоЗапроса = СформироватьТелоЗапроса(КонтекстЧека.ПараметрыПодключения, ФискальныеДанные);
	
	// Выполнить HTTP-запрос к Device Manager
	РезультатHTTP = ВыполнитьHTTPЗапросЛокальный(КонтекстЧека.ПараметрыПодключения, "/dm/execute", ТелоЗапроса);
	
	Если НЕ РезультатHTTP.Успех Тогда
		Результат.Ошибка = РезультатHTTP.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	ОтветСервера = РезультатHTTP.Ответ;
	
	// Проверить код результата из ответа
	КодОтвета = ПолучитьКодОтвета(ОтветСервера);
	
	Если КодОтвета <> 0 Тогда
		Результат.Ошибка = "Ошибка закрытия чека (код " + Формат(КодОтвета, "ЧГ=0") + "): "
			+ ПолучитьТекстОшибкиОтвета(ОтветСервера);
		Возврат Результат;
	КонецЕсли;
	
	// Извлечь фискальный номер из ответа (info.doccode)
	Если ТипЗнч(ОтветСервера) = Тип("Соответствие") Тогда
		Инфо = ОтветСервера["info"];
		Если ТипЗнч(Инфо) = Тип("Соответствие") И Инфо["doccode"] <> Неопределено Тогда
			Результат.ФискальныйНомер = Строка(Инфо["doccode"]);
		КонецЕсли;
	КонецЕсли;
	
	Результат.Успех = Истина;
	
	Возврат Результат;
	
КонецФункции

// Открывает кассовую смену на ПРРО.
// Если смена уже открыта (res=1096), считается успехом.
//
// Параметры:
//  ПараметрыОборудования - Структура - параметры кассового оборудования
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Ошибка (Строка), Информация (Соответствие)
//
Функция ОткрытьСмену(ПараметрыОборудования) Экспорт
	
	Результат = Новый Структура("Успех, Ошибка, Информация", Ложь, "", Неопределено);
	
	ЛокальныеПараметры = ИнициализироватьПараметрыПодключения(ПараметрыОборудования);
	
	Если ПустаяСтрока(ЛокальныеПараметры.Device) Тогда
		Результат.Ошибка = "Не задано имя устройства ПРРО (Device).";
		Возврат Результат;
	КонецЕсли;
	
	ФискальныеДанные = Новый Структура("task", 0); // 0 = открытие смены
	
	ТелоЗапроса = СформироватьТелоЗапроса(ЛокальныеПараметры, ФискальныеДанные);
	РезультатHTTP = ВыполнитьHTTPЗапросЛокальный(ЛокальныеПараметры, "/dm/execute", ТелоЗапроса);
	
	Если НЕ РезультатHTTP.Успех Тогда
		Результат.Ошибка = РезультатHTTP.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	КодОтвета = ПолучитьКодОтвета(РезультатHTTP.Ответ);
	
	// res=0 → успех, res=1096 → смена уже открыта (тоже считаем успехом)
	Если КодОтвета = 0 ИЛИ КодОтвета = 1096 Тогда
		Результат.Успех = Истина;
		Результат.Информация = РезультатHTTP.Ответ;
	Иначе
		Результат.Ошибка = "Ошибка открытия смены (код " + Формат(КодОтвета, "ЧГ=0") + "): "
			+ ПолучитьТекстОшибкиОтвета(РезультатHTTP.Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Закрывает кассовую смену на ПРРО (Z-отчёт).
//
// Параметры:
//  ПараметрыОборудования - Структура - параметры кассового оборудования
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Ошибка (Строка), Информация (Соответствие)
//
Функция ЗакрытьСмену(ПараметрыОборудования) Экспорт
	
	Результат = Новый Структура("Успех, Ошибка, Информация", Ложь, "", Неопределено);
	
	ЛокальныеПараметры = ИнициализироватьПараметрыПодключения(ПараметрыОборудования);
	
	Если ПустаяСтрока(ЛокальныеПараметры.Device) Тогда
		Результат.Ошибка = "Не задано имя устройства ПРРО (Device).";
		Возврат Результат;
	КонецЕсли;
	
	ФискальныеДанные = Новый Структура("task", 11); // 11 = Z-отчёт (закрытие смены)
	
	ТелоЗапроса = СформироватьТелоЗапроса(ЛокальныеПараметры, ФискальныеДанные);
	РезультатHTTP = ВыполнитьHTTPЗапросЛокальный(ЛокальныеПараметры, "/dm/execute", ТелоЗапроса);
	
	Если НЕ РезультатHTTP.Успех Тогда
		Результат.Ошибка = РезультатHTTP.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	КодОтвета = ПолучитьКодОтвета(РезультатHTTP.Ответ);
	
	Если КодОтвета = 0 Тогда
		Результат.Успех = Истина;
		Результат.Информация = РезультатHTTP.Ответ;
	Иначе
		Результат.Ошибка = "Ошибка закрытия смены (код " + Формат(КодОтвета, "ЧГ=0") + "): "
			+ ПолучитьТекстОшибкиОтвета(РезультатHTTP.Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Формирует X-отчёт (без гашения).
//
// Параметры:
//  ПараметрыОборудования - Структура - параметры кассового оборудования
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Ошибка (Строка), Информация (Соответствие)
//
Функция XОтчет(ПараметрыОборудования) Экспорт
	
	Результат = Новый Структура("Успех, Ошибка, Информация", Ложь, "", Неопределено);
	
	ЛокальныеПараметры = ИнициализироватьПараметрыПодключения(ПараметрыОборудования);
	
	Если ПустаяСтрока(ЛокальныеПараметры.Device) Тогда
		Результат.Ошибка = "Не задано имя устройства ПРРО (Device).";
		Возврат Результат;
	КонецЕсли;
	
	ФискальныеДанные = Новый Структура("task", 10); // 10 = X-отчёт
	
	ТелоЗапроса = СформироватьТелоЗапроса(ЛокальныеПараметры, ФискальныеДанные);
	РезультатHTTP = ВыполнитьHTTPЗапросЛокальный(ЛокальныеПараметры, "/dm/execute", ТелоЗапроса);
	
	Если НЕ РезультатHTTP.Успех Тогда
		Результат.Ошибка = РезультатHTTP.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	КодОтвета = ПолучитьКодОтвета(РезультатHTTP.Ответ);
	
	Если КодОтвета = 0 Тогда
		Результат.Успех = Истина;
		Результат.Информация = РезультатHTTP.Ответ;
	Иначе
		Результат.Ошибка = "Ошибка X-отчёта (код " + Формат(КодОтвета, "ЧГ=0") + "): "
			+ ПолучитьТекстОшибкиОтвета(РезультатHTTP.Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Выполняет служебное внесение или выемку наличных.
//
// Параметры:
//  ПараметрыОборудования - Структура - параметры кассового оборудования
//  Сумма - Число - сумма внесения (положительная) или выемки (отрицательная)
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Ошибка (Строка), Информация (Соответствие)
//
Функция ВнесениеВыемка(ПараметрыОборудования, Сумма) Экспорт
	
	Результат = Новый Структура("Успех, Ошибка, Информация", Ложь, "", Неопределено);
	
	ЛокальныеПараметры = ИнициализироватьПараметрыПодключения(ПараметрыОборудования);
	
	Если ПустаяСтрока(ЛокальныеПараметры.Device) Тогда
		Результат.Ошибка = "Не задано имя устройства ПРРО (Device).";
		Возврат Результат;
	КонецЕсли;
	
	// task: 3 = внесение (сумма > 0), 4 = выемка (сумма < 0)
	ТипЗадания = ?(Сумма >= 0, 3, 4);
	АбсСумма = ?(Сумма >= 0, Сумма, -Сумма);
	
	ДанныеКассы = Новый Структура;
	ДанныеКассы.Вставить("type", 0); // 0 = наличные
	ДанныеКассы.Вставить("sum", АбсСумма);
	
	ФискальныеДанные = Новый Структура;
	ФискальныеДанные.Вставить("task", ТипЗадания);
	ФискальныеДанные.Вставить("cash", ДанныеКассы);
	
	ТелоЗапроса = СформироватьТелоЗапроса(ЛокальныеПараметры, ФискальныеДанные);
	РезультатHTTP = ВыполнитьHTTPЗапросЛокальный(ЛокальныеПараметры, "/dm/execute", ТелоЗапроса);
	
	Если НЕ РезультатHTTP.Успех Тогда
		Результат.Ошибка = РезультатHTTP.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	КодОтвета = ПолучитьКодОтвета(РезультатHTTP.Ответ);
	
	Если КодОтвета = 0 Тогда
		Результат.Успех = Истина;
		Результат.Информация = РезультатHTTP.Ответ;
	Иначе
		ОписаниеОперации = ?(Сумма >= 0, "внесения", "выемки");
		Результат.Ошибка = "Ошибка " + ОписаниеОперации + " (код " + Формат(КодОтвета, "ЧГ=0") + "): "
			+ ПолучитьТекстОшибкиОтвета(РезультатHTTP.Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает текущий статус ПРРО.
//
// Параметры:
//  ПараметрыОборудования - Структура - параметры кассового оборудования
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Ошибка (Строка), Информация (Соответствие)
//
Функция ПолучитьСтатус(ПараметрыОборудования) Экспорт
	
	Результат = Новый Структура("Успех, Ошибка, Информация", Ложь, "", Неопределено);
	
	ЛокальныеПараметры = ИнициализироватьПараметрыПодключения(ПараметрыОборудования);
	
	Если ПустаяСтрока(ЛокальныеПараметры.Device) Тогда
		Результат.Ошибка = "Не задано имя устройства ПРРО (Device).";
		Возврат Результат;
	КонецЕсли;
	
	ФискальныеДанные = Новый Структура("task", 18); // 18 = статус ПРРО
	
	ТелоЗапроса = СформироватьТелоЗапроса(ЛокальныеПараметры, ФискальныеДанные);
	РезультатHTTP = ВыполнитьHTTPЗапросЛокальный(ЛокальныеПараметры, "/dm/execute", ТелоЗапроса);
	
	Если НЕ РезультатHTTP.Успех Тогда
		Результат.Ошибка = РезультатHTTP.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	КодОтвета = ПолучитьКодОтвета(РезультатHTTP.Ответ);
	
	Если КодОтвета = 0 Тогда
		Результат.Успех = Истина;
		Результат.Информация = РезультатHTTP.Ответ;
	Иначе
		Результат.Ошибка = "Ошибка получения статуса (код " + Формат(КодОтвета, "ЧГ=0") + "): "
			+ ПолучитьТекстОшибкиОтвета(РезультатHTTP.Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Инициализирует параметры подключения из ПараметрыОборудования.
// Совместимость: принимает как Host/Port/Device (прямая передача),
// так и АдресСервера (из PTM_Fiscal) в формате "host:port/device".
//
// Параметры:
//  ПараметрыОборудования - Структура - входные параметры
//
// Возвращаемое значение:
//  Структура - Host, Port, Device, SecureConnection, НалоговаяГруппа
//
Функция ИнициализироватьПараметрыПодключения(ПараметрыОборудования)
	
	Параметры = Новый Структура;
	Параметры.Вставить("Host", ПолучитьПараметр(ПараметрыОборудования, "Host", ""));
	Параметры.Вставить("Port", ПолучитьПараметр(ПараметрыОборудования, "Port", 0));
	Параметры.Вставить("Device", ПолучитьПараметр(ПараметрыОборудования, "Device", ""));
	Параметры.Вставить("SecureConnection", ПолучитьПараметр(ПараметрыОборудования, "SecureConnection", Ложь));
	Параметры.Вставить("НалоговаяГруппа", ПолучитьПараметр(ПараметрыОборудования, "НалоговаяГруппа", 1));
	
	// Если Host/Port/Device не заданы явно - разобрать из АдресСервера
	АдресСервера = ПолучитьПараметр(ПараметрыОборудования, "АдресСервера", "");
	
	Если НЕ ПустаяСтрока(АдресСервера) И ПустаяСтрока(Параметры.Device) Тогда
		РазобранныеПараметры = РазобратьАдресСервера(АдресСервера);
		Если ПустаяСтрока(Параметры.Host) ИЛИ Параметры.Host = "" Тогда
			Параметры.Host = РазобранныеПараметры.Host;
		КонецЕсли;
		Если Параметры.Port = 0 Тогда
			Параметры.Port = РазобранныеПараметры.Port;
		КонецЕсли;
		Параметры.Device = РазобранныеПараметры.Device;
		Параметры.SecureConnection = РазобранныеПараметры.SecureConnection;
	КонецЕсли;
	
	// Дефолты если всё ещё не задано
	Если ПустаяСтрока(Параметры.Host) Тогда
		Параметры.Host = "localhost";
	КонецЕсли;
	Если Параметры.Port = 0 Тогда
		Параметры.Port = 3939;
	КонецЕсли;
	
	Возврат Параметры;
	
КонецФункции

// Разбирает строку АдресСервера из PTM_Fiscal в компоненты.
// Поддерживаемые форматы:
//   "host:port/device"
//   "host:port"     (Device останется пустым)
//   "host/device"   (Port = 3939)
//   "host"          (Port = 3939, Device пуст)
//   "https://host:port/device"
//   "http://host:port/device"
//
// Параметры:
//  АдресСервера - Строка - адрес сервера
//
// Возвращаемое значение:
//  Структура - Host, Port, Device, SecureConnection
//
Функция РазобратьАдресСервера(АдресСервера)
	
	Результат = Новый Структура("Host, Port, Device, SecureConnection", "localhost", 3939, "", Ложь);
	
	Адрес = СокрЛП(АдресСервера);
	Если ПустаяСтрока(Адрес) Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Убрать протокол
	Если СтрНайти(ВРег(Адрес), "HTTPS://") = 1 Тогда
		Адрес = Сред(Адрес, 9); // после "https://"
		Результат.SecureConnection = Истина;
	ИначеЕсли СтрНайти(ВРег(Адрес), "HTTP://") = 1 Тогда
		Адрес = Сред(Адрес, 8); // после "http://"
	Иначе
		Результат.SecureConnection = Ложь;
	КонецЕсли;
	
	// Разделить по первому "/" - host:port / device
	ПозицияСлеш = СтрНайти(Адрес, "/");
	Если ПозицияСлеш > 0 Тогда
		ЧастьDevice = Сред(Адрес, ПозицияСлеш + 1);
		Адрес = Лев(Адрес, ПозицияСлеш - 1);
		Если НЕ ПустаяСтрока(ЧастьDevice) Тогда
			Результат.Device = ЧастьDevice;
		КонецЕсли;
	КонецЕсли;
	
	// Разделить host:port
	ПозицияДвоеточие = СтрНайти(Адрес, ":");
	Если ПозицияДвоеточие > 0 Тогда
		Результат.Host = Лев(Адрес, ПозицияДвоеточие - 1);
		СтрокаПорт = Сред(Адрес, ПозицияДвоеточие + 1);
		ОписаниеТиповЧисло = Новый ОписаниеТипов("Число");
		ЗначениеПорта = ОписаниеТиповЧисло.ПривестиЗначение(СтрокаПорт);
		Если ЗначениеПорта > 0 Тогда
			Результат.Port = ЗначениеПорта;
		КонецЕсли;
	Иначе
		Результат.Host = Адрес;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Формирует стандартное тело JSON-запроса для Device Manager.
//
// Параметры:
//  ПараметрыПодкл - Структура - параметры подключения
//  ФискальныеДанные - Структура - данные задания (task, receipt/cash)
//
// Возвращаемое значение:
//  Структура - готовое тело запроса
//
Функция СформироватьТелоЗапроса(ПараметрыПодкл, ФискальныеДанные)
	
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("ver", 6);
	ТелоЗапроса.Вставить("source", "PTM_Driver_Vchasno");
	ТелоЗапроса.Вставить("device", ПараметрыПодкл.Device);
	ТелоЗапроса.Вставить("tag", Строка(Новый УникальныйИдентификатор));
	ТелоЗапроса.Вставить("type", 1);
	ТелоЗапроса.Вставить("fiscal", ФискальныеДанные);
	
	Возврат ТелоЗапроса;
	
КонецФункции

// Извлекает код результата из ответа Device Manager.
//
// Параметры:
//  ОтветСервера - Соответствие - распарсенный JSON-ответ
//
// Возвращаемое значение:
//  Число - код ответа (0 = успех)
//
Функция ПолучитьКодОтвета(ОтветСервера)
	
	КодОтвета = 0;
	Если ТипЗнч(ОтветСервера) = Тип("Соответствие") Тогда
		ЗначениеRes = ОтветСервера["res"];
		Если ЗначениеRes <> Неопределено Тогда
			КодОтвета = ЗначениеRes;
		КонецЕсли;
	КонецЕсли;
	Возврат КодОтвета;
	
КонецФункции

// Извлекает текст ошибки из ответа Device Manager.
//
// Параметры:
//  ОтветСервера - Соответствие - распарсенный JSON-ответ
//
// Возвращаемое значение:
//  Строка - текст ошибки
//
Функция ПолучитьТекстОшибкиОтвета(ОтветСервера)
	
	ТекстОшибки = "";
	Если ТипЗнч(ОтветСервера) = Тип("Соответствие") Тогда
		ЗначениеErr = ОтветСервера["errortxt"];
		Если ЗначениеErr <> Неопределено Тогда
			ТекстОшибки = Строка(ЗначениеErr);
		КонецЕсли;
	КонецЕсли;
	Возврат ТекстОшибки;
	
КонецФункции

// Получает параметр из структуры с значением по умолчанию.
//
// Параметры:
//  ИсходнаяСтруктура - Структура - структура с параметрами
//  ИмяПараметра - Строка - имя искомого параметра
//  ЗначениеПоУмолчанию - Произвольный - значение при отсутствии параметра
//
// Возвращаемое значение:
//  Произвольный - значение параметра или значение по умолчанию
//
Функция ПолучитьПараметр(ИсходнаяСтруктура, ИмяПараметра, ЗначениеПоУмолчанию)
	
	Значение = ЗначениеПоУмолчанию;
	Если ИсходнаяСтруктура <> Неопределено И ТипЗнч(ИсходнаяСтруктура) = Тип("Структура") Тогда
		Если ИсходнаяСтруктура.Свойство(ИмяПараметра) Тогда
			Значение = ИсходнаяСтруктура[ИмяПараметра];
		КонецЕсли;
	КонецЕсли;
	Возврат Значение;
	
КонецФункции

// Выполняет HTTP POST запрос к Vchasno Kasa Device Manager.
//
// Параметры:
//  ПараметрыПодкл - Структура - Host, Port, SecureConnection
//  АдресРесурса - Строка - путь ресурса ("/dm/execute")
//  ТелоЗапроса - Структура - данные для сериализации в JSON
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево - признак успешного выполнения
//    * Ошибка - Строка - текст ошибки
//    * Ответ - Соответствие - распарсенный JSON-ответ сервера
//
Функция ВыполнитьHTTPЗапросЛокальный(ПараметрыПодкл, АдресРесурса, ТелоЗапроса) // BSLLS:InternetAccess-off
	
	Результат = Новый Структура("Успех, Ошибка, Ответ", Ложь, "", Неопределено);
	
	Хост = ПараметрыПодкл.Host;
	Порт = ПараметрыПодкл.Port;
	
	// Сериализовать тело запроса в JSON
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ТелоЗапроса);
	ТелоСтрока = ЗаписьJSON.Закрыть();
	
	// Создать HTTP-соединение
	ЗащищенноеСоединение = Неопределено;
	Если ПараметрыПодкл.SecureConnection Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	КонецЕсли;
	
	Таймаут = 60; // секунд, фискализация может быть долгой
	
	Попытка
		Соединение = Новый HTTPСоединение(Хост, Порт, , , , Таймаут, ЗащищенноеСоединение); // BSLLS:InternetAccess-off
	Исключение
		Результат.Ошибка = "Ошибка соединения с Device Manager ("
			+ Хост + ":" + Формат(Порт, "ЧГ=0")
			+ "): " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	
	// Сформировать HTTP-запрос
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	
	Запрос = Новый HTTPЗапрос(АдресРесурса, Заголовки); // BSLLS:InternetAccess-off
	Запрос.УстановитьТелоИзСтроки(ТелоСтрока, , ИспользованиеByteOrderMark.НеИспользовать);
	
	// Отправить запрос
	Попытка
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Исключение
		Результат.Ошибка = "Ошибка HTTP-запроса к Device Manager: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	
	// Проверить HTTP-код
	Если Ответ.КодСостояния < 200 ИЛИ Ответ.КодСостояния > 299 Тогда
		Результат.Ошибка = "Device Manager вернул HTTP " + Формат(Ответ.КодСостояния, "ЧГ=0")
			+ ": " + Ответ.ПолучитьТелоКакСтроку();
		Возврат Результат;
	КонецЕсли;
	
	// Парсинг JSON-ответа
	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
	Если ПустаяСтрока(ТелоОтвета) Тогда
		ТелоОтвета = "{}";
	КонецЕсли;
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		Результат.Ответ = ПрочитатьJSON(ЧтениеJSON, Истина);
	Исключение
		Результат.Ошибка = "Ошибка разбора JSON-ответа Device Manager: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	
	Результат.Успех = Истина;
	Возврат Результат;
	
КонецФункции

#КонецОбласти
