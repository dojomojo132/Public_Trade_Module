#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	КассовоеОборудование = Справочники.КассовоеОборудование.ПустаяСсылка();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьСмену(Команда)
	Результат = ОткрытьСменуНаСервере();
	ПоказатьРезультат(Результат);
КонецПроцедуры

&НаСервере
Функция ОткрытьСменуНаСервере()
	Возврат ВыполнитьОперацию(0, "Открытие смены");
КонецФункции

&НаКлиенте
Процедура XОтчет(Команда)
	Результат = XОтчетНаСервере();
	ПоказатьРезультат(Результат);
КонецПроцедуры

&НаСервере
Функция XОтчетНаСервере()
	Возврат ВыполнитьОперацию(10, "X-отчёт");
КонецФункции

&НаКлиенте
Процедура ZОтчет(Команда)
	Результат = ZОтчетНаСервере();
	ПоказатьРезультат(Результат);
КонецПроцедуры

&НаСервере
Функция ZОтчетНаСервере()
	Возврат ВыполнитьОперацию(11, "Z-отчёт (закрытие смены)");
КонецФункции

&НаКлиенте
Процедура Внесение(Команда)
	Результат = ВнесениеНаСервере(Сумма);
	ПоказатьРезультат(Результат);
КонецПроцедуры

&НаСервере
Функция ВнесениеНаСервере(Знач СуммаОперации)
	Возврат ВыполнитьОперациюКасса(СуммаОперации, "Внесение");
КонецФункции

&НаКлиенте
Процедура Изъятие(Команда)
	Результат = ИзъятиеНаСервере(Сумма);
	ПоказатьРезультат(Результат);
КонецПроцедуры

&НаСервере
Функция ИзъятиеНаСервере(Знач СуммаОперации)
	Возврат ВыполнитьОперациюКасса(-СуммаОперации, "Изъятие");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьРезультат(Результат)
	СтрокаСтатуса = Результат.Статус;
	Для Каждого Стр Из Результат.Сообщения Цикл
		Сообщить(Стр);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыОборудования()
	Если НЕ ЗначениеЗаполнено(КассовоеОборудование) Тогда
		Возврат Неопределено;
	КонецЕсли;
	КО = КассовоеОборудование.ПолучитьОбъект();
	ПараметрыОбор = Новый Структура;
	ПараметрыОбор.Вставить("АдресСервера", КО.АдресСервера);
	Возврат ПараметрыОбор;
КонецФункции

&НаСервере
Функция ВыполнитьОперацию(Знач НомерЗадачи, Знач НазваниеОперации)
	Результат = Новый Структура("Статус, Сообщения");
	Результат.Сообщения = Новый Массив;

	ПараметрыОбор = ПолучитьПараметрыОборудования();
	Если ПараметрыОбор = Неопределено Тогда
		Результат.Статус = "Ошибка: кассовое оборудование не выбрано";
		Результат.Сообщения.Добавить(Результат.Статус);
		Возврат Результат;
	КонецЕсли;

	Попытка
		Если НомерЗадачи = 0 Тогда
			Итог = Вчсн_ДрайверПРРО.ОткрытьСмену(ПараметрыОбор);
		ИначеЕсли НомерЗадачи = 10 Тогда
			Итог = Вчсн_ДрайверПРРО.XОтчет(ПараметрыОбор);
		ИначеЕсли НомерЗадачи = 11 Тогда
			Итог = Вчсн_ДрайверПРРО.ЗакрытьСмену(ПараметрыОбор);
		Иначе
			Результат.Статус = "Ошибка: неизвестная операция " + НомерЗадачи;
			Результат.Сообщения.Добавить(Результат.Статус);
			Возврат Результат;
		КонецЕсли;
	Исключение
		Результат.Статус = "Исключение: " + ОписаниеОшибки();
		Результат.Сообщения.Добавить(Результат.Статус);
		Возврат Результат;
	КонецПопытки;

	Если Итог.Успех Тогда
		Результат.Статус = НазваниеОперации + ": выполнено успешно";
	Иначе
		Результат.Статус = НазваниеОперации + ": ОШИБКА — " + Итог.Ошибка;
	КонецЕсли;
	Результат.Сообщения.Добавить(Результат.Статус);

	// Вывести полный ответ DM
	Если Итог.Свойство("Информация") И Итог.Информация <> Неопределено Тогда
		Результат.Сообщения.Добавить("────────────────────────────────");
		Результат.Сообщения.Добавить("Ответ Device Manager:");
		ДобавитьИнформациюИзОтвета(Результат.Сообщения, Итог.Информация, "");
	КонецЕсли;

	Возврат Результат;
КонецФункции

&НаСервере
Функция ВыполнитьОперациюКасса(Знач СуммаОперации, Знач НазваниеОперации)
	Результат = Новый Структура("Статус, Сообщения");
	Результат.Сообщения = Новый Массив;

	ПараметрыОбор = ПолучитьПараметрыОборудования();
	Если ПараметрыОбор = Неопределено Тогда
		Результат.Статус = "Ошибка: кассовое оборудование не выбрано";
		Результат.Сообщения.Добавить(Результат.Статус);
		Возврат Результат;
	КонецЕсли;

	Попытка
		Итог = Вчсн_ДрайверПРРО.ВнесениеВыемка(ПараметрыОбор, СуммаОперации);
	Исключение
		Результат.Статус = "Исключение: " + ОписаниеОшибки();
		Результат.Сообщения.Добавить(Результат.Статус);
		Возврат Результат;
	КонецПопытки;

	Если Итог.Успех Тогда
		Результат.Статус = НазваниеОперации + " (" + Формат(?(СуммаОперации >= 0, СуммаОперации, -СуммаОперации), "ЧДЦ=2") + "): выполнено";
	Иначе
		Результат.Статус = НазваниеОперации + ": ОШИБКА — " + Итог.Ошибка;
	КонецЕсли;
	Результат.Сообщения.Добавить(Результат.Статус);

	Если Итог.Свойство("Информация") И Итог.Информация <> Неопределено Тогда
		Результат.Сообщения.Добавить("────────────────────────────────");
		Результат.Сообщения.Добавить("Ответ Device Manager:");
		ДобавитьИнформациюИзОтвета(Результат.Сообщения, Итог.Информация, "");
	КонецЕсли;

	Возврат Результат;
КонецФункции

&НаСервере
Процедура ДобавитьИнформациюИзОтвета(Сообщения, Данные, Отступ)
	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Для Каждого КлючЗначение Из Данные Цикл
			Если ТипЗнч(КлючЗначение.Значение) = Тип("Соответствие") Тогда
				Сообщения.Добавить(Отступ + Строка(КлючЗначение.Ключ) + ":");
				ДобавитьИнформациюИзОтвета(Сообщения, КлючЗначение.Значение, Отступ + "  ");
			ИначеЕсли ТипЗнч(КлючЗначение.Значение) = Тип("Массив") Тогда
				Сообщения.Добавить(Отступ + Строка(КлючЗначение.Ключ) + ": [" + Формат(КлючЗначение.Значение.Количество(), "ЧГ=0") + " элементов]");
				Для Каждого Элемент Из КлючЗначение.Значение Цикл
					ДобавитьИнформациюИзОтвета(Сообщения, Элемент, Отступ + "  ");
				КонецЦикла;
			Иначе
				Сообщения.Добавить(Отступ + Строка(КлючЗначение.Ключ) + ": " + Строка(КлючЗначение.Значение));
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Данные) = Тип("Массив") Тогда
		Для Каждого Элемент Из Данные Цикл
			ДобавитьИнформациюИзОтвета(Сообщения, Элемент, Отступ);
		КонецЦикла;
	Иначе
		Сообщения.Добавить(Отступ + Строка(Данные));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
