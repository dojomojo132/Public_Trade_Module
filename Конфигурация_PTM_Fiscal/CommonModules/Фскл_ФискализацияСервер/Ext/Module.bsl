#Область ПрограммныйИнтерфейс

// Обработчик подписки на событие ОбработкаПроведения документа ЧекККМ.
// Вызывается платформой автоматически при проведении ЧекККМ (после основной обработки).
//
// Параметры:
//  Источник - ДокументОбъект.ЧекККМ - проводимый документ
//  Отказ - Булево - флаг отказа проведения
//  РежимПроведения - РежимПроведенияДокумента - режим проведения
//
Процедура Фскл_ОбработкаПроведенияЧекККМ(Источник, Отказ, РежимПроведения) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьФискализацию(Источник.Ссылка, Отказ);
	
КонецПроцедуры

// Выполняет фискализацию документа ЧекККМ.
// Вызывается из подписки на событие ОбработкаПроведения ЧекККМ.
//
// Параметры:
//  СсылкаНаЧек - ДокументСсылка.ЧекККМ - ссылка на проведённый чек
//  Отказ - Булево - флаг отказа (если Истина - проведение будет отменено)
//
Процедура ВыполнитьФискализацию(СсылкаНаЧек, Отказ) Экспорт
	
	// 1. Получить данные чека
	ДанныеЧека = ПолучитьДанныеЧека(СсылкаНаЧек);
	Если ДанныеЧека = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// 2. Получить оборудование кассы
	Оборудование = ПолучитьОборудованиеКассы(ДанныеЧека.Касса);
	Если Оборудование = Неопределено Тогда
		Возврат; // Нет оборудования - фискализация не выполняется
	КонецЕсли;
	
	// 3. Распределить позиции по ФОП
	ГруппыПоФОП = РаспределитьПоФОП(ДанныеЧека.Товары);
	
	// 4. Создать ФискальныйЧек для каждой группы
	Для Каждого ГруппаФОП Из ГруппыПоФОП Цикл
		СоздатьФискальныйЧек(СсылкаНаЧек, Оборудование, ГруппаФОП.Ключ, ГруппаФОП.Значение, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

// Получает данные чека ККМ для фискализации.
//
// Параметры:
//  СсылкаНаЧек - ДокументСсылка.ЧекККМ - ссылка на чек
//
// Возвращаемое значение:
//  Структура, Неопределено - данные чека или Неопределено если чек не найден
//
Функция ПолучитьДанныеЧека(СсылкаНаЧек)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЧекККМ.Ссылка КАК Ссылка,
	|	ЧекККМ.Касса КАК Касса,
	|	ЧекККМ.Склад КАК Склад,
	|	ЧекККМ.Сумма КАК Сумма,
	|	ЧекККМ.СуммаНаличными КАК СуммаНаличными,
	|	ЧекККМ.СуммаБезналичная КАК СуммаБезналичная,
	|	ЧекККМ.КассоваяСмена КАК КассоваяСмена
	|ИЗ
	|	Документ.ЧекККМ КАК ЧекККМ
	|ГДЕ
	|	ЧекККМ.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаЧек);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	ДанныеЧека = Новый Структура;
	ДанныеЧека.Вставить("Ссылка", Выборка.Ссылка);
	ДанныеЧека.Вставить("Касса", Выборка.Касса);
	ДанныеЧека.Вставить("Склад", Выборка.Склад);
	ДанныеЧека.Вставить("Сумма", Выборка.Сумма);
	ДанныеЧека.Вставить("СуммаНаличными", Выборка.СуммаНаличными);
	ДанныеЧека.Вставить("СуммаБезналичная", Выборка.СуммаБезналичная);
	ДанныеЧека.Вставить("КассоваяСмена", Выборка.КассоваяСмена);
	
	// Получить товары
	ЗапросТовары = Новый Запрос;
	ЗапросТовары.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	ЕСТЬNULL(Номенклатура.НалоговаяГруппа, ЗНАЧЕНИЕ(Справочник.НалоговыеГруппы.ПустаяСсылка)) КАК НалоговаяГруппа
	|ИЗ
	|	Документ.ЧекККМ.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО Товары.Номенклатура = Номенклатура.Ссылка
	|ГДЕ
	|	Товары.Ссылка = &Ссылка";
	ЗапросТовары.УстановитьПараметр("Ссылка", СсылкаНаЧек);
	
	ДанныеЧека.Вставить("Товары", ЗапросТовары.Выполнить().Выгрузить());
	
	Возврат ДанныеЧека;
	
КонецФункции

// Получает кассовое оборудование (ПРРО) для указанной кассы.
//
// Параметры:
//  Касса - СправочникСсылка.Кассы - ссылка на кассу
//
// Возвращаемое значение:
//  Структура, Неопределено - параметры оборудования или Неопределено
//
Функция ПолучитьОборудованиеКассы(Касса)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КассовоеОборудование.Ссылка КАК Ссылка,
	|	КассовоеОборудование.ТипДрайвера КАК ТипДрайвера,
	|	КассовоеОборудование.АдресСервера КАК АдресСервера,
	|	КассовоеОборудование.Токен КАК Токен
	|ИЗ
	|	Справочник.КассовоеОборудование КАК КассовоеОборудование
	|ГДЕ
	|	КассовоеОборудование.Владелец = &Касса
	|	И НЕ КассовоеОборудование.ПометкаУдаления
	|	И КассовоеОборудование.ТипДрайвера <> ЗНАЧЕНИЕ(Перечисление.ТипыДрайверовПРРО.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Касса", Касса);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	ПараметрыОборудования = Новый Структура;
	ПараметрыОборудования.Вставить("Ссылка", Выборка.Ссылка);
	ПараметрыОборудования.Вставить("ТипДрайвера", Выборка.ТипДрайвера);
	ПараметрыОборудования.Вставить("АдресСервера", Выборка.АдресСервера);
	ПараметрыОборудования.Вставить("Токен", Выборка.Токен);
	
	Возврат ПараметрыОборудования;
	
КонецФункции

// Распределяет товары по ФОП на основе регистра РаспределениеНалоговыхГрупп.
// Если все товары попадают в один ФОП или маппинг не настроен - возвращает одну группу.
//
// Параметры:
//  ТаблицаТоваров - ТаблицаЗначений - таблица строк товаров чека
//
// Возвращаемое значение:
//  Соответствие - Ключ = ФОП (или Неопределено), Значение = Массив строк товаров
//
Функция РаспределитьПоФОП(ТаблицаТоваров)
	
	// Получить маппинг НалоговаяГруппа -> ФОП из регистра
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Р.НалоговаяГруппа КАК НалоговаяГруппа,
	|	Р.ФОП КАК ФОП
	|ИЗ
	|	РегистрСведений.РаспределениеНалоговыхГрупп КАК Р";
	
	МаппингНГ = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МаппингНГ.Вставить(Выборка.НалоговаяГруппа, Выборка.ФОП);
	КонецЦикла;
	
	// Распределить товары по ФОП
	ГруппыПоФОП = Новый Соответствие;
	Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
		ФОП = МаппингНГ.Получить(СтрокаТовара.НалоговаяГруппа);
		
		Если ГруппыПоФОП.Получить(ФОП) = Неопределено Тогда
			ГруппыПоФОП.Вставить(ФОП, Новый Массив);
		КонецЕсли;
		ГруппыПоФОП.Получить(ФОП).Добавить(СтрокаТовара);
	КонецЦикла;
	
	// Если маппинг пуст - все товары в одну группу
	Если ГруппыПоФОП.Количество() = 0 Тогда
		ВсеТовары = Новый Массив;
		Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
			ВсеТовары.Добавить(СтрокаТовара);
		КонецЦикла;
		ГруппыПоФОП.Вставить(Неопределено, ВсеТовары);
	КонецЕсли;
	
	Возврат ГруппыПоФОП;
	
КонецФункции

// Создает документ ФискальныйЧек и отправляет его через драйвер ПРРО.
//
// Параметры:
//  СсылкаНаЧекККМ - ДокументСсылка.ЧекККМ - ссылка на исходный чек
//  ПараметрыОборудования - Структура - параметры кассового оборудования
//  ФОП - Неопределено, СправочникСсылка - ФОП для группы товаров
//  МассивТоваров - Массив - массив строк товаров
//  Отказ - Булево - флаг отказа проведения
//
Процедура СоздатьФискальныйЧек(СсылкаНаЧекККМ, ПараметрыОборудования, ФОП, МассивТоваров, Отказ)
	
	// 1. Создать документ ФискальныйЧек
	ФискЧек = Документы.ФискальныйЧек.СоздатьДокумент();
	ФискЧек.Дата = ТекущаяДатаСеанса();
	ФискЧек.Оборудование = ПараметрыОборудования.Ссылка;
	ФискЧек.ДокументОснование = СсылкаНаЧекККМ;
	ФискЧек.Статус = Перечисления.СтатусыФискализации.КОтправке;
	
	// 2. Заполнить ТЧ Товары
	СуммаЧека = 0;
	Для Каждого СтрокаТовара Из МассивТоваров Цикл
		НоваяСтрока = ФискЧек.Товары.Добавить();
		НоваяСтрока.Номенклатура = СтрокаТовара.Номенклатура;
		НоваяСтрока.Количество = СтрокаТовара.Количество;
		НоваяСтрока.Цена = СтрокаТовара.Цена;
		НоваяСтрока.Сумма = СтрокаТовара.Сумма;
		НоваяСтрока.НомерСтрокиЧекаККМ = СтрокаТовара.НомерСтроки;
		СуммаЧека = СуммаЧека + СтрокаТовара.Сумма;
	КонецЦикла;
	ФискЧек.Сумма = СуммаЧека;
	
	// 3. Вызвать драйвер ПРРО
	РезультатФискализации = ВызватьДрайверПРРО(ПараметрыОборудования, ФискЧек);
	
	// 4. Обновить статус по результату
	Если РезультатФискализации.Успех Тогда
		ФискЧек.Статус = Перечисления.СтатусыФискализации.Фискализирован;
		ФискЧек.ФискальныйНомер = РезультатФискализации.ФискальныйНомер;
	Иначе
		ФискЧек.Статус = Перечисления.СтатусыФискализации.Ошибка;
		// Не отменяем проведение ЧекККМ при ошибке фискализации
		// Чек будет повторно отправлен регламентным заданием
	КонецЕсли;
	
	// 5. Записать чек
	ФискЧек.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

// Вызывает драйвер ПРРО по типу оборудования.
// Драйверы находятся в отдельных расширениях (PTM_Driver_*).
//
// Параметры:
//  ПараметрыОборудования - Структура - параметры кассового оборудования
//  ФискЧек - ДокументОбъект.ФискальныйЧек - создаваемый фискальный чек
//
// Возвращаемое значение:
//  Структура - Успех (Булево), ФискальныйНомер (Строка), Ошибка (Строка)
//
Функция ВызватьДрайверПРРО(ПараметрыОборудования, ФискЧек)
	
	Результат = Новый Структура("Успех, ФискальныйНомер, Ошибка", Ложь, "", "");
	
	ТипДрайвера = ПараметрыОборудования.ТипДрайвера;
	
	// Диспетчер: выбрать модуль драйвера по типу
	ИмяМодуляДрайвера = ПолучитьИмяМодуляДрайвера(ТипДрайвера);
	Если ИмяМодуляДрайвера = Неопределено Тогда
		Результат.Ошибка = "Не найден драйвер ПРРО для типа: " + Строка(ТипДрайвера);
		Возврат Результат;
	КонецЕсли;
	
	// Проверить доступность модуля драйвера (расширение подключено?)
	Попытка
		МодульДрайвера = Вычислить(ИмяМодуляДрайвера);
	Исключение
		Результат.Ошибка = "Расширение драйвера не подключено: " + ИмяМодуляДрайвера;
		Возврат Результат;
	КонецПопытки;
	
	// Открыть чек
	РезОткрытия = МодульДрайвера.ОткрытьЧек(ПараметрыОборудования, "Продажа");
	Если НЕ РезОткрытия.Успех Тогда
		Результат.Ошибка = "Ошибка открытия чека: " + РезОткрытия.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	// Добавить позиции
	Для Каждого СтрокаТовара Из ФискЧек.Товары Цикл
		РезПозиции = МодульДрайвера.ДобавитьПозицию(
			СтрокаТовара.Номенклатура,
			СтрокаТовара.Количество,
			СтрокаТовара.Цена,
			СтрокаТовара.Сумма,
			"");
		Если НЕ РезПозиции.Успех Тогда
			Результат.Ошибка = "Ошибка добавления позиции: " + РезПозиции.Ошибка;
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	
	// Закрыть чек
	РезЗакрытия = МодульДрайвера.ЗакрытьЧек(ФискЧек.Сумма, "Наличные");
	Если РезЗакрытия.Успех Тогда
		Результат.Успех = Истина;
		Результат.ФискальныйНомер = РезЗакрытия.ФискальныйНомер;
	Иначе
		Результат.Ошибка = "Ошибка закрытия чека: " + РезЗакрытия.Ошибка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает имя общего модуля драйвера по типу.
// Драйверы в ОТДЕЛЬНЫХ расширениях со своими префиксами:
//  PTM_Driver_Emulator -> Эмл_ДрайверПРРО
//  PTM_Driver_Checkbox -> Чбкс_ДрайверПРРО
//  PTM_Driver_Vchasno  -> Вчсн_ДрайверПРРО
//
// Параметры:
//  ТипДрайвера - ПеречислениеСсылка.ТипыДрайверовПРРО - тип драйвера ПРРО
//
// Возвращаемое значение:
//  Строка, Неопределено - имя модуля драйвера или Неопределено
//
Функция ПолучитьИмяМодуляДрайвера(ТипДрайвера)
	
	СоответствиеДрайверов = Новый Соответствие;
	СоответствиеДрайверов.Вставить(Перечисления.ТипыДрайверовПРРО.Эмулятор, "Эмл_ДрайверПРРО");
	СоответствиеДрайверов.Вставить(Перечисления.ТипыДрайверовПРРО.Checkbox, "Чбкс_ДрайверПРРО");
	СоответствиеДрайверов.Вставить(Перечисления.ТипыДрайверовПРРО.Vchasno, "Вчсн_ДрайверПРРО");
	
	Возврат СоответствиеДрайверов.Получить(ТипДрайвера);
	
КонецФункции

#КонецОбласти
