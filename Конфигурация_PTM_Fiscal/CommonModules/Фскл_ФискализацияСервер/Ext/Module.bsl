#Область ПрограммныйИнтерфейс

// Контракт драйверов ПРРО (расширения PTM_Driver_*):
//   ОткрытьЧек(ПараметрыОборудования, ТипОперации) -> {Успех, Ошибка, КонтекстЧека}
//   ДобавитьПозицию(КонтекстЧека, ДанныеПозиции) -> {Успех, Ошибка}
//   ЗакрытьЧек(КонтекстЧека, Сумма, ВидОплаты) -> {Успех, ФискальныйНомер, Ошибка}
// ДанныеПозиции: Номенклатура, Количество, Цена, Сумма, АкцизнаяМарка, НалоговаяГруппа, КодУКТЗЕД
// ВидОплаты: "Наличные" | "Безналичные"

// Выполняет фискализацию документа ЧекККМ.
// Вызывается из &После("ОбработкаПроведения") в ObjectModule расширения PTM_Fiscal.
//
// Параметры:
//  СсылкаНаЧек - ДокументСсылка.ЧекККМ - ссылка на проведённый чек
//  Отказ - Булево - флаг отказа (если Истина - проведение будет отменено)
//
Процедура ВыполнитьФискализацию(СсылкаНаЧек, Отказ) Экспорт
	
	Если НЕ НастройкиПоУмолчанию.ПолучитьФискальныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросПроверки = Новый Запрос;
	ЗапросПроверки.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ФискальныйЧек.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ФискальныйЧек КАК ФискальныйЧек
	|ГДЕ
	|	ФискальныйЧек.ДокументОснование = &Ссылка";
	ЗапросПроверки.УстановитьПараметр("Ссылка", СсылкаНаЧек);
	Если НЕ ЗапросПроверки.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеЧека = ПолучитьДанныеЧека(СсылкаНаЧек);
	Если ДанныеЧека = Неопределено Тогда
		СообщитьОшибкуФискализации("Не удалось получить данные чека ККМ для фискализации.", Отказ);
		Возврат;
	КонецЕсли;
	
	Если НЕ ТребуетсяФискализацияЧека(ДанныеЧека) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПроверитьТоварыДляФискализации(ДанныеЧека.Товары, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Фскл_ОстаткиСервер.ПроверитьТоварыДляПродажи(ДанныеЧека.Товары, ДанныеЧека.Дата, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	Оборудование = ПолучитьОборудованиеКассы(ДанныеЧека.Касса);
	Если Оборудование = Неопределено Тогда
		СообщитьОшибкуФискализации(
			"Для кассы """ + Строка(ДанныеЧека.Касса) + """ не настроено фискальное оборудование (ПРРО).",
			Отказ);
		Возврат;
	КонецЕсли;
	
	ГруппыПоФОП = РаспределитьПоФОП(ДанныеЧека.Товары);
	Если ГруппыПоФОП.Количество() = 0 Тогда
		СообщитьОшибкуФискализации("Нет товаров для фискализации.", Отказ);
		Возврат;
	КонецЕсли;
	
	ВидОплаты = ДанныеЧека.ВидОплаты;
	
	Для Каждого ГруппаФОП Из ГруппыПоФОП Цикл
		СоздатьФискальныйЧек(
			СсылкаНаЧек,
			Оборудование,
			ГруппаФОП.Ключ,
			ГруппаФОП.Значение,
			ВидОплаты,
			Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТребуетсяФискализацияЧека(ДанныеЧека)
	
	Возврат ДанныеЧека.Статус = Перечисления.СтатусыЧекаККМ.Пробит;
	
КонецФункции

Процедура СообщитьОшибкуФискализации(ТекстОшибки, Отказ)
	
	Отказ = Истина;
	ОбщегоНазначенияБПО.СообщитьПользователю(ТекстОшибки);
	
КонецПроцедуры

Функция ПроверитьТоварыДляФискализации(ТаблицаТоваров, Отказ)
	
	СписокБезНГ = Новый Массив;
	
	Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТовара.НалоговаяГруппа) Тогда
			СписокБезНГ.Добавить(Строка(СтрокаТовара.Номенклатура));
		КонецЕсли;
	КонецЦикла;
	
	Если СписокБезНГ.Количество() > 0 Тогда
		СообщитьОшибкуФискализации(
			"Для фискального чека у всех товаров должна быть заполнена налоговая группа. "
			+ "Не заполнено: " + СтрСоединить(СписокБезНГ, ", "),
			Отказ);
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеЧека(СсылкаНаЧек)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЧекККМ.Ссылка КАК Ссылка,
	|	ЧекККМ.Касса КАК Касса,
	|	ЧекККМ.Склад КАК Склад,
	|	ЧекККМ.СуммаДокумента КАК СуммаДокумента,
	|	ЧекККМ.КассоваяСмена КАК КассоваяСмена,
	|	ЧекККМ.Статус КАК Статус,
	|	ЧекККМ.Дата КАК Дата
	|ИЗ
	|	Документ.ЧекККМ КАК ЧекККМ
	|ГДЕ
	|	ЧекККМ.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаЧек);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	ДанныеЧека = Новый Структура;
	ДанныеЧека.Вставить("Ссылка", Выборка.Ссылка);
	ДанныеЧека.Вставить("Касса", Выборка.Касса);
	ДанныеЧека.Вставить("Склад", Выборка.Склад);
	ДанныеЧека.Вставить("СуммаДокумента", Выборка.СуммаДокумента);
	ДанныеЧека.Вставить("КассоваяСмена", Выборка.КассоваяСмена);
	ДанныеЧека.Вставить("Статус", Выборка.Статус);
	ДанныеЧека.Вставить("Дата", Выборка.Дата);
	ДанныеЧека.Вставить("ВидОплаты", ПолучитьВидОплатыЧека(СсылкаНаЧек));
	
	ЗапросТовары = Новый Запрос;
	ЗапросТовары.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.АкцизнаяМарка КАК АкцизнаяМарка,
	|	ЕСТЬNULL(СпрНоменклатура.НалоговаяГруппа, ЗНАЧЕНИЕ(Справочник.НалоговыеГруппы.ПустаяСсылка)) КАК НалоговаяГруппа,
	|	ЕСТЬNULL(СпрНоменклатура.КодУКТЗЕД, """") КАК КодУКТЗЕД
	|ИЗ
	|	Документ.ЧекККМ.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО Товары.Номенклатура = СпрНоменклатура.Ссылка
	|ГДЕ
	|	Товары.Ссылка = &Ссылка";
	ЗапросТовары.УстановитьПараметр("Ссылка", СсылкаНаЧек);
	
	ДанныеЧека.Вставить("Товары", ЗапросТовары.Выполнить().Выгрузить());
	
	Возврат ДанныеЧека;
	
КонецФункции

Функция ПолучитьВидОплатыЧека(СсылкаНаЧек)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Оплата.ВидОплаты КАК ВидОплаты
	|ИЗ
	|	Документ.ЧекККМ.Оплата КАК Оплата
	|ГДЕ
	|	Оплата.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаЧек);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат "Наличные";
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Если Выборка.ВидОплаты = Перечисления.ВидыОплаты.Безналичные Тогда
		Возврат "Безналичные";
	КонецЕсли;
	
	Возврат "Наличные";
	
КонецФункции

Функция СформироватьДанныеПозиции(СтрокаТовара)
	
	ДанныеПозиции = Новый Структура;
	ДанныеПозиции.Вставить("Номенклатура", СтрокаТовара.Номенклатура);
	ДанныеПозиции.Вставить("Количество", СтрокаТовара.Количество);
	ДанныеПозиции.Вставить("Цена", СтрокаТовара.Цена);
	ДанныеПозиции.Вставить("Сумма", СтрокаТовара.Сумма);
	ДанныеПозиции.Вставить("АкцизнаяМарка", СтрокаТовара.АкцизнаяМарка);
	ДанныеПозиции.Вставить("НалоговаяГруппа", СтрокаТовара.НалоговаяГруппа);
	ДанныеПозиции.Вставить("КодУКТЗЕД", СтрокаТовара.КодУКТЗЕД);
	
	Возврат ДанныеПозиции;
	
КонецФункции

Функция ПолучитьОборудованиеКассы(Касса)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Кассы.Оборудование КАК Ссылка,
	|	КассовоеОборудование.ТипДрайвера КАК ТипДрайвера,
	|	КассовоеОборудование.АдресСервера КАК АдресСервера,
	|	КассовоеОборудование.Токен КАК Токен
	|ИЗ
	|	Справочник.Кассы КАК Кассы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КассовоеОборудование КАК КассовоеОборудование
	|		ПО Кассы.Оборудование = КассовоеОборудование.Ссылка
	|ГДЕ
	|	Кассы.Ссылка = &Касса
	|	И Кассы.Оборудование <> ЗНАЧЕНИЕ(Справочник.КассовоеОборудование.ПустаяСсылка)
	|	И КассовоеОборудование.ТипДрайвера <> ЗНАЧЕНИЕ(Перечисление.ТипыДрайверовПРРО.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Касса", Касса);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	ПараметрыОборудования = Новый Структура;
	ПараметрыОборудования.Вставить("Ссылка", Выборка.Ссылка);
	ПараметрыОборудования.Вставить("ТипДрайвера", Выборка.ТипДрайвера);
	ПараметрыОборудования.Вставить("АдресСервера", Выборка.АдресСервера);
	ПараметрыОборудования.Вставить("Токен", Выборка.Токен);
	
	Возврат ПараметрыОборудования;
	
КонецФункции

Функция РаспределитьПоФОП(ТаблицаТоваров)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Р.НалоговаяГруппа КАК НалоговаяГруппа,
	|	Р.ФОП КАК ФОП
	|ИЗ
	|	РегистрСведений.РаспределениеНалоговыхГрупп КАК Р";
	
	МаппингНГ = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МаппингНГ.Вставить(Выборка.НалоговаяГруппа, Выборка.ФОП);
	КонецЦикла;
	
	ГруппыПоФОП = Новый Соответствие;
	Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		ФОП = МаппингНГ.Получить(СтрокаТовара.НалоговаяГруппа);
		
		Если ГруппыПоФОП.Получить(ФОП) = Неопределено Тогда
			ГруппыПоФОП.Вставить(ФОП, Новый Массив);
		КонецЕсли;
		ГруппыПоФОП.Получить(ФОП).Добавить(СтрокаТовара);
		
	КонецЦикла;
	
	Если ГруппыПоФОП.Количество() = 0 И ТаблицаТоваров.Количество() > 0 Тогда
		ВсеТовары = Новый Массив;
		Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
			ВсеТовары.Добавить(СтрокаТовара);
		КонецЦикла;
		ГруппыПоФОП.Вставить(Неопределено, ВсеТовары);
	КонецЕсли;
	
	Возврат ГруппыПоФОП;
	
КонецФункции

Процедура СоздатьФискальныйЧек(СсылкаНаЧекККМ, ПараметрыОборудования, ФОП, МассивТоваров, ВидОплаты, Отказ)
	
	ФискЧек = Документы.ФискальныйЧек.СоздатьДокумент();
	ФискЧек.Дата = ТекущаяДатаСеанса();
	ФискЧек.Оборудование = ПараметрыОборудования.Ссылка;
	ФискЧек.ДокументОснование = СсылкаНаЧекККМ;
	ФискЧек.Статус = Перечисления.СтатусыФискализации.КОтправке;
	
	СуммаЧека = 0;
	Для Каждого СтрокаТовара Из МассивТоваров Цикл
		НоваяСтрока = ФискЧек.Товары.Добавить();
		НоваяСтрока.Номенклатура = СтрокаТовара.Номенклатура;
		НоваяСтрока.Количество = СтрокаТовара.Количество;
		НоваяСтрока.Цена = СтрокаТовара.Цена;
		НоваяСтрока.Сумма = СтрокаТовара.Сумма;
		СуммаЧека = СуммаЧека + СтрокаТовара.Сумма;
	КонецЦикла;
	ФискЧек.Сумма = СуммаЧека;
	
	РезультатФискализации = ВызватьДрайверПРРО(ПараметрыОборудования, ФискЧек, МассивТоваров, ВидОплаты);
	
	Если РезультатФискализации.Успех Тогда
		ФискЧек.Статус = Перечисления.СтатусыФискализации.Фискализирован;
		ФискЧек.ФискальныйНомер = РезультатФискализации.ФискальныйНомер;
		ФискЧек.Записать(РежимЗаписиДокумента.Запись);
		ЗарегистрироватьВСмене(
			ФискЧек.Ссылка,
			СсылкаНаЧекККМ,
			ФОП,
			ФискЧек.Сумма,
			ФискЧек.ФискальныйНомер);
		Фскл_ОстаткиСервер.СписатьПоУспешнойФискализации(
			ФОП,
			МассивТоваров,
			ФискЧек.Ссылка,
			ФискЧек.Дата);
	Иначе
		СообщитьОшибкуФискализации("Ошибка фискализации: " + РезультатФискализации.Ошибка, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Функция ВызватьДрайверПРРО(ПараметрыОборудования, ФискЧек, МассивТоваров, ВидОплаты)
	
	Результат = Новый Структура("Успех, ФискальныйНомер, Ошибка", Ложь, "", "");
	
	ИмяМодуляДрайвера = ПолучитьИмяМодуляДрайвера(ПараметрыОборудования.ТипДрайвера);
	Если ИмяМодуляДрайвера = Неопределено Тогда
		Результат.Ошибка = "Не найден драйвер ПРРО для типа: " + Строка(ПараметрыОборудования.ТипДрайвера);
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		РезОткрытия = Вычислить(СтрШаблон("%1.ОткрытьЧек(ПараметрыОборудования, ""Продажа"")", ИмяМодуляДрайвера));
	Исключение
		Результат.Ошибка = "Расширение драйвера не подключено: " + ИмяМодуляДрайвера;
		Возврат Результат;
	КонецПопытки;
	
	Если НЕ РезОткрытия.Успех Тогда
		Результат.Ошибка = "Ошибка открытия чека: " + РезОткрытия.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	КонтекстЧека = РезОткрытия.КонтекстЧека;
	
	Для Каждого СтрокаТовара Из МассивТоваров Цикл
		ДанныеПозиции = СформироватьДанныеПозиции(СтрокаТовара);
		Попытка
			РезПозиции = Вычислить(СтрШаблон("%1.ДобавитьПозицию(КонтекстЧека, ДанныеПозиции)", ИмяМодуляДрайвера));
		Исключение
			Результат.Ошибка = "Ошибка вызова драйвера при добавлении позиции: " + ОписаниеОшибки();
			Возврат Результат;
		КонецПопытки;
		Если НЕ РезПозиции.Успех Тогда
			Результат.Ошибка = "Ошибка добавления позиции: " + РезПозиции.Ошибка;
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	
	Попытка
		РезЗакрытия = Вычислить(СтрШаблон("%1.ЗакрытьЧек(КонтекстЧека, ФискЧек.Сумма, ""%2"")",
			ИмяМодуляДрайвера, ВидОплаты));
	Исключение
		Результат.Ошибка = "Ошибка вызова драйвера при закрытии чека: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	
	Если РезЗакрытия.Успех Тогда
		Результат.Успех = Истина;
		Результат.ФискальныйНомер = РезЗакрытия.ФискальныйНомер;
	Иначе
		Результат.Ошибка = "Ошибка закрытия чека: " + РезЗакрытия.Ошибка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Регистрирует чек ККМ и фискальный чек в открытой кассовой смене.
//
Процедура ЗарегистрироватьВСмене(СсылкаФискальныйЧек, СсылкаНаЧекККМ, ФОП, СуммаФискЧека, ФискальныйНомер)
	
	РеквизитыЧека = ОбщегоНазначенияБПО.ЗначенияРеквизитовОбъекта(
		СсылкаНаЧекККМ,
		"КассоваяСмена, Касса, СуммаДокумента");
	
	Если НЕ ЗначениеЗаполнено(РеквизитыЧека.КассоваяСмена) Тогда
		Возврат;
	КонецЕсли;
	
	СсылкаСмены = РеквизитыЧека.КассоваяСмена;
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Документ.КассоваяСмена");
	ЭлементБлокировки.УстановитьЗначение("Ссылка", СсылкаСмены);
	Блокировка.Заблокировать();
	
	СменаОбъект = СсылкаСмены.ПолучитьОбъект();
	Если СменаОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СменаОбъект.Статус <> Перечисления.СтатусыКассовойСмены.Открыта Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЕстьСтрокаЧекаККМВСмене(СменаОбъект, СсылкаНаЧекККМ) Тогда
		СтрокаЧека = СменаОбъект.ЧекиККМ.Добавить();
		СтрокаЧека.Касса = РеквизитыЧека.Касса;
		СтрокаЧека.ЧекККМ = СсылкаНаЧекККМ;
		СтрокаЧека.Сумма = РеквизитыЧека.СуммаДокумента;
		СтрокаЧека.СуммаСкидки = ПолучитьСуммуСкидкиЧека(СсылкаНаЧекККМ);
	КонецЕсли;
	
	Если НЕ ЕстьСтрокаФискальногоЧекаВСмене(СменаОбъект, СсылкаФискальныйЧек) Тогда
		СтрокаФиск = СменаОбъект.ФискальныеЧеки.Добавить();
		СтрокаФиск.ВидОперации = Перечисления.ВидыОперацийФискальногоЧека.Продажа;
		СтрокаФиск.ФОП = ФОП;
		СтрокаФиск.ФискальныйНомер = ФискальныйНомер;
		СтрокаФиск.Сумма = СуммаФискЧека;
		СтрокаФиск.ФискальныйЧек = СсылкаФискальныйЧек;
	КонецЕсли;
	
	СменаОбъект.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры

Функция ЕстьСтрокаЧекаККМВСмене(СменаОбъект, СсылкаНаЧекККМ)
	
	Для Каждого СтрокаТЧ Из СменаОбъект.ЧекиККМ Цикл
		Если СтрокаТЧ.ЧекККМ = СсылкаНаЧекККМ Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ЕстьСтрокаФискальногоЧекаВСмене(СменаОбъект, СсылкаФискальныйЧек)
	
	Для Каждого СтрокаТЧ Из СменаОбъект.ФискальныеЧеки Цикл
		Если СтрокаТЧ.ФискальныйЧек = СсылкаФискальныйЧек Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьСуммуСкидкиЧека(СсылкаНаЧекККМ)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Товары.СуммаСкидки), 0) КАК СуммаСкидки
	|ИЗ
	|	Документ.ЧекККМ.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаЧекККМ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СуммаСкидки;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция ПолучитьИмяМодуляДрайвера(ТипДрайвера)
	
	СоответствиеДрайверов = Новый Соответствие;
	СоответствиеДрайверов.Вставить(Перечисления.ТипыДрайверовПРРО.Эмулятор, "Эмл_ДрайверПРРО");
	СоответствиеДрайверов.Вставить(Перечисления.ТипыДрайверовПРРО.Checkbox, "Чбкс_ДрайверПРРО");
	СоответствиеДрайверов.Вставить(Перечисления.ТипыДрайверовПРРО.Vchasno, "Вчсн_ДрайверПРРО");
	
	Возврат СоответствиеДрайверов.Получить(ТипДрайвера);
	
КонецФункции

#КонецОбласти
