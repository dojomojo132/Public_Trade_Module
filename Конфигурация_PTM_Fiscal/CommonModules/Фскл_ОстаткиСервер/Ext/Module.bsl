#Область ПрограммныйИнтерфейс

// Контроль фискальных остатков включён (фискальный режим + настройка).
//
// Возвращаемое значение:
//   Булево
//
Функция КонтрольВключен() Экспорт
	
	Если НЕ НастройкиПоУмолчанию.ПолучитьФискальныйРежим() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат НастройкиПоУмолчанию.ПолучитьКонтрольФискальныхОстатков();
	
КонецФункции

// Возвращает остаток акцизного товара по ФОП на дату.
//
Функция ПолучитьОстаток(ФОП, Номенклатура, Дата) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Количество
	|ИЗ
	|	РегистрНакопления.ФискальныеОстатки.Остатки(
	|		&Дата,
	|		ФОП = &ФОП
	|			И Номенклатура = &Номенклатура) КАК Остатки";
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ФОП", ФОП);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

// Проверяет достаточность фискального остатка для одной позиции.
//
// Возвращаемое значение:
//   Структура - Достаточно, Остаток, ТекстОшибки
//
Функция ПроверитьДостаточность(ФОП, Номенклатура, Количество, Дата) Экспорт
	
	Результат = Новый Структура("Достаточно, Остаток, ТекстОшибки", Истина, 0, "");
	
	Если НЕ КонтрольВключен() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Количество <= 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Остаток = ПолучитьОстаток(ФОП, Номенклатура, Дата);
	Результат.Остаток = Остаток;
	
	Если Остаток < Количество Тогда
		Результат.Достаточно = Ложь;
		Результат.ТекстОшибки = СтрШаблон(
			"Недостаточно фискального остатка. ФОП: %1, товар: %2. Нужно: %3, доступно: %4",
			Строка(ФОП),
			Строка(Номенклатура),
			Формат(Количество, "ЧЦ=15; ЧДЦ=4"),
			Формат(Остаток, "ЧЦ=15; ЧДЦ=4"));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет фискальные остатки для таблицы товаров чека (только акцизные).
//
// Параметры:
//  ТаблицаТоваров - ТаблицаЗначений - Номенклатура, Количество, НалоговаяГруппа
//  Дата - Дата
//  Отказ - Булево
//
// Возвращаемое значение:
//   Булево
//
Функция ПроверитьТоварыДляПродажи(ТаблицаТоваров, Дата, Отказ = Ложь) Экспорт
	
	Если НЕ КонтрольВключен() Тогда
		Возврат Истина;
	КонецЕсли;
	
	МаппингНГ = ПолучитьМаппингНалоговыхГрупп();
	АкцизныеНоменклатуры = ПолучитьАкцизныеНоменклатуры(ТаблицаТоваров);
	
	Потребности = Новый Соответствие;
	КлючиПотребностей = Новый Массив;
	
	Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		Если АкцизныеНоменклатуры.Получить(СтрокаТовара.Номенклатура) <> Истина Тогда
			Продолжить;
		КонецЕсли;
		
		ФОП = МаппингНГ.Получить(СтрокаТовара.НалоговаяГруппа);
		Ключ = КлючПотребности(ФОП, СтрокаТовара.Номенклатура);
		
		ТекущееКоличество = Потребности.Получить(Ключ);
		Если ТекущееКоличество = Неопределено Тогда
			ТекущееКоличество = 0;
			КлючиПотребностей.Добавить(Ключ);
		КонецЕсли;
		
		Потребности.Вставить(Ключ, ТекущееКоличество + СтрокаТовара.Количество);
		
	КонецЦикла;
	
	Для Каждого Ключ Из КлючиПотребностей Цикл
		
		ДанныеКлюча = РазобратьКлючПотребности(Ключ);
		Проверка = ПроверитьДостаточность(
			ДанныеКлюча.ФОП,
			ДанныеКлюча.Номенклатура,
			Потребности.Получить(Ключ),
			Дата);
		
		Если НЕ Проверка.Достаточно Тогда
			Отказ = Истина;
			ОбщегоНазначенияБПО.СообщитьПользователю(Проверка.ТекстОшибки);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НЕ Отказ;
	
КонецФункции

// Списывает фискальные остатки после успешной фискализации.
//
Процедура СписатьПоУспешнойФискализации(ФОП, МассивТоваров, СсылкаРегистратор, Дата) Экспорт
	
	Если НЕ КонтрольВключен() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЕстьДвиженияПоРегистратору(СсылкаРегистратор) Тогда
		Возврат;
	КонецЕсли;
	
	АкцизныеНоменклатуры = ПолучитьАкцизныеНоменклатурыИзМассива(МассивТоваров);
	Потребности = Новый Соответствие;
	КлючиПотребностей = Новый Массив;
	
	Для Каждого СтрокаТовара Из МассивТоваров Цикл
		
		Если АкцизныеНоменклатуры.Получить(СтрокаТовара.Номенклатура) <> Истина Тогда
			Продолжить;
		КонецЕсли;
		
		Ключ = КлючПотребности(ФОП, СтрокаТовара.Номенклатура);
		ТекущееКоличество = Потребности.Получить(Ключ);
		Если ТекущееКоличество = Неопределено Тогда
			ТекущееКоличество = 0;
			КлючиПотребностей.Добавить(Ключ);
		КонецЕсли;
		
		Потребности.Вставить(Ключ, ТекущееКоличество + СтрокаТовара.Количество);
		
	КонецЦикла;
	
	Если КлючиПотребностей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗаблокироватьОстатки(ФОП, КлючиПотребностей);
	
	НаборЗаписей = РегистрыНакопления.ФискальныеОстатки.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(СсылкаРегистратор);
	
	Для Каждого Ключ Из КлючиПотребностей Цикл
		
		ДанныеКлюча = РазобратьКлючПотребности(Ключ);
		Движение = НаборЗаписей.Добавить();
		Движение.Регистратор = СсылкаРегистратор;
		Движение.Период = Дата;
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.ФОП = ДанныеКлюча.ФОП;
		Движение.Номенклатура = ДанныеКлюча.Номенклатура;
		Движение.Количество = Потребности.Получить(Ключ);
		
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

// Возвращает ФОП по налоговой группе из регистра РаспределениеНалоговыхГрупп.
//
Функция ПолучитьФОППоНалоговойГруппе(НалоговаяГруппа) Экспорт
	
	Маппинг = ПолучитьМаппингНалоговыхГрупп();
	Возврат Маппинг.Получить(НалоговаяГруппа);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьМаппингНалоговыхГрупп()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Р.НалоговаяГруппа КАК НалоговаяГруппа,
	|	Р.ФОП КАК ФОП
	|ИЗ
	|	РегистрСведений.РаспределениеНалоговыхГрупп КАК Р";
	
	Маппинг = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Маппинг.Вставить(Выборка.НалоговаяГруппа, Выборка.ФОП);
	КонецЦикла;
	
	Возврат Маппинг;
	
КонецФункции

Функция ПолучитьАкцизныеНоменклатуры(ТаблицаТоваров)
	
	МассивНоменклатуры = Новый Массив;
	Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
		Если ЗначениеЗаполнено(СтрокаТовара.Номенклатура)
			И МассивНоменклатуры.Найти(СтрокаТовара.Номенклатура) = Неопределено Тогда
			МассивНоменклатуры.Добавить(СтрокаТовара.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПолучитьПризнакиАкциза(МассивНоменклатуры);
	
КонецФункции

Функция ПолучитьАкцизныеНоменклатурыИзМассива(МассивТоваров)
	
	МассивНоменклатуры = Новый Массив;
	Для Каждого СтрокаТовара Из МассивТоваров Цикл
		Если ЗначениеЗаполнено(СтрокаТовара.Номенклатура)
			И МассивНоменклатуры.Найти(СтрокаТовара.Номенклатура) = Неопределено Тогда
			МассивНоменклатуры.Добавить(СтрокаТовара.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПолучитьПризнакиАкциза(МассивНоменклатуры);
	
КонецФункции

Функция ПолучитьПризнакиАкциза(МассивНоменклатуры)
	
	Результат = Новый Соответствие;
	
	Если МассивНоменклатуры.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	Номенклатура.ТребуетАкцизнуюМарку КАК ТребуетАкцизнуюМарку
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В (&МассивНоменклатуры)";
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Номенклатура, Выборка.ТребуетАкцизнуюМарку);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция КлючПотребности(ФОП, Номенклатура)
	
	Возврат Строка(ФОП.УникальныйИдентификатор()) + "|" + Строка(Номенклатура.УникальныйИдентификатор());
	
КонецФункции

Функция РазобратьКлючПотребности(Ключ)
	
	Части = СтрРазделить(Ключ, "|");
	Данные = Новый Структура;
	Данные.Вставить("ФОП", Справочники.ФОП.ПолучитьСсылку(Новый УникальныйИдентификатор(Части[0])));
	Данные.Вставить("Номенклатура", Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Части[1])));
	Возврат Данные;
	
КонецФункции

Процедура ЗаблокироватьОстатки(ФОП, КлючиПотребностей)
	
	Блокировка = Новый БлокировкаДанных;
	
	Для Каждого Ключ Из КлючиПотребностей Цикл
		ДанныеКлюча = РазобратьКлючПотребности(Ключ);
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ФискальныеОстатки");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("ФОП", ДанныеКлюча.ФОП);
		ЭлементБлокировки.УстановитьЗначение("Номенклатура", ДанныеКлюча.Номенклатура);
	КонецЦикла;
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

Функция ЕстьДвиженияПоРегистратору(СсылкаРегистратор)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Поле1
	|ИЗ
	|	РегистрНакопления.ФискальныеОстатки
	|ГДЕ
	|	Регистратор = &Регистратор";
	Запрос.УстановитьПараметр("Регистратор", СсылкаРегистратор);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

#КонецОбласти
