		СписокВидов.ПоказатьВыборЭлемента(Оп, "Выберите вид возврата:");
		
	Иначе
		
		// Стандартный режим: Выбор кассы для возврата денежных средств
		СписокКасс = ПолучитьДоступныеКассыДляРасчета();
		
