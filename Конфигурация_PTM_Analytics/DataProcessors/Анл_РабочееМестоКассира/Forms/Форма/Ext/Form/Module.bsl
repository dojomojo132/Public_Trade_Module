&НаКлиенте
Асинх Процедура ЗакрытьСменуКоманда(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.КассоваяСмена) Тогда
		ПоказатьПредупреждение(, "Нет активной смены!");
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = "Закрыть текущую смену? Это действие нельзя отменить." + Символы.ПС + 
		"После закрытия необходимо будет открыть новую смену для продолжения работы.";
	Результат = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЗакрытьСменуНаСервере();
		ПоказатьОповещениеПользователя("Смена закрыта", , "Кассовая смена успешно закрыта. Откройте новую смену для продолжения работы.");
		
		// Предлагаем открыть новую смену
		РезультатНовойСмены = Ждать ВопросАсинх("Открыть новую смену для продолжения работы?", РежимДиалогаВопрос.ДаНет);
		
		Если РезультатНовойСмены = КодВозвратаДиалога.Да Тогда
			ПроверитьИОткрытьСменуНаСервере();
		Иначе
			// Закрываем РМК
			Закрыть();
		КонецЕсли;
		
	Исключение
		ПоказатьПредупреждение(, "Ошибка при закрытии смены: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПереключитьВРежимВозврата(Команда)
	
	// Если уже в режиме возврата, игнорируем
	Если РежимРаботы = "Возврат" Тогда
		Возврат;
	КонецЕсли;
	
	// Проверяем, есть ли товары в чеке
	Если Объект.ТЧ.Количество() > 0 Тогда
		Результат = Ждать ВопросАсинх("В чеке есть товары. Очистить чек перед переключением в режим возврата?", РежимДиалогаВопрос.ДаНетОтмена);
		
		Если Результат = КодВозвратаДиалога.Да Тогда
			Объект.ТЧ.Очистить();
			Ждать ВыбратьРежимВозврата();
		ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
			ПоказатьПредупреждение(, "Для переключения в режим возврата необходимо очистить чек!");
		КонецЕсли;
		// При "Отмена" - ничего не делаем
		Возврат;
	КонецЕсли;
	
	// Показываем выбор режима возврата
	Ждать ВыбратьРежимВозврата();
	
КонецПроцедуры

&НаКлиенте
Асинх Функция ВыбратьРежимВозврата()
	
	// Показываем список выбора режима возврата
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Добавить("СвободныйВозврат", "Свободный возврат (ручной ввод товаров)");
	СписокВыбора.Добавить("ПоЧеку", "Возврат по чеку (выбор из списка чеков)");
	
	Оповещение = Новый ОписаниеОповещения("ОбработкаВыбораРежимаВозврата", ЭтотОбъект);
	СписокВыбора.ПоказатьВыборЭлемента(Оповещение, "Выберите режим возврата:");
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Асинх Процедура ОбработкаВыбораРежимаВозврата(ВыбранныйЭлемент, ДопПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыбранныйЭлемент.Значение = "ПоЧеку" Тогда
		// Открываем форму выбора чека с оповещением
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("РежимВыбора", Истина);
		ПараметрыФормы.Вставить("Склад", Склад);
		
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораЧека", ЭтотОбъект);
		ОткрытьФорму("Документ.ЧекККМ.Форма.ФормаВыбораЧека", ПараметрыФормы, ЭтотОбъект, , , , Оповещение);
	ИначеЕсли ВыбранныйЭлемент.Значение = "СвободныйВозврат" Тогда
		// Свободный возврат - просто переключаем режим
		ЧекДляВозврата = Неопределено;
		РежимРаботы = "Возврат";
		ОбновитьОтображениеРежима();
		ПоказатьПредупреждение(, "Режим возврата активирован. Добавляйте товары для возврата.");
	КонецЕсли;
	
	АктивироватьПоиск();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораЧека(ВыбранныйЧек, ДопПараметры) Экспорт
	
	Если ТипЗнч(ВыбранныйЧек) = Тип("ДокументСсылка.ЧекККМ") Тогда
		// Заполняем ТЧ на основании выбранного чека
		ЧекДляВозврата = ВыбранныйЧек;
		ЗаполнитьТЧИзЧекаНаСервере(ВыбранныйЧек);
		РежимРаботы = "Возврат";
		ОбновитьОтображениеРежима();
	КонецЕсли;
	
	АктивироватьПоиск();
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПереключитьВРежимПродажи(Команда)
	
	// Если уже в режиме продажи, игнорируем
	Если РежимРаботы = "Продажа" Тогда
		Возврат;
	КонецЕсли;
	
	// Проверяем, есть ли товары в чеке
	Если Объект.ТЧ.Количество() > 0 Тогда
		Результат = Ждать ВопросАсинх("В чеке есть товары для возврата. Очистить и переключиться в режим продажи?", РежимДиалогаВопрос.ДаНет);
		Если Результат = КодВозвратаДиалога.Да Тогда
			Объект.ТЧ.Очистить();
			ЧекДляВозврата = Неопределено;
			РежимРаботы = "Продажа";
			ОбновитьОтображениеРежима();
		КонецЕсли;
		АктивироватьПоиск();
		Возврат;
	КонецЕсли;
	
	// Переключаемся сразу
	ЧекДляВозврата = Неопределено;
	РежимРаботы = "Продажа";
	ОбновитьОтображениеРежима();
	АктивироватьПоиск();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеРежима()
	
	// Проверяем фискальный режим
	ФискальныйРежимВкл = ПолучитьФискальныйРежимНаСервере();
	
	// Меняем заголовок формы в зависимости от режима
	Если РежимРаботы = "Возврат" Тогда
		Заголовок = "РМК - РЕЖИМ ВОЗВРАТА";
		НадписьРежимРаботы = "РЕЖИМ: ВОЗВРАТ";
		
		// Меняем заголовок кнопки "Рассчитать" на "Оформить возврат"
		Если Элементы.Найти("Рассчитать") <> Неопределено Тогда
			Элементы.Рассчитать.Заголовок = "ОФОРМИТЬ ВОЗВРАТ";
			Элементы.Рассчитать.ЦветФона = WebЦвета.Томатный;
		КонецЕсли;
		
		// Скрываем кнопку "Возврат", показываем "Продажа"
		Если Элементы.Найти("Возврат") <> Неопределено Тогда
			Элементы.Возврат.Видимость = Ложь;
		КонецЕсли;
		
		Если Элементы.Найти("Продажа") <> Неопределено Тогда
			Элементы.Продажа.Видимость = Истина;
		КонецЕсли;
		
		// Меняем цвет для визуального отличия
		Если Элементы.Найти("ИтогСумма") <> Неопределено Тогда
			Элементы.ИтогСумма.ЦветТекста = WebЦвета.Красный;
		КонецЕсли;
		
		// Устанавливаем цвет надписи режима
		Если Элементы.Найти("НадписьРежимРаботы") <> Неопределено Тогда
			Элементы.НадписьРежимРаботы.ЦветТекста = WebЦвета.Красный;
		КонецЕсли;
		
		// Отключаем поле акцизной марки в режиме возврата или без фискализации
		Если Элементы.Найти("ТЧАкцизнаяМарка") <> Неопределено Тогда
			Элементы.ТЧАкцизнаяМарка.ТолькоПросмотр = Истина;
			Элементы.ТЧАкцизнаяМарка.Видимость = Ложь; // Скрываем поле
			Элементы.ТЧАкцизнаяМарка.ЦветФона = WebЦвета.СветлоСерый;
		КонецЕсли;
		
		// Скрываем блок сдачи в режиме возврата
		Если Элементы.Найти("ГруппаСдачи") <> Неопределено Тогда
			Элементы.ГруппаСдачи.Видимость = Ложь;
		КонецЕсли;
		
		Если Элементы.Найти("КнопкаСдача") <> Неопределено Тогда
			Элементы.КнопкаСдача.Видимость = Ложь;
		КонецЕсли;
		
		ОчиститьПоляСдачи();
		
	Иначе
		Заголовок = "Рабочее место кассира";
		НадписьРежимРаботы = "РЕЖИМ: ПРОДАЖА";
		
		// Возвращаем стандартный заголовок кнопки
		Если Элементы.Найти("Рассчитать") <> Неопределено Тогда
			Элементы.Рассчитать.Заголовок = "РАССЧИТАТЬ";
			Элементы.Рассчитать.ЦветФона = Новый Цвет; // Сброс цвета
		КонецЕсли;
		
		// Показываем кнопку "Возврат", скрываем "Продажа"
		Если Элементы.Найти("Возврат") <> Неопределено Тогда
			Элементы.Возврат.Видимость = Истина;
		КонецЕсли;
		
		Если Элементы.Найти("Продажа") <> Неопределено Тогда
			Элементы.Продажа.Видимость = Ложь;
		КонецЕсли;
		
		// Возвращаем стандартный цвет
		Если Элементы.Найти("ИтогСумма") <> Неопределено Тогда
			Элементы.ИтогСумма.ЦветТекста = Новый Цвет;
		КонецЕсли;
		
		// Устанавливаем зеленый цвет для режима продажи
		Если Элементы.Найти("НадписьРежимРаботы") <> Неопределено Тогда
			Элементы.НадписьРежимРаботы.ЦветТекста = WebЦвета.Зеленый;
		КонецЕсли;
		
		// Включаем поле акцизной марки в режиме продажи с фискализацией
		Если Элементы.Найти("ТЧАкцизнаяМарка") <> Неопределено Тогда
			Если ФискальныйРежимВкл Тогда
				Элементы.ТЧАкцизнаяМарка.ТолькоПросмотр = Ложь;
				Элементы.ТЧАкцизнаяМарка.Видимость = Истина; // Показываем поле
				Элементы.ТЧАкцизнаяМарка.ЦветФона = Новый Цвет; // Сброс цвета
			Иначе
				// Скрываем поле в нефискальном режиме
				Элементы.ТЧАкцизнаяМарка.ТолькоПросмотр = Истина;
				Элементы.ТЧАкцизнаяМарка.Видимость = Ложь; // Скрываем поле
			КонецЕсли;
		КонецЕсли;
		
		// Показываем блок сдачи в режиме продажи
		Если Элементы.Найти("ГруппаСдачи") <> Неопределено Тогда
			Элементы.ГруппаСдачи.Видимость = Истина;
		КонецЕсли;
		
		Если Элементы.Найти("КнопкаСдача") <> Неопределено Тогда
			Элементы.КнопкаСдача.Видимость = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЧИзЧекаНаСервере(Знач ЧекСсылка)
	
	// Очищаем текущую ТЧ
	Объект.ТЧ.Очистить();
	
	// Загружаем товары из чека
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЧекККМТовары.Номенклатура КАК Номенклатура,
		|	ЧекККМТовары.Количество КАК Количество,
		|	ЧекККМТовары.Цена КАК Цена,
		|	ЧекККМТовары.Сумма КАК Сумма,
		|	ЧекККМТовары.АкцизнаяМарка КАК АкцизнаяМарка
		|ИЗ
		|	Документ.ЧекККМ.Товары КАК ЧекККМТовары
		|ГДЕ
		|	ЧекККМТовары.Ссылка = &Чек";
	
	Запрос.УстановитьПараметр("Чек", ЧекСсылка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.ТЧ.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;
		НоваяСтрока.Количество = Выборка.Количество;
		НоваяСтрока.Цена = Выборка.Цена;
		НоваяСтрока.Сумма = Выборка.Сумма;
		НоваяСтрока.АкцизнаяМарка = Выборка.АкцизнаяМарка;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область МобильнаяКасса

// Обработчик нажатия кнопки "Мобильная касса".
// Переключает режим: подключение ↔ отключение мобильной сессии.
//
&НаКлиенте
Процедура МобильнаяКассаНажатие(Команда)
	
	Если ПустаяСтрока(ИдМобильнойСессии) Тогда
		ПодключитьМобильнуюКассу();
	Иначе
		ОтключитьМобильнуюКассу();
	КонецЕсли;
	
КонецПроцедуры

// Использует ИмяКомпьютера как стабильный ID сессии, 
// выгружает текущий чек в регистр, показывает URL, запускает таймер опроса.
//
&НаКлиенте
Процедура ПодключитьМобильнуюКассу()
	
	ИдМобильнойСессии = НРег(ИмяКомпьютера());
	
	ВыгрузитьТЧВМобильнуюКорзинуНаСервере();
	
	URL = "http://" + ИмяКомпьютера() + "/ptm/hs/mobile/?session=" + ИдМобильнойСессии;
	
	ТекстСообщения = "Мобильная касса подключена!" + Символы.ПС + Символы.ПС
		+ "Откройте на телефоне:" + Символы.ПС + URL;
	
	ПоказатьПредупреждение(Неопределено, ТекстСообщения, 0, "📱 Мобильная касса");
	
	Сообщить("📱 Ссылка на мобильную кассу (скопируйте): " + URL);
	
	ПодключитьОбработчикОжидания("ОбработчикОжиданияМобильнойКорзины", 5, Ложь);
	
	Элементы.МобильнаяКасса.ЦветФона = Новый Цвет(76, 175, 80);
	
КонецПроцедуры

// Останавливает таймер и сбрасывает мобильную сессию.
//
&НаКлиенте
Процедура ОтключитьМобильнуюКассу()
	
	ОтключитьОбработчикОжидания("ОбработчикОжиданияМобильнойКорзины");
	
	// Очистить оставшиеся записи корзины
	ОчиститьМобильнуюКорзинуНаСервере(ИдМобильнойСессии);
	
	ИдМобильнойСессии = "";
	
	Элементы.МобильнаяКасса.ЦветФона = Новый Цвет(30, 144, 255);
	
	ПоказатьОповещениеПользователя("Мобильная касса", , "Мобильная касса отключена", БиблиотекаКартинок.Информация);
	
КонецПроцедуры

// Выгружает текущие товары чека в регистр для отображения на мобильной кассе.
// НомерПозиции 1..N — товары из РМК (read-only на телефоне).
//
&НаСервере
Процедура ВыгрузитьТЧВМобильнуюКорзинуНаСервере()
	
	// Очистить старые данные сессии
	ОчиститьМобильнуюКорзинуНаСервере(ИдМобильнойСессии);
	
	// Маркерная запись НомерПозиции = 0 — признак активной РМК
	НаборМаркер = РегистрыСведений.Анл_МобильнаяКорзина.СоздатьНаборЗаписей();
	НаборМаркер.Отбор.ИдСессии.Установить(ИдМобильнойСессии);
	НаборМаркер.Отбор.НомерПозиции.Установить(0);
	МаркерЗапись = НаборМаркер.Добавить();
	МаркерЗапись.ИдСессии = ИдМобильнойСессии;
	МаркерЗапись.НомерПозиции = 0;
	МаркерЗапись.Наименование = "__SESSION_ACTIVE__";
	МаркерЗапись.ДатаДобавления = ТекущаяДатаСеанса();
	МаркерЗапись.Отправлено = Ложь;
	НаборМаркер.Записать();
	
	НомерСтр = 1;
	Для Каждого СтрокаТЧ Из Объект.ТЧ Цикл
		НаборЗаписей = РегистрыСведений.Анл_МобильнаяКорзина.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИдСессии.Установить(ИдМобильнойСессии);
		НаборЗаписей.Отбор.НомерПозиции.Установить(НомерСтр);
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ИдСессии = ИдМобильнойСессии;
		НоваяЗапись.НомерПозиции = НомерСтр;
		НоваяЗапись.Штрихкод = СтрокаТЧ.Штрихкод;
		НоваяЗапись.Наименование = СокрЛП(Строка(СтрокаТЧ.Номенклатура));
		НоваяЗапись.Количество = СтрокаТЧ.Количество;
		НоваяЗапись.Цена = СтрокаТЧ.Цена;
		НоваяЗапись.Сумма = СтрокаТЧ.Сумма;
		НоваяЗапись.ДатаДобавления = ТекущаяДатаСеанса();
		НоваяЗапись.Отправлено = Ложь;
		НаборЗаписей.Записать();
		НомерСтр = НомерСтр + 1;
	КонецЦикла;
	
КонецПроцедуры

// Таймер — вызывается каждые 5 секунд.
// Проверяет наличие отправленных товаров в регистре и добавляет их в ТЧ.
//
&НаКлиенте
Процедура ОбработчикОжиданияМобильнойКорзины()
	
	Если ПустаяСтрока(ИдМобильнойСессии) Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоДобавленных = ПринятьТоварыИзМобильнойКорзиныНаСервере();
	
	Если КоличествоДобавленных > 0 Тогда
		ПоказатьОповещениеПользователя(
			"Мобильная касса",
			,
			"Принято товаров: " + КоличествоДобавленных,
			БиблиотекаКартинок.Информация);
	КонецЕсли;
	
КонецПроцедуры

// Серверная функция: читает отправленные товары из регистра,
// находит номенклатуру по штрихкоду, добавляет в ТЧ, удаляет из регистра.
//
// Возвращаемое значение:
//  Число - количество добавленных товаров.
//
&НаСервере
Функция ПринятьТоварыИзМобильнойКорзиныНаСервере()
	
	Если ПустаяСтрока(ИдМобильнойСессии) Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Корзина.ИдСессии КАК ИдСессии,
		|	Корзина.НомерПозиции КАК НомерПозиции,
		|	Корзина.Штрихкод КАК Штрихкод
		|ИЗ
		|	РегистрСведений.Анл_МобильнаяКорзина КАК Корзина
		|ГДЕ
		|	Корзина.ИдСессии = &ИдСессии
		|	И Корзина.НомерПозиции >= 10000
		|	И Корзина.Отправлено = ИСТИНА";
	
	Запрос.УстановитьПараметр("ИдСессии", ИдМобильнойСессии);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Счётчик = 0;
	
	Для Каждого СтрокаКорзины Из Результат Цикл
		
		// Найти номенклатуру по штрихкоду
		ЗапросШК = Новый Запрос;
		ЗапросШК.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Штрихкоды.Номенклатура КАК Номенклатура
			|ИЗ
			|	РегистрСведений.Штрихкоды КАК Штрихкоды
			|ГДЕ
			|	Штрихкоды.Штрихкод = &Штрихкод";
		
		ЗапросШК.УстановитьПараметр("Штрихкод", СтрокаКорзины.Штрихкод);
		ВыборкаШК = ЗапросШК.Выполнить().Выбрать();
		
		Если ВыборкаШК.Следующий() Тогда
			ДобавитьТоварВЧек(ВыборкаШК.Номенклатура, "", СтрокаКорзины.Штрихкод);
			Счётчик = Счётчик + 1;
		КонецЕсли;
		
		// Удалить обработанную запись из регистра
		НаборЗаписей = РегистрыСведений.Анл_МобильнаяКорзина.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИдСессии.Установить(СтрокаКорзины.ИдСессии);
		НаборЗаписей.Отбор.НомерПозиции.Установить(СтрокаКорзины.НомерПозиции);
		НаборЗаписей.Записать();
		
	КонецЦикла;
	
	Возврат Счётчик;
	
КонецФункции

// Очищает все записи корзины для данной сессии.
//
&НаСервереБезКонтекста
Процедура ОчиститьМобильнуюКорзинуНаСервере(Знач ИдСессии)
	
	Если ПустаяСтрока(ИдСессии) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Корзина.ИдСессии КАК ИдСессии,
		|	Корзина.НомерПозиции КАК НомерПозиции
		|ИЗ
		|	РегистрСведений.Анл_МобильнаяКорзина КАК Корзина
		|ГДЕ
		|	Корзина.ИдСессии = &ИдСессии";
	
	Запрос.УстановитьПараметр("ИдСессии", ИдСессии);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаКорзины Из Результат Цикл
		НаборЗаписей = РегистрыСведений.Анл_МобильнаяКорзина.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИдСессии.Установить(СтрокаКорзины.ИдСессии);
		НаборЗаписей.Отбор.НомерПозиции.Установить(СтрокаКорзины.НомерПозиции);
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти