КонецПроцедуры
&НаКлиенте
Асинх Процедура ПредложитьОткрытьСмену()
	Результат = Ждать ВопросАсинх("Кассовая смена не открыта. Открыть новую смену?", РежимДиалогаВопрос.ДаНет);
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Если СоздатьИПодключитьСменуНаСервере() Тогда
			ПоказатьПредупреждение(, "Смена успешно открыта!");
			АктивироватьПоиск();
		Иначе
			// Ошибка при создании - закрываемся
			Закрыть();
		КонецЕсли;
	Иначе
		// Пользователь отказался - закрываем РМК
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// Только активная форма обрабатывает события сканера
	Если НЕ ФормаАктивна Тогда
		Возврат;
	КонецЕсли;
	
	// БПО: события от подключаемого оборудования (сканер штрихкодов)
	Если ИмяСобытия = "ScanData" И Источник = "ПодключаемоеОборудование" Тогда
		Если ТипЗнч(Параметр) = Тип("Структура") И Параметр.Свойство("Штрихкод") Тогда
			// В режиме ввода марки — направляем данные сканера в строку ТЧ
			Если РежимВводаМарки = Истина Тогда
				ПрименитьМаркуКСтроке(Параметр.Штрихкод);
				Возврат;
			КонецЕсли;
			ОбработкаШтрихкода(Параметр.Штрихкод);
		ИначеЕсли ТипЗнч(Параметр) = Тип("Массив") И Параметр.Количество() > 0 Тогда
			Если РежимВводаМарки = Истина Тогда
				ПрименитьМаркуКСтроке(Параметр[0]);
				Возврат;
			КонецЕсли;
			ОбработкаШтрихкода(Параметр[0]);
		КонецЕсли;
	
	ИначеЕсли ИмяСобытия = "СканерШтрихкод" Тогда
		// Старый формат (обратная совместимость)
		Если РежимВводаМарки = Истина Тогда
			ПрименитьМаркуКСтроке(Параметр);
			Возврат;
		КонецЕсли;
		ОбработкаШтрихкода(Параметр);
		
	ИначеЕсли ИмяСобытия = "ИзмененыНастройкиПоУмолчанию" Тогда
		// Полное обновление панели
		ОбновитьНастройкиПанелиНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ЛогикаКассовойСмены

&НаСервере
Функция ПроверитьИПодключитьСмену()
	
	// Ищем открытую смену
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КассоваяСмена.Ссылка КАК Смена
		|ИЗ
		|	Документ.КассоваяСмена КАК КассоваяСмена
		|ГДЕ
		|	КассоваяСмена.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыКассовойСмены.Открыта)
		|	И НЕ КассоваяСмена.ПометкаУдаления";
		
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Объект.КассоваяСмена = Выборка.Смена;
	// Касса по умолчанию не устанавливается — используется выбранная при оплате
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция СоздатьИПодключитьСменуНаСервере()
	
	// 1. Определяем кассу для новой смены
	// В реальном проекте: брали бы из настроек пользователя.
	// Здесь берем первую попавшуюся или основную.
	КассаДляСмены = Справочники.Кассы.ПустаяСсылка();
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ Справочник.Кассы ГДЕ НЕ ПометкаУдаления");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		КассаДляСмены = Выборка.Ссылка;
	КонецЕсли;
	
	Если КассаДляСмены.Пустая() Тогда
		Сообщить("Ошибка: В системе нет ни одной кассы!");
		Возврат Ложь;
	КонецЕсли;
	
	// 2. Создаем документ
	НачатьТранзакцию();
	Попытка
		НоваяСмена = Документы.КассоваяСмена.СоздатьДокумент();
		НоваяСмена.Дата = ТекущаяДатаСеанса();
		НоваяСмена.ДатаНачала = ТекущаяДатаСеанса();
		НоваяСмена.Касса = КассаДляСмены; // Используем правильное имя реквизита
		НоваяСмена.Статус = Перечисления.СтатусыКассовойСмены.Открыта;
		
		НоваяСмена.Записать(РежимЗаписиДокумента.Проведение);
		
		// 3. Подключаем к контексту формы
		Объект.КассоваяСмена = НоваяСмена.Ссылка;
		// Касса по умолчанию не устанавливается — используется выбранная при оплате
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Сообщить("Не удалось открыть смену: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;

КонецФункции

&НаСервере
Функция ПроверитьИОткрытьСменуНаСервере()
	
	// Проверяем, есть ли открытая смена
	Если ПроверитьИПодключитьСмену() Тогда
		Возврат Истина;
	Иначе
		// Если нет открытой смены, создаем новую
		Возврат СоздатьИПодключитьСменуНаСервере();
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗакрытьСменуНаСервере()
	
	Если НЕ ЗначениеЗаполнено(Объект.КассоваяСмена) Тогда
		ВызватьИсключение "Нет активной смены для закрытия!";
	КонецЕсли;
	
	СменаОбъект = Объект.КассоваяСмена.ПолучитьОбъект();
	
	Если СменаОбъект = Неопределено Тогда
		ВызватьИсключение "Не удалось получить объект смены!";
	КонецЕсли;
	
	Если СменаОбъект.Статус = Перечисления.СтатусыКассовойСмены.Закрыта Тогда
		ВызватьИсключение "Смена уже закрыта!";
	КонецЕсли;
	
	СменаОбъект.ЗакрытьСмену();
	
	// Очищаем контекст РМК
	Объект.КассоваяСмена = Документы.КассоваяСмена.ПустаяСсылка();
	
КонецПроцедуры

#КонецОбласти

#Область СканированиеИПоиск

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// ПодключаемоеОборудование: разрешить использование сканера
	ИспользоватьПодключаемоеОборудование = Истина;
	
	// Условное оформление индикатора акцизной марки
	НастроитьУсловноеОформление();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Правило 1: Акцизный товар, марка НЕ сканирована (МаркаСтатус = 1) - красный фон
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ПолеОформления = ЭлементУО.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("ТЧМаркаСтатус");
	
	ОтборЭлемента = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ТЧ.МаркаСтатус");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 1;
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 180, 180));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "X");
	
	// Правило 2: Акцизный товар, марка сканирована (МаркаСтатус = 2) - зелёный фон
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ПолеОформления = ЭлементУО.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("ТЧМаркаСтатус");
	
	ОтборЭлемента = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ТЧ.МаркаСтатус");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 2;
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(180, 255, 180));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "V");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	
	// ПодключаемоеОборудование: отключение оборудования
	МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПриЗакрытииФормы(Неопределено, ЭтотОбъект);
	ЗавершитьРаботуСистемы(Истина);
КонецПроцедуры

&НаКлиенте
Процедура АктивироватьПоиск()
	// Устанавливаем фокус на поле поиска товара
	Если Элементы.Найти("ПолеПоискаТовара") <> Неопределено Тогда
		ТекущийЭлемент = Элементы.ПолеПоискаТовара;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПолеПоискаТовараПриИзменении(Элемент)
	ОбработкаШтрихкода(Объект.ПолеПоискаТовара);
	Объект.ПолеПоискаТовара = "";
	АктивироватьПоиск();
КонецПроцедуры

// --- ГЛОБАЛЬНЫЙ ПОИСК + АКЦИЗ ---

&НаКлиенте
Процедура ОбработкаШтрихкода(Штрихкод)
	Если ПустаяСтрока(Штрихкод) Тогда Возврат; КонецЕсли;
	
	// В режиме ввода марки — перенаправляем данные сканера
	Если РежимВводаМарки = Истина Тогда
		ПрименитьМаркуКСтроке(Штрихкод);
		Возврат;
	КонецЕсли;
	
	// 1. Вызываем глобальный поиск (через Client wrapper)
	Оповещение = Новый ОписаниеОповещения("ОбработкаПоискаЗавершение", ЭтотОбъект, Штрихкод);
	ОбщегоНазначенияКлиент.НайтиИОбработатьТовар(Штрихкод, Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаПоискаЗавершение(Результат, Штрихкод) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		// Товар добавляется в чек. Для акцизных товаров в фискальном режиме
		// марка не запрашивается сразу — вводится позднее через индикатор (красный).
		ДобавитьТоварВЧек(Результат, "", Штрихкод);
	КонецЕсли;
	
	АктивироватьПоиск();
	
КонецПроцедуры

&НаКлиенте
Процедура ВводМаркиЗавершение(Марка, ДопПараметры) Экспорт
	
	Если Марка = Неопределено ИЛИ ПустаяСтрока(Марка) Тогда
		ПоказатьПредупреждение(, "Отмена: Акцизная марка обязательна!");
		Возврат;
	КонецЕсли;
	
	// Здесь можно добавить Regex проверку формата марки (буквы/цифры)
	ДобавитьТоварВЧек(ДопПараметры.Результат, Марка, ДопПараметры.Штрихкод);
	АктивироватьПоиск();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыТовараНаСервере(Знач Номенклатура)
	Возврат Новый Структура("ТребуетАкцизнуюМарку", Номенклатура.ТребуетАкцизнуюМарку);
КонецФункции

&НаСервере
Функция ПолучитьФискальныйРежимНаСервере()
	Возврат НастройкиПоУмолчанию.ПолучитьФискальныйРежим();
КонецФункции

&НаСервере
Процедура НастроитьВидимостьФОП()
	ФискальныйРежим = НастройкиПоУмолчанию.ПолучитьФискальныйРежим();
	РазделениеВключено = НастройкиПоУмолчанию.ПолучитьРазделениеФискальныхЧеков();
	Элементы.ТЧФОП.Видимость = ФискальныйРежим И РазделениеВключено;
	Элементы.ТЧНалГруппа.Видимость = ФискальныйРежим;
КонецПроцедуры

&НаСервере
Процедура ДобавитьТоварВЧек(Знач Номенклатура, Знач АкцизнаяМарка, Знач Штрихкод = "")
	
	// Определяем, требует ли товар акцизную марку
	ТребуетМарку = Номенклатура.ТребуетАкцизнуюМарку;
	ФискальныйРежим = НастройкиПоУмолчанию.ПолучитьФискальныйРежим();
	
	// Акцизные товары в фискальном режиме НИКОГДА не суммируются - каждый экземпляр = отдельная строка
	Если ТребуетМарку И ФискальныйРежим Тогда
		// Всегда новая строка для акцизного товара
		СтрокаТЧ = Объект.ТЧ.Добавить();
		СтрокаТЧ.Номенклатура = Номенклатура;
		СтрокаТЧ.Количество = 1;
		СтрокаТЧ.Цена = ПолучитьЦенуНоменклатуры(Номенклатура);
		СтрокаТЧ.АкцизнаяМарка = АкцизнаяМарка;
		СтрокаТЧ.Штрихкод = Штрихкод;
		
		// Статус марки: 1 = не сканирована (красный), 2 = сканирована (зелёный)
		Если ЗначениеЗаполнено(АкцизнаяМарка) Тогда
			СтрокаТЧ.МаркаСтатус = 2; // Зелёный - марка введена
		Иначе
			СтрокаТЧ.МаркаСтатус = 1; // Красный - марка не введена
		КонецЕсли;
	Иначе
		// Обычный товар - суммируем количество если уже есть в чеке
		ПараметрыОтбора = Новый Структура("Номенклатура", Номенклатура);
		НайденныеСтроки = Объект.ТЧ.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			СтрокаТЧ = НайденныеСтроки[0];
			СтрокаТЧ.Количество = СтрокаТЧ.Количество + 1;
		Иначе
			СтрокаТЧ = Объект.ТЧ.Добавить();
			СтрокаТЧ.Номенклатура = Номенклатура;
			СтрокаТЧ.Количество = 1;
			СтрокаТЧ.Цена = ПолучитьЦенуНоменклатуры(Номенклатура);
			СтрокаТЧ.Штрихкод = Штрихкод;
			СтрокаТЧ.МаркаСтатус = 0; // Не акцизный товар
		КонецЕсли;
	КонецЕсли;
	
	СтрокаТЧ.Сумма = СтрокаТЧ.Цена * СтрокаТЧ.Количество;
	
	// ФОП для отображения в строке ТЧ (из регистра РаспределениеНалоговыхГрупп)
	Если ЗначениеЗаполнено(Номенклатура.НалоговаяГруппа) Тогда
		ФОПИзРегистра = РегистрыСведений.РаспределениеНалоговыхГрупп.ПолучитьПоследнее(, Новый Структура("НалоговаяГруппа", Номенклатура.НалоговаяГруппа));
		Если ЗначениеЗаполнено(ФОПИзРегистра.ФОП) Тогда
			СтрокаТЧ.ФОП = Строка(ФОПИзРегистра.ФОП);
		КонецЕсли;
	КонецЕсли;
	
	// Налоговая группа для отображения в строке ТЧ
	Если ЗначениеЗаполнено(Номенклатура.НалоговаяГруппа) Тогда
		СтрокаТЧ.НалоговаяГруппа = Строка(Номенклатура.НалоговаяГруппа);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЦенуНоменклатуры(Номенклатура)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ЕСТЬNULL(Ц.Цена, 0) КАК Цена 
		|ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Д, Номенклатура=&Н) КАК Ц";
	Запрос.УстановитьПараметр("Д", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Н", Номенклатура);
	Выб = Запрос.Выполнить().Выбрать();
	Если Выб.Следующий() Тогда Возврат Выб.Цена; КонецЕсли;
	Возврат 0;
КонецФункции

#КонецОбласти

#Область ДействияСТаблицейТоваров

&НаКлиенте
Процедура ТЧПриИзменении(Элемент)
	АктивироватьПоиск();
КонецПроцедуры

&НаКлиенте
Процедура ТЧВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	// Клик по индикатору марки — войти в режим ввода акцизной марки
	Если Поле.Имя = "ТЧМаркаСтатус" Тогда
		СтандартнаяОбработка = Ложь;
		
		ТекДанные = Объект.ТЧ.НайтиПоИдентификатору(ВыбраннаяСтрока);
		Если ТекДанные = Неопределено Тогда Возврат; КонецЕсли;
		
		// Ввод марки только для строк без марки (статус 1 = красный)
		Если ТекДанные.МаркаСтатус <> 1 Тогда Возврат; КонецЕсли;
		
		// Входим в режим ввода марки
		РежимВводаМарки = Истина;
		ИндексСтрокиДляМарки = ВыбраннаяСтрока;
		
		// Показываем встроенное поле ввода марки
		// Сканер: данные поступают через ОбработкаОповещения → ПрименитьМаркуКСтроке → поле скрывается
		// Ручной ввод: пользователь вводит в поле → ПолеВводаМаркиПриИзменении → поле скрывается
		ТекстВводаМарки = "";
		Элементы.ПолеВводаМарки.Видимость = Истина;
		ТекущийЭлемент = Элементы.ПолеВводаМарки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьМаркуКСтроке(Знач Марка)
	
	Если НЕ РежимВводаМарки Тогда Возврат; КонецЕсли;
	Если ПустаяСтрока(Марка) Тогда Возврат; КонецЕсли;
	
	ТекДанные = Объект.ТЧ.НайтиПоИдентификатору(ИндексСтрокиДляМарки);
	Если ТекДанные <> Неопределено Тогда
		ТекДанные.АкцизнаяМарка = Марка;
		ТекДанные.МаркаСтатус = 2; // Зелёный — марка введена
	КонецЕсли;
	
	// Скрываем поле ввода марки
	Элементы.ПолеВводаМарки.Видимость = Ложь;
	ТекстВводаМарки = "";
	
	РежимВводаМарки = Ложь;
	ИндексСтрокиДляМарки = Неопределено;
	АктивироватьПоиск();
	
КонецПроцедуры

&НаКлиенте
Процедура ВводМаркиИндикаторЗавершение(Марка, ДопПараметры) Экспорт
	
	// Если марка уже установлена сканером — игнорируем результат диалога
	Если НЕ РежимВводаМарки Тогда Возврат; КонецЕсли;
	
	Если Марка = Неопределено ИЛИ ПустаяСтрока(Марка) Тогда
		// Отмена ввода — остаёмся без марки (красный индикатор)
		РежимВводаМарки = Ложь;
		ИндексСтрокиДляМарки = Неопределено;
		АктивироватьПоиск();
		Возврат;
	КонецЕсли;
	
	ПрименитьМаркуКСтроке(Марка);
	
КонецПроцедуры

&НаКлиенте
Процедура ТЧКоличествоПриИзменении(Элемент)
	ТекСтрока = Элементы.ТЧ.ТекущиеДанные;
	Если ТекСтрока <> Неопределено Тогда
		ТекСтрока.Сумма = ТекСтрока.Цена * ТекСтрока.Количество;
	КонецЕсли;
	АктивироватьПоиск();
КонецПроцедуры

&НаКлиенте
Процедура ТЧЦенаПриИзменении(Элемент)
	ТекСтрока = Элементы.ТЧ.ТекущиеДанные;
	Если ТекСтрока <> Неопределено Тогда
		ТекСтрока.Сумма = ТекСтрока.Цена * ТекСтрока.Количество;
	КонецЕсли;
	АктивироватьПоиск();
КонецПроцедуры

&НаКлиенте
Процедура ТЧАкцизнаяМаркаПриИзменении(Элемент)
	
	ТекДанные = Элементы.ТЧ.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда Возврат; КонецЕсли;
	
	// Если марка заполнена — устанавливаем зелёный статус
	Если ЗначениеЗаполнено(ТекДанные.АкцизнаяМарка) И ТекДанные.МаркаСтатус = 1 Тогда
		ТекДанные.МаркаСтатус = 2; // Зелёный — марка введена
	ИначеЕсли НЕ ЗначениеЗаполнено(ТекДанные.АкцизнаяМарка) И ТекДанные.МаркаСтатус = 2 Тогда
		ТекДанные.МаркаСтатус = 1; // Красный — марка удалена
	КонецЕсли;
	
	// Выходим из режима ввода марки
	РежимВводаМарки = Ложь;
	ИндексСтрокиДляМарки = Неопределено;
	АктивироватьПоиск();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеВводаМаркиПриИзменении(Элемент)
	
	// Пользователь ввёл марку вручную в поле ввода
	Если НЕ РежимВводаМарки Тогда
		Элементы.ПолеВводаМарки.Видимость = Ложь;
		ТекстВводаМарки = "";
		АктивироватьПоиск();
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ТекстВводаМарки) Тогда
		// Пустая строка — отмена ввода
		Элементы.ПолеВводаМарки.Видимость = Ложь;
		РежимВводаМарки = Ложь;
		ИндексСтрокиДляМарки = Неопределено;
		АктивироватьПоиск();
		Возврат;
	КонецЕсли;
	
	ПрименитьМаркуКСтроке(ТекстВводаМарки);
	
КонецПроцедуры



&НаКлиенте
Асинх Процедура Удалить(Команда)
	Если Объект.ТЧ.Количество() = 0 Тогда Возврат; КонецЕсли;
	Результат = Ждать ВопросАсинх("Очистить чек полностью?", РежимДиалогаВопрос.ДаНет);
	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект.ТЧ.Очистить();
		ОчиститьПоляСдачи();
	КонецЕсли;
	АктивироватьПоиск();
КонецПроцедуры

#КонецОбласти

#Область ОформлениеПродажи

&НаКлиенте
Процедура РассчитатьСдачу(Команда)
	
	// Рассчитываем итоговую сумму чека
	ИтогоСумма = 0;
	Для Каждого СтрТЧ Из Объект.ТЧ Цикл
		ИтогоСумма = ИтогоСумма + СтрТЧ.Сумма;
	КонецЦикла;
	
	// Если внесено = 0, устанавливаем фокус на поле ввода
	Если СуммаОтКлиента = 0 Тогда
		СуммаОтКлиента = ИтогоСумма;
	КонецЕсли;
	
	// Рассчитываем сдачу
	СуммаСдачи = СуммаОтКлиента - ИтогоСумма;
	
	// Обновляем цвет надписи сдачи
	ОбновитьЦветСдачи();
	
	// Устанавливаем фокус на поле Внесено
	Если Элементы.Найти("СуммаОтКлиентаПоле") <> Неопределено Тогда
		ТекущийЭлемент = Элементы.СуммаОтКлиентаПоле;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаОтКлиентаПолеПриИзменении(Элемент)
	
	// Рассчитываем итоговую сумму чека
	ИтогоСумма = 0;
	Для Каждого СтрТЧ Из Объект.ТЧ Цикл
		ИтогоСумма = ИтогоСумма + СтрТЧ.Сумма;
	КонецЦикла;
	
	// Вычисляем сдачу
	СуммаСдачи = СуммаОтКлиента - ИтогоСумма;
	
	// Обновляем цвет надписи сдачи
	ОбновитьЦветСдачи();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЦветСдачи()
	
	Если Элементы.Найти("СуммаСдачиПоле") <> Неопределено Тогда
		Если СуммаСдачи >= 0 Тогда
			Элементы.СуммаСдачиПоле.ЦветТекста = WebЦвета.Зеленый;
		Иначе
			Элементы.СуммаСдачиПоле.ЦветТекста = WebЦвета.Красный;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПоляСдачи()
	
	СуммаОтКлиента = 0;
	СуммаСдачи = 0;
	
	Если Элементы.Найти("СуммаСдачиПоле") <> Неопределено Тогда
		Элементы.СуммаСдачиПоле.ЦветТекста = WebЦвета.Зеленый;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Рассчитать(Команда)
	
	Если Объект.ТЧ.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Чек пуст!");
		Возврат;
	КонецЕсли;
	
	// В фискальном режиме: проверяем что все акцизные марки заполнены
	Если РежимРаботы <> "Возврат" Тогда
		ФискальныйРежимВкл = ПолучитьФискальныйРежимНаСервере();
		Если ФискальныйРежимВкл Тогда
			Для Каждого СтрТЧ Из Объект.ТЧ Цикл
				Если СтрТЧ.МаркаСтатус = 1 Тогда
					ПоказатьПредупреждение(, "Не все акцизные марки заполнены! Нажмите на красный индикатор (X) для ввода марки.");
					Возврат;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	// В зависимости от режима - продажа или возврат
	Если РежимРаботы = "Возврат" Тогда
		ОформитьВозврат();
	Иначе
		ОформитьПродажу();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОформитьПродажу()
	
	// Проверяем настройку разделения фискальных чеков
	НастройкиРазделения = ПолучитьНастройкиРазделенияНаСервере();
	
	Если НастройкиРазделения.РазделениеВключено Тогда
		
		// Режим разделения: показываем вид оплаты (Наличные / Карта)
		СписокВидов = Новый СписокЗначений;
		СписокВидов.Добавить("Наличные", "Наличные");
		СписокВидов.Добавить("Карта", "Карта");
		
		Оп = Новый ОписаниеОповещения("ВыборВидаОплатыЗавершение", ЭтотОбъект, НастройкиРазделения);
		СписокВидов.ПоказатьВыборЭлемента(Оп, "Выберите вид оплаты:");
		
	Иначе
		
		// Стандартный режим: выбор кассы напрямую
		СписокКасс = ПолучитьДоступныеКассыДляРасчета();
		
		Если СписокКасс.Количество() = 0 Тогда
			ПоказатьПредупреждение(, "Нет доступных касс для расчета! Проверьте настройки справочника Кассы.");
			Возврат;
		КонецЕсли;
		
		Оп = Новый ОписаниеОповещения("ВыборОплатыЗавершение", ЭтотОбъект);
		СписокКасс.ПоказатьВыборЭлемента(Оп, "Выберите кассу для оплаты:");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыборВидаОплатыЗавершение(ВыбранныйЭлемент, НастройкиРазделения) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВидОплаты = ВыбранныйЭлемент.Значение;
	
	// Для безналичной оплаты — подтверждение суммы
	Если ВидОплаты = "Карта" Тогда
		
		СуммаЧека = 0;
		Для Каждого СтрТЧ Из Объект.ТЧ Цикл
			СуммаЧека = СуммаЧека + СтрТЧ.Сумма;
		КонецЦикла;
		
		ТекстВопроса = "Оплата картой." 
			+ Символы.ПС + "Сумма к оплате: " + Формат(СуммаЧека, "ЧЦ=15; ЧДЦ=2")
			+ Символы.ПС + "Товары будут разделены по ФОП."
			+ Символы.ПС + Символы.ПС + "Подтвердить оплату?";
		
		Результат = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Подтверждение оплаты");
		
		Если Результат = КодВозвратаДиалога.Да Тогда
			ВыполнитьОформлениеСРазделением(ВидОплаты, НастройкиРазделения.КассаНаличных);
		Иначе
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Оплата картой отменена.";
			Сообщение.Сообщить();
			АктивироватьПоиск();
		КонецЕсли;
		
	Иначе
		
		// Наличные — сразу оформляем с разделением по ФОП
		ВыполнитьОформлениеСРазделением("Наличные", НастройкиРазделения.КассаНаличных);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОформлениеСРазделением(ВидОплаты, КассаНаличных)
	
	// Вызов сервера для оформления чеков с разделением по ФОП
	РезультатОформления = ОформитьЧекиСРазделениемПоФОПНаСервере(ВидОплаты, КассаНаличных);
	
	Если РезультатОформления.Успех Тогда
		ПоказатьПредупреждение(, "Оформлено чеков: " + Строка(РезультатОформления.КоличествоЧеков) + ". Успешно!");
		Объект.ТЧ.Очистить();
		ОчиститьПоляСдачи();
	КонецЕсли;
	
	АктивироватьПоиск();
	
КонецПроцедуры

&НаСервере
Функция ОформитьЧекиСРазделениемПоФОПНаСервере(Знач ВидОплаты, Знач КассаНаличных)
	
	Результат = Новый Структура("Успех, КоличествоЧеков", Ложь, 0);
	
	// Проверяем фискальный режим
	ФискальныйРежимВкл = НастройкиПоУмолчанию.ПолучитьФискальныйРежим();
	
	// Группируем товары по ФОП
	ГруппыПоФОП = Новый Соответствие; // Ключ = ФОП (ссылка), Значение = Массив строк ТЧ
	
	Для Каждого СтрТЧ Из Объект.ТЧ Цикл
		
		// Получаем ФОП через НалоговуюГруппу из регистра РаспределениеНалоговыхГрупп
		НалГруппа = СтрТЧ.Номенклатура.НалоговаяГруппа;
		ФОПНоменклатуры = Справочники.ФОП.ПустаяСсылка();
		Если ЗначениеЗаполнено(НалГруппа) Тогда
			ДанныеРегистра = РегистрыСведений.РаспределениеНалоговыхГрупп.ПолучитьПоследнее(, Новый Структура("НалоговаяГруппа", НалГруппа));
			ФОПНоменклатуры = ДанныеРегистра.ФОП;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ФОПНоменклатуры) Тогда
			Сообщить("Не настроен ФОП для налоговой группы """ + Строка(НалГруппа) + """ номенклатуры """ + Строка(СтрТЧ.Номенклатура) + """! Настройте ФОП в регистре Распределение налоговых групп.");
			Возврат Результат;
		КонецЕсли;
		
		МассивСтрок = ГруппыПоФОП.Получить(ФОПНоменклатуры);
		Если МассивСтрок = Неопределено Тогда
			МассивСтрок = Новый Массив;
			ГруппыПоФОП.Вставить(ФОПНоменклатуры, МассивСтрок);
		КонецЕсли;
		
		МассивСтрок.Добавить(СтрТЧ);
		
	КонецЦикла;
	
	// Создаём отдельный ЧекККМ для каждого ФОП
	КоличествоЧеков = 0;
	
	// Предварительная проверка касс до начала транзакции
	Для Каждого КлючИЗначение Из ГруппыПоФОП Цикл
		
		ТекФОП = КлючИЗначение.Ключ;
		
		Если ВидОплаты = "Наличные" Тогда
			КассаОплаты = КассаНаличных;
		Иначе
			КассаОплаты = ТекФОП.КассаБезналичных;
			
			Если Не ЗначениеЗаполнено(КассаОплаты) Тогда
				Сообщить("Не указана касса безналичных для ФОП """ + Строка(ТекФОП) + """! Заполните в справочнике ФОП.");
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(КассаОплаты) Тогда
			Сообщить("Не определена касса для вида оплаты """ + ВидОплаты + """! Проверьте настройки.");
			Возврат Результат;
		КонецЕсли;
		
	КонецЦикла;
	
	НачатьТранзакцию();
	Попытка
		
		Для Каждого КлючИЗначение Из ГруппыПоФОП Цикл
			
			ТекФОП = КлючИЗначение.Ключ;
			МассивТоваров = КлючИЗначение.Значение;
			
			// Определяем кассу
			Если ВидОплаты = "Наличные" Тогда
				КассаОплаты = КассаНаличных;
			Иначе
				КассаОплаты = ТекФОП.КассаБезналичных;
			КонецЕсли;
			
			НовыйЧек = Документы.ЧекККМ.СоздатьДокумент();
			НовыйЧек.Дата = ТекущаяДатаСеанса();
			
			НовыйЧек.Склад = Склад;
			НовыйЧек.Касса = КассаОплаты;
			НовыйЧек.КассоваяСмена = Объект.КассоваяСмена;
			
			Если ФискальныйРежимВкл Тогда
				НовыйЧек.Статус = Перечисления.СтатусыЧекаККМ.Пробит;
			Иначе
				НовыйЧек.Статус = Перечисления.СтатусыЧекаККМ.Нефискальный;
			КонецЕсли;
			
			СуммаДок = 0;
			Для Каждого СтрТовар Из МассивТоваров Цикл
				НоваяСтр = НовыйЧек.Товары.Добавить();
				НоваяСтр.Номенклатура = СтрТовар.Номенклатура;
				НоваяСтр.Количество = СтрТовар.Количество;
				НоваяСтр.Цена = СтрТовар.Цена;
				НоваяСтр.Сумма = СтрТовар.Сумма;
				НоваяСтр.НалоговаяГруппа = СтрТовар.Номенклатура.НалоговаяГруппа;
				НоваяСтр.АкцизнаяМарка = СтрТовар.АкцизнаяМарка;
				СуммаДок = СуммаДок + СтрТовар.Сумма;
			КонецЦикла;
			
			НовыйЧек.СуммаДокумента = СуммаДок;
			
			// Заполняем оплату
			Оплата = НовыйЧек.Оплата.Добавить();
			Оплата.КассаОплаты = КассаОплаты;
			Оплата.Сумма = СуммаДок;
			
			ВидКассы = КассаОплаты.ВидКассы;
			Если ВидКассы = Перечисления.ВидыКасс.БанковскийСчет Тогда
				Оплата.ВидОплаты = Перечисления.ВидыОплаты.Безналичные;
			Иначе
				Оплата.ВидОплаты = Перечисления.ВидыОплаты.Наличные;
			КонецЕсли;
			
			НовыйЧек.Записать(РежимЗаписиДокумента.Проведение);
			КоличествоЧеков = КоличествоЧеков + 1;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Сообщить("Ошибка проведения чеков с разделением по ФОП: " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;
	
	Результат.Успех = Истина;
	Результат.КоличествоЧеков = КоличествоЧеков;
	Возврат Результат;
	
КонецФункции

