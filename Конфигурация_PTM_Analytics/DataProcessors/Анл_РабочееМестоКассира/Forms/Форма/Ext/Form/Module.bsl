		Если Результат = КодВозвратаДиалога.Да Тогда
			ВыполнитьОформлениеВозврата(НастройкиРазделения.КассаНаличных);
		Иначе
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Возврат через карту отменён.";
			Сообщение.Сообщить();
			АктивироватьПоиск();
		КонецЕсли;
		
	Иначе
		
		ВыполнитьОформлениеВозврата(НастройкиРазделения.КассаНаличных);
		
	КонецЕсли;
	
