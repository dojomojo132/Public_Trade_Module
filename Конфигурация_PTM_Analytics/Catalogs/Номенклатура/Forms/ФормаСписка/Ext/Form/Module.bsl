&После("ПриСозданииНаСервере")
Процедура Анл_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Команда = Команды.Добавить("Анл_УстановитьНалоговуюГруппу");
	Команда.Действие = "Анл_УстановитьНалоговуюГруппу";
	Команда.Заголовок = "Установить налоговую группу";
	
	Кнопка = Элементы.Добавить("Анл_КнопкаУстановитьНГ", Тип("КнопкаФормы"), Элементы.СписокКоманднаяПанель);
	Кнопка.ИмяКоманды = "Анл_УстановитьНалоговуюГруппу";
	Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	Кнопка.Заголовок = "Установить НГ";
	
КонецПроцедуры

&НаКлиенте
Процедура Анл_УстановитьНалоговуюГруппу(Команда)
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выберите элементы номенклатуры для установки налоговой группы.");
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("Анл_ОбработкаВыбораНалоговойГруппы", ЭтотОбъект);
	ОткрытьФорму("Справочник.НалоговыеГруппы.ФормаВыбора", , ЭтотОбъект, , , , ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура Анл_ОбработкаВыбораНалоговойГруппы(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоЭлементов = Элементы.Список.ВыделенныеСтроки.Количество();
	
	ТекстВопроса = "Установить налоговую группу """ + Строка(ВыбранноеЗначение) + """ для " 
		+ Строка(КоличествоЭлементов) + " выделенных строк (включая вложенные в группы)?";
	
	ДопПараметры = Новый Структура("НалоговаяГруппа", ВыбранноеЗначение);
	ОписаниеОповещения = Новый ОписаниеОповещения("Анл_ОбработкаОтветаНаВопрос", ЭтотОбъект, ДопПараметры);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура Анл_ОбработкаОтветаНаВопрос(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	МассивСсылок = Новый Массив;
	Для Каждого Стр Из Элементы.Список.ВыделенныеСтроки Цикл
		МассивСсылок.Добавить(Стр);
	КонецЦикла;
	
	Обновлено = Анл_УстановитьНалоговуюГруппуНаСервере(МассивСсылок, ДополнительныеПараметры.НалоговаяГруппа);
	
	Элементы.Список.Обновить();
	
	ПоказатьОповещениеПользователя("Налоговая группа установлена", , 
		"Обновлено элементов: " + Строка(Обновлено));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция Анл_УстановитьНалоговуюГруппуНаСервере(МассивСсылок, НалоговаяГруппа)
	
	Счётчик = 0;
	
	Для Каждого Ссылка Из МассивСсылок Цикл
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Объект.ЭтоГруппа Тогда
			Счётчик = Счётчик + Анл_УстановитьНГДляГруппы(Ссылка, НалоговаяГруппа);
		Иначе
			Объект.НалоговаяГруппа = НалоговаяГруппа;
			Объект.Записать();
			Счётчик = Счётчик + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Счётчик;
	
КонецФункции

&НаСервереБезКонтекста
Функция Анл_УстановитьНГДляГруппы(ГруппаСсылка, НалоговаяГруппа)
	
	Счётчик = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Родитель = &Родитель
		|	И НЕ Номенклатура.ЭтоГруппа";
	Запрос.УстановитьПараметр("Родитель", ГруппаСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.НалоговаяГруппа = НалоговаяГруппа;
		Объект.Записать();
		Счётчик = Счётчик + 1;
	КонецЦикла;
	
	// Рекурсия по вложенным группам
	ЗапросГрупп = Новый Запрос;
	ЗапросГрупп.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Родитель = &Родитель
		|	И Номенклатура.ЭтоГруппа";
	ЗапросГрупп.УстановитьПараметр("Родитель", ГруппаСсылка);
	
	ВыборкаГрупп = ЗапросГрупп.Выполнить().Выбрать();
	Пока ВыборкаГрупп.Следующий() Цикл
		Счётчик = Счётчик + Анл_УстановитьНГДляГруппы(ВыборкаГрупп.Ссылка, НалоговаяГруппа);
	КонецЦикла;
	
	Возврат Счётчик;
	
КонецФункции
