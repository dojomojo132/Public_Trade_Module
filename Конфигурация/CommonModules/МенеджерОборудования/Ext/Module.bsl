// ОбщийМодуль.МенеджерОборудования
// Свойства модуля: [x] Клиент (упр. прил), [x] Сервер, [x] ВызовСервера
//
// Улучшенная подсистема сканера штрихкодов:
// - COM-драйвер (Scanner.ScanOPOS) — основной метод
// - NativeAPI (AddIn.Scanner.CScanner) — fallback
// - ExternalEvent — для сканеров с нативной поддержкой 1С
// - Переподключение при ошибке
// - Централизованная рассылка через Оповестить("СканерШтрихкод")
//
// USB HID сканеры (эмуляция клавиатуры) — обрабатываются псевдо-драйвером
// в формах напрямую (пинг-понг полей), МенеджерОборудования не участвует.

// =========================================================================
// КЛИЕНТСКАЯ ЧАСТЬ — работа с оборудованием
// =========================================================================
#Если Клиент Тогда

#Область ПодключениеСканера

// Подключение сканера штрихкодов.
// Последовательно пробует: COM-драйвер → NativeAPI.
// При успехе сохраняет объект в глДрайверСканера.
//
Процедура ПодключитьСканер() Экспорт
	
	ДанныеСканера = ОбщегоНазначения.ПолучитьНастройкиСканера();
	
	Если ДанныеСканера = Неопределено Тогда
		// Нет настроек сканера — работаем только через USB HID (псевдо-драйвер)
		Возврат;
	КонецЕсли;
	
	Параметры = ДанныеСканера.Параметры;
	
	// --- Попытка 1: COM-драйвер (ScanOPOS.dll) ---
	Если ПодключитьCOMСканер(Параметры) Тогда
		Возврат;
	КонецЕсли;
	
	// --- Попытка 2: NativeAPI компонента ---
	ПодключитьNativeAPIСканер(Параметры);
	
КонецПроцедуры

// Отключение сканера.
// Безопасно отключает драйвер и очищает глобальную переменную.
//
Процедура ОтключитьСканер() Экспорт
	
	Если глДрайверСканера = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		глДрайверСканера.DeviceEnabled = Ложь;
	Исключение
		// Игнорируем — устройство может быть уже отключено
	КонецПопытки;
	
	глДрайверСканера = Неопределено;
	
КонецПроцедуры

// Переподключение сканера.
// Вызывается при потере связи или по команде пользователя.
//
Процедура ПереподключитьСканер() Экспорт
	
	ОтключитьСканер();
	ПодключитьСканер();
	
КонецПроцедуры

// Возвращает Истина, если сканер подключён.
//
Функция СканерПодключен() Экспорт
	
	Возврат глДрайверСканера <> Неопределено;
	
КонецФункции

#КонецОбласти

#Область ОбработкаСобытий

// Обработка внешнего события от NativeAPI-компоненты или драйвера.
// Вызывается из МодуляУправляемогоПриложения.ОбработкаВнешнегоСобытия().
//
// Параметры:
//  Источник - Строка - идентификатор источника события
//  Событие  - Строка - имя события
//  Данные   - Строка - данные события (штрихкод)
//
Процедура ОбработатьВнешнееСобытие(Источник, Событие, Данные) Экспорт
	
	Штрихкод = "";
	
	// Распознаём события от различных сканеров
	Если ВРег(Событие) = "BARCODE" 
		ИЛИ ВРег(Событие) = "SCANDATA"
		ИЛИ ВРег(Событие) = "SCAN" Тогда
		
		Штрихкод = СокрЛП(Данные);
		
	ИначеЕсли ВРег(Источник) = "CYCLON"
		ИЛИ ВРег(Источник) = "BARCODESCANNER"
		ИЛИ ВРег(Источник) = "SCANNER" Тогда
		
		Штрихкод = СокрЛП(Данные);
		
	КонецЕсли;
	
	Если Не ПустаяСтрока(Штрихкод) Тогда
		ОповеститьОШтрихкоде(Штрихкод);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события COM-драйвера (Scanner.ScanOPOS: событие "Scan").
// Вызывается напрямую COM-объектом при получении данных от сканера.
//
Процедура ОбработчикСобытияСканирования(Данные) Экспорт
	
	Штрихкод = СокрЛП(Строка(Данные));
	
	Если Не ПустаяСтрока(Штрихкод) Тогда
		ОповеститьОШтрихкоде(Штрихкод);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик завершения асинхронного подключения NativeAPI компоненты.
//
Процедура ПослеПодключенияКомпоненты(Подключено, ДопПараметры) Экспорт
	
	Если Не Подключено Тогда
		// NativeAPI не доступен — работаем только через USB HID
		Возврат;
	КонецЕсли;
	
	Попытка
		ДрайверОбъект = Новый("AddIn.Scanner.CScanner");
		
		Параметры = ДопПараметры.Настройки;
		ДрайверОбъект.Port = Параметры.Port;
		ДрайверОбъект.Speed = Параметры.Speed;
		ДрайверОбъект.DataBits = Параметры.DataBits;
		ДрайверОбъект.StopBits = Параметры.StopBits;
		
		ДрайверОбъект.DeviceEnabled = Истина;
		ДрайверОбъект.DataEventEnabled = Истина;
		
		глДрайверСканера = ДрайверОбъект;
		
	Исключение
		// NativeAPI создан, но устройство не отвечает
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

// Централизованная рассылка штрихкода всем открытым формам.
// Все формы, подписанные на событие "СканерШтрихкод", получат оповещение.
//
Процедура ОповеститьОШтрихкоде(Штрихкод)
	
	Оповестить("СканерШтрихкод", Штрихкод, "МенеджерОборудования");
	
КонецПроцедуры

// Попытка подключения COM-драйвера (Scanner.ScanOPOS).
// Возвращает Истина при успехе.
//
Функция ПодключитьCOMСканер(Параметры)
	
	Попытка
		ДрайверОбъект = Новый COMОбъект("Scanner.ScanOPOS");
		ДрайверОбъект.Open();
		
		ДрайверОбъект.Port = Параметры.Port;
		ДрайверОбъект.Speed = Параметры.Speed;
		ДрайверОбъект.DataBits = Параметры.DataBits;
		ДрайверОбъект.StopBits = Параметры.StopBits;
		
		ДобавитьОбработчик ДрайверОбъект.Scan, ОбработчикСобытияСканирования;
		
		ДрайверОбъект.DeviceEnabled = Истина;
		глДрайверСканера = ДрайверОбъект;
		
		Возврат Истина;
		
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

// Попытка подключения NativeAPI-компоненты сканера (асинхронная).
//
Процедура ПодключитьNativeAPIСканер(Параметры)
	
	ДопПараметры = Новый Структура("Настройки", Параметры);
	Оповещение = Новый ОписаниеОповещения("ПослеПодключенияКомпоненты", МенеджерОборудования, ДопПараметры);
	
	Попытка
		НачатьПодключениеВнешнейКомпоненты(Оповещение, "Scanner", "CScanner");
	Исключение
		// NativeAPI компонента не установлена — работаем через USB HID
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли