#Область ПрограммныйИнтерфейс

// Обработчик HTTP-запроса API: auth (кроме health), request-id, вызов use-case.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос
//  ТребуетАвторизацию - Булево
//  Обработчик - Строка - имя операции для маршрутизации
//
// Возвращаемое значение:
//  HTTPСервисОтвет
//
Функция ОбработатьЗапрос(Запрос, ТребуетАвторизацию, Обработчик) Экспорт

	ИдЗапроса = ПолучитьИлиСоздатьRequestId(Запрос);

	Попытка

		Если ТребуетАвторизацию Тогда
			РезультатАутентификации = ПроверитьApiKey(Запрос);
			Если НЕ РезультатАутентификации.Успех Тогда
				Возврат ОтветОшибки(401, "unauthorized", РезультатАутентификации.Сообщение, ИдЗапроса);
			КонецЕсли;
		КонецЕсли;

		Если Обработчик = "health" Тогда
			Данные = ДанныеHealth();
			Возврат ОтветJSON(200, Данные, ИдЗапроса);
		КонецЕсли;

		Параметры = ПараметрыЗапросаВСтруктуру(Запрос);

		Если Обработчик = "stocks" Тогда
			Результат = ПтмАпиРегистры.ПолучитьОстатки(Параметры);
		ИначеЕсли Обработчик = "sales" Тогда
			Результат = ПтмАпиРегистры.ПолучитьПродажи(Параметры);
		ИначеЕсли Обработчик = "cash-balances" Тогда
			Результат = ПтмАпиРегистры.ПолучитьДенежныеСредства(Параметры);
		ИначеЕсли Обработчик = "settlements" Тогда
			Результат = ПтмАпиРегистры.ПолучитьВзаиморасчеты(Параметры);
		ИначеЕсли Обработчик = "barcodes" Тогда
			Результат = ПтмАпиРегистры.ПолучитьШтрихкоды(Параметры);
		ИначеЕсли Обработчик = "prices" Тогда
			Результат = ПтмАпиРегистры.ПолучитьЦены(Параметры);
		ИначеЕсли Обработчик = "products" Тогда
			Результат = ПтмАпиСправочники.ПолучитьНоменклатуру(Параметры);
		ИначеЕсли Обработчик = "product-by-id" Тогда
			Результат = ПтмАпиСправочники.ПолучитьНоменклатуруПоИд(ПараметрURL(Запрос, "id"));
		ИначеЕсли Обработчик = "warehouses" Тогда
			Результат = ПтмАпиСправочники.ПолучитьСклады(Параметры);
		ИначеЕсли Обработчик = "warehouse-by-id" Тогда
			Результат = ПтмАпиСправочники.ПолучитьСкладПоИд(ПараметрURL(Запрос, "id"));
		ИначеЕсли Обработчик = "cash-registers" Тогда
			Результат = ПтмАпиСправочники.ПолучитьКассы(Параметры);
		ИначеЕсли Обработчик = "cash-register-by-id" Тогда
			Результат = ПтмАпиСправочники.ПолучитьКассуПоИд(ПараметрURL(Запрос, "id"));
		ИначеЕсли Обработчик = "counterparties" Тогда
			Результат = ПтмАпиСправочники.ПолучитьКонтрагентов(Параметры);
		ИначеЕсли Обработчик = "counterparty-by-id" Тогда
			Результат = ПтмАпиСправочники.ПолучитьКонтрагентаПоИд(ПараметрURL(Запрос, "id"));
		ИначеЕсли Обработчик = "price-types" Тогда
			Результат = ПтмАпиСправочники.ПолучитьТипыЦен(Параметры);
		ИначеЕсли Обработчик = "price-type-by-id" Тогда
			Результат = ПтмАпиСправочники.ПолучитьТипЦенПоИд(ПараметрURL(Запрос, "id"));
		ИначеЕсли Обработчик = "goods-receipts"
			Или Обработчик = "write-offs"
			Или Обработчик = "inventories"
			Или Обработчик = "repricings"
			Или Обработчик = "cash-in"
			Или Обработчик = "cash-out"
			Или Обработчик = "receipts"
			Или Обработчик = "goods-receipt-by-id"
			Или Обработчик = "write-off-by-id"
			Или Обработчик = "inventory-by-id"
			Или Обработчик = "repricing-by-id"
			Или Обработчик = "cash-in-by-id"
			Или Обработчик = "cash-out-by-id"
			Или Обработчик = "receipt-by-id" Тогда
			// Документы — secondary; реализация отдельным этапом
			Возврат ОтветОшибки(501, "not_implemented",
				"Document endpoints will be implemented after registers (secondary channel)", ИдЗапроса);
		Иначе
			Возврат ОтветОшибки(404, "not_found", "Unknown handler", ИдЗапроса);
		КонецЕсли;

		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("Ошибка") И Результат.Ошибка Тогда
			Код = 400;
			Если Результат.Свойство("HttpКод") Тогда
				Код = Результат.HttpКод;
			КонецЕсли;
			КодОшибки = "validation_error";
			Если Результат.Свойство("КодОшибки") Тогда
				КодОшибки = Результат.КодОшибки;
			КонецЕсли;
			Сообщение = "";
			Если Результат.Свойство("Сообщение") Тогда
				Сообщение = Результат.Сообщение;
			КонецЕсли;
			Возврат ОтветОшибки(Код, КодОшибки, Сообщение, ИдЗапроса);
		КонецЕсли;

		Возврат ОтветJSON(200, Результат, ИдЗапроса);

	Исключение
		// Не отдаём сырой ОписаниеОшибки клиенту
		Возврат ОтветОшибки(500, "internal_error", "Internal server error", ИдЗапроса);
	КонецПопытки;

КонецФункции

// Разбор и проверка обязательного периода (max 31 день).
//
// Параметры:
//  Параметры - Структура - query-параметры
//  Обязателен - Булево
//
// Возвращаемое значение:
//  Структура - Успех, ДатаНачала, ДатаОкончания, КодОшибки, Сообщение, HttpКод, Ошибка
//
Функция РазобратьПериод(Параметры, Обязателен = Истина) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Ошибка", Истина);
	Результат.Вставить("ДатаНачала", Неопределено);
	Результат.Вставить("ДатаОкончания", Неопределено);
	Результат.Вставить("КодОшибки", "");
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("HttpКод", 400);

	СтрокаС = Неопределено;
	СтрокаПо = Неопределено;
	Параметры.Свойство("dateFrom", СтрокаС);
	Параметры.Свойство("dateTo", СтрокаПо);

	ЕстьС = ЗначениеЗаполнено(СтрокаС);
	ЕстьПо = ЗначениеЗаполнено(СтрокаПо);

	Если Обязателен И (НЕ ЕстьС Или НЕ ЕстьПо) Тогда
		Результат.КодОшибки = "period_required";
		Результат.Сообщение = "Query parameters dateFrom and dateTo are required (max 31 days)";
		Возврат Результат;
	КонецЕсли;

	Если НЕ ЕстьС И НЕ ЕстьПо Тогда
		Результат.Успех = Истина;
		Результат.Ошибка = Ложь;
		Возврат Результат;
	КонецЕсли;

	Если ЕстьС <> ЕстьПо Тогда
		Результат.КодОшибки = "period_required";
		Результат.Сообщение = "Both dateFrom and dateTo must be provided together";
		Возврат Результат;
	КонецЕсли;

	ДатаНачала = ДатаИзСтрокиISO(Строка(СтрокаС));
	ДатаОкончания = ДатаИзСтрокиISO(Строка(СтрокаПо));

	Если НЕ ЗначениеЗаполнено(ДатаНачала) Или НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		Результат.КодОшибки = "period_invalid";
		Результат.Сообщение = "Invalid dateFrom or dateTo (use ISO-8601)";
		Возврат Результат;
	КонецЕсли;

	Если ДатаНачала > ДатаОкончания Тогда
		Результат.КодОшибки = "period_invalid";
		Результат.Сообщение = "dateFrom must be less than or equal to dateTo";
		Возврат Результат;
	КонецЕсли;

	// Календарные дни включительно
	Дней = (НачалоДня(ДатаОкончания) - НачалоДня(ДатаНачала)) / 86400 + 1;
	Если Дней > 31 Тогда
		Результат.КодОшибки = "period_too_long";
		Результат.Сообщение = "Period must not exceed 31 days; split into multiple requests";
		Возврат Результат;
	КонецЕсли;

	// date-only: конец суток
	Если СтрДлина(СтрЗаменить(СтрЗаменить(Строка(СтрокаПо), "T", ""), ":", "")) <= 10
		Или СтрНайти(Строка(СтрокаПо), "T") = 0 Тогда
		ДатаОкончания = КонецДня(ДатаОкончания);
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Ошибка = Ложь;
	Результат.ДатаНачала = ДатаНачала;
	Результат.ДатаОкончания = ДатаОкончания;
	Возврат Результат;

КонецФункции

// Пагинация limit/offset из query.
//
// Параметры:
//  Параметры - Структура
//
// Возвращаемое значение:
//  Структура - Limit, Offset
//
Функция ПараметрыПагинации(Параметры) Экспорт

	Limit = 100;
	Offset = 0;

	Если Параметры.Свойство("limit") И ЗначениеЗаполнено(Параметры.limit) Тогда
		Limit = БезопасноЧисло(Параметры.limit, 100);
	КонецЕсли;
	Если Параметры.Свойство("offset") И ЗначениеЗаполнено(Параметры.offset) Тогда
		Offset = БезопасноЧисло(Параметры.offset, 0);
	КонецЕсли;

	Если Limit < 1 Тогда
		Limit = 1;
	КонецЕсли;
	Если Limit > 1000 Тогда
		Limit = 1000;
	КонецЕсли;
	Если Offset < 0 Тогда
		Offset = 0;
	КонецЕсли;

	Возврат Новый Структура("Limit, Offset", Limit, Offset);

КонецФункции

// Страница списка.
//
// Параметры:
//  ВсеЭлементы - Массив
//  Limit - Число
//  Offset - Число
//
// Возвращаемое значение:
//  Структура - items, count, limit, offset, total
//
Функция СтраницаСписка(ВсеЭлементы, Limit, Offset) Экспорт

	Total = ВсеЭлементы.Количество();
	Items = Новый Массив;

	Индекс = 0;
	Для Каждого Элемент Из ВсеЭлементы Цикл
		Если Индекс >= Offset И Items.Количество() < Limit Тогда
			Items.Добавить(Элемент);
		КонецЕсли;
		Индекс = Индекс + 1;
		Если Items.Количество() >= Limit И Индекс > Offset + Limit Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("items", Items);
	Результат.Вставить("count", Items.Количество());
	Результат.Вставить("limit", Limit);
	Результат.Вставить("offset", Offset);
	Результат.Вставить("total", Total);
	Возврат Результат;

КонецФункции

// Структура ошибки use-case.
//
Функция ОшибкаUseCase(КодОшибки, Сообщение, HttpКод = 400) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Ошибка", Истина);
	Результат.Вставить("КодОшибки", КодОшибки);
	Результат.Вставить("Сообщение", Сообщение);
	Результат.Вставить("HttpКод", HttpКод);
	Возврат Результат;

КонецФункции

// UUID ссылки в строку.
//
Функция ИдСсылки(Ссылка) Экспорт

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Строка(Ссылка.УникальныйИдентификатор());

КонецФункции

// Ссылка справочника по UUID-строке.
//
Функция СсылкаПоИд(Менеджер, СтрокаИд) Экспорт

	Если НЕ ЗначениеЗаполнено(СтрокаИд) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Уид = Новый УникальныйИдентификатор(СокрЛП(СтрокаИд));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Ссылка = Менеджер.ПолучитьСсылку(Уид);
	Возврат Ссылка;

КонецФункции

// Дата из ISO / date-only.
//
Функция ДатаИзСтрокиISO(Знач СтрокаДаты) Экспорт

	Если НЕ ЗначениеЗаполнено(СтрокаДаты) Тогда
		Возврат '00010101';
	КонецЕсли;

	СтрокаДаты = СокрЛП(СтрокаДаты);
	СтрокаДаты = СтрЗаменить(СтрокаДаты, "T", "");
	СтрокаДаты = СтрЗаменить(СтрокаДаты, "Z", "");
	СтрокаДаты = СтрЗаменить(СтрокаДаты, "-", "");
	СтрокаДаты = СтрЗаменить(СтрокаДаты, ":", "");
	СтрокаДаты = СтрЗаменить(СтрокаДаты, " ", "");

	// отрезать дробную часть
	ПозТочки = СтрНайти(СтрокаДаты, ".");
	Если ПозТочки > 0 Тогда
		СтрокаДаты = Лев(СтрокаДаты, ПозТочки - 1);
	КонецЕсли;
	// timezone +0300
	ПозПлюс = СтрНайти(СтрокаДаты, "+");
	Если ПозПлюс > 0 Тогда
		СтрокаДаты = Лев(СтрокаДаты, ПозПлюс - 1);
	КонецЕсли;

	Попытка
		Если СтрДлина(СтрокаДаты) >= 14 Тогда
			Возврат Дата(Лев(СтрокаДаты, 14));
		ИначеЕсли СтрДлина(СтрокаДаты) >= 8 Тогда
			Возврат Дата(Лев(СтрокаДаты, 8) + "000000");
		КонецЕсли;
	Исключение
		Возврат '00010101';
	КонецПопытки;

	Возврат '00010101';

КонецФункции

Функция БезопасноЧисло(Значение, ЗначениеПоУмолчанию = 0) Экспорт

	Если Значение = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	ОписаниеТипа = Новый ОписаниеТипов("Число");
	Результат = ОписаниеТипа.ПривестиЗначение(Значение);
	Если Результат = 0 И СокрЛП(Строка(Значение)) <> "0" И НЕ ПустаяСтрока(СокрЛП(Строка(Значение))) Тогда
		// leave as converted
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция БезопасноБулево(Значение, ЗначениеПоУмолчанию = Ложь) Экспорт

	Если Значение = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	С = НРег(СокрЛП(Строка(Значение)));
	Если С = "true" Или С = "1" Или С = "да" Или С = "истина" Тогда
		Возврат Истина;
	КонецЕсли;
	Если С = "false" Или С = "0" Или С = "нет" Или С = "ложь" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеHealth()

	Данные = Новый Структура;
	Данные.Вставить("status", "ok");
	Данные.Вставить("version", "1.0.0");
	Данные.Вставить("time", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Возврат Данные;

КонецФункции

Функция ПолучитьИлиСоздатьRequestId(Запрос)

	Ид = ЗаголовокЗапроса(Запрос, "X-Request-Id");
	Если НЕ ЗначениеЗаполнено(Ид) Тогда
		Ид = ЗаголовокЗапроса(Запрос, "x-request-id");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Ид) Тогда
		Ид = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
	Возврат Ид;

КонецФункции

Функция ПроверитьApiKey(Запрос)

	Результат = Новый Структура("Успех, Сообщение", Ложь, "");

	ОжидаемыйКлюч = СокрЛП(Строка(Константы.ПтмАпиКлюч.Получить()));
	Если НЕ ЗначениеЗаполнено(ОжидаемыйКлюч) Тогда
		// DEV: ключ не задан — пропускаем проверку
		Результат.Успех = Истина;
		Возврат Результат;
	КонецЕсли;

	Ключ = ЗаголовокЗапроса(Запрос, "X-Api-Key");
	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Ключ = ЗаголовокЗапроса(Запрос, "x-api-key");
	КонецЕсли;

	Если СокрЛП(Строка(Ключ)) <> ОжидаемыйКлюч Тогда
		Результат.Сообщение = "Invalid or missing X-Api-Key";
		Возврат Результат;
	КонецЕсли;

	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

Функция ЗаголовокЗапроса(Запрос, Имя)

	Попытка
		Возврат Запрос.Заголовки.Получить(Имя);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ПараметрыЗапросаВСтруктуру(Запрос)

	Результат = Новый Структура;
	Для Каждого КлючИЗначение Из Запрос.ПараметрыЗапроса Цикл
		Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПараметрURL(Запрос, Имя)

	Попытка
		Возврат Запрос.ПараметрыURL.Получить(Имя);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ОтветJSON(КодСостояния, Данные, ИдЗапроса)

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("X-Request-Id", ИдЗапроса);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8);

	Возврат Ответ;

КонецФункции

Функция ОтветОшибки(КодСостояния, КодОшибки, Сообщение, ИдЗапроса)

	Тело = Новый Структура;
	Тело.Вставить("code", КодОшибки);
	Тело.Вставить("message", Сообщение);
	Тело.Вставить("requestId", ИдЗапроса);
	Возврат ОтветJSON(КодСостояния, Тело, ИдЗапроса);

КонецФункции

#КонецОбласти
