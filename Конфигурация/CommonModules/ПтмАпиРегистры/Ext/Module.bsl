Функция ПолучитьШтрихкоды(Параметры) Экспорт

	Пагинация = ПтмАпи.ПараметрыПагинации(Параметры);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Штрихкоды.Штрихкод КАК Штрихкод,
	|	Штрихкоды.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	(&Штрихкод = """" ИЛИ Штрихкоды.Штрихкод = &Штрихкод)
	|	И (&Номенклатура = НЕОПРЕДЕЛЕНО ИЛИ Штрихкоды.Номенклатура = &Номенклатура)";

	Штрихкод = "";
	Номенклатура = Неопределено;
	Если Параметры.Свойство("barcode") И ЗначениеЗаполнено(Параметры.barcode) Тогда
		Штрихкод = СокрЛП(Строка(Параметры.barcode));
	КонецЕсли;
	Если Параметры.Свойство("productId") И ЗначениеЗаполнено(Параметры.productId) Тогда
		Номенклатура = ПтмАпи.СсылкаПоИд(Справочники.Номенклатура, Параметры.productId);
	ИначеЕсли Параметры.Свойство("productCode") И ЗначениеЗаполнено(Параметры.productCode) Тогда
		Номенклатура = Справочники.Номенклатура.НайтиПоКоду(СокрЛП(Строка(Параметры.productCode)));
	КонецЕсли;

	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);

	Все = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаДанных = Новый Структура;
		СтрокаДанных.Вставить("barcode", СокрЛП(Выборка.Штрихкод));
		СтрокаДанных.Вставить("productId", ПтмАпи.ИдСсылки(Выборка.Номенклатура));
		СтрокаДанных.Вставить("productCode", ?(ЗначениеЗаполнено(Выборка.Номенклатура), СокрЛП(Выборка.Номенклатура.Код), ""));
		СтрокаДанных.Вставить("productName", ?(ЗначениеЗаполнено(Выборка.Номенклатура), СокрЛП(Выборка.Номенклатура.Наименование), ""));
		Все.Добавить(СтрокаДанных);
	КонецЦикла;

	Возврат ПтмАпи.СтраницаСписка(Все, Пагинация.Limit, Пагинация.Offset);

КонецФункции

Функция ПолучитьЦены(Параметры) Экспорт

	Пагинация = ПтмАпи.ПараметрыПагинации(Параметры);

	// history mode if both dates present
	ПериодПров = ПтмАпи.РазобратьПериод(Параметры, Ложь);
	Если ПериодПров.Ошибка Тогда
		Возврат ПтмАпи.ОшибкаUseCase(ПериодПров.КодОшибки, ПериодПров.Сообщение, ПериодПров.HttpКод);
	КонецЕсли;

	Номенклатура = Неопределено;
	ТипЦен = Неопределено;
	Если Параметры.Свойство("productId") И ЗначениеЗаполнено(Параметры.productId) Тогда
		Номенклатура = ПтмАпи.СсылкаПоИд(Справочники.Номенклатура, Параметры.productId);
	ИначеЕсли Параметры.Свойство("productCode") И ЗначениеЗаполнено(Параметры.productCode) Тогда
		Номенклатура = Справочники.Номенклатура.НайтиПоКоду(СокрЛП(Строка(Параметры.productCode)));
	КонецЕсли;
	Если Параметры.Свойство("priceTypeId") И ЗначениеЗаполнено(Параметры.priceTypeId) Тогда
		ТипЦен = ПтмАпи.СсылкаПоИд(Справочники.ТипыЦен, Параметры.priceTypeId);
	ИначеЕсли Параметры.Свойство("priceTypeCode") И ЗначениеЗаполнено(Параметры.priceTypeCode) Тогда
		ТипЦен = Справочники.ТипыЦен.НайтиПоКоду(СокрЛП(Строка(Параметры.priceTypeCode)));
	КонецЕсли;

	Все = Новый Массив;

	Если ЗначениеЗаполнено(ПериодПров.ДатаНачала) Тогда
		// history
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Цены.Период КАК Период,
		|	Цены.Номенклатура КАК Номенклатура,
		|	Цены.ТипЦен КАК ТипЦен,
		|	Цены.Цена КАК Цена,
		|	Цены.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры КАК Цены
		|ГДЕ
		|	Цены.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И (&Номенклатура = НЕОПРЕДЕЛЕНО ИЛИ Цены.Номенклатура = &Номенклатура)
		|	И (&ТипЦен = НЕОПРЕДЕЛЕНО ИЛИ Цены.ТипЦен = &ТипЦен)";
		Запрос.УстановитьПараметр("НачалоПериода", ПериодПров.ДатаНачала);
		Запрос.УстановитьПараметр("КонецПериода", ПериодПров.ДатаОкончания);
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		Запрос.УстановитьПараметр("ТипЦен", ТипЦен);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Все.Добавить(СтрокаЦены(Выборка));
		КонецЦикла;
	Иначе
		// slice last
		OnDate = ТекущаяДатаСеанса();
		Если Параметры.Свойство("onDate") И ЗначениеЗаполнено(Параметры.onDate) Тогда
			OnDate = ПтмАпи.ДатаИзСтрокиISO(Строка(Параметры.onDate));
		КонецЕсли;
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Срез.Период КАК Период,
		|	Срез.Номенклатура КАК Номенклатура,
		|	Срез.ТипЦен КАК ТипЦен,
		|	Срез.Цена КАК Цена,
		|	Срез.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Период, ) КАК Срез
		|ГДЕ
		|	(&Номенклатура = НЕОПРЕДЕЛЕНО ИЛИ Срез.Номенклатура = &Номенклатура)
		|	И (&ТипЦен = НЕОПРЕДЕЛЕНО ИЛИ Срез.ТипЦен = &ТипЦен)";
		Запрос.УстановитьПараметр("Период", OnDate);
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		Запрос.УстановитьПараметр("ТипЦен", ТипЦен);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Все.Добавить(СтрокаЦены(Выборка));
		КонецЦикла;
	КонецЕсли;

	Возврат ПтмАпи.СтраницаСписка(Все, Пагинация.Limit, Пагинация.Offset);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СтрокаЦены(Выборка)

	СтрокаДанных = Новый Структура;
	СтрокаДанных.Вставить("productId", ПтмАпи.ИдСсылки(Выборка.Номенклатура));
	СтрокаДанных.Вставить("productCode", ?(ЗначениеЗаполнено(Выборка.Номенклатура), СокрЛП(Выборка.Номенклатура.Код), ""));
	СтрокаДанных.Вставить("priceTypeId", ПтмАпи.ИдСсылки(Выборка.ТипЦен));
	СтрокаДанных.Вставить("priceTypeCode", ?(ЗначениеЗаполнено(Выборка.ТипЦен), СокрЛП(Выборка.ТипЦен.Код), ""));
	СтрокаДанных.Вставить("price", Выборка.Цена);
	СтрокаДанных.Вставить("period", Формат(Выборка.Период, "ДФ=yyyy-MM-ddTHH:mm:ss"));
	СтрокаДанных.Вставить("recorderId", ПтмАпи.ИдСсылки(Выборка.Регистратор));
	Возврат СтрокаДанных;

КонецФункции

#КонецОбласти
