#Область ПрограммныйИнтерфейс

Функция ПолучитьОстатки(Параметры) Экспорт

	Пагинация = ПтмАпи.ПараметрыПагинации(Параметры);
	OnlyNonZero = Истина;
	Если Параметры.Свойство("onlyNonZero") Тогда
		OnlyNonZero = ПтмАпи.БезопасноБулево(Параметры.onlyNonZero, Истина);
	КонецЕсли;

	Период = ТекущаяДатаСеанса();
	Если Параметры.Свойство("onDate") И ЗначениеЗаполнено(Параметры.onDate) Тогда
		Период = ПтмАпи.ДатаИзСтрокиISO(Строка(Параметры.onDate));
		Если НЕ ЗначениеЗаполнено(Период) Тогда
			Возврат ПтмАпи.ОшибкаUseCase("validation_error", "Invalid onDate");
		КонецЕсли;
	КонецЕсли;

	Склад = Неопределено;
	Номенклатура = Неопределено;
	Если Параметры.Свойство("warehouseId") И ЗначениеЗаполнено(Параметры.warehouseId) Тогда
		Склад = ПтмАпи.СсылкаПоИд(Справочники.Склады, Параметры.warehouseId);
	ИначеЕсли Параметры.Свойство("warehouseCode") И ЗначениеЗаполнено(Параметры.warehouseCode) Тогда
		Склад = Справочники.Склады.НайтиПоКоду(СокрЛП(Строка(Параметры.warehouseCode)));
	КонецЕсли;
	Если Параметры.Свойство("productId") И ЗначениеЗаполнено(Параметры.productId) Тогда
		Номенклатура = ПтмАпи.СсылкаПоИд(Справочники.Номенклатура, Параметры.productId);
	ИначеЕсли Параметры.Свойство("productCode") И ЗначениеЗаполнено(Параметры.productCode) Тогда
		Номенклатура = Справочники.Номенклатура.НайтиПоКоду(СокрЛП(Строка(Параметры.productCode)));
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Склад КАК Склад,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(&Период, ) КАК Остатки
	|ГДЕ
	|	(&Склад = НЕОПРЕДЕЛЕНО ИЛИ Остатки.Склад = &Склад)
	|	И (&Номенклатура = НЕОПРЕДЕЛЕНО ИЛИ Остатки.Номенклатура = &Номенклатура)
	|	И (&OnlyNonZero = ЛОЖЬ ИЛИ Остатки.КоличествоОстаток <> 0)";

	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("OnlyNonZero", OnlyNonZero);

	Все = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаДанных = Новый Структура;
		СтрокаДанных.Вставить("warehouseId", ПтмАпи.ИдСсылки(Выборка.Склад));
		СтрокаДанных.Вставить("warehouseCode", СокрЛП(Выборка.Склад.Код));
		СтрокаДанных.Вставить("productId", ПтмАпи.ИдСсылки(Выборка.Номенклатура));
		СтрокаДанных.Вставить("productCode", СокрЛП(Выборка.Номенклатура.Код));
		СтрокаДанных.Вставить("quantity", Выборка.Количество);
		СтрокаДанных.Вставить("onDate", Формат(Период, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		Все.Добавить(СтрокаДанных);
	КонецЦикла;

	Возврат ПтмАпи.СтраницаСписка(Все, Пагинация.Limit, Пагинация.Offset);

КонецФункции

Функция ПолучитьПродажи(Параметры) Экспорт

	ПериодПров = ПтмАпи.РазобратьПериод(Параметры, Истина);
	Если ПериодПров.Ошибка Тогда
		Возврат ПтмАпи.ОшибкаUseCase(ПериодПров.КодОшибки, ПериодПров.Сообщение, ПериодПров.HttpКод);
	КонецЕсли;

	Пагинация = ПтмАпи.ПараметрыПагинации(Параметры);

	Номенклатура = Неопределено;
	Касса = Неопределено;
	Если Параметры.Свойство("productId") И ЗначениеЗаполнено(Параметры.productId) Тогда
		Номенклатура = ПтмАпи.СсылкаПоИд(Справочники.Номенклатура, Параметры.productId);
	ИначеЕсли Параметры.Свойство("productCode") И ЗначениеЗаполнено(Параметры.productCode) Тогда
		Номенклатура = Справочники.Номенклатура.НайтиПоКоду(СокрЛП(Строка(Параметры.productCode)));
	КонецЕсли;
	Если Параметры.Свойство("cashRegisterId") И ЗначениеЗаполнено(Параметры.cashRegisterId) Тогда
		Касса = ПтмАпи.СсылкаПоИд(Справочники.Кассы, Параметры.cashRegisterId);
	ИначеЕсли Параметры.Свойство("cashRegisterCode") И ЗначениеЗаполнено(Параметры.cashRegisterCode) Тогда
		Касса = Справочники.Кассы.НайтиПоКоду(СокрЛП(Строка(Параметры.cashRegisterCode)));
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Обороты.Номенклатура КАК Номенклатура,
	|	Обороты.Касса КАК Касса,
	|	Обороты.КассоваяСмена КАК КассоваяСмена,
	|	Обороты.Сотрудник КАК Сотрудник,
	|	Обороты.КоличествоОборот КАК Количество,
	|	Обороты.СуммаОборот КАК Сумма,
	|	Обороты.СебестоимостьОборот КАК Себестоимость
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, , ) КАК Обороты
	|ГДЕ
	|	(&Номенклатура = НЕОПРЕДЕЛЕНО ИЛИ Обороты.Номенклатура = &Номенклатура)
	|	И (&Касса = НЕОПРЕДЕЛЕНО ИЛИ Обороты.Касса = &Касса)";

	Запрос.УстановитьПараметр("НачалоПериода", ПериодПров.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", ПериодПров.ДатаОкончания);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Касса", Касса);

	Все = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаДанных = Новый Структура;
		СтрокаДанных.Вставить("productId", ПтмАпи.ИдСсылки(Выборка.Номенклатура));
		СтрокаДанных.Вставить("productCode", ?(ЗначениеЗаполнено(Выборка.Номенклатура), СокрЛП(Выборка.Номенклатура.Код), ""));
		СтрокаДанных.Вставить("cashRegisterId", ПтмАпи.ИдСсылки(Выборка.Касса));
		СтрокаДанных.Вставить("cashRegisterCode", ?(ЗначениеЗаполнено(Выборка.Касса), СокрЛП(Выборка.Касса.Код), ""));
		СтрокаДанных.Вставить("shiftId", ПтмАпи.ИдСсылки(Выборка.КассоваяСмена));
		СтрокаДанных.Вставить("employeeId", ПтмАпи.ИдСсылки(Выборка.Сотрудник));
		СтрокаДанных.Вставить("quantity", Выборка.Количество);
		СтрокаДанных.Вставить("amount", Выборка.Сумма);
		СтрокаДанных.Вставить("cost", Выборка.Себестоимость);
		СтрокаДанных.Вставить("period", Формат(ПериодПров.ДатаНачала, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		Все.Добавить(СтрокаДанных);
	КонецЦикла;

	Возврат ПтмАпи.СтраницаСписка(Все, Пагинация.Limit, Пагинация.Offset);

КонецФункции

