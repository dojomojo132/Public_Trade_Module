		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоПриход</dataPath>
			<field>КоличествоПриход</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Приход (кол.)</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоРасход</dataPath>
			<field>КоличествоРасход</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Расход (кол.)</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ОТ.Период КАК Период,
	ОТ.Регистратор КАК Документ,
	ОТ.Склад КАК Склад,
	ОТ.Номенклатура КАК Номенклатура,
	ВЫБОР
		КОГДА ТИПЗНАЧЕНИЯ(ОТ.Регистратор) = ТИП(Документ.ПриходТовара) ТОГДА &quot;Приход товара&quot;
		КОГДА ТИПЗНАЧЕНИЯ(ОТ.Регистратор) = ТИП(Документ.ЧекККМ) ТОГДА &quot;Продажа&quot;
		КОГДА ТИПЗНАЧЕНИЯ(ОТ.Регистратор) = ТИП(Документ.ВозвратТовараОтПокупателя) ТОГДА &quot;Возврат&quot;
		КОГДА ТИПЗНАЧЕНИЯ(ОТ.Регистратор) = ТИП(Документ.СписаниеТовара) ТОГДА &quot;Списание&quot;
		КОГДА ТИПЗНАЧЕНИЯ(ОТ.Регистратор) = ТИП(Документ.ИнвентаризацияТоваров) ТОГДА &quot;Инвентаризация&quot;
		ИНАЧЕ &quot;Прочее&quot;
	КОНЕЦ КАК ВидОперации,
	ВЫБОР КОГДА ОТ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) ТОГДА ОТ.Количество ИНАЧЕ 0 КОНЕЦ КАК КоличествоПриход,
	ВЫБОР КОГДА ОТ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) ТОГДА ОТ.Количество ИНАЧЕ 0 КОНЕЦ КАК КоличествоРасход
ИЗ
	РегистрНакопления.ОстаткиТоваров КАК ОТ
ГДЕ
	ОТ.Период МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода</query>
