		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ОИО.Склад КАК Склад,
	ОИО.Номенклатура КАК Номенклатура,
	ОИО.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	ЕСТЬNULL(ОИО.КоличествоНачальныйОстаток, 0) КАК НачальныйОстаток,
	ЕСТЬNULL(Движения.Поступление, 0) КАК Поступление,
	ЕСТЬNULL(Движения.ПродажиКоличество, 0) КАК ПродажиКоличество,
	ЕСТЬNULL(Движения.ВозвратыКоличество, 0) КАК ВозвратыКоличество,
	ЕСТЬNULL(Движения.СписаниеКоличество, 0) КАК Списание,
	ЕСТЬNULL(Движения.ИнвентаризацияПриход, 0)
		- ЕСТЬNULL(Движения.ИнвентаризацияРасход, 0) КАК Инвентаризация,
	ЕСТЬNULL(ОИО.КоличествоКонечныйОстаток, 0) КАК КонечныйОстаток
ИЗ
	РегистрНакопления.ОстаткиТоваров.ОстаткиИОбороты(
		&amp;НачалоПериода,
		&amp;КонецПериода,
		,
	) КАК ОИО

	ЛЕВОЕ СОЕДИНЕНИЕ (
		ВЫБРАТЬ
			ОТ.Склад КАК Склад,
			ОТ.Номенклатура КАК Номенклатура,

			СУММА(ВЫБОР
				КОГДА ОТ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
					И ТИПЗНАЧЕНИЯ(ОТ.Регистратор) = ТИП(Документ.ПриходТовара)
				ТОГДА ОТ.Количество ИНАЧЕ 0 КОНЕЦ) КАК Поступление,

			СУММА(ВЫБОР
				КОГДА ОТ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
					И ТИПЗНАЧЕНИЯ(ОТ.Регистратор) = ТИП(Документ.ЧекККМ)
				ТОГДА ОТ.Количество ИНАЧЕ 0 КОНЕЦ) КАК ПродажиКоличество,

			СУММА(ВЫБОР
				КОГДА ОТ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
					И ТИПЗНАЧЕНИЯ(ОТ.Регистратор) = ТИП(Документ.ВозвратТовараОтПокупателя)
				ТОГДА ОТ.Количество ИНАЧЕ 0 КОНЕЦ) КАК ВозвратыКоличество,

			СУММА(ВЫБОР
				КОГДА ОТ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
					И ТИПЗНАЧЕНИЯ(ОТ.Регистратор) = ТИП(Документ.СписаниеТовара)
				ТОГДА ОТ.Количество ИНАЧЕ 0 КОНЕЦ) КАК СписаниеКоличество,

			СУММА(ВЫБОР
				КОГДА ОТ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
					И ТИПЗНАЧЕНИЯ(ОТ.Регистратор) = ТИП(Документ.ИнвентаризацияТоваров)
				ТОГДА ОТ.Количество ИНАЧЕ 0 КОНЕЦ) КАК ИнвентаризацияПриход,

			СУММА(ВЫБОР
				КОГДА ОТ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
					И ТИПЗНАЧЕНИЯ(ОТ.Регистратор) = ТИП(Документ.ИнвентаризацияТоваров)
				ТОГДА ОТ.Количество ИНАЧЕ 0 КОНЕЦ) КАК ИнвентаризацияРасход

		ИЗ
			РегистрНакопления.ОстаткиТоваров КАК ОТ
		ГДЕ
			ОТ.Период МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
		СГРУППИРОВАТЬ ПО
			ОТ.Склад,
			ОТ.Номенклатура
	) КАК Движения
	ПО ОИО.Склад = Движения.Склад
		И ОИО.Номенклатура = Движения.Номенклатура</query>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
		<name>ПродажиСуммы</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПродажиСумма</dataPath>
