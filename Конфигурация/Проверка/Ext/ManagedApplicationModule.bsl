// Модуль управляемого приложения
//
// Подсистема оборудования:
// - Автоподключение сканера при старте (в Попытка — не блокирует запуск)
// - Перехват внешних событий от NativeAPI/COM драйверов
// - Безопасное отключение при завершении

Перем глДрайверСканера Экспорт;

Процедура ПриНачалеРаботыСистемы()
	
	// Автоподключение сканера штрихкодов
	// Если настройки сканера не заданы — работает USB HID (через псевдо-драйвер в формах)
	// Обёрнуто в Попытка чтобы ошибка подключения не блокировала запуск приложения
	Попытка
		МенеджерОборудования.ПодключитьСканер();
	Исключение
		// Сканер не подключился — не критично, продолжаем работу
	КонецПопытки;
	
КонецПроцедуры

// Перехват внешних событий от NativeAPI-компонент и COM-драйверов.
// Все события сканера перенаправляются в МенеджерОборудования,
// который рассылает штрихкод всем открытым формам через Оповестить().
//
Процедура ОбработкаВнешнегоСобытия(Источник, Событие, Данные)
	
	Попытка
		МенеджерОборудования.ОбработатьВнешнееСобытие(Источник, Событие, Данные);
	Исключение
		// Ошибка обработки события — не критично
	КонецПопытки;
	
КонецПроцедуры

Процедура ПриЗавершенииРаботыСистемы()
	
	// Безопасное отключение сканера
	Попытка
		МенеджерОборудования.ОтключитьСканер();
	Исключение
		// Игнорируем — приложение уже закрывается
	КонецПопытки;
	
КонецПроцедуры