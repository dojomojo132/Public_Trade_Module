
#Область ОбработчикиСобытий

// Обработчик GET-запроса поиска товара.
// URL: /ptm/api/search?code=<код_или_штрихкод>
//
// Алгоритм поиска (аналогичен ОбщегоНазначения.НайтиТовар):
//   1. Поиск по штрихкоду в РегистрСведений.Штрихкоды
//   2. Поиск по Коду или Артикулу в Справочник.Номенклатура
//
// Возвращает JSON:
//   Если найдено - массив объектов товара с полями:
//     Код, Наименование, Артикул, ЕдиницаИзмерения, СтавкаНДС, Цена, Штрихкоды[]
//   Если не найдено - {"success": false, "error": "Товар не найден"}
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - входящий HTTP-запрос.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - ответ с JSON-телом.
//
Функция ПоискТовараGET(Запрос)
	
	СтрокаПоиска = Запрос.ПараметрыЗапроса.Получить("code");
	
	Если СтрокаПоиска = Неопределено ИЛИ ПустаяСтрока(СтрокаПоиска) Тогда
		Возврат СформироватьОтветОшибки(400, "Не указан параметр code");
	КонецЕсли;
	
	СтрокаПоиска = СокрЛП(СтрокаПоиска);
	
	// --- Поиск товаров ---
	НайденныеТовары = НайтиТоварыПоКоду(СтрокаПоиска);
	
	Если НайденныеТовары.Количество() = 0 Тогда
		Возврат СформироватьОтветОшибки(404, "Товар не найден по запросу: " + СтрокаПоиска);
	КонецЕсли;
	
	// --- Формирование ответа ---
	МассивТоваров = Новый Массив;
	
	Для Каждого Товар Из НайденныеТовары Цикл
		ДанныеТовара = ПолучитьДанныеТовара(Товар);
		МассивТоваров.Добавить(ДанныеТовара);
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("success", Истина);
	Результат.Вставить("count", МассивТоваров.Количество());
	Результат.Вставить("items", МассивТоваров);
	
	Возврат СформироватьОтветJSON(200, Результат);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Поиск товаров по коду/штрихкоду/артикулу.
// Логика аналогична ОбщегоНазначения.НайтиТовар.
//
// Параметры:
//  СтрокаПоиска - Строка - код, штрихкод или артикул.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Номенклатура - найденные товары.
//
Функция НайтиТоварыПоКоду(Знач СтрокаПоиска)
	
	Результат = Новый Массив;
	
	// --- ЭТАП 1: ПОИСК ПО ШТРИХКОДУ (Приоритет) ---
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|   Штрихкоды.Номенклатура КАК Номенклатура
		|ИЗ
		|   РегистрСведений.Штрихкоды КАК Штрихкоды
		|       ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		|       ПО Штрихкоды.Номенклатура = Номенклатура.Ссылка
		|ГДЕ
		|   Штрихкоды.Штрихкод = &СтрокаПоиска
		|   И НЕ Номенклатура.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("СтрокаПоиска", СтрокаПоиска);
	ТаблицаРезультатов = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаРезультатов.Количество() > 0 Тогда
		Для Каждого Строка Из ТаблицаРезультатов Цикл
			Результат.Добавить(Строка.Номенклатура);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	
	// --- ЭТАП 2: ПОИСК ПО КОДУ ИЛИ АРТИКУЛУ ---
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|   Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|   Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|   Номенклатура.Код = &СтрокаПоиска
		|   И НЕ Номенклатура.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|   Номенклатура.Ссылка
		|ИЗ
		|   Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|   Номенклатура.Артикул = &СтрокаПоиска
		|   И НЕ Номенклатура.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("СтрокаПоиска", СтрокаПоиска);
	ТаблицаРезультатов = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка Из ТаблицаРезультатов Цикл
		Результат.Добавить(Строка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Получает полные данные товара для ответа API.
//
// Параметры:
//  НоменклатураСсылка - СправочникСсылка.Номенклатура - ссылка на товар.
//
// Возвращаемое значение:
//  Структура - данные товара для сериализации в JSON.
//
Функция ПолучитьДанныеТовара(НоменклатураСсылка)
	
	// Основные реквизиты
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Код КАК Код,
		|	Номенклатура.Наименование КАК Наименование,
		|	Номенклатура.Артикул КАК Артикул,
		|	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Номенклатура.СтавкаНДС КАК СтавкаНДС,
		|	Номенклатура.КодУКТЗЕД КАК КодУКТЗЕД,
		|	Номенклатура.ТребуетАкцизнуюМарку КАК ТребуетАкцизнуюМарку,
		|	Номенклатура.ПроцентНаценки КАК ПроцентНаценки
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", НоменклатураСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		Возврат Новый Структура("error", "Ошибка чтения данных товара");
	КонецЕсли;
	
	// Розничная цена
	Цена = ОбщегоНазначения.ПолучитьРозничнуюЦену(ТекущаяДатаСеанса(), НоменклатураСсылка);
	
	// Штрихкоды товара
	ЗапросШК = Новый Запрос;
	ЗапросШК.Текст = 
		"ВЫБРАТЬ
		|	Штрихкоды.Штрихкод КАК Штрихкод
		|ИЗ
		|	РегистрСведений.Штрихкоды КАК Штрихкоды
		|ГДЕ
		|	Штрихкоды.Номенклатура = &Ссылка";
	
	ЗапросШК.УстановитьПараметр("Ссылка", НоменклатураСсылка);
	МассивШтрихкодов = Новый Массив;
	ВыборкаШК = ЗапросШК.Выполнить().Выбрать();
	Пока ВыборкаШК.Следующий() Цикл
		МассивШтрихкодов.Добавить(ВыборкаШК.Штрихкод);
	КонецЦикла;
	
	// Формируем структуру
	ДанныеТовара = Новый Структура;
	ДанныеТовара.Вставить("code", СокрЛП(Выборка.Код));
	ДанныеТовара.Вставить("name", СокрЛП(Выборка.Наименование));
	ДанныеТовара.Вставить("article", СокрЛП(Выборка.Артикул));
	ДанныеТовара.Вставить("unit", Строка(Выборка.ЕдиницаИзмерения));
	ДанныеТовара.Вставить("vatRate", Строка(Выборка.СтавкаНДС));
	ДанныеТовара.Вставить("codeUKTZED", СокрЛП(Выборка.КодУКТЗЕД));
	ДанныеТовара.Вставить("requiresExciseStamp", Выборка.ТребуетАкцизнуюМарку);
	ДанныеТовара.Вставить("markupPercent", Выборка.ПроцентНаценки);
	ДанныеТовара.Вставить("price", Цена);
	ДанныеТовара.Вставить("barcodes", МассивШтрихкодов);
	
	Возврат ДанныеТовара;
	
КонецФункции

// Формирует HTTP-ответ с JSON телом.
//
// Параметры:
//  КодСостояния - Число - HTTP-код (200, 400, 404, 500).
//  Данные - Структура - данные для сериализации.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - ответ сервиса.
//
Функция СформироватьОтветJSON(КодСостояния, Данные)
	
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	
	Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	
	Возврат Ответ;
	
КонецФункции

// Формирует ответ с ошибкой.
//
// Параметры:
//  КодСостояния - Число - HTTP-код ошибки.
//  Сообщение - Строка - текст ошибки.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - ответ с ошибкой.
//
Функция СформироватьОтветОшибки(КодСостояния, Сообщение)
	
	Данные = Новый Структура;
	Данные.Вставить("success", Ложь);
	Данные.Вставить("error", Сообщение);
	
	Возврат СформироватьОтветJSON(КодСостояния, Данные);
	
КонецФункции

#КонецОбласти
