
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Инициализация не требуется
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Подключаем сканер штрихкодов
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(Неопределено, ЭтотОбъект, "СканерШтрихкода");
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	// Отключение выполняется платформой автоматически
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	// БПО: события от сканера штрихкодов
	Если ИмяСобытия = "ScanData" И Источник = "ПодключаемоеОборудование" Тогда

		Если ТипЗнч(Параметр) = Тип("Структура") И Параметр.Свойство("Штрихкод") Тогда
			ОбработкаШтрихкода(Параметр.Штрихкод);
		ИначеЕсли ТипЗнч(Параметр) = Тип("Массив") И Параметр.Количество() > 0 Тогда
			ОбработкаШтрихкода(Параметр[0]);
		Иначе
			Возврат;
		КонецЕсли;

	ИначеЕсли ИмяСобытия = "СканерШтрихкод" Тогда
		// Прямое событие сканера
		ОбработкаШтрихкода(Параметр);
	Иначе
		Возврат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СканированиеИПоиск

&НаКлиенте
Процедура ОбработкаШтрихкода(Штрихкод)
	// Запускает поиск по штрихкоду:
	// - 1 товар: открывает форму элемента
	// - Несколько товаров: показывает диалог выбора (как в РМК)
	// - Не найден: показывает предупреждение

	Если ПустаяСтрока(Штрихкод) Тогда
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ОбработкаПоискаЗавершение", ЭтотОбъект);
	ОбщегоНазначенияКлиент.НайтиИОбработатьТовар(Штрихкод, Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаПоискаЗавершение(Результат, ДопПараметры) Экспорт
	// Открывает форму найденного или выбранного элемента номенклатуры

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПараметрыОткрытия = Новый Структура("Ключ", Результат);
	ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента", ПараметрыОткрытия, ЭтотОбъект);

КонецПроцедуры

#КонецОбласти
