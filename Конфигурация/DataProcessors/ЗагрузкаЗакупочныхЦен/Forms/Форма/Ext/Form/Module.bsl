&НаКлиенте
Процедура ВыбратьФайл(Команда)
	// Диалог выбора файла xlsx
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВыбораФайла", ЭтотОбъект);
	НачатьПомещениеФайла(ОписаниеОповещения, , , Истина,
		ЭтотОбъект.УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораФайла(Результат, АдресХранилища, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	Если НЕ Результат Тогда
		Возврат;
	КонецЕсли;
	Объект.ПутьКФайлу = ВыбранноеИмяФайла;
	ПрочитатьФайлНаСервере(АдресХранилища);
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьФайл(Команда)
	// Пользователь уже загрузил файл ранее, повторное чтение
	Если ПустаяСтрока(Объект.ПутьКФайлу) Тогда
		ПоказатьПредупреждение(, "Сначала выберите файл");
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаПовторногоЧтения", ЭтотОбъект);
	НачатьПомещениеФайла(ОписаниеОповещения, , , Истина,
		ЭтотОбъект.УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаПовторногоЧтения(Результат, АдресХранилища, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	Если НЕ Результат Тогда
		Возврат;
	КонецЕсли;
	ПрочитатьФайлНаСервере(АдресХранилища);
КонецПроцедуры

&НаСервере
Процедура ПрочитатьФайлНаСервере(Знач АдресХранилища)
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ТаблицаРезультат = ОбъектОбработки.ЗагрузитьДанныеИзФайла(АдресХранилища);
	
	ДанныеИзФайла.Очистить();
	Для Каждого СтрокаДанных Из ТаблицаРезультат Цикл
		НоваяСтрока = ДанныеИзФайла.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЦены(Команда)
	Если ДанныеИзФайла.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Нет данных для загрузки. Сначала прочитайте файл.");
		Возврат;
	КонецЕсли;
	
	РезультатЗагрузки = ЗагрузитьЦеныНаСервере();
	
	Если РезультатЗагрузки.Успешно Тогда
		ПоказатьПредупреждение(, "Загружено " + РезультатЗагрузки.Количество 
			+ " позиций. Документ Переоценка №" + РезультатЗагрузки.НомерДокумента);
	Иначе
		ПоказатьПредупреждение(, "Ошибка: " + РезультатЗагрузки.СообщениеОбОшибке);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЗагрузитьЦеныНаСервере()
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	// Конвертируем FormDataCollection в ТаблицуЗначений
	ТаблицаЗначений = Новый ТаблицаЗначений;
	ТаблицаЗначений.Колонки.Добавить("Штрихкод");
	ТаблицаЗначений.Колонки.Добавить("НаименованиеФайл");
	ТаблицаЗначений.Колонки.Добавить("Номенклатура");
	ТаблицаЗначений.Колонки.Добавить("НоменклатураНаименование");
	ТаблицаЗначений.Колонки.Добавить("ЦенаЗакупки");
	ТаблицаЗначений.Колонки.Добавить("СтараяЦена");
	ТаблицаЗначений.Колонки.Добавить("Статус");
	
	Для Каждого СтрокаФормы Из ДанныеИзФайла Цикл
		НоваяСтрока = ТаблицаЗначений.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаФормы);
	КонецЦикла;
	
	Возврат ОбъектОбработки.ЗагрузитьЦены(ТаблицаЗначений);
КонецФункции
