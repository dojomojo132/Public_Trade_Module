#Область ПрограммныйИнтерфейс

// Загружает данные из Excel-файла и возвращает таблицу значений для предпросмотра.
//
// Параметры:
//  АдресХранилища - Строка - адрес файла во временном хранилище.
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица с данными из файла.
//
Функция ЗагрузитьДанныеИзФайла(АдресХранилища) Экспорт
	
	ТабличныйДокумент = ПрочитатьExcelИзХранилища(АдресХранилища);
	
	ТаблицаДанных = СоздатьТаблицуДанных();
	
	ЗаполнитьТаблицуИзДокумента(ТабличныйДокумент, ТаблицаДанных);
	
	Если ТаблицаДанных.Количество() > 0 Тогда
		НайтиНоменклатуруПоШтрихкодам(ТаблицаДанных);
		ЗаполнитьСтарыеЦены(ТаблицаДанных);
	КонецЕсли;
	
	Возврат ТаблицаДанных;
	
КонецФункции

// Создает документ Переоценка с загруженными закупочными ценами.
//
// Параметры:
//  ТаблицаДанных - ТаблицаЗначений - данные из ЗагрузитьДанныеИзФайла().
//
// Возвращаемое значение:
//  Структура - результат загрузки:
//    * Успешно - Булево
//    * Количество - Число
//    * НомерДокумента - Строка
//    * СообщениеОбОшибке - Строка
//
Функция ЗагрузитьЦены(ТаблицаДанных) Экспорт
	
	Результат = Новый Структура("Успешно, Количество, НомерДокумента, СообщениеОбОшибке", Ложь, 0, "", "");
	
	ТипЦенЗакупочная = ПолучитьТипЦенЗакупочная();
	Если ТипЦенЗакупочная.Пустая() Тогда
		Результат.СообщениеОбОшибке = "Не найден тип цен 'Закупочная'";
		Возврат Результат;
	КонецЕсли;
	
	СоответствиеНоменклатуры = ПодготовитьДанныеДляЗагрузки(ТаблицаДанных);
	
	Если СоответствиеНоменклатуры.Количество() = 0 Тогда
		Результат.СообщениеОбОшибке = "Нет данных для загрузки";
		Возврат Результат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		ДокументОбъект = Документы.Переоценка.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		ДокументОбъект.ТипЦен = ТипЦенЗакупочная;
		
		Для Каждого КлючЗначение Из СоответствиеНоменклатуры Цикл
			Данные = КлючЗначение.Значение;
			НоваяСтрока = ДокументОбъект.Товары.Добавить();
			НоваяСтрока.Номенклатура = Данные.Номенклатура;
			НоваяСтрока.Цена = Данные.ЦенаЗакупки;
			НоваяСтрока.Штрихкод = Данные.Штрихкод;
			НоваяСтрока.СтараяЦена = Данные.СтараяЦена;
		КонецЦикла;
		
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
		Результат.Успешно = Истина;
		Результат.Количество = СоответствиеНоменклатуры.Количество();
		Результат.НомерДокумента = ДокументОбъект.Номер;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат.СообщениеОбОшибке = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьExcelИзХранилища(АдресХранилища)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
	УдалитьИзВременногоХранилища(АдресХранилища);
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	ДвоичныеДанные.Записать(ИмяВременногоФайла);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ИмяВременногоФайла);
	
	УдалитьФайлы(ИмяВременногоФайла); // BSLLS:FileSystemAccess-off
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция СоздатьТаблицуДанных()
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Штрихкод", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	ТаблицаДанных.Колонки.Добавить("НаименованиеФайл", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	ТаблицаДанных.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаДанных.Колонки.Добавить("НоменклатураНаименование", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	ТаблицаДанных.Колонки.Добавить("ЦенаЗакупки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаДанных.Колонки.Добавить("СтараяЦена", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаДанных.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(30)));
	
	Возврат ТаблицаДанных;
	
КонецФункции

Процедура ЗаполнитьТаблицуИзДокумента(ТабличныйДокумент, ТаблицаДанных)
	
	ОписаниеЧисла = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
	КоличествоСтрок = ТабличныйДокумент.ВысотаТаблицы;
	
	Для НомерСтроки = 2 По КоличествоСтрок Цикл
		
		ШтрихкодЗначение = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 6).Текст);
		ЦенаТекст = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 9).Текст);
		
		Если ПустаяСтрока(ШтрихкодЗначение) ИЛИ ПустаяСтрока(ЦенаТекст) Тогда
			Продолжить;
		КонецЕсли;
		
		Цена = ОписаниеЧисла.ПривестиЗначение(СтрЗаменить(ЦенаТекст, ",", "."));
		Если Цена <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НаименованиеЗначение = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 2).Текст);
		
		НоваяСтрока = ТаблицаДанных.Добавить();
		НоваяСтрока.Штрихкод = ШтрихкодЗначение;
		НоваяСтрока.НаименованиеФайл = НаименованиеЗначение;
		НоваяСтрока.ЦенаЗакупки = Цена;
		НоваяСтрока.Статус = "Не найден";
		
	КонецЦикла;
	
КонецПроцедуры

Процедура НайтиНоменклатуруПоШтрихкодам(ТаблицаДанных)
	
	МассивШтрихкодов = ТаблицаДанных.ВыгрузитьКолонку("Штрихкод");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Штрихкоды.Штрихкод КАК Штрихкод,
		|	Штрихкоды.Номенклатура КАК Номенклатура,
		|	ЕСТЬNULL(СправочникНоменклатура.Наименование, """") КАК НоменклатураНаименование
		|ИЗ
		|	РегистрСведений.Штрихкоды КАК Штрихкоды
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
		|		ПО Штрихкоды.Номенклатура = СправочникНоменклатура.Ссылка
		|ГДЕ
		|	Штрихкоды.Штрихкод В (&МассивШтрихкодов)";
	
	Запрос.УстановитьПараметр("МассивШтрихкодов", МассивШтрихкодов);
	
	СоответствиеШтрихкодов = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СоответствиеШтрихкодов.Вставить(Выборка.Штрихкод,
			Новый Структура("Номенклатура, Наименование", Выборка.Номенклатура, Выборка.НоменклатураНаименование));
	КонецЦикла;
	
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		ДанныеШтрихкода = СоответствиеШтрихкодов.Получить(СтрокаДанных.Штрихкод);
		Если ДанныеШтрихкода = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаДанных.Номенклатура = ДанныеШтрихкода.Номенклатура;
		СтрокаДанных.НоменклатураНаименование = ДанныеШтрихкода.Наименование;
		СтрокаДанных.Статус = "Найден";
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСтарыеЦены(ТаблицаДанных)
	
	МассивНоменклатуры = Новый Массив;
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		Если СтрокаДанных.Статус <> "Найден" Тогда
			Продолжить;
		КонецЕсли;
		Если МассивНоменклатуры.Найти(СтрокаДанных.Номенклатура) = Неопределено Тогда
			МассивНоменклатуры.Добавить(СтрокаДанных.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивНоменклатуры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТипЦенЗакупочная = ПолучитьТипЦенЗакупочная();
	
	ЗапросЦен = Новый Запрос;
	ЗапросЦен.Текст =
		"ВЫБРАТЬ
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
		|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|		,
		|		ТипЦен = &ТипЦен
		|			И Номенклатура В (&МассивНоменклатуры)) КАК ЦеныНоменклатурыСрезПоследних";
	
	ЗапросЦен.УстановитьПараметр("ТипЦен", ТипЦенЗакупочная);
	ЗапросЦен.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	
	СоответствиеЦен = Новый Соответствие;
	ВыборкаЦен = ЗапросЦен.Выполнить().Выбрать();
	Пока ВыборкаЦен.Следующий() Цикл
		СоответствиеЦен.Вставить(ВыборкаЦен.Номенклатура, ВыборкаЦен.Цена);
	КонецЦикла;
	
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		Если СтрокаДанных.Статус <> "Найден" Тогда
			Продолжить;
		КонецЕсли;
		СтараяЦена = СоответствиеЦен.Получить(СтрокаДанных.Номенклатура);
		Если СтараяЦена <> Неопределено Тогда
			СтрокаДанных.СтараяЦена = СтараяЦена;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТипЦенЗакупочная()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТипыЦен.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ТипыЦен КАК ТипыЦен
		|ГДЕ
		|	ТипыЦен.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", "Закупочная");
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Справочники.ТипыЦен.ПустаяСсылка();
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;
	
КонецФункции

Функция ПодготовитьДанныеДляЗагрузки(ТаблицаДанных)
	
	СоответствиеНоменклатуры = Новый Соответствие;
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		Если СтрокаДанных.Статус = "Найден" И СтрокаДанных.ЦенаЗакупки > 0 Тогда
			СоответствиеНоменклатуры.Вставить(СтрокаДанных.Номенклатура, СтрокаДанных);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СоответствиеНоменклатуры;
	
КонецФункции

#КонецОбласти
