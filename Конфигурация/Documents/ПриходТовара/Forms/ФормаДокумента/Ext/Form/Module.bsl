#Область ОбработчикиСобытийФормы

&НаКлиенте
Асинх Процедура ПриОткрытии(Отказ)
	
	// Подключение сканера штрихкода через БПО
	ПоддерживаемыеТипы = МенеджерОборудованияКлиентСервер.ПараметрыТипыОборудования();
	ПоддерживаемыеТипы.СканерШтрихкода = Истина;
	ОповещениеПриПодключении = Новый ОписаниеОповещения("ПодключитьСканерЗавершение", ЭтотОбъект);
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПоТипу(ОповещениеПриПодключении, УникальныйИдентификатор, ПоддерживаемыеТипы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьСканерЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если Не РезультатВыполнения.Результат Тогда
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Сканер не подключен: " + РезультатВыполнения.ОписаниеОшибки;
		СообщениеПользователю.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(Завершение)
	
	// Отключение сканера при закрытии формы
	ПоддерживаемыеТипы = МенеджерОборудованияКлиентСервер.ПараметрыТипыОборудования();
	ПоддерживаемыеТипы.СканерШтрихкода = Истина;
	ОповещениеПриОтключении = Новый ОписаниеОповещения("ОтключитьСканерЗавершение", ЭтотОбъект);
	МенеджерОборудованияКлиент.НачатьОтключениеОборудованияПоТипу(ОповещениеПриОтключении, УникальныйИдентификатор, ПоддерживаемыеТипы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьСканерЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если Не РезультатВыполнения.Результат Тогда
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Ошибка отключения сканера: " + РезультатВыполнения.ОписаниеОшибки;
		СообщениеПользователю.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник = "ПодключаемоеОборудование" И ИмяСобытия = "ScanData" Тогда
		// Получен штрихкод от сканера
		Штрихкод = "";
		Если ТипЗнч(Параметр) = Тип("Структура") Тогда
			Если Параметр.Свойство("Штрихкод") Тогда
				Штрихкод = Параметр.Штрихкод;
			КонецЕсли;
		ИначеЕсли ТипЗнч(Параметр) = Тип("Массив") Тогда
			Штрихкод = Параметр[0];
		Иначе
			Штрихкод = Строка(Параметр);
		КонецЕсли;
		
		Если Не ПустаяСтрока(Штрихкод) Тогда
			ОбработатьШтрихкодСканера(Штрихкод);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	// Делегируем обработку внешних событий в БПО
	ИнтеграцияПодсистемБПОКлиент.ОбработкаВнешнегоСобытия(Источник, Событие, Данные);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработкаШтрихкодаСканера

&НаКлиенте
Асинх Процедура ОбработатьШтрихкодСканера(Штрихкод)
	
	// Поиск номенклатуры по штрихкоду
	ДанныеПоШтрихкоду = НайтиНоменклатуруИДанныеПоШтрихкоду(Штрихкод);
	
	Если ДанныеПоШтрихкоду = Неопределено Тогда
		Ждать ПредупреждениеАсинх("Товар с штрихкодом \"" + Штрихкод + "\" не найден!");
		Возврат;
	КонецЕсли;
	
	// Ищем, есть ли уже такой товар в ТЧ
	НайденнаяСтрока = Неопределено;
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		Если СтрокаТовара.Номенклатура = ДанныеПоШтрихкоду.Номенклатура Тогда
			НайденнаяСтрока = СтрокаТовара;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НайденнаяСтрока <> Неопределено Тогда
		// Товар уже есть — увеличиваем количество
		НайденнаяСтрока.Количество = НайденнаяСтрока.Количество + 1;
		НайденнаяСтрока.Сумма = НайденнаяСтрока.Цена * НайденнаяСтрока.Количество;
		Элементы.Товары.ТекущаяСтрока = НайденнаяСтрока.ПолучитьИдентификатор();
	Иначе
		// Добавляем новую строку
		НоваяСтрока = Объект.Товары.Добавить();
		НоваяСтрока.Штрихкод = Штрихкод;
		НоваяСтрока.Номенклатура = ДанныеПоШтрихкоду.Номенклатура;
		НоваяСтрока.Количество = 1;
		НоваяСтрока.ЦенаРозничнаяТекущая = ДанныеПоШтрихкоду.ЦенаТекущая;
		
		// Фокус на новую строку
		Элементы.Товары.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	КонецЕсли;
	
	// Пересчитываем сумму документа
	ПересчитатьСуммуДокумента();
	
	// Звуковой сигнал
	ПодключитьОбработчикОжидания("ОповеститьОСканировании", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОповеститьОСканировании()
	Сигнал();
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуДокумента()
	
	Итого = 0;
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		Итого = Итого + СтрокаТовара.Сумма;
	КонецЦикла;
	Объект.СуммаДокумента = Итого;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиНоменклатуруИДанныеПоШтрихкоду(Штрихкод)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|\tШтрихкоды.Номенклатура КАК Номенклатура,
	|\tЕСТЬNULL(Штрихкоды.Номенклатура.ПроцентНаценки, 0) КАК ПроцентНаценки
	|ИЗ
	|\tРегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|\tШтрихкоды.Штрихкод = &Штрихкод";
	
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	// Получаем текущую цену
	Отбор = Новый Структура("Номенклатура", Выборка.Номенклатура);
	ЦеныСрез = РегистрыСведений.ЦеныНоменклатуры.ПолучитьПоследнее(ТекущаяДатаСеанса(), Отбор);
	
	Данные = Новый Структура;
	Данные.Вставить("Номенклатура", Выборка.Номенклатура);
	Данные.Вставить("ПроцентНаценки", Выборка.ПроцентНаценки);
	Данные.Вставить("ЦенаТекущая", ЦеныСрез.Цена);
	
	Возврат Данные;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// 1. Получаем данные товара с сервера (Наценка)
	ДанныеТовара = ПолучитьДанныеНоменклатуры(ТекущиеДанные.Номенклатура);
	
	// 2. Рассчитываем цену, если есть цена закупки
	Если ТекущиеДанные.Цена > 0 Тогда
		РассчитатьРозничнуюЦену(ТекущиеДанные, ДанныеТовара.ПроцентНаценки);
	КонецЕсли;
	
	// 3. Заполняем текущую розничную для сравнения
	ТекущиеДанные.ЦенаРозничнаяТекущая = ДанныеТовара.ЦенаТекущая;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ТоварыШтрихкодПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Проверка на пустой штрихкод
	Если ПустаяСтрока(ТекущиеДанные.Штрихкод) Тогда
		Возврат;
	КонецЕсли;
	
	// Поиск номенклатуры по штрихкоду
	НайденнаяНоменклатура = НайтиНоменклатуруПоШтрихкоду(ТекущиеДанные.Штрихкод);
	
	Если НайденнаяНоменклатура = Неопределено Тогда
		
		// Товар не найден - показываем предупреждение
		Ждать ПредупреждениеАсинх("Товар с штрихкодом """ + ТекущиеДанные.Штрихкод + """ не найден!");
		ТекущиеДанные.Штрихкод = "";
		Возврат;
		
	КонецЕсли;
	
	// Заполняем номенклатуру
	ТекущиеДанные.Номенклатура = НайденнаяНоменклатура;
	
	// Получаем данные товара
	ДанныеТовара = ПолучитьДанныеНоменклатуры(НайденнаяНоменклатура);
	
	// Рассчитываем розничную цену, если есть закупочная
	Если ТекущиеДанные.Цена > 0 Тогда
		РассчитатьРозничнуюЦену(ТекущиеДанные, ДанныеТовара.ПроцентНаценки);
	КонецЕсли;
	
	// Заполняем текущую розничную для сравнения
	ТекущиеДанные.ЦенаРозничнаяТекущая = ДанныеТовара.ЦенаТекущая;
	
	// Устанавливаем фокус на поле "Количество"
	//Элементы.Товары.ТекущийЭлемент = Элементы.ТоварыКоличество;	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Пересчитываем сумму строки (стандартная логика)
	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество;
	
	// 1. Получаем % наценки (чтобы не дергать сервер лишний раз, можно кэшировать, но пока так)
	ДанныеТовара = ПолучитьДанныеНоменклатуры(ТекущиеДанные.Номенклатура);
	
	// 2. Рассчитываем новую розницу
	РассчитатьРозничнуюЦену(ТекущиеДанные, ДанныеТовара.ПроцентНаценки);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьРозничнуюЦену(СтрокаТЧ, ПроцентНаценки)
	
	Если ПроцентНаценки = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Формула: Закупка * (1 + % / 100)
	РасчетнаяЦена = СтрокаТЧ.Цена * (1 + ПроцентНаценки / 100);
	
	// Округление (получаем метод округления с сервера один раз при открытии или каждый раз)
	// Для оптимизации вызовем серверную функцию без контекста
	Порядок = ПолучитьПорядокОкругления();
	
	СтрокаТЧ.ЦенаРозничнаяНовая = ОкруглитьЦену(РасчетнаяЦена, Порядок);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиНоменклатуруПоШтрихкоду(Штрихкод)
	
	// Поиск в регистре Штрихкоды
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Штрихкоды.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод = &Штрихкод";
	
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Номенклатура;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеНоменклатуры(НоменклатураСсылка)
	
	Результ = Новый Структура("ПроцентНаценки, ЦенаТекущая");
	Результ.ПроцентНаценки = 0;
	Результ.ЦенаТекущая = 0;
	
	Если НоменклатураСсылка.Пустая() Тогда
		Возврат Результ;
	КонецЕсли;
	
	// Читаем наценку из справочника
	Результ.ПроцентНаценки = НоменклатураСсылка.ПроцентНаценки;
	
	// Читаем текущую цену из регистра сведений
	Отбор = Новый Структура("Номенклатура", НоменклатураСсылка);
	Цены = РегистрыСведений.ЦеныНоменклатуры.ПолучитьПоследнее(ТекущаяДата(), Отбор);
	Результ.ЦенаТекущая = Цены.Цена;
	
	Возврат Результ;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПорядокОкругления()
	// Читаем константу
	Возврат НастройкиПоУмолчанию.ПолучитьПорядокОкругленияЦен();
КонецФункции

&НаКлиенте
Функция ОкруглитьЦену(Цена, Порядок)
	
	Если Порядок = ПредопределенноеЗначение("Перечисление.ПорядкиОкругленияЦен.Окр001") Тогда
		Возврат Окр(Цена, 2);
	ИначеЕсли Порядок = ПредопределенноеЗначение("Перечисление.ПорядкиОкругленияЦен.Окр010") Тогда
		Возврат Окр(Цена / 0.1, 0, РежимОкругления.Окр15как20) * 0.1;
	ИначеЕсли Порядок = ПредопределенноеЗначение("Перечисление.ПорядкиОкругленияЦен.Окр050") Тогда
		Возврат Окр(Цена / 0.5, 0, РежимОкругления.Окр15как20) * 0.5;
	ИначеЕсли Порядок = ПредопределенноеЗначение("Перечисление.ПорядкиОкругленияЦен.Окр100") Тогда
		Возврат Окр(Цена, 0, РежимОкругления.Окр15как20);
	ИначеЕсли Порядок = ПредопределенноеЗначение("Перечисление.ПорядкиОкругленияЦен.ОкрВБольшую") Тогда
		Возврат Цел(Цена) + ?(Цена = Цел(Цена), 0, 1);
	КонецЕсли;
	
	Возврат Цена;
	
КонецФункции

#КонецОбласти

