Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ФискальныеОстатки.Записывать = Истина;
	
	Для Каждого ТекСтрока Из Товары Цикл
		
		Если НЕ ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекСтрока.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = Движения.ФискальныеОстатки.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.ФОП = ФОП;
		Движение.Номенклатура = ТекСтрока.Номенклатура;
		Движение.Количество = ТекСтрока.Количество;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если НЕ ЗначениеЗаполнено(ФОП) Тогда
		ОбщегоНазначения.СообщитьПользователю("Укажите ФОП для фискального прихода.", , "ФОП", , Отказ);
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из Товары Цикл
		
		Если НЕ ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ТекСтрока.Номенклатура.ТребуетАкцизнуюМарку Тогда
			ТекстОшибки = "В фискальный приход можно добавлять только акцизные товары. Не подходит: "
				+ Строка(ТекСтрока.Номенклатура);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ,
				"Товары[" + Формат(ТекСтрока.НомерСтроки - 1, "ЧГ=0") + "].Номенклатура", , Отказ);
		КонецЕсли;
		
		Если ТекСтрока.Количество <= 0 Тогда
			ОбщегоНазначения.СообщитьПользователю("Количество должно быть больше нуля.",
				, "Товары[" + Формат(ТекСтрока.НомерСтроки - 1, "ЧГ=0") + "].Количество", , Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
