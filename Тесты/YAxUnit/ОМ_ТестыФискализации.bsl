#Область ПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ДобавитьТестовыйНабор("Эмулятор ПРРО — контракт драйвера")
			.ДобавитьТест("ЭмуляторПолныйЦиклПродажиНаличные")
			.ДобавитьТест("ЭмуляторПолныйЦиклПродажиБезналичные")
			.ДобавитьТест("ЭмуляторОтказБезОткрытогоЧека")
			.ДобавитьТест("ЭмуляторОтменитьЧек")
	;
	
КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ЭмуляторПолныйЦиклПродажиНаличные() Экспорт
	
	ПараметрыОборудования = Новый Структура("Ссылка, ТипДрайвера", Неопределено, Перечисления.ТипыДрайверовПРРО.Эмулятор);
	
	РезОткрытия = Эмл_ДрайверПРРО.ОткрытьЧек(ПараметрыОборудования, "Продажа");
	ЮТест.ОжидаетЧто(РезОткрытия.Успех).Равно(Истина);
	ЮТест.ОжидаетЧто(РезОткрытия.КонтекстЧека).Заполнено();
	
	ДанныеПозиции = Новый Структура;
	ДанныеПозиции.Вставить("Номенклатура", "Тестовый товар");
	ДанныеПозиции.Вставить("Количество", 2);
	ДанныеПозиции.Вставить("Цена", 100);
	ДанныеПозиции.Вставить("Сумма", 200);
	ДанныеПозиции.Вставить("АкцизнаяМарка", "");
	ДанныеПозиции.Вставить("НалоговаяГруппа", Неопределено);
	ДанныеПозиции.Вставить("КодУКТЗЕД", "");
	
	РезПозиции = Эмл_ДрайверПРРО.ДобавитьПозицию(РезОткрытия.КонтекстЧека, ДанныеПозиции);
	ЮТест.ОжидаетЧто(РезПозиции.Успех).Равно(Истина);
	
	РезЗакрытия = Эмл_ДрайверПРРО.ЗакрытьЧек(РезОткрытия.КонтекстЧека, 200, "Наличные");
	ЮТест.ОжидаетЧто(РезЗакрытия.Успех).Равно(Истина);
	ЮТест.ОжидаетЧто(РезЗакрытия.ФискальныйНомер).Содержит("EMU-CASH-");
	
КонецПроцедуры

Процедура ЭмуляторПолныйЦиклПродажиБезналичные() Экспорт
	
	ПараметрыОборудования = Новый Структура;
	РезОткрытия = Эмл_ДрайверПРРО.ОткрытьЧек(ПараметрыОборудования, "Продажа");
	
	ДанныеПозиции = Новый Структура("Номенклатура, Количество, Цена, Сумма, АкцизнаяМарка, НалоговаяГруппа, КодУКТЗЕД",
		"Товар", 1, 50, 50, "", Неопределено, "");
	
	Эмл_ДрайверПРРО.ДобавитьПозицию(РезОткрытия.КонтекстЧека, ДанныеПозиции);
	РезЗакрытия = Эмл_ДрайверПРРО.ЗакрытьЧек(РезОткрытия.КонтекстЧека, 50, "Безналичные");
	
	ЮТест.ОжидаетЧто(РезЗакрытия.Успех).Равно(Истина);
	ЮТест.ОжидаетЧто(РезЗакрытия.ФискальныйНомер).Содержит("EMU-CARD-");
	
КонецПроцедуры

Процедура ЭмуляторОтказБезОткрытогоЧека() Экспорт
	
	РезПозиции = Эмл_ДрайверПРРО.ДобавитьПозицию(Неопределено, Новый Структура);
	ЮТест.ОжидаетЧто(РезПозиции.Успех).Равно(Ложь);
	
	РезЗакрытия = Эмл_ДрайверПРРО.ЗакрытьЧек(Неопределено, 100, "Наличные");
	ЮТест.ОжидаетЧто(РезЗакрытия.Успех).Равно(Ложь);
	
КонецПроцедуры

Процедура ЭмуляторОтменитьЧек() Экспорт
	
	РезОткрытия = Эмл_ДрайверПРРО.ОткрытьЧек(Новый Структура, "Продажа");
	РезОтмены = Эмл_ДрайверПРРО.ОтменитьЧек(РезОткрытия.КонтекстЧека);
	
	ЮТест.ОжидаетЧто(РезОтмены.Успех).Равно(Истина);
	ЮТест.ОжидаетЧто(РезОткрытия.КонтекстЧека.Открыт).Равно(Ложь);
	
КонецПроцедуры

#КонецОбласти
