// Тест 4.1: Чек пробит (фискальный режим) → Статус = Пробит
Процедура НовыйЧекПолучаетСтатусПробит() Экспорт
	
	// Arrange
	Касса   = ПолучитьТестовуюКассу();
	Смена   = СоздатьКассовуюСмену(Касса);
	Товар   = ПолучитьТестовыйТовар();
	Склад   = ПолучитьТестовыйСклад();
	
	// Act: создать чек с фискальным статусом
	Чек = СоздатьЧекККМ(Касса, Смена.Ссылка, Склад, Товар, 1, 100,
		Перечисления.СтатусыЧекаККМ.Пробит);
	
	// Assert
	ЮТест.ОжидаетЧто(Чек.Статус).ЧтоОписываетКак("Статус ЧекаККМ").
		Равно(Перечисления.СтатусыЧекаККМ.Пробит);
	ЮТест.ОжидаетЧто(Чек.Проведен).ЧтоОписываетКак("ЧекККМ должен быть проведён").Истинно();
	
	// Cleanup
	ОтменитьДанные(Чек);
	ОтменитьДанные(Смена);
	
КонецПроцедуры

