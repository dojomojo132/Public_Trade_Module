// Тест 1.3: Создание новой смены → Статус = Открыта
Процедура СозданиеСменыУстанавливаетСтатусОткрыта() Экспорт
	
	// Arrange: получить первую кассу
	Касса = ПолучитьТестовуюКассу();
	ЮТест.ОжидаетЧто(Не Касса.Пустая()).ЧтоОписываетКак("Не найдена ни одна касса в ИБ").Истинно();
	
	// Act: создать смену
	НовийЧек = СоздатьКассовуюСмену(Касса);
	
	// Assert
	ЮТест.ОжидаетЧто(НовийЧек.Статус).ЧтоОписываетКак("Статус смены").
		Равно(Перечисления.СтатусыКассовойСмены.Открыта);
	ЮТест.ОжидаетЧто(НовийЧек.Проведен).ЧтоОписываетКак("Смена должна быть проведена").Истинно();
	
	// Cleanup
	ОтменитьДанные(НовийЧек);
	
КонецПроцедуры

// Тест 1.5: Закрытие смены → Статус = Закрыта, ДатаОкончания заполнена
Процедура ЗакрытиеСменыУстанавливаетСтатусЗакрыта() Экспорт
	
	// Arrange
	Касса = ПолучитьТестовуюКассу();
	Смена = СоздатьКассовуюСмену(Касса);
	
	// Act: закрыть смену
	СменаОбъект = Смена.Ссылка.ПолучитьОбъект();
	СменаОбъект.ЗакрытьСмену();
	
	// Assert
	СменаЗакрытая = Смена.Ссылка.ПолучитьОбъект();
	ЮТест.ОжидаетЧто(СменаЗакрытая.Статус).ЧтоОписываетКак("Статус смены после закрытия").
		Равно(Перечисления.СтатусыКассовойСмены.Закрыта);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(СменаЗакрытая.ДатаОкончания)).
		ЧтоОписываетКак("ДатаОкончания должна быть заполнена").Истинно();
	
	// Cleanup
	ОтменитьДанные(Смена);
	
КонецПроцедуры

// Тест: Закрытие уже закрытой смены → исключение
Процедура ЗакрытиеУжеЗакрытойСменыВызываетИсключение() Экспорт
	
	// Arrange
	Касса = ПолучитьТестовуюКассу();
	Смена = СоздатьКассовуюСмену(Касса);
	
	// Закрыть первый раз
	СменаОбъект = Смена.Ссылка.ПолучитьОбъект();
	СменаОбъект.ЗакрытьСмену();
	
	// Act + Assert: повторное закрытие должно вызвать исключение
	Попытка
		СменаОбъект2 = Смена.Ссылка.ПолучитьОбъект();
		СменаОбъект2.ЗакрытьСмену();
		ЮТест.Ошибка("Ожидалось исключение при повторном закрытии смены");
	Исключение
		// Ожидаемое поведение — исключение должно быть
		ЮТест.ОжидаетЧто(ОписаниеОшибки()).НеПусто();
	КонецПопытки;
	
	// Cleanup
	ОтменитьДанные(Смена);

КонецПроцедуры

#КонецОбласти

