// Тест 2.7: Сумма строки = Количество × Цена
Процедура ПересчётСуммыСтрокиПриИзмененииКоличества() Экспорт
	
	// Invoke: проверяем математику (без записи в ИБ)
	Цена = 99.5;
	Количество = 3;
	ОжидаемаяСумма = 298.5;
	
	ФактическаяСумма = Цена * Количество;
	ЮТест.ОжидаетЧто(ФактическаяСумма).ЧтоОписываетКак("Сумма = Цена × Количество").
		Равно(ОжидаемаяСумма);
	
КонецПроцедуры

// Тест 2.9: Итог после удаления строки пересчитывается
Процедура ИтогПересчитываетсяПриУдаленииСтроки() Экспорт
	
	// Arrange: таблица значений как ТЧ
	ТЧ = Новый ТаблицаЗначений;
	ТЧ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ТЧ.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
	ТЧ.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	
	Стр1 = ТЧ.Добавить();
	Стр1.Количество = 2; Стр1.Цена = 100; Стр1.Сумма = 200;
	
	Стр2 = ТЧ.Добавить();
	Стр2.Количество = 1; Стр2.Цена = 50;  Стр2.Сумма = 50;
	
	// Act: удалить строку 2
	ТЧ.Удалить(Стр2);
	
	// Assert: итог = 200
	Итог = 0;
	Для Каждого Стр Из ТЧ Цикл
		Итог = Итог + Стр.Сумма;
	КонецЦикла;
	
	ЮТест.ОжидаетЧто(Итог).ЧтоОписываетКак("Итог после удаления строки").Равно(200);
	
КонецПроцедуры

#КонецОбласти

