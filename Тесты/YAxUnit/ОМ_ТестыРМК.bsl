// Тест 5.1 + 5.4: Возврат создаёт ВозвратТовараОтПокупателя
Процедура ВозвратСозданДокументВозврата() Экспорт
	
	// Arrange: создать чек-основание
	Касса = ПолучитьТестовуюКассу();
	Смена = СоздатьКассовуюСмену(Касса);
	Товар = ПолучитьТестовыйТовар();
	Склад = ПолучитьТестовыйСклад();
	
	ЧекОснование = СоздатьЧекККМ(Касса, Смена.Ссылка, Склад, Товар, 1, 100,
		Перечисления.СтатусыЧекаККМ.НеФискальный);
	
	// Act: оформить возврат
	Возврат = Документы.ВозвратТовараОтПокупателя.СоздатьДокумент();
	Возврат.Дата = ТекущаяДатаСеанса();
	Возврат.Склад = Склад;
	Возврат.Касса = Касса;
	Возврат.ДокументОснование = ЧекОснование.Ссылка;
	
	Стр = Возврат.Товары.Добавить();
	Стр.Номенклатура = Товар;
	Стр.Количество = 1;
	Стр.Цена = 100;
	Стр.Сумма = 100;
	
	Возврат.Записать(РежимЗаписиДокумента.Проведение);
	
	// Assert
	ЮТест.ОжидаетЧто(Возврат.Проведен).ЧтоОписываетКак("Документ возврата проведён").Истинно();
	ЮТест.ОжидаетЧто(Возврат.ДокументОснование).ЧтоОписываетКак("Ссылка на чек-основание").
		Равно(ЧекОснование.Ссылка);
	
	// Cleanup
	ОтменитьДанные(Возврат);
	ОтменитьДанные(ЧекОснование);
	ОтменитьДанные(Смена);
	
КонецПроцедуры

// Тест 5.4: Движения регистра при возврате со знаком минус (сторно)
Процедура ДвиженияРегистраПриВозвратеСторно() Экспорт
	
	// Arrange
	Касса = ПолучитьТестовуюКассу();
	Смена = СоздатьКассовуюСмену(Касса);
	Товар = ПолучитьТестовыйТовар();
	Склад = ПолучитьТестовыйСклад();
	
	ЧекОснование = СоздатьЧекККМ(Касса, Смена.Ссылка, Склад, Товар, 2, 100,
		Перечисления.СтатусыЧекаККМ.НеФискальный);
	
	Возврат = Документы.ВозвратТовараОтПокупателя.СоздатьДокумент();
	Возврат.Дата = ТекущаяДатаСеанса();
	Возврат.Склад = Склад;
	Возврат.Касса = Касса;
	
	Стр = Возврат.Товары.Добавить();
	Стр.Номенклатура = Товар;
	Стр.Количество = 2;
	Стр.Цена = 100;
	Стр.Сумма = 200;
	Возврат.Записать(РежимЗаписиДокумента.Проведение);
	
	// Assert: движения должны быть с видом расход (сторно продажи)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Кол
		|ИЗ РегистрНакопления.Продажи
		|ГДЕ Регистратор = &Рег И ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)";
	Запрос.УстановитьПараметр("Рег", Возврат.Ссылка);
	
	КолВо = Запрос.Выполнить().Выгрузить()[0]["Кол"];
	ЮТест.ОжидаетЧто(КолВо > 0).ЧтоОписываетКак("Движения возврата должны быть расходными").Истинно();
	
	// Cleanup
	ОтменитьДанные(Возврат);
	ОтменитьДанные(ЧекОснование);
	ОтменитьДанные(Смена);
	
КонецПроцедуры

#КонецОбласти

