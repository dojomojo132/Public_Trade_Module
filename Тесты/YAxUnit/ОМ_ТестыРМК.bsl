// Тест 4.10: СуммаДокумента = сумма строк ТЧ
Процедура СуммаДокументаРавнаСуммеСтрок() Экспорт
	
	// Arrange
	Касса = ПолучитьТестовуюКассу();
	Смена = СоздатьКассовуюСмену(Касса);
	Товар = ПолучитьТестовыйТовар();
	Склад = ПолучитьТестовыйСклад();
	
	// Act: чек с 2 строками
	Чек = Документы.ЧекККМ.СоздатьДокумент();
	Чек.Дата = ТекущаяДатаСеанса();
	Чек.Касса = Касса;
	Чек.КассоваяСмена = Смена.Ссылка;
	Чек.Склад = Склад;
	Чек.Статус = Перечисления.СтатусыЧекаККМ.НеФискальный;
	
	Стр1 = Чек.Товары.Добавить();
	Стр1.Номенклатура = Товар;
	Стр1.Количество = 2;
	Стр1.Цена = 100;
	Стр1.Сумма = 200;
	
	Стр2 = Чек.Товары.Добавить();
	Стр2.Номенклатура = Товар;
	Стр2.Количество = 1;
	Стр2.Цена = 50;
	Стр2.Сумма = 50;
	
	ОжидаемаяСумма = 250;
	Чек.СуммаДокумента = Стр1.Сумма + Стр2.Сумма;
	
	Оплата = Чек.Оплата.Добавить();
	Оплата.КассаОплаты = Касса;
	Оплата.Сумма = ОжидаемаяСумма;
	Оплата.ВидОплаты = Перечисления.ВидыОплаты.Наличные;
	
	Чек.Записать(РежимЗаписиДокумента.Проведение);
	
	// Assert
	ЮТест.ОжидаетЧто(Чек.СуммаДокумента).ЧтоОписываетКак("СуммаДокумента").Равно(250);
	
	// Cleanup
	ОтменитьДанные(Чек);
	ОтменитьДанные(Смена);
	
КонецПроцедуры

// Тест 4.9: Оформление пустого ТЧ должно не создавать чек
Процедура ОформлениеПустогоЧекаВозвращаетЛожь() Экспорт
	
	// Arrange: пустая ТЧ (нет строк)
	Касса = ПолучитьТестовуюКассу();
	Смена = СоздатьКассовуюСмену(Касса);
	Склад = ПолучитьТестовыйСклад();
	
	// Act: попытка создать чек без товаров
	Попытка
		Чек = Документы.ЧекККМ.СоздатьДокумент();
		Чек.Дата = ТекущаяДатаСеанса();
		Чек.Касса = Касса;
		Чек.КассоваяСмена = Смена.Ссылка;
		Чек.Склад = Склад;
		Чек.Статус = Перечисления.СтатусыЧекаККМ.НеФискальный;
		Чек.СуммаДокумента = 0;
		Чек.Записать(РежимЗаписиДокумента.Проведение);
		
		// Если провёлся — это ожидаемо на уровне платформы (пустой документ).
		// Бизнес-проверка: кол-во строк = 0 → РМК должен был не допустить
		ЮТест.ОжидаетЧто(Чек.Товары.Количество()).ЧтоОписываетКак("Чек без товаров: строк = 0").Равно(0);
		
		ОтменитьДанные(Чек);
	Исключение
		// Платформа не разрешила — тоже допустимо
	КонецПопытки;
	
	// Cleanup
	ОтменитьДанные(Смена);
	
КонецПроцедуры

// Тест 4.6: Движения регистра Продажи созданы при проведении
Процедура ДвиженияРегистраПродажиСозданы() Экспорт
	
	// Arrange
	Касса = ПолучитьТестовуюКассу();
	Смена = СоздатьКассовуюСмену(Касса);
	Товар = ПолучитьТестовыйТовар();
	Склад = ПолучитьТестовыйСклад();
	
	// Act
	Чек = СоздатьЧекККМ(Касса, Смена.Ссылка, Склад, Товар, 2, 100,
		Перечисления.СтатусыЧекаККМ.НеФискальный);
	
	// Assert: проверяем наличие движений по регистру Продажи
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Кол
		|ИЗ РегистрНакопления.Продажи
		|ГДЕ Регистратор = &Чек";
	Запрос.УстановитьПараметр("Чек", Чек.Ссылка);
	
	КолВо = Запрос.Выполнить().Выгрузить()[0]["Кол"];
	ЮТест.ОжидаетЧто(КолВо > 0).ЧтоОписываетКак("Должны быть движения регистра Продажи").Истинно();
	
	// Cleanup
	ОтменитьДанные(Чек);
	ОтменитьДанные(Смена);
	
КонецПроцедуры

#КонецОбласти

