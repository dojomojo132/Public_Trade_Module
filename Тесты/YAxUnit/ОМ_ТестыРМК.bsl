// Получить тестовую кассу (первая попавшаяся)
Функция ПолучитьТестовуюКассу()
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Кассы ГДЕ НЕ ПометкаУдаления");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	ЮТест.Ошибка("В ИБ нет ни одной кассы! Заполните тестовые данные.");
	Возврат Справочники.Кассы.ПустаяСсылка();
КонецФункции

// Получить тестовый товар (первая номенклатура без пометки удаления)
Функция ПолучитьТестовыйТовар()
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Номенклатура ГДЕ НЕ ПометкаУдаления И НЕ ЭтоГруппа");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	ЮТест.Ошибка("В ИБ нет ни одной номенклатуры!");
	Возврат Справочники.Номенклатура.ПустаяСсылка();
КонецФункции

// Получить тестовый склад
Функция ПолучитьТестовыйСклад()
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Склады ГДЕ НЕ ПометкаУдаления");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	ЮТест.Ошибка("В ИБ нет ни одного склада!");
	Возврат Справочники.Склады.ПустаяСсылка();
КонецФункции

// Создать и провести кассовую смену
Функция СоздатьКассовуюСмену(Касса)
	НачатьТранзакцию();
	Попытка
		Смена = Документы.КассоваяСмена.СоздатьДокумент();
		Смена.Дата        = ТекущаяДатаСеанса();
		Смена.ДатаНачала  = ТекущаяДатаСеанса();
		Смена.Статус      = Перечисления.СтатусыКассовойСмены.Открыта;
		Смена.Записать(РежимЗаписиДокумента.Проведение);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение "СоздатьКассовуюСмену: " + ОписаниеОшибки();
	КонецПопытки;
	Возврат Смена;
КонецФункции

// Создать и провести ЧекККМ с одним товаром
Функция СоздатьЧекККМ(Касса, Смена, Склад, Товар, Количество, Цена, Статус)
	НачатьТранзакцию();
	Попытка
		Чек = Документы.ЧекККМ.СоздатьДокумент();
		Чек.Дата            = ТекущаяДатаСеанса();
		Чек.Касса           = Касса;
		Чек.КассоваяСмена   = Смена;
		Чек.Склад           = Склад;
		Чек.Статус          = Статус;
		
		Стр = Чек.Товары.Добавить();
		Стр.Номенклатура = Товар;
		Стр.Количество   = Количество;
		Стр.Цена         = Цена;
		Стр.Сумма        = Количество * Цена;
		
		Чек.СуммаДокумента = Стр.Сумма;
		
		Оплата = Чек.Оплата.Добавить();
		Оплата.КассаОплаты = Касса;
		Оплата.Сумма       = Стр.Сумма;
		Оплата.ВидОплаты   = Перечисления.ВидыОплаты.Наличные;
		
		Чек.Записать(РежимЗаписиДокумента.Проведение);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение "СоздатьЧекККМ: " + ОписаниеОшибки();
	КонецПопытки;
	Возврат Чек;
КонецФункции

// Откатить проведение и удалить тестовый документ
Процедура ОтменитьДанные(Объект)
	Попытка
		ОбъектДляУдаления = Объект.Ссылка.ПолучитьОбъект();
		Если ОбъектДляУдаления = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Если ОбъектДляУдаления.Проведен Тогда
			ОбъектДляУдаления.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
		ОбъектДляУдаления.УстановитьПометкуУдаления(Истина);
	Исключение
		// Ошибка очистки — не критична
	КонецПопытки;
КонецПроцедуры

#КонецОбласти
