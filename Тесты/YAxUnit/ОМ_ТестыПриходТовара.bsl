// =============================================================================
// Шаблон тестового модуля YAxUnit для документа ПриходТовара
// Общий модуль: ОМ_ТестыПриходТовара (Сервер, ВызовСервера)
// 
// СТРУКТУРА ПриходТовара (из MCP):
//   Реквизиты: Контрагент, Склад, СуммаДокумента, ВходящийНомер
//   ТЧ Товары: Номенклатура, Количество, Цена, Сумма,
//              ЦенаРозничнаяТекущая, ЦенаРозничнаяНовая, Штрихкод
//   Регистры: ОстаткиТоваров (+приход), Взаиморасчеты (+приход)
// =============================================================================

#Область ПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ДобавитьТестовыйНабор("Проведение ПриходТовара — движения")
			.ДобавитьТест("ПроведениеСоздаётПриходОстатков")
			.ДобавитьТест("ПроведениеСоздаётДвиженияВзаиморасчётов")
			.ДобавитьТест("ПроведениеНесколькихТоваровСоздаётНесколькоДвижений")
		.ДобавитьТестовыйНабор("Валидация ПриходТовара")
			.ДобавитьТест("ПриходБезТоваровНеПроводится")
			.ДобавитьТест("ПриходБезСкладаНеПроводится")
			.ДобавитьТест("ПриходБезКонтрагентаНеПроводится")
		.ДобавитьТестовыйНабор("Розничные цены")
			.ДобавитьТест("ПриходСНовойЦенойОбновляетРозничнуюЦену")
	;
	
КонецПроцедуры

#КонецОбласти

#Область Тесты

// --- НАБОР: Проведение ---

Процедура ПроведениеСоздаётПриходОстатков() Экспорт
	
	Данные = ПодготовитьДанныеПрихода();
	Ссылка = СоздатьИПровестиПриход(Данные);
	
	// Проверяем движение по ОстаткиТоваров (приход)
	Движения = ЮТЗапросы.ЗаписиРегистра("РегистрНакопления.ОстаткиТоваров", Ссылка);
	ЮТест.ОжидаетЧто(Движения).Заполнено().ИмеетДлину(1);
	
	Движение = Движения[0];
	ЮТест.ОжидаетЧто(Движение.ВидДвижения).Равно(ВидДвиженияНакопления.Приход);
	ЮТест.ОжидаетЧто(Движение.Номенклатура).Равно(Данные.Товар);
	ЮТест.ОжидаетЧто(Движение.Склад).Равно(Данные.Склад);
	ЮТест.ОжидаетЧто(Движение.Количество).Равно(10);
	
КонецПроцедуры

Процедура ПроведениеСоздаётДвиженияВзаиморасчётов() Экспорт
	
	Данные = ПодготовитьДанныеПрихода();
	Ссылка = СоздатьИПровестиПриход(Данные);
	
	// Проверяем движение по Взаиморасчеты (приход — задолженность контрагенту)
	Движения = ЮТЗапросы.ЗаписиРегистра("РегистрНакопления.Взаиморасчеты", Ссылка);
	ЮТест.ОжидаетЧто(Движения).Заполнено();
	
	Движение = Движения[0];
	ЮТест.ОжидаетЧто(Движение.Контрагент).Равно(Данные.Контрагент);
	ЮТест.ОжидаетЧто(Движение.Сумма).Равно(1000);
	
КонецПроцедуры

Процедура ПроведениеНесколькихТоваровСоздаётНесколькоДвижений() Экспорт
	
	Данные = ПодготовитьДанныеПрихода();
	
	// Второй товар
	Товар2 = ЮТест.Данные().СоздатьЭлемент("Справочники.Номенклатура",
		Новый Структура("Наименование", "Тестовый товар 2"));
	Данные.Вставить("Товар2", Товар2);
	Данные.Вставить("ДваТовара", Истина);
	
	Ссылка = СоздатьИПровестиПриход(Данные);
	
	Движения = ЮТЗапросы.ЗаписиРегистра("РегистрНакопления.ОстаткиТоваров", Ссылка);
	ЮТест.ОжидаетЧто(Движения).ИмеетДлину(2);
	
КонецПроцедуры

// --- НАБОР: Валидация ---

Процедура ПриходБезТоваровНеПроводится() Экспорт
	
	Данные = ПодготовитьДанныеПрихода();
	Данные.Вставить("БезТоваров", Истина);
	
	ЮТест.ОжидаетЧто(
		ЮТест.ВыполнитьСПерехватомИсключения("СоздатьИПровестиПриход", ЭтотОбъект, Данные))
		.ИмеетТип("Строка")
		.Заполнено();
	
КонецПроцедуры

Процедура ПриходБезСкладаНеПроводится() Экспорт
	
	Данные = ПодготовитьДанныеПрихода();
	Данные.Вставить("Склад", Справочники.Склады.ПустаяСсылка());
	
	ЮТест.ОжидаетЧто(
		ЮТест.ВыполнитьСПерехватомИсключения("СоздатьИПровестиПриход", ЭтотОбъект, Данные))
		.ИмеетТип("Строка")
		.Заполнено();
	
КонецПроцедуры

Процедура ПриходБезКонтрагентаНеПроводится() Экспорт
	
	Данные = ПодготовитьДанныеПрихода();
	Данные.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	
	ЮТест.ОжидаетЧто(
		ЮТест.ВыполнитьСПерехватомИсключения("СоздатьИПровестиПриход", ЭтотОбъект, Данные))
		.ИмеетТип("Строка")
		.Заполнено();
	
КонецПроцедуры

// --- НАБОР: Розничные цены ---

Процедура ПриходСНовойЦенойОбновляетРозничнуюЦену() Экспорт
	
	// TODO: Реализовать после уточнения механизма обновления цен
	// Этот тест проверит, что при заполнении ЦенаРозничнаяНовая
	// создаётся документ Переоценка или обновляется регистр цен
	
	ЮТест.Пропустить("Требуется уточнение бизнес-логики переоценки");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПодготовитьДанныеПрихода()
	
	Склад = ЮТест.Данные().СоздатьЭлемент("Справочники.Склады",
		Новый Структура("Наименование", "Тестовый склад прихода"));
	
	Товар = ЮТест.Данные().СоздатьЭлемент("Справочники.Номенклатура",
		Новый Структура("Наименование", "Тестовый товар прихода"));
	
	Контрагент = ЮТест.Данные().СоздатьЭлемент("Справочники.Контрагенты",
		Новый Структура("Наименование", "Тестовый поставщик"));
	
	Результат = Новый Структура;
	Результат.Вставить("Склад", Склад);
	Результат.Вставить("Товар", Товар);
	Результат.Вставить("Контрагент", Контрагент);
	Результат.Вставить("Количество", 10);
	Результат.Вставить("Цена", 100);
	Результат.Вставить("Сумма", 1000);
	Результат.Вставить("БезТоваров", Ложь);
	Результат.Вставить("ДваТовара", Ложь);
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьИПровестиПриход(Данные) Экспорт
	
	Конструктор = ЮТест.Данные().КонструкторОбъекта("Документы.ПриходТовара")
		.Установить("Дата", ТекущаяДатаСеанса())
		.Установить("Склад", Данные.Склад)
		.Установить("Контрагент", Данные.Контрагент);
	
	Если Не Данные.БезТоваров Тогда
		Конструктор
			.ТабличнаяЧасть("Товары")
				.ДобавитьСтроку()
				.Установить("Номенклатура", Данные.Товар)
				.Установить("Количество", Данные.Количество)
				.Установить("Цена", Данные.Цена)
				.Установить("Сумма", Данные.Сумма);
		
		Если Данные.Свойство("ДваТовара") И Данные.ДваТовара Тогда
			Конструктор
				.ДобавитьСтроку()
				.Установить("Номенклатура", Данные.Товар2)
				.Установить("Количество", 5)
				.Установить("Цена", 200)
				.Установить("Сумма", 1000);
		КонецЕсли;
	КонецЕсли;
	
	Ссылка = Конструктор.Записать();
	Возврат Ссылка;
	
КонецФункции

#КонецОбласти
