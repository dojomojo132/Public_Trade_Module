// =============================================================================
// Шаблон дымовых тестов YAxUnit — проверка открытия всех форм PTM
// Общий модуль: ОМ_ДымовыеТестыPTM (Сервер, ВызовСервера)
//
// Дымовые тесты — самый простой и полезный тип тестов:
//   - Проверяют что все формы открываются без ошибок
//   - Ловят 90% ошибок деплоя
//   - Время выполнения: ~1-2 минуты
//
// ПРИМЕЧАНИЕ: YAxUnit имеет встроенный генератор дымовых тестов.
// Этот модуль — ручная альтернатива для точного контроля.
// =============================================================================

#Область ПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ДобавитьТестовыйНабор("Дымовые: формы документов")
			.ДобавитьТест("ФормаЧекККМОткрывается")
			.ДобавитьТест("ФормаПриходТовараОткрывается")
			.ДобавитьТест("ФормаКассовойСменыОткрывается")
			.ДобавитьТест("ФормаПереоценкиОткрывается")
			.ДобавитьТест("ФормаСписанияТовараОткрывается")
			.ДобавитьТест("ФормаВозвратаТовараОткрывается")
			.ДобавитьТест("ФормаИнвентаризацииОткрывается")
			.ДобавитьТест("ФормаПКООткрывается")
			.ДобавитьТест("ФормаРКООткрывается")
		.ДобавитьТестовыйНабор("Дымовые: формы справочников")
			.ДобавитьТест("ФормаНоменклатурыОткрывается")
			.ДобавитьТест("ФормаКонтрагентовОткрывается")
			.ДобавитьТест("ФормаСкладовОткрывается")
			.ДобавитьТест("ФормаКассОткрывается")
			.ДобавитьТест("ФормаДисконтныхКартОткрывается")
			.ДобавитьТест("ФормаПользователейОткрывается")
		.ДобавитьТестовыйНабор("Дымовые: формы списков")
			.ДобавитьТест("ФормаСпискаЧековОткрывается")
			.ДобавитьТест("ФормаСпискаПриходовОткрывается")
			.ДобавитьТест("ФормаСпискаНоменклатурыОткрывается")
	;
	
КонецПроцедуры

#КонецОбласти

#Область Тесты

