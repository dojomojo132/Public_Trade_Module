#Область СлужебныеПроцедурыИФункции

// Универсальная проверка открытия формы
// Если форма не существует или падает при открытии — тест провалится
Процедура ПроверитьОткрытиеФормы(ИмяФормы)
	
	Попытка
		// Получаем форму на сервере (без открытия на клиенте)
		Форма = ПолучитьФорму(ИмяФормы);
		ЮТест.ОжидаетЧто(Форма).НеРавно(Неопределено);
	Исключение
		// Если форма не существует или падает — провалить тест
		ЮТест.Провалить("Форма не открывается: " + ИмяФормы
			+ Символы.ПС + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти
