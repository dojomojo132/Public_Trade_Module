&НаКлиенте
Процедура ПолучитьВерсиюДрайвераЗавершение(Результат, Контекст) Экспорт
	
	Если Результат.Результат Тогда
		
		ТекстСообщения = "";
		ОписаниеДрайвера = Результат.ОписаниеДрайвера;
		Если НЕ ПустаяСтрока(ОписаниеДрайвера.РевизияИнтерфейса) Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Ревизия драйвера: %1'"), ОписаниеДрайвера.РевизияИнтерфейса) + Символы.ПС;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ОписаниеДрайвера.ВерсияДрайвера) Тогда
			ТекстСообщения = ТекстСообщения + СтрШаблон(НСтр("ru = 'Версия драйвера установленная: %1'"), ОписаниеДрайвера.ВерсияДрайвера) + Символы.ПС;
		КонецЕсли;
		
	Иначе
		
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Ошибка получения описания драйвера: %1'"), Результат.ОписаниеОшибки);
		
	КонецЕсли;
	
	ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

