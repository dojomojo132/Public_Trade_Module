# Скопируйте в .env и заполните своими значениями.
# .env уже в .gitignore — токены не попадут в git.

# Telegram Bot для tg-dashboard MCP (создаётся через @BotFather)
TG_BOT_TOKEN=
# chat_id, куда слать дашборд (узнаётся через https://api.telegram.org/bot<TOKEN>/getUpdates после написания боту)
TG_CHAT_ID=
