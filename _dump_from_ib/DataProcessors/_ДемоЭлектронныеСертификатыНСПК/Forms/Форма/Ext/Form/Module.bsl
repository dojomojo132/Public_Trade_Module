&НаКлиенте
Функция ЗаполнитьПараметрыОперации();
	
	ПараметрыОперации = ЭлектронныеСертификатыНСПККлиентСервер.ПараметрыОперацииНСПК();
	ПараметрыОперации.АдресСервера = АдресСервера; 
	ПараметрыОперации.КлючДоступа = КлючДоступа;
	ПараметрыОперации.КлючКассы = КлючКассы;                
	
	ПараметрыОперации.ИнтернетПрокси.Сервер = ПроксиСервер;
	ПараметрыОперации.ИнтернетПрокси.Порт = ПроксиПорт;
	ПараметрыОперации.ИнтернетПрокси.Пользователь = ПроксиПользователь;
	ПараметрыОперации.ИнтернетПрокси.Пароль = ПроксиПароль;

	ИдентификаторЗапроса = Новый УникальныйИдентификатор();
	ПараметрыОперации.ИдентификаторЗапроса = ИдентификаторЗапроса;
	ПараметрыОперации.ИдентификаторКассы   = ИдентификаторКассы;         
	ПараметрыОперации.ПроверятьКорневыеСертификаты = ПроверятьКорневыеСертификаты;
	ПараметрыОперации.ПротоколОбмена = ПротоколОбменаФЭСНСПК;          
	
	ПараметрыОперации.ХешНомерКарты         = СокрЛП(ХешНомерКарты);    
	ПараметрыОперации.СсылкаНаПлатежныйСчет = СокрЛП(СсылкаНаПлатежныйСчет); 
	
	Возврат ПараметрыОперации;
	
КонецФункции

&НаСервере
Процедура ОбработатьРезультатНаСервере(РезультатВыполнения);
	
	Ответ.Очистить();
	
	Если РезультатВыполнения.Результат Тогда
		Сообщить(НСтр("ru='ОК'"));
		Если РезультатВыполнения.Свойство("ИдентификаторКорзины") И НЕ ПустаяСтрока(РезультатВыполнения.ИдентификаторКорзины) Тогда
			ИдентификаторКорзины = РезультатВыполнения.ИдентификаторКорзины;
		КонецЕсли;
		Если РезультатВыполнения.Свойство("СуммаСертификатами") Тогда
			СуммаСертификатами = РезультатВыполнения.СуммаСертификатами;
			СобственныеСредства = СуммаЧека - СуммаСертификатами;
		КонецЕсли;
		
		Если РезультатВыполнения.Свойство("ТоварныеПозиции") И РезультатВыполнения.ТоварныеПозиции.Количество() > 0 Тогда
			Для Каждого ТоварнаяПозиция Из РезультатВыполнения.ТоварныеПозиции Цикл
				Товар = Ответ.Добавить();       
				Если ТоварнаяПозиция.Свойство("НомерПозиции") Тогда
					Товар.НомерПозиции = ТоварнаяПозиция.НомерПозиции;
				КонецЕсли;
				Если ТоварнаяПозиция.Свойство("КодТовараТРУ") Тогда
					Товар.КодТовараТРУ = ТоварнаяПозиция.КодТовараТРУ;
				КонецЕсли;
				Если ТоварнаяПозиция.Свойство("Количество") Тогда
					Товар.Количество = ТоварнаяПозиция.Количество;
				КонецЕсли;            
				Если ТоварнаяПозиция.Свойство("БалансКоличество") Тогда
					Товар.Количество = ТоварнаяПозиция.БалансКоличество;
				КонецЕсли;            
				Если ТоварнаяПозиция.Свойство("Цена") Тогда
					Товар.Цена = ТоварнаяПозиция.Цена;
				КонецЕсли;
				Если ТоварнаяПозиция.Свойство("Сертификаты") И ТоварнаяПозиция.Сертификаты.Количество() > 0 Тогда
					Для Каждого Сертификат Из ТоварнаяПозиция.Сертификаты Цикл
						Позиция = Товар.Сертификаты.Добавить();
						ЗаполнитьЗначенияСвойств(Позиция, Сертификат);
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;                
		
		Если РезультатВыполнения.Свойство("ДоступныеСертификаты") И РезультатВыполнения.ДоступныеСертификаты.Количество() > 0 Тогда
			Для Каждого ДоступныйСертификат Из РезультатВыполнения.ДоступныеСертификаты Цикл
				Для Каждого КодТоваровТРУ  Из ДоступныйСертификат.КодыТоваровТРУ Цикл      
					Позиция = Ответ.Добавить();
					Позиция.КодТовараТРУ = КодТоваровТРУ.КодТовараТРУ;
					Позиция.Количество = КодТоваровТРУ.БалансКоличество;
					Позиция.Цена = КодТоваровТРУ.ЛимитДенежныхСредств;    
					Сертификат = Позиция.Сертификаты.Добавить();    
					Сертификат.Идентификатор = ДоступныйСертификат.Идентификатор;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;        
		
		ИдентификаторыКорзинПокупок.Очистить();
		
		Если РезультатВыполнения.Свойство("ИдентификаторыКорзинПокупок") И РезультатВыполнения.ИдентификаторыКорзинПокупок.Количество() > 0 Тогда 
			Для Каждого ИдентификаторыКорзинСтрока Из РезультатВыполнения.ИдентификаторыКорзинПокупок Цикл    
				Позиция = ИдентификаторыКорзинПокупок.Добавить();   
				ЗаполнитьЗначенияСвойств(Позиция, ИдентификаторыКорзинСтрока);
			КонецЦикла;
		КонецЕсли;        
		
	Иначе
		ОписаниеОшибки = НСтр("ru='ОШИБКА: (%1) %2'");
		ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, РезультатВыполнения.КодРезультата, РезультатВыполнения.ОписаниеОшибки); 
		Сообщить(ОписаниеОшибки);
	КонецЕсли;

КонецПроцедуры

