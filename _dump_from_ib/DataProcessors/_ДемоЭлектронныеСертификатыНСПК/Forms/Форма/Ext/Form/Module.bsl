&НаКлиенте
Процедура ПредварительноеОдобрениеИспользования(Команда)
	
	ПараметрыОперации = ЗаполнитьПараметрыОперации();
	
	СуммаЧека = 0;
	Для Каждого Товар Из ТаблицаТоваров Цикл
		СуммаЧека = СуммаЧека + Товар.Количество * Товар.Цена;
		Если Не ПустаяСтрока(Товар.КодТовараТРУ) Тогда
			ТоварнаяПозиция = ЭлектронныеСертификатыНСПККлиентСервер.ПараметрыТоварнойПозиции();
			ТоварнаяПозиция.НомерПозиции = Товар.НомерПозиции;        
			ТоварнаяПозиция.СертификатПоследниеЦифры = Товар.СертификатПоследниеЦифры;  
			//Товар.КодТовараТРУ = СокрЛП(Товар.КодТовараТРУ);
			//Пока СтрДлина(Товар.КодТовараТРУ) < 30 Цикл      
			//	Товар.КодТовараТРУ = Товар.КодТовараТРУ + "0";
			//КонецЦикла;
			ТоварнаяПозиция.КодТовараТРУ = Товар.КодТовараТРУ;
			ТоварнаяПозиция.Количество   = Товар.Количество; 
			ТоварнаяПозиция.Цена         = Товар.Цена;
			ПараметрыОперации.ТоварныеПозиции.Добавить(ТоварнаяПозиция);
		КонецЕсли;
	КонецЦикла;

	Если ВыполнениеНаСервере Тогда
		ПредварительноеОдобрениеИспользованияНаСервере(ПараметрыОперации);
	Иначе
		ОповещениеМетода = Новый ОписаниеОповещения("ОбработатьРезультатЗавершение", ЭтотОбъект, ПараметрыОперации); 
		ЭлектронныеСертификатыНСПККлиент.НачатьПредварительноеОдобрениеИспользования(ОповещениеМетода, ПараметрыОперации);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
