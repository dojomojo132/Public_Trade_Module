&НаКлиенте
Процедура ПолучениеСпискаИдентификаторовКорзинПокупокТСП(Команда)
	
	ПараметрыОперации = ЗаполнитьПараметрыОперации();
	
	Если ТаблицаТоваров.Количество() > 0 Тогда
		ПараметрыОперации.КодТовараТРУ = ТаблицаТоваров[0].КодТовараТРУ;
	КонецЕсли;
	
	ПараметрыОперации.ХешНомерКарты         = СокрЛП(ХешНомерКарты);    
	ПараметрыОперации.СсылкаНаПлатежныйСчет = СокрЛП(СсылкаНаПлатежныйСчет); 
	
	Если ВыполнениеНаСервере Тогда
		ПолучениеСпискаИдентификаторовКорзинПокупокТСПНаСервере(ПараметрыОперации);
	Иначе
		ОповещениеМетода = Новый ОписаниеОповещения("ОбработатьРезультатЗавершение", ЭтотОбъект, ПараметрыОперации); 
		ЭлектронныеСертификатыНСПККлиент.НачатьПолучениеСпискаИдентификаторовКорзинПокупокТСП(ОповещениеМетода, ПараметрыОперации);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОперациюЭТЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Элементы.Главная.Доступность = Истина;
	
	Если РезультатВыполнения.Результат Тогда
		ТекстСообщения = НСтр("ru = 'Операция выполнена успешно.'");
		Если РезультатВыполнения.Свойство("ХешНомерКарты") Тогда
			ХешНомерКарты = РезультатВыполнения.ХешНомерКарты;
		КонецЕсли;
		Если РезультатВыполнения.Свойство("СсылкаНаПлатежныйСчет") Тогда
			СсылкаНаПлатежныйСчет = РезультатВыполнения.СсылкаНаПлатежныйСчет;
		КонецЕсли;
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
	КонецЕсли;
	
	ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОперациюККТЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Элементы.Главная.Доступность = Истина;
	
	Если РезультатВыполнения.Результат Тогда
		ТекстСообщения = НСтр("ru = 'Операция выполнена успешно.'");
		
		Если РезультатВыполнения.Свойство("НомерЧекаККТ") Тогда
			ЧекНомер = РезультатВыполнения.НомерЧекаККТ;
		КонецЕсли;
		
		Если РезультатВыполнения.Свойство("ФискальныйПризнак") Тогда
			ЧекФискальныйПризнак = РезультатВыполнения.ФискальныйПризнак;
		КонецЕсли;
		
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
	КонецЕсли;
	
	ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

