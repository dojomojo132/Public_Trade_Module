	Если ВыполнениеНаСервере Тогда
		НСПКВерсияВКНаСервере();
	Иначе
		ОповещениеМетода = Новый ОписаниеОповещения("НСПКВерсияВКЗавершение", ЭтотОбъект); 
		ЭлектронныеСертификатыНСПККлиент.НачатьПолучениеВерсииВК(ОповещениеМетода);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НСПКВерсияВКЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт 
	
	Если ТипЗнч(РезультатВыполнения) = Тип("Структура") Тогда   
		Если РезультатВыполнения.Свойство("Версия") Тогда
			Сообщить(РезультатВыполнения.Версия);
		ИначеЕсли РезультатВыполнения.Свойство("ОписаниеОшибки") Тогда 
			Сообщить(РезультатВыполнения.ОписаниеОшибки);   
		КонецЕсли;
	Иначе
		Сообщить(РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

