&НаКлиенте
Перем ДополнительныеПараметры;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИспользоватьПодключаемоеОборудование = _ДемоПодключаемоеОборудованиеВызовСервера.ИспользоватьПодключаемоеОборудование();
	
	Объект.Кассир = "Казакова Н.А.";
	Объект.Организация = "ООО ""Альфа""";
	Объект.ДатаКоррекции = ТекущаяДата();
	
	ОбновитьИнтерфейсПользователя();
	
	Если Не ОбщегоНазначенияБПО.ИспользуетсяТерминалыСбораДанных() Тогда
		Элементы.ТоварыЗагрузитьИзТСД.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ДополнительныеПараметры = МенеджерОборудованияКлиентСервер.ДополнительныеПараметрыОперации();
	
	// ПодключаемоеОборудование
	Если ИспользоватьПодключаемоеОборудование Тогда
		ПоддерживаемыеТипы = МенеджерОборудованияКлиентСервер.ПараметрыТипыОборудования();
		ПоддерживаемыеТипы.СчитывательМагнитныхКарт = Истина;
		ПоддерживаемыеТипы.СканерШтрихкода = Истина;
		ПоддерживаемыеТипы.ДисплейПокупателя = Истина;
		ОповещенияПриПодключении = Новый ОписаниеОповещения("ПодключитьОборудованиеЗавершение", ЭтотОбъект);    
		МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПоТипу(ОповещенияПриПодключении, УникальныйИдентификатор, ПоддерживаемыеТипы);
	КонецЕсли;
	// Конец ПодключаемоеОборудование
	
	СтрокаДисплеяПокупателя = НСтр("ru = 'Добро пожаловать.'");
	ПересчитатьДокументНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьОборудованиеЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если Не РезультатВыполнения.Результат Тогда
		ТекстСообщения = НСтр( "ru = 'При подключении оборудования произошла ошибка:
				|""%ОписаниеОшибки%"".'" );
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%" , РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
	Иначе
		ТекстСообщения = НСтр("ru = 'Оборудование подключено.'" );
		ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
		ВывестиИнформациюНаДисплейПокупателя();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	
	Оповестить("ОбновитьСписок");
	
	// ПодключаемоеОборудование
	Если ИспользоватьПодключаемоеОборудование Тогда     
		
		ОборудованиеДисплеиПокупателяКлиент.НачатьОчисткуДисплеяПокупателя(, УникальныйИдентификатор,,, ДополнительныеПараметры);
		
		ПоддерживаемыеТипы = МенеджерОборудованияКлиентСервер.ПараметрыТипыОборудования();
		ПоддерживаемыеТипы.СчитывательМагнитныхКарт = Истина;
		ПоддерживаемыеТипы.СканерШтрихкода = Истина;
		ПоддерживаемыеТипы.ДисплейПокупателя = Истина;
		
		ОповещенияПриОтключении = Новый ОписаниеОповещения("ОтключитьОборудованиеЗавершение", ЭтотОбъект);    
		МенеджерОборудованияКлиент.НачатьОтключениеОборудованияПоТипу(ОповещенияПриОтключении, УникальныйИдентификатор, ПоддерживаемыеТипы);
		
	КонецЕсли;
	// Конец ПодключаемоеОборудование
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьОборудованиеЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если Не РезультатВыполнения.Результат Тогда
		ТекстСообщения = НСтр( "ru = 'При отключении оборудования произошла ошибка: ""%ОписаниеОшибки%"".'" );
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%" , РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
	Иначе
		ТекстСообщения = НСтр("ru = 'Оборудование отключено.'" );
		ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник = "ПодключаемоеОборудование" И ВводДоступен() Тогда
		Если ИмяСобытия = "ScanData" Тогда
			ОбработатьПолученныйШКНаКлиенте(Параметр.Штрихкод);
		ИначеЕсли ИмяСобытия = "TracksData" Тогда
			ПолученКодИзСМК(Параметр);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ОбновитьИнтерфейсПользователя();
	
	Если Объект.Статус = Перечисления._ДемоСтатусыЧековККМ.Фискализирован Тогда
		
		Элементы.ГруппаШапка.ТолькоПросмотр = Истина;
		
		Элементы.ФискализацияЧека.Видимость = Ложь;
		Элементы.ЧекКоррекции.Видимость = Истина;
		Элементы.ЧекКоррекции.КнопкаПоУмолчанию = Истина;
		
		Элементы.Отложить.Видимость = Ложь;
		Элементы.Сохранить.Видимость = Ложь;
		
		Элементы.ТоварыГруппаКнопок.Видимость = Ложь; 
		Элементы.ОплатаНаличныеБезСдачи.Видимость= Ложь; 
		
		Элементы.СтраницаДанныеАгента.ТолькоПросмотр = Истина;
		
	ИначеЕсли Объект.Статус = Перечисления._ДемоСтатусыЧековККМ.Коррекция Тогда
		
		Элементы.ГруппаШапка.ТолькоПросмотр = Истина;
		
		Элементы.ФискализацияЧека.Видимость = Ложь;
		Элементы.ЧекКоррекции.Видимость = Истина;
		Элементы.ЧекКоррекции.КнопкаПоУмолчанию = Истина;
		
		Элементы.Отложить.Видимость = Ложь;
		Элементы.Сохранить.Видимость = Ложь;
		
		Элементы.ТоварыГруппаКнопок.Видимость = Ложь; 
		Элементы.ОплатаНаличныеБезСдачи.Видимость= Ложь; 
		
		Элементы.СтраницаКоррекция.ТолькоПросмотр = Ложь; 
		Элементы.СтраницаТовары.ТолькоПросмотр = Ложь; 
		Элементы.СтраницаОплата.ТолькоПросмотр = Ложь;
		Элементы.СтраницаДанныеАгента.ТолькоПросмотр = Ложь;
		
	Иначе
		
		Элементы.ГруппаШапка.ТолькоПросмотр = Ложь;
		
		Элементы.ФискализацияЧека.Доступность = Истина;
		Элементы.ФискализацияЧека.КнопкаПоУмолчанию = Истина;
		Элементы.ЧекКоррекции.Видимость = Истина;
		Элементы.ЧекКоррекции.КнопкаПоУмолчанию = Ложь;
		
		Элементы.Отложить.Видимость = Истина;
		
		Элементы.ТоварыГруппаКнопок.Видимость = Истина; 
		Элементы.ОплатаНаличныеБезСдачи.Видимость = Истина; 
		
		Элементы.СтраницаКоррекция.ТолькоПросмотр = Ложь; 
		Элементы.СтраницаТовары.ТолькоПросмотр = Ложь; 
		Элементы.СтраницаОплата.ТолькоПросмотр = Ложь;
		Элементы.СтраницаДанныеАгента.ТолькоПросмотр = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

#Область ОбработчикиКомандФормы

// Процедура вызывается нажатием кнопки "Получить вес".
//
&НаКлиенте
Процедура ПолучитьВесВыполнить(Команда)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		ТекстСообщения = НСтр("ru='Необходимо выбрать строку, для которой нужно получить вес.'"); 
		ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Доступность = Ложь;
	
	ОповещенияПриПолученииВеса = Новый ОписаниеОповещения("ПолучитьВесВыполнить_Завершение", ЭтотОбъект);
	ОборудованиеВесовоеОборудованиеКлиент.НачатьПолученияВесаСЭлектронныхВесов(ОповещенияПриПолученииВеса, УникальныйИдентификатор, Неопределено, Неопределено, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьВесВыполнить_Завершение(РезультатВыполнения, Параметры) Экспорт
	
	Доступность = Истина;
	
	Если РезультатВыполнения.Результат Тогда
		
		ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
		
		Если РезультатВыполнения.Вес = 0 Тогда
			ТекстСообщения = НСтр("ru = 'Электронные весы вернули нулевой вес.'");
			ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
		Иначе
			ТекущаяСтрока.Количество = РезультатВыполнения.Вес; // Вес получен
			РассчитатьСуммуРучнойСкидки();
			ПересчитатьДокументНаКлиенте();  
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзТСД(Команда)
	
	Если ИспользоватьПодключаемоеОборудование Тогда
		Доступность = Ложь;
		ОповещенияПриЗагрузкеИзТСД = Новый ОписаниеОповещения("ЗагрузитьИзТСДЗавершение", ЭтотОбъект);
		МодульОборудованиеТерминалыСбораДанныхКлиент = ОбщегоНазначенияБПОКлиент.ОбщийМодуль("ОборудованиеТерминалыСбораДанныхКлиент");
		МодульОборудованиеТерминалыСбораДанныхКлиент.НачатьЗагрузкуДанныеИзТСД(ОповещенияПриЗагрузкеИзТСД, УникальныйИдентификатор, , , ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзТСДЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Доступность = Истина;
	Если РезультатВыполнения.Результат Тогда
		Если РезультатВыполнения.Свойство("ТаблицаТоваров") Тогда
			Для Каждого Данные Из РезультатВыполнения.ТаблицаТоваров Цикл
				ОбработатьПолученныйШКНаСервере(Данные.Штрихкод, Данные.Количество);
			КонецЦикла;
			ПересчитатьДокументНаКлиенте();
		КонецЕсли;
	Иначе
		ОбщегоНазначенияБПОКлиент.СообщитьПользователю(РезультатВыполнения.ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФискализацияЧека_Завершение(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения.Результат Тогда
		// Установить полученное значение номера чека реквизиту документа.
		Объект.НомерСменыККМ = РезультатВыполнения.НомерСменыККТ;
		Объект.НомерЧекаККМ = РезультатВыполнения.НомерЧекаККТ;
		
		Объект.НомерПредписания = Объект.НомерЧекаККМ;
		Объект.ОписаниеКоррекции = "Чек ККМ";
		
		Если Параметры.ЧекКоррекции Тогда
			Объект.Статус = ПредопределенноеЗначение("Перечисление._ДемоСтатусыЧековККМ.Коррекция");
		Иначе
			Объект.Статус = ПредопределенноеЗначение("Перечисление._ДемоСтатусыЧековККМ.Фискализирован");
		КонецЕсли;
	
		Объект.Дата = ОбщегоНазначенияБПОКлиентСервер.ДатаСеанса();
		Если Не ЗначениеЗаполнено(Объект.НомерЧекаККМ) Тогда
			Объект.НомерЧекаККМ = 1;
		КонецЕсли;
			
		ПараметрыЗаписи = Новый Структура("РежимЗаписи, РежимПроведения", РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный);
		Если ЗаписатьДокументНаСервере(ПараметрыЗаписи) Тогда
			Оповестить("ОбновитьСписок");
			ОбновитьИнтерфейсПользователя();
		Иначе
			ТекстСообщения = НСтр("ru = 'Ошибка записи документа'");
			ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
		КонецЕсли; 
		
		ТекстСообщения = НСтр("ru = 'Операция завершена успешно.'");
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
	КонецЕсли;
	
	ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
	Доступность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ФискализацияЧека_ПослеОткрытииЧека(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	
	// Осуществялем запрос а ЕГАИС
	ПараметрыВыполнения.ПродолжитьПечать = Истина; // Если запрос в ЕГАИС успешен
	
	АдресЧека = "URL";  // Заполняет ЕГАИС
	ПодписьЧека = "подпись"; // Заполняет ЕГАИС
	
	ПараметрыВыполнения.Вставить("АдресЧека", АдресЧека);
	ПараметрыВыполнения.Вставить("ПодписьЧека", ПодписьЧека);
	ПараметрыВыполнения.Вставить("ИНН", "23452352");
	ПараметрыВыполнения.Вставить("КПП", "23452352");
	ПараметрыВыполнения.Вставить("НаименованиеОрганизации", "ООО ""РОСИЙСКИЕ ТЕХНОЛОГИИ""");
	
	Если Не ПараметрыВыполнения.ПродолжитьПечать Тогда 
		ПараметрыВыполнения.ОписаниеОшибки = НСтр("ru = 'При подписи чека произошла ошибка.'");
	КонецЕсли;
		
	ВыполнитьОбработкуОповещения(ПараметрыВыполнения.ОповещениеПродолжения, ПараметрыВыполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ФискализацияЧека_ПриОшибкеПечатиЧека(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	
	// Делает отмену запроса в ЕГАИС
	ВыполнитьОбработкуОповещения(ПараметрыВыполнения.ОповещениеПродолжения, ПараметрыВыполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ФискализацияЧека_ВыбратьУстройствоЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если НЕ РезультатВыполнения.Результат Тогда
		ОбщегоНазначенияБПОКлиент.СообщитьПользователю(РезультатВыполнения.ОписаниеОшибки);
		Возврат;
	КонецЕсли;
		
	Доступность = Ложь;
	
	Расчет = Истина;
	ВывестиИнформациюНаДисплейПокупателя();
	
	ОбщиеПараметры = ПолучитьДанныеЧека(Параметры);
	
	Если Объект.ЕГАИС Тогда      
		ОповещениеПослеОткрытииЧека = Новый ОписаниеОповещения("ФискализацияЧека_ПослеОткрытииЧека", ЭтотОбъект, ОбщиеПараметры);
		ОповещениеПриОшибкеПечатиЧека = Новый ОписаниеОповещения("ФискализацияЧека_ПриОшибкеПечатиЧека", ЭтотОбъект, ОбщиеПараметры);
		ДополнительныеПараметры.Вставить("ОповещениеПослеОткрытииЧека", ОповещениеПослеОткрытииЧека);
		ДополнительныеПараметры.Вставить("ОповещениеПриОшибкеПечатиЧека", ОповещениеПриОшибкеПечатиЧека);
	КонецЕсли;
	
	ПровестиФорматноЛогическийКонтрольНаСервере(ОбщиеПараметры, РезультатВыполнения.ИдентификаторУстройства);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ФискализацияЧека_Завершение", ЭтотОбъект, Параметры);
	Если Параметры.ЧекКоррекции Тогда
			ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФормированиеЧекаКоррекцииНаФискальномУстройстве(ОписаниеОповещения,
				УникальныйИдентификатор, РезультатВыполнения.ИдентификаторУстройства, ОбщиеПараметры, ДополнительныеПараметры);
		Иначе
			ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФискализациюЧекаНаФискальномУстройстве(ОписаниеОповещения,
				УникальныйИдентификатор, РезультатВыполнения.ИдентификаторУстройства, ОбщиеПараметры, ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры
        
&НаКлиенте
Процедура ФискализацияЧека(Параметры) Экспорт
	
	ПоддерживаемыеТипы = МенеджерОборудованияКлиентСервер.ПараметрыТипыОборудования();
	ПоддерживаемыеТипы.ПринтерЧеков = Истина;
	ПоддерживаемыеТипы.ККТ = Истина;
	
	ПослеВыбратьУстройство = Новый ОписаниеОповещения("ФискализацияЧека_ВыбратьУстройствоЗавершение", ЭтотОбъект, Параметры);
	МенеджерОборудованияКлиент.ВыбратьУстройство(ПослеВыбратьУстройство, ПоддерживаемыеТипы,
			НСтр("ru='Выберите фискальное устройство'"),
			НСтр("ru='Фискальное устройство не подключено.'"), 
			НСтр("ru='Фискальное устройство не выбрано.'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ФискализироватьЧекВыполнить_Продолжить(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения <> Неопределено И Тип(РезультатВыполнения) = Тип("Структура") Тогда
		ФискализацияЧека(РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФискализироватьЧекВыполнить(Команда)
	
	Записать();
	
	ОчиститьСообщения();         
	ПараметрыВыполнения = Новый Структура("ЧекКоррекции", Ложь);
	
	Если Объект.Статус <> ПредопределенноеЗначение("Перечисление._ДемоСтатусыЧековККМ.Фискализирован") Тогда
		ПараметрыКоманды = Неопределено;
		Обработчик = Новый ОписаниеОповещения("ФискализироватьЧекВыполнить_Продолжить", ЭтотОбъект, ПараметрыКоманды);
		ОткрытьФорму("Документ._ДемоЧек.Форма.ФормированиеЧека",  ПараметрыВыполнения, ПараметрыКоманды,,,, Обработчик, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	Иначе
		ОшибкаПовторнаяФискализацияЧека();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЧекКоррекции(Команда)
	
	Записать();
	
	ОчиститьСообщения();         
	ПараметрыВыполнения = Новый Структура("ЧекКоррекции", Истина);
	
	ПараметрыКоманды = Неопределено;
	Обработчик = Новый ОписаниеОповещения("ФискализироватьЧекВыполнить_Продолжить", ЭтотОбъект, ПараметрыКоманды);
	ОткрытьФорму("Документ._ДемоЧек.Форма.ФормированиеЧека",  ПараметрыВыполнения, ПараметрыКоманды,,,, Обработчик, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

