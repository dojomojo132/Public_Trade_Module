	// Общие реквизиты для всех типов оборудования.
	ОбщиеПараметры.ТипРасчета          = Объект.ТипОперации;
	ОбщиеПараметры.Кассир              = СокрЛП(Объект.Кассир);
	ОбщиеПараметры.КассирИНН           = СокрЛП(Объект.КассирИНН);
	
	ОбщиеПараметры.ОрганизацияНазвание = Объект.Организация;
	ОбщиеПараметры.ОрганизацияИНН      = "0000000000";
	ОбщиеПараметры.ОрганизацияКПП      = "234523454542";
	
	Если Не ПустаяСтрока(Объект.Клиент) Тогда
		ОбщиеПараметры.СведенияОПокупателе.Покупатель    = Строка(Объект.Клиент);
		ОбщиеПараметры.СведенияОПокупателе.ПокупательИНН = Объект.Клиент.ИНН;
	КонецЕсли;
	
	//ОбщиеПараметры.АдресРасчетов       = "г.Москва, Дмитровское ш. д.9";
	//ОбщиеПараметры.МестоРасчетов       = "Северное крыло, комната 9441";
	
	// Параметры необходимые для чека ЕНВД на принтере чеков
	ОбщиеПараметры.НомерКассы = "3463345";
	ОбщиеПараметры.НомерЧека  = Объект.Номер;
	ОбщиеПараметры.НомерСмены = 1;
	// Новые параметры для ККТ по ФЗ-54
	ОбщиеПараметры.ОтправительEmail  = "info@1c.ru";
	Если ПараметрыОперации <> Неопределено Тогда                                
		ОбщиеПараметры.Электронно = ПараметрыОперации.Электронно;
		ОбщиеПараметры.ПокупательEmail   = ПараметрыОперации.ПокупательEmail;
		ОбщиеПараметры.Отправляет1СEmail = ПараметрыОперации.ОтправлятьEmailСредствами1С;
		ОбщиеПараметры.ПокупательНомер = ПараметрыОперации.ПокупательНомер;
		ОбщиеПараметры.Отправляет1СSMS = ПараметрыОперации.ОтправлятьSMSСредствами1С;
	Иначе
		ОбщиеПараметры.Электронно = Ложь;
	КонецЕсли;
	
	ОбщиеПараметры.СистемаНалогообложения = Объект.СистемаНалогообложения;
	
	ОбщиеПараметры.ДанныеКоррекции.ТипКоррекции      = Объект.ТипКоррекции;
	ОбщиеПараметры.ДанныеКоррекции.ОписаниеКоррекции = Объект.ОписаниеКоррекции;
	ОбщиеПараметры.ДанныеКоррекции.ДатаКоррекции     = Объект.ДатаКоррекции;
	ОбщиеПараметры.ДанныеКоррекции.НомерПредписания  = Объект.НомерПредписания;
	ОбщиеПараметры.НеприменениеККТ = НеприменениеККТ;
	
	ОбщиеПараметры.ДополнительныйРеквизит = Объект.ДополнительныйРеквизит;
	ОбщиеПараметры.ДополнительныйРеквизитПользователя.Наименование = Объект.РеквизитПользователяНаименование;
	ОбщиеПараметры.ДополнительныйРеквизитПользователя.Значение = Объект.РеквизитПользователяЗначение;
	
	ОбщиеПараметры.СформироватьЧекКоррекции = СформироватьЧекКоррекции;
	Возврат ОбщиеПараметры;
	
КонецФункции

// Процедура из массива параметров выбирает код магнитной карты, полученный с СМК.
//
&НаКлиенте
Процедура ПолученКодИзСМК(Параметр)
	
	Если Параметр.СписокШаблонов <> Неопределено И Параметр.СписокШаблонов.Количество() > 0 Тогда
		МКод = Параметр.СписокШаблонов[0].ДанныеДорожек[0].ЗначениеПоля;
	Иначе
		МКод = Параметр.КодКарты;
	КонецЕсли;
	
	ПолучитьКлиентаНаСервере(МКод);
	
КонецПроцедуры

// Процедура производит поиск клиента в справочнике Клиенты по коду магнитной карты.
//
&НаСервере
Процедура ПолучитьКлиентаНаСервере(МКод)
	
	Клиент = _ДемоПодключаемоеОборудованиеВызовСервера.НайтиКлиентаПоМК(МКод);
	Если Клиент <> Неопределено Тогда
		Объект.Клиент = Клиент;
	Иначе
		ПустаяСсылка = Новый (Тип("СправочникСсылка._ДемоКлиенты"));
		Объект.Клиент = ПустаяСсылка;
		ОбщегоНазначенияБПО.СообщитьПользователю(НСтр("ru = 'Клиент не найден.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьПолученныйШКНаклиенте(ДанныеСканера)
	
	МодульМенеджерОборудованияМаркировкаКлиентСервер = ОбщегоНазначенияБПОКлиент.ОбщийМодуль("МенеджерОборудованияМаркировкаКлиентСервер");
	ДанныеМаркировки = МодульМенеджерОборудованияМаркировкаКлиентСервер.РазобратьШтриховойКодТовара(ДанныеСканера);
		
		Если ДанныеМаркировки.Разобран Тогда
		 Если ПустаяСтрока(ДанныеМаркировки.EAN) Тогда
			ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
			Если ТекущаяСтрока = Неопределено Тогда
				ТекстСообщения = НСтр("ru='Необходимо выбрать строку, для которой вводиться контрольная марка.'"); 
				ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
				Возврат;
			Иначе
				ТекущаяСтрока.РеквизитКодаТовара = ДанныеМаркировки.РеквизитКодаТовара;
				ТекущаяСтрока.Штрихкод = ДанныеСканера;
				Возврат;
			КонецЕсли;
		Иначе
			ОбработатьПолученныйШКНаСервере(ДанныеМаркировки.EAN, , ДанныеМаркировки);
		КонецЕсли;
	Иначе
	ОбработатьПолученныйШКНаСервере(ДанныеСканера);
	КонецЕсли;
	
	ПересчитатьДокументНаКлиенте();  
	
КонецПроцедуры

// Процедура производит поиск позиции в справочнике Номенклатура по штрихкоду.
//
&НаСервере
Процедура ОбработатьПолученныйШКНаСервере(ТекКод, Количество = 1, ДанныеМаркировки = Неопределено)
	
	РезультатОбработки = _ДемоПодключаемоеОборудованиеВызовСервера.ПоискПоШтрихкоду(ТекКод);
	Если РезультатОбработки.Количество() Тогда
		СтруктураПараметров = ЗаполнитьСвойстваНоменклатуры(РезультатОбработки[0]._ДемоНоменклатура);
		СтруктураПараметров.Вставить("Количество", Количество);
		Если ДанныеМаркировки <> Неопределено  Тогда
			СтруктураПараметров.Вставить("ГлобальныйИдентификаторТорговойЕдиницы", ДанныеМаркировки.GTIN);
			СтруктураПараметров.Вставить("СерийныйНомер", ДанныеМаркировки.СерийныйНомер);
			СтруктураПараметров.Вставить("РеквизитКодаТовара", ДанныеМаркировки.РеквизитКодаТовара);
			СтруктураПараметров.Вставить("Штрихкод", ТекКод);
		КонецЕсли;    
		ДобавитьПозициюНоменклатуры(СтруктураПараметров);
		СтрокаДисплеяПокупателя = РезультатОбработки[0]._ДемоНоменклатура;
	Иначе
		ОбщегоНазначенияБПО.СообщитьПользователю(НСтр("ru = 'Товар не найден.'"));
	КонецЕсли;

КонецПроцедуры

// Процедура добавляет заполненную строку в ТЧ Товары.
//
&НаСервере
Процедура ДобавитьПозициюНоменклатуры(СтруктураПараметров)
	
	ТекущаяСтрока = Объект.Товары.Добавить();
	ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтруктураПараметров);
	
	Если Не СтруктураПараметров.Весовой Тогда
		ТекущаяСтрока.Количество = СтруктураПараметров.Количество;
	КонецЕсли;
	
	ТекущаяСтрока.Сумма = ТекущаяСтрока.Цена * ТекущаяСтрока.Количество;
	Элементы.Товары.ТекущаяСтрока = ТекущаяСтрока.ПолучитьИдентификатор();
	
КонецПроцедуры

// Процедура рассчитывает сумму ручной скидки по проценту.
//
&НаКлиенте
Процедура РассчитатьПроцентРучнойСкидки()
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	ТекущаяСтрока.СуммаРучнойСкидки = Окр(ТекущаяСтрока.Цена * ТекущаяСтрока.Количество * (ТекущаяСтрока.ПроцентРучнойСкидки/100),2);
	ТекущаяСтрока.Сумма = ТекущаяСтрока.Цена * ТекущаяСтрока.Количество - ТекущаяСтрока.СуммаРучнойСкидки;
	
	РассчитатьСуммуНДС();
	
КонецПроцедуры

// Процедура рассчитывает процент ручной скидки по сумме скидки.
//
&НаКлиенте
Процедура РассчитатьСуммуРучнойСкидки()
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	СуммаСтр = ТекущаяСтрока.Цена * ТекущаяСтрока.Количество;
	Если ТекущаяСтрока.СуммаРучнойСкидки > СуммаСтр Тогда
		ТекущаяСтрока.СуммаРучнойСкидки = 0;
		ТекущаяСтрока.ПроцентРучнойСкидки = 0;
		ТекущаяСтрока.Сумма = СуммаСтр;
		Текст = НСтр("ru = 'Сумма ручной скидки не может превышать стоимость'");
		ПоказатьПредупреждение(, Текст, 10);
	Иначе
		Если СуммаСтр > 0 Тогда
			ТекущаяСтрока.ПроцентРучнойСкидки = (ТекущаяСтрока.СуммаРучнойСкидки / СуммаСтр) * 100;
			ТекущаяСтрока.Сумма = СуммаСтр - ТекущаяСтрока.СуммаРучнойСкидки;
		Иначе
			ТекущаяСтрока.ПроцентРучнойСкидки = 0;
			ТекущаяСтрока.Сумма = 0;
		КонецЕсли;
	КонецЕсли;
	
	РассчитатьСуммуНДС();
	
КонецПроцедуры

// Процедура обновляет информацию о текущем состоянии документа.
//
&НаКлиенте
Процедура ПересчитатьДокументНаКлиенте()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма");
	Объект.СуммаСкидки = Объект.Товары.Итог("СуммаРучнойСкидки");
	Объект.СуммаБезСкидки = Объект.СуммаДокумента + Объект.СуммаСкидки;
	Объект.СуммаНДС = Объект.Товары.Итог("СуммаНДС");
	Объект.СуммаОплаты = Объект.Оплата.Итог("СуммаОплаты");
	
	Сдача = Объект.СуммаОплаты - Объект.СуммаДокумента;
	Если Сдача > 0 Тогда
		Объект.Сдача = Сдача;
	Иначе
		Объект.Сдача = 0;
	КонецЕсли;
	
	ВывестиИнформациюНаДисплейПокупателя();
	
КонецПроцедуры

// Процедура вывода информации на дисплей покупателя.
//
&НаКлиенте
Процедура ВывестиИнформациюНаДисплейПокупателя()
	
	Если НЕ ИспользоватьПодключаемоеОборудование Тогда
		Возврат;
	КонецЕсли;
	
	ФорматнаяСтрока = "ЧДЦ=2; ЧРГ=' '; ЧН=0.00; ЧГ=0";
	ДлинаТекста     = 20;
	
	ДПТекст1 = "";
	ДПТекст2 = "";
	
	Если Расчет Тогда
		
		ДПТекст1 = ?(
		Не ЗначениеЗаполнено(СтрокаДисплеяПокупателя),
		"",
		Лев(" К ОПЛАТЕ: " + Формат(Объект.СуммаДокумента, ФорматнаяСтрока), ДлинаТекста));
		
		Доплата = Объект.СуммаДокумента - Объект.СуммаОплаты;
		
		ДПТекст2 = ?(
		Не ЗначениеЗаполнено(СтрокаДисплеяПокупателя),
		"",
		Лев(НСтр("ru='    СДАЧА: '") + Формат(Объект.Сдача, ФорматнаяСтрока), ДлинаТекста));
		
	Иначе
		
		ДПТекст1 = ?(
		Не ЗначениеЗаполнено(СтрокаДисплеяПокупателя),
		"",
		Лев(СтрокаДисплеяПокупателя, ДлинаТекста));
		
		ДПТекст2 = ?(
		Не ЗначениеЗаполнено(СтрокаДисплеяПокупателя),
		"",
		Лев(НСтр("ru='ИТОГО: '") + Формат(Объект.СуммаДокумента, ФорматнаяСтрока), ДлинаТекста));
		
	КонецЕсли;
	
	Пока СтрДлина(ДПТекст1) < ДлинаТекста Цикл
		ДПТекст1 = ДПТекст1 + " ";
	КонецЦикла;
		
	Пока СтрДлина(ДПТекст2) < ДлинаТекста Цикл
		ДПТекст2 = ДПТекст2 + " ";
	КонецЦикла;
	
	ПараметрыОперации = ОборудованиеДисплеиПокупателяКлиент.ПараметрыОперацииДисплейПокупателя(ДПТекст1 + Символы.ПС + ДПТекст2);
	ОборудованиеДисплеиПокупателяКлиент.НачатьВыводИнформацииНаДисплейПокупателя(, УникальныйИдентификатор, ,ПараметрыОперации, ДополнительныеПараметры);
	
КонецПроцедуры

// Процедура выводит предупреждение о невозможности повторной печати чека.
//
&НаКлиенте
Процедура ОшибкаПовторнаяФискализацияЧека()
	
	ТекстПредупреждения = НСтр("ru = 'Чек уже фискализирован на фискальном устройстве'");
	ПоказатьПредупреждение(, ТекстПредупреждения, 10);
	
КонецПроцедуры

// Функция записывает чек в базу со статусом Отложен и закрывает документ.
//
&НаКлиенте
Функция ОтложитьЧек()
	
	Результат = Истина;
	Если НЕ Объект.Проведен Тогда
		Объект.СуммаОплаты = 0;
		Объект.Статус = ПредопределенноеЗначение("Перечисление._ДемоСтатусыЧековККМ.Отложен");
		ПараметрыЗаписи = Новый Структура("РежимЗаписи",РежимЗаписиДокумента.Запись);
		Если НЕ ЗаписатьДокументНаСервере(ПараметрыЗаписи) Тогда
			Результат = Ложь;
			ТекстСообщения = НСтр("ru = 'Ошибка записи документа'");
			ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		Оповестить("ОбновитьСписок");
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Если Объект.Проведен Тогда
		ОшибкаПовторнаяФискализацияЧека();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Процедура рассчитывает сумму НДС по ставке для текущей строки в ТЧ Товары.
//
&НаКлиенте
Процедура РассчитатьСуммуНДС()
	
	// Цена включает НДС
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	Сумма = ТекущаяСтрока.Сумма;
	Ставка = _ДемоПодключаемоеОборудованиеВызовСервера.ВернутьСтавкуНДС(ТекущаяСтрока.СтавкаНДС);
	Если Ставка = Неопределено Тогда
		ТекущаяСтрока.СуммаНДС = 0;
	ИначеЕсли Ставка > 0 И Ставка < 100 Тогда
		ТекущаяСтрока.СуммаНДС = Окр(Сумма - Сумма/( 1 + Ставка/ 100), 2);
	ИначеЕсли Ставка > 100 Тогда
		ТекущаяСтрока.СуммаНДС = Окр(Сумма - Сумма/( 1 + (Ставка - 100)/ 100), 2);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПровестиФорматноЛогическийКонтрольНаСервере(ОбщиеПараметры, ИдентификаторУстройства)
	
	Если ОбщегоНазначенияБПО.ИспользуетсяФорматноЛогическийКонтроль() Тогда
		МодульФорматноЛогическийКонтроль = ОбщегоНазначенияБПО.ОбщийМодуль("ФорматноЛогическийКонтроль");
		МодульФорматноЛогическийКонтроль.ПровестиФорматноЛогическийКонтроль(ОбщиеПараметры, ИдентификаторУстройства);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ЗаполнитьСвойстваНоменклатуры(Номенклатура)
	
	СвойстваНоменклатуры = Новый Структура();
	СвойстваНоменклатуры.Вставить("Номенклатура", Номенклатура);
	СвойстваНоменклатуры.Вставить("Характеристика", Номенклатура.Характеристика);
	СвойстваНоменклатуры.Вставить("Весовой", Номенклатура.Весовой);
	СвойстваНоменклатуры.Вставить("Цена", Номенклатура.Цена);
	СвойстваНоменклатуры.Вставить("ЕдиницаИзмерения", Номенклатура.ЕдиницаИзмерения);
	СвойстваНоменклатуры.Вставить("СтавкаНДС", Номенклатура.СтавкаНДС);
	СвойстваНоменклатуры.Вставить("ПредметРасчета", Номенклатура.ПризнакПредметаРасчета);
	Возврат СвойстваНоменклатуры;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСвойствоВесовойНаСервере(Номенклатура)
	
	Возврат Номенклатура.Весовой;
	
КонецФункции

// Функция записи и проведения документа.
//
&НаСервере
Функция ЗаписатьДокументНаСервере(ПараметрыЗаписи)
	
	Результат = Ложь;
	
	Попытка
		Результат = Записать(ПараметрыЗаписи);
	Исключение
		ТекстСообщения = ОписаниеОшибки();
		ОбщегоНазначенияБПО.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Функция заполняет ТЧ Товары данными из справочника Номенклатура.
//
&НаСервере
Функция ЗаполнитьДемоДаннымиНаСервере()
	
	Результат = _ДемоПодключаемоеОборудованиеВызовСервера.ВыбратьДемоДанные();
	Если Результат.Количество() = 0 Тогда
		Возврат Ложь;
	Иначе
		Объект.Товары.Загрузить(Результат);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура НаличныеБезСдачи(Команда)
	
	Объект.Оплата.Очистить();
	Строка = Объект.Оплата.Добавить();
	Строка.ВидОплаты = ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.Наличные");
	Строка.СуммаОплаты = Объект.Товары.Итог("Сумма");
	ПересчитатьДокументНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ОплатитьНаЭТ(Команда)                    
	
	Доступность = Ложь;
	
	ОчиститьСообщения();
	ПараметрыОперации = Новый Структура();
	ПараметрыОперации.Вставить("ТипТранзакции"               , "AuthorizeSales");
	ПараметрыОперации.Вставить("ЗапретРедактированияСуммы"   , Ложь);
	ПараметрыОперации.Вставить("Сумма", Объект.Товары.Итог("Сумма"));
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОплатитьНаЭТ_ВыполнитьОперацию", ЭтотОбъект, ПараметрыОперации);
	ОткрытьФорму("Справочник.ПодключаемоеОборудование.Форма.ФормаАвторизацииЭТ", ПараметрыОперации,,,  ,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры            

 &НаКлиенте
Процедура ОплатитьНаЭТ_ВыполнитьОперацию(Результат, Параметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		
		Если НЕ Параметры.Свойство("ТипТранзакции") Тогда
			ТекстСообщения = НСтр("ru = 'Не указан тип транзакции.'");
			ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
		
		ПараметрыОперации = ОборудованиеПлатежныеСистемыКлиентСервер.ПараметрыВыполненияЭквайринговойОперации();  
		ПараметрыОперации.ДокументОснование = Объект.Ссылка;
		ПараметрыОперации.ТипТранзакции  = Параметры.ТипТранзакции;
		ПараметрыОперации.СуммаОперации  = Результат.Сумма;
		ПараметрыОперации.СсылочныйНомер = Результат.СсылочныйНомер;
		
		Оповещение = Новый ОписаниеОповещения("ОплатитьНаЭТ_Завершение", ЭтотОбъект);
		ОборудованиеПлатежныеСистемыКлиент.НачатьВыполнениеОперацииНаЭквайринговомТерминале(Оповещение, УникальныйИдентификатор, Неопределено, ПараметрыОперации);
	Иначе
		Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОплатитьНаЭТ_Завершение(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения.Результат Тогда               
		Строка = Объект.Оплата.Добавить();
		Строка.ВидОплаты = ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.Электронно");
		Строка.СуммаОплаты = Объект.Товары.Итог("Сумма");
		ТекстСообщения = НСтр("ru = 'Операция выполнена успешно.'");
		ПересчитатьДокументНаКлиенте();
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
	КонецЕсли;
	
	ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
	
	Доступность = Истина;
	
КонецПроцедуры

#КонецОбласти