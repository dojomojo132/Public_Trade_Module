	Если НЕ ЗаполнитьДемоДаннымиНаСервере() Тогда
		ТекстПредупреждения = НСтр("ru = 'Справочник ""Номенклатура"" не заполнен.'");
		ПоказатьПредупреждение(, ТекстПредупреждения, 10);
	Иначе
