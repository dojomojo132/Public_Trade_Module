{
    "editor.formatOnSave": false,
    "files.encoding": "utf8bom",
    "files.autoSave": "onFocusChange",
    
    "files.associations": {
        "*.bsl": "bsl",
        "*.os": "bsl"
    },
    
    "[bsl]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": false,
        "editor.wordWrap": "on"
    },
    
    "files.exclude": {
        "**/_backups/**": true,
        "**/_dump_clean/**": true,
        "**/_dump_current/**": true,
        "**/_dump_current_sync/**": true,
        "**/_dump_from_ib/**": true,
        "**/_form_temp_backup/**": true,
        "**/_saved_import/**": true,
        "**/_test_content_backup/**": true,
        "**/MCP_Extension/**": true,
        "**/MCP_Extension_check/**": true,
        "**/node_modules/**": true,
        "**/CF/**": true,
        "**/PTM/**": true,
        "**/.venv/**": true,
        "**/logs/**": true,
        "**/tools/**": true,
        "**/Документация/Валидация/backups/**": true
    },

    // files.watcherExclude — КЛЮЧЕВОЙ параметр: VS Code не отправляет события изменений
    // языковым серверам (включая BSL LS) для этих папок → сервер их не переиндексирует
    "files.watcherExclude": {
        "**/_backups/**": true,
        "**/_dump_clean/**": true,
        "**/_dump_current/**": true,
        "**/_dump_current_sync/**": true,
        "**/_dump_from_ib/**": true,
        "**/_form_temp_backup/**": true,
        "**/_saved_import/**": true,
        "**/_test_content_backup/**": true,
        "**/MCP_Extension/**": true,
        "**/MCP_Extension_check/**": true,
        "**/node_modules/**": true,
        "**/_archive/**": true,
        "**/CF/**": true,
        "**/PTM/**": true,
        "**/logs/**": true,
        "**/ScannerEmulator/**": true,
        "**/.venv/**": true,
        "**/tools/**": true,
        "**/Документация/Валидация/backups/**": true
    },

    "search.exclude": {
        "**/node_modules": true,
        "**/DerivedData": true,
        "**/_backups/**": true,
        "**/_dump_*/**": true,
        "**/MCP_Extension/**": true,
        "**/MCP_Extension_check/**": true,
        "**/_saved_import/**": true,
        "**/_form_temp_backup/**": true,
        "**/CF/**": true,
        "**/PTM/**": true,
        "**/.venv/**": true,
        "**/logs/**": true,
        "**/tools/**": true,
        "**/Документация/Валидация/backups/**": true
    },
    
    "github.copilot.chat.codeGeneration.useReferencedFiles": true,

    // BSL Language Server extension: ограничиваем анализ только Конфигурацией
    "language-1c-bsl.languageServerConfiguration.configurationRoot": "${workspaceFolder}/Конфигурация",
    "language-1c-bsl.languageServerConfiguration.analyzeHierarchy": false,

    // Автоподтверждение действий агента (без ручного клика)
    "chat.agent.autoApprove": true,

    // Максимальное количество шагов агента за один запрос
    "chat.agent.maxRequests": 1000,

    // Agent-scoped hooks в .agent.md файлах (Preview)
    "chat.useCustomAgentHooks": true,
    "chat.mcp.serverSampling": {
        "Public_Trade_Module/.vscode/mcp.json: obsidian-vault": {
            "allowedModels": [
                "copilot/auto",
                "copilotcli/claude-sonnet-4.6",
                "copilot/claude-opus-4.6"
            ]
        }
    }
}