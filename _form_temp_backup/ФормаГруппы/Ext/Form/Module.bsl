
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Нет дополнительной логики при создании формы группы
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура УстановитьНаценку(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Сначала запишите группу.");
		Возврат;
	КонецЕсли;
	
	Если ПроцентНаценкиГруппы = 0 Тогда
		Результат = Ждать ВопросАсинх(
			"Процент наценки равен 0. Установить нулевую наценку для всех подчинённых элементов?",
			РежимДиалогаВопрос.ДаНет);
		Если Результат = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Результат = Ждать ВопросАсинх(
		СтрШаблон("Установить наценку %1%% для ВСЕХ элементов группы ""%2"" (включая подгруппы)?",
			ПроцентНаценкиГруппы, Объект.Наименование),
		РежимДиалогаВопрос.ДаНет);
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоОбновленных = УстановитьНаценкуНаСервере(ПроцентНаценкиГруппы);
	
	Элементы.НадписьРезультат.Видимость = Истина;
	Элементы.НадписьРезультат.Заголовок = СтрШаблон("Обновлено элементов: %1", КоличествоОбновленных);
	
	ПоказатьПредупреждение(,
		СтрШаблон("Наценка %1%% установлена для %2 элементов.", ПроцентНаценкиГруппы, КоличествоОбновленных));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция УстановитьНаценкуНаСервере(Знач НовыйПроцент)
	
	СсылкаГруппы = Объект.Ссылка;
	
	// Получить все элементы (не группы) рекурсивно во всех подгруппах
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка В ИЕРАРХИИ (&Родитель)
		|	И НЕ Номенклатура.ЭтоГруппа
		|	И НЕ Номенклатура.ПометкаУдаления";
	Запрос.УстановитьПараметр("Родитель", СсылкаГруппы);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Счетчик = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			ОбъектНоменклатуры = Выборка.Ссылка.ПолучитьОбъект();
			ОбъектНоменклатуры.ПроцентНаценки = НовыйПроцент;
			ОбъектНоменклатуры.Записать();
			Счетчик = Счетчик + 1;
		Исключение
			// Пропускаем заблокированные объекты
			Продолжить;
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Счетчик;
	
КонецФункции

#КонецОбласти
