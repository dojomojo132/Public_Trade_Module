#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	КассовоеОборудование = Справочники.КассовоеОборудование.ПустаяСсылка();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьСмену(Команда)
	РезультатСервер = ОткрытьСменуНаСервере();
	ПоказатьСтатус(РезультатСервер);
КонецПроцедуры

&НаСервере
Функция ОткрытьСменуНаСервере()
	Рез = ВызватьОперациюПРРО(0);
	Возврат Рез;
КонецФункции

&НаКлиенте
Процедура XОтчет(Команда)
	Рез = XОтчетНаСервере();
	ПоказатьСтатус(Рез);
КонецПроцедуры

&НаСервере
Функция XОтчетНаСервере()
	Возврат ВызватьОперациюПРРО(10);
КонецФункции

&НаКлиенте
Процедура ZОтчет(Команда)
	Рез = ZОтчетНаСервере();
	ПоказатьСтатус(Рез);
КонецПроцедуры

&НаСервере
Функция ZОтчетНаСервере()
	Возврат ВызватьОперациюПРРО(11);
КонецФункции

&НаКлиенте
Процедура Внесение(Команда)
	Рез = ВнесениеНаСервере(Сумма);
	ПоказатьСтатус(Рез);
КонецПроцедуры

&НаСервере
Функция ВнесениеНаСервере(Знач СуммаОп)
	Возврат ВызватьВнесениеИзъятие(СуммаОп);
КонецФункции

&НаКлиенте
Процедура Изъятие(Команда)
	Рез = ИзъятиеНаСервере(Сумма);
	ПоказатьСтатус(Рез);
КонецПроцедуры

&НаСервере
Функция ИзъятиеНаСервере(Знач СуммаОп)
	Возврат ВызватьВнесениеИзъятие(-СуммаОп);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьСтатус(ТекстСтатуса)
	СтрокаСтатуса = ТекстСтатуса;
КонецПроцедуры

&НаСервере
Функция ВызватьОперациюПРРО(Знач НомерЗадачи)
	Если НЕ ЗначениеЗаполнено(КассовоеОборудование) Тогда
		Возврат "Ошибка: кассовое оборудование не выбрано";
	КонецЕсли;
	
	КО = КассовоеОборудование.ПолучитьОбъект();
	ПараметрыОбор = Новый Структура;
	ПараметрыОбор.Вставить("АдресСервера", КО.АдресСервера);
	ПараметрыОбор.Вставить("Токен", "");
	
	Рез = "";
	Попытка
		Если НомерЗадачи = 0 Тогда
			Итог = Вчсн_ДрайверПРРО.ОткрытьСмену(ПараметрыОбор);
		ИначеЕсли НомерЗадачи = 10 Тогда
			Итог = Вчсн_ДрайверПРРО.XОтчет(ПараметрыОбор);
		ИначеЕсли НомерЗадачи = 11 Тогда
			Итог = Вчсн_ДрайверПРРО.ЗакрытьСмену(ПараметрыОбор);
		КонецЕсли;
		
		Если Итог.Успех Тогда
			Рез = "Выполнено успешно";
		Иначе
			Рез = "Ошибка: " + Итог.Ошибка;
		КонецЕсли;
	Исключение
		Рез = "Исключение: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Рез;
КонецФункции

&НаСервере
Функция ВызватьВнесениеИзъятие(Знач Сумма)
	Если НЕ ЗначениеЗаполнено(КассовоеОборудование) Тогда
		Возврат "Ошибка: кассовое оборудование не выбрано";
	КонецЕсли;
	
	КО = КассовоеОборудование.ПолучитьОбъект();
	ПараметрыОбор = Новый Структура;
	ПараметрыОбор.Вставить("АдресСервера", КО.АдресСервера);
	
	Рез = "";
	Попытка
		Итог = Вчсн_ДрайверПРРО.ВнесениеВыемка(ПараметрыОбор, Сумма);
		Если Итог.Успех Тогда
			Рез = "Выполнено: " + ?(Сумма > 0, "Внесение", "Изъятие");
		Иначе
			Рез = "Ошибка: " + Итог.Ошибка;
		КонецЕсли;
	Исключение
		Рез = "Исключение: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Рез;
КонецФункции

#КонецОбласти
