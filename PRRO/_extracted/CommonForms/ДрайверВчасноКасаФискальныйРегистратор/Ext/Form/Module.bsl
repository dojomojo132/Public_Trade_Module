&НаКлиенте
Функция АдресЭлектроннойПочтыСоответствуетТребованиям(Знач Адрес, РазрешитьЛокальныеАдреса = Ложь)
	
	Буквы = "abcdefghijklmnopqrstuvwxyz";
	Цифры = "0123456789";
	СпецСимволы = ".@_-:+";
	
	Если СтрЧислоВхождений(Адрес, "@") <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СтрЧислоВхождений(Адрес, ":") > 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Найти(Адрес, "..") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Адрес = НРег(Адрес);
	
	Если Не СтрокаСодержитТолькоДопустимыеСимволы(Адрес, Буквы + Цифры + СпецСимволы) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Позиция = Найти(Адрес, "@");
	ЛокальноеИмя = Лев(Адрес, Позиция - 1);
	Домен = Сред(Адрес, Позиция + 1);
	
	Если ПустаяСтрока(ЛокальноеИмя) Или ПустаяСтрока(Домен) Или СтрДлина(ЛокальноеИмя) > 64 Или СтрДлина(Домен) > 255 Тогда		
		Возврат Ложь;
	КонецЕсли;
	
	Если ЕстьСимволыВНачалеВКонце(Домен, СпецСимволы) Тогда
		Возврат Ложь;
	КонецЕсли;
		
	Если Не РазрешитьЛокальныеАдреса И Найти(Домен, ".") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Найти(Домен, "_") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Найти(Домен, ":") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Найти(Домен, "+") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Зона = Домен;
	Позиция = Найти(Зона, ".");
	Пока Позиция > 0 Цикл
		Зона = Сред(Зона, Позиция + 1);
		Позиция = Найти(Зона, ".");
	КонецЦикла;
	
	Возврат РазрешитьЛокальныеАдреса Или СтрДлина(Зона) >= 2 И СтрокаСодержитТолькоДопустимыеСимволы(Зона, Буквы);
	
КонецФункции

&НаКлиенте
Функция СтрокаСодержитТолькоДопустимыеСимволы(Строка, ДопустимыеСимволы)
	
	МассивСимволов = Новый Массив;
	Для Позиция = 1 По СтрДлина(ДопустимыеСимволы) Цикл
		МассивСимволов.Добавить(Сред(ДопустимыеСимволы, Позиция, 1));
	КонецЦикла;
	
	Для Позиция = 1 По СтрДлина(Строка) Цикл
		Если МассивСимволов.Найти(Сред(Строка, Позиция, 1)) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ЕстьСимволыВНачалеВКонце(Строка, ПроверяемыеСимволы)
	
	Для Позиция = 1 По СтрДлина(ПроверяемыеСимволы) Цикл
		Символ = Сред(ПроверяемыеСимволы, Позиция, 1);
		СимволНайден = (Лев(Строка, 1) = Символ) Или (Прав(Строка, 1) = Символ);
		Если СимволНайден Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция Округлить(Число, Точность)

	Возврат Точность * Окр(Число / Точность);  		
	
КонецФункции

