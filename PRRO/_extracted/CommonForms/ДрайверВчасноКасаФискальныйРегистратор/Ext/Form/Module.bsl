	ОписаниеДрайвераXML.ЗаписатьАтрибут("EquipmentType", "ФискальныйРегистратор");
	ОписаниеДрайвераXML.ЗаписатьАтрибут("IntegrationComponent", "false");
	ОписаниеДрайвераXML.ЗаписатьАтрибут("MainDriverInstalled", "false");
	ОписаниеДрайвераXML.ЗаписатьАтрибут("DriverVersion", мВерсия);
	ОписаниеДрайвераXML.ЗаписатьАтрибут("IntegrationComponentVersion", мВерсия);
	ОписаниеДрайвераXML.ЗаписатьКонецЭлемента();
	
