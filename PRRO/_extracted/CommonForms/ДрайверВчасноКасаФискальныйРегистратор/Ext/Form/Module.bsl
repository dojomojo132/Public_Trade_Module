&НаКлиенте
Функция ЗакрытьЧек(ИДУстройства, НаличнаяОплата, ОплатаКартой, ОплатаКредитом, ОплатаСертификатом, СуммаЧека, НомерЧекаВозврата, НомерСозданногоЧека, ФискальныйНомерСозданногоЧека) Экспорт
	   	
	Если UseNotifications Тогда
		ТипКонтактнойИнформации = "";
		ЗначениеКонтактнойИнформации = "";
		ВвестиКонтактнуюИнформацию(ТипКонтактнойИнформации, ЗначениеКонтактнойИнформации);
		Если ЗначениеЗаполнено(ЗначениеКонтактнойИнформации) Тогда
			мКлиентскиеДанные = Новый Структура(ТипКонтактнойИнформации, ЗначениеКонтактнойИнформации);
		КонецЕсли;
	КонецЕсли; 
			
	мФискальныеДанные.receipt.Вставить("sum", СуммаЧека);
	мФискальныеДанные.receipt.Вставить("comment_up", CommentUp);
	мФискальныеДанные.receipt.Вставить("comment_down", CommentDown);
	мФискальныеДанные.receipt.Вставить("not_check_safe", Истина);

	Если НаличнаяОплата Тогда
		БезналичнаяОплата = ОплатаКартой + ОплатаКредитом + ОплатаСертификатом;
		ТочностьОкругления = ?(RoundingAccuracy = 0, HTA(), RoundingAccuracy);
		
		мФискальныеДанные.receipt.Вставить("round", Округлить(СуммаЧека - БезналичнаяОплата, ТочностьОкругления) - (СуммаЧека - БезналичнаяОплата));
		
		Оплата = Новый Структура;
		Оплата.Вставить("type", 0);
		Оплата.Вставить("sum", Округлить(СуммаЧека - БезналичнаяОплата, ТочностьОкругления));
		Оплата.Вставить("comment", "");
		Оплата.Вставить("change", Округлить(НаличнаяОплата, ТочностьОкругления) - Округлить(СуммаЧека - БезналичнаяОплата, ТочностьОкругления));
		мФискальныеДанные.receipt.pays.Добавить(Оплата);
	КонецЕсли;
	
	Если ОплатаКартой Тогда
		
		Если BatchMode И мФискальныеДанные.task = 2 Тогда
			КодRRN = "";
			ВвестиКодRRN(КодRRN, НомерЧекаВозврата);
			Если ЗначениеЗаполнено(КодRRN) Тогда
				мЭквайринговыеДанные = Новый Структура("task, refundid", 2, КодRRN);
			КонецЕсли;
		КонецЕсли;
		
		Оплата = Новый Структура;
		Оплата.Вставить("type", 2);
		Оплата.Вставить("sum", ОплатаКартой);
		Оплата.Вставить("comment", "");
		мФискальныеДанные.receipt.pays.Добавить(Оплата);
	КонецЕсли;
	
	Если ОплатаКредитом Тогда
		Оплата = Новый Структура;
		Оплата.Вставить("type", 5);
		Оплата.Вставить("sum", ОплатаКредитом);
		Оплата.Вставить("comment", "");
		мФискальныеДанные.receipt.pays.Добавить(Оплата);
	КонецЕсли;
	
	Если ОплатаСертификатом Тогда
		Оплата = Новый Структура;
		Оплата.Вставить("type", 6);
		Оплата.Вставить("sum", ОплатаСертификатом);
		Оплата.Вставить("comment", "");
		мФискальныеДанные.receipt.pays.Добавить(Оплата);
	КонецЕсли;
	
	Ответ = Неопределено;
	Результат = ВыполнитьФискальноеЗадание(Ответ);
	
	Если Результат Тогда
		НомерСозданногоЧека = Ответ["info"]["docno"];
		ФискальныйНомерСозданногоЧека = Ответ["info"]["doccode"];
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

