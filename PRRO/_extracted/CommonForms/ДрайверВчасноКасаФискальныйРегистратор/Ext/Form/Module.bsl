&НаКлиенте
Процедура ВвестиКонтактнуюИнформацию(Тип, Значение)

	ИмяФайлаVBS = ПолучитьИмяВременногоФайла("vbs");
	ИмяФайлаTXT = ПолучитьИмяВременногоФайла("txt");
	
	Скрипт = Новый ТекстовыйДокумент;
	Скрипт.УстановитьТекст(VBS(ИмяФайлаTXT, "Введіть пошту або телефон для відправки чека", ""));
	Скрипт.Записать(ИмяФайлаVBS, КодировкаТекста.UTF16);
	
	ЗапуститьПриложение("wscript """ + ИмяФайлаVBS + """", , Истина);
	
	Текст = Новый ЧтениеТекста(ИмяФайлаTXT);
	КонтактнаяИнформация = Текст.ПрочитатьСтроку();
	Текст.Закрыть();
	
	Почта = НРег(КонтактнаяИнформация);
	
	Телефон = "";
	Для Сч = 1 По СтрДлина(КонтактнаяИнформация) Цикл
		Символ = Сред(КонтактнаяИнформация, Сч, 1);
		Если КодСимвола(Символ) >= 48 И КодСимвола(Символ) <= 57 Тогда
			Телефон = Телефон + Символ;
		КонецЕсли;
	КонецЦикла;
	Телефон = "+380" + Прав(Телефон, 9);
		
	Если АдресЭлектроннойПочтыСоответствуетТребованиям(Почта) Тогда
		Тип = "email";
		Значение = Почта;
	ИначеЕсли СтрДлина(Телефон) = 13 Тогда
		Тип = "phone";
		Значение = Телефон;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ВвестиКодRRN(КодRRN, НомерЧекаВозврата)
	
	Если ЗначениеЗаполнено(НомерЧекаВозврата) Тогда
		Ответ = Неопределено;
		
		Если Не ЗначениеЗаполнено(КодRRN) Тогда
			Если ВыполнитьФискальноеЗадание(Ответ, Новый Структура("task, fiscal_number", 23, НомерЧекаВозврата)) Тогда
				Для Каждого Оплата Из Ответ["info"]["printinfo"]["pays"] Цикл
					Если Оплата["type"] = 2 Тогда
						КодRRN = Оплата["rrn"];
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(КодRRN) Тогда
			Если HTTP("GET", "https", "kasa.vchasno.ua", , "/c/" + НомерЧекаВозврата + ".json", , , , Ответ) Тогда
				Для Каждого Оплата Из Ответ["data"]["pays"] Цикл
					Если Оплата["name"] = "Картка" Тогда
						КодRRN = Оплата["rrn"];
					КонецЕсли;
				КонецЦикла; 	
			КонецЕсли;
		КонецЕсли; 
	КонецЕсли;
	
	ИмяФайлаVBS = ПолучитьИмяВременногоФайла("vbs");
	ИмяФайлаTXT = ПолучитьИмяВременногоФайла("txt");
	
	Скрипт = Новый ТекстовыйДокумент;
	Скрипт.УстановитьТекст(VBS(ИмяФайлаTXT, "Введіть унікальний код транзакції RRN", КодRRN));
	Скрипт.Записать(ИмяФайлаVBS, КодировкаТекста.UTF16);
	
	ЗапуститьПриложение("wscript """ + ИмяФайлаVBS + """", , Истина);
	
	Текст = Новый ЧтениеТекста(ИмяФайлаTXT);
	КодRRN = Текст.ПрочитатьСтроку();
	Текст.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Функция VBS(filename, prompt, default)

	Скрипт = "
	|Set fs = CreateObject(""Scripting.FileSystemObject"")
    |Set a = fs.CreateTextFile(""%filename%"", True)
    |a.WriteLine(InputBox(""%prompt%"", ""Вчасно.Каса"", ""%default%""))
    |a.Close";
	
	Скрипт = СтрЗаменить(Скрипт, "%filename%", filename);
	Скрипт = СтрЗаменить(Скрипт, "%prompt%", prompt);
	Скрипт = СтрЗаменить(Скрипт, "%default%", default);
	
	Возврат Скрипт;
	
КонецФункции

