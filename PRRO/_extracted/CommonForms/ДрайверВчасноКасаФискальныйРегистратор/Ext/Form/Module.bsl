&НаКлиенте
Функция НапечататьФискСтроку(ИДУстройства, Наименование, Количество, Цена, Сумма, Отдел, НДС, ДопРеквизиты) Экспорт
	
	Результат = Ложь;
	
	ЧтениеXML = Новый ЧтениеXML; 
	ЧтениеXML.УстановитьСтроку(ДопРеквизиты);
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.Имя = "Record" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда		
			
			СтавкаНДССтрока = ЧтениеXML.ЗначениеАтрибута("VAT");
			ЕстьАкциз = XMLЗначение(Тип("Булево"), ЧтениеXML.ЗначениеАтрибута("IsExcisable"));
			
			НоменклатураНаименование = ЧтениеXML.ЗначениеАтрибута("Nomenclature");
			УКТЗЕД = ЧтениеXML.ЗначениеАтрибута("UKTZED");
			Артикул = ЧтениеXML.ЗначениеАтрибута("VendorCode");
			ШтрихКод = ЧтениеXML.ЗначениеАтрибута("Barcode");
			ЕдИзмерения = ЧтениеXML.ЗначениеАтрибута("Dimension");
			Скидка = XMLЗначение(Тип("Число"), ЧтениеXML.ЗначениеАтрибута("Discount"));
			СуммаСкидки = XMLЗначение(Тип("Число"), ЧтениеXML.ЗначениеАтрибута("DiscountAmount"));
			ЦенаВключаетНДС = ЧтениеXML.ЗначениеАтрибута("PriceIncludeVAT");
			СуммаНДС = XMLЗначение(Тип("Число"), ЧтениеXML.ЗначениеАтрибута("AmountVAT"));
			ШтихкодАкцизнойМарки = ЧтениеXML.ЗначениеАтрибута("ExciseStampBarcode");
			
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаСоответствий = CorrespondenceTable.НайтиСтроки(Новый Структура("СтавкаНДС, ПодакцизныйТовар", СтавкаНДССтрока, ЕстьАкциз));
	
	Если ТаблицаСоответствий.Количество() = 1 Тогда
		Результат = Истина;
		
		ФискСтрока = Новый Структура;
		ФискСтрока.Вставить("code", Артикул);
		ФискСтрока.Вставить("code1", ШтрихКод);
		ФискСтрока.Вставить("code2", УКТЗЕД);
		ФискСтрока.Вставить("code3", "");
		Если Найти(ШтихкодАкцизнойМарки, ",") Тогда
			ФискСтрока.Вставить("code_aa", РазложитьСтрокуВМассивПодстрок(ШтихкодАкцизнойМарки));
		Иначе
			ФискСтрока.Вставить("code_a", ШтихкодАкцизнойМарки);
		КонецЕсли;
		ФискСтрока.Вставить("name", СтрЗаменить(Наименование, УКТЗЕД + "#", ""));
		ФискСтрока.Вставить("cnt", Количество);
		ФискСтрока.Вставить("price", Цена);
		ФискСтрока.Вставить("disc", Окр(Количество * Цена, 2) - Сумма);
		ФискСтрока.Вставить("disc_type", 0);
		ФискСтрока.Вставить("cost", Окр(Количество * Цена, 2));
		ФискСтрока.Вставить("taxgrp", ТаблицаСоответствий[0].НалоговаяГруппаРРО);
		ФискСтрока.Вставить("comment", "");
		
		мФискальныеДанные.receipt.rows.Добавить(ФискСтрока);		
	Иначе
		СформироватьОшибку(999, "Не знайдені параметри торгового устаткування (параметри оподаткування).
		|" + СтрЗаменить(Наименование, УКТЗЕД + "#", "") + "
		|Ставка ПДВ:" + Символы.НПП + СтавкаНДССтрока + "
		|Підакцизний:" + Символы.НПП + Формат(ЕстьАкциз, "БЛ=Ні; БИ=Так"));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

