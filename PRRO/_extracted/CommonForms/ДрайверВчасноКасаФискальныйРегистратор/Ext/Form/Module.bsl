&НаКлиенте
Функция ВыполнитьФискальноеЗадание(Ответ = Неопределено, ФискальныеДанные = Неопределено)
	
	АдресРесурса = "/dm/execute";
	
	Запрос = Новый Структура;
	Запрос.Вставить("ver", 6);
	Запрос.Вставить("source", мИсточник);
	Запрос.Вставить("device", Device);
	Запрос.Вставить("tag", Строка(Новый УникальныйИдентификатор));
	Запрос.Вставить("need_pf_img", 2);
	Запрос.Вставить("need_pf_pdf", 1);
	Запрос.Вставить("need_pf_txt", 1);
	Запрос.Вставить("need_pf_doccmd", 1);
	Запрос.Вставить("type", 1);
	
	Если ФискальныеДанные = Неопределено Тогда
		
		Если ЗначениеЗаполнено(мКлиентскиеДанные) Тогда
			Запрос.Вставить("userinfo", мКлиентскиеДанные);
		КонецЕсли;
		Запрос.Вставить("fiscal", мФискальныеДанные);
		Если ЗначениеЗаполнено(мЭквайринговыеДанные) Тогда
			Запрос.Вставить("pay", мЭквайринговыеДанные);
		КонецЕсли;
		
		ВыводЧека = Output;
		ИмяПринтера = ?(ВыводЧека = 1 Или ВыводЧека = 2, ЭтотОбъект["Printer" + ВыводЧека], "");
		
		Если ВыводЧека = 4 Тогда
			ВыводЧека = 0;
			ИмяПринтера = "";			
			Строки = AdvancedOutput.НайтиСтроки(Новый Структура("ФискальноеЗадание", мФискальныеДанные.task));
			Для Каждого Строка Из Строки Цикл			
				ВыводЧека = Строка.ВыводЧека;
				ИмяПринтера = ?(ВыводЧека = 1 Или ВыводЧека = 2, Строка["Принтер" + ВыводЧека], "");
			КонецЦикла;
		КонецЕсли;
		
		Если BatchMode Тогда
			АдресРесурса = "/dm/execute-pkg";
		ИначеЕсли ВыводЧека = 2 Тогда
			АдресРесурса = "/dm/execute-prn" + ?(ПустаяСтрока(ИмяПринтера), "", "?dev_id=" + ИмяПринтера);
		КонецЕсли;
		
		Результат = HTTP("POST", ?(SecureConnection, "https", "http"), Host, Port, АдресРесурса, , "JSON", Запрос, Ответ);
		
		Если Результат Тогда
			Если Ответ["res"] Тогда
				Если Ложь Тогда
				ИначеЕсли мФискальныеДанные.task = 0 И Ответ["res"] = 1096 Тогда
				Иначе
					Результат = Ложь;
					СформироватьОшибку(Ответ["res"], "Помилка при роботі DEVICE MANAGER:" + Символы.НПП + Ответ["errortxt"] + Символы.НПП + "(" + Формат(Ответ["res"], "ЧГ=0") + ")");
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Ответ["pf_image"]) Тогда
				П = Новый Структура;
				П.Вставить("Картинка", Новый Картинка(Base64Значение(СтрЗаменить(Ответ["pf_image"], "data:image/png;base64,", ""))));
				П.Вставить("ВыводЧека", ВыводЧека);
				П.Вставить("ИмяПринтера", ИмяПринтера);
				П.Вставить("Заголовок", "Перегляд чека" + ?(Ответ["info"]["doccode"] = Неопределено, "", Символы.НПП + Ответ["info"]["doccode"]));
				
				ОткрытьФорму("ОбщаяФорма.ВчасноКаса_Форма", П, , Истина);
			КонецЕсли;
		Иначе
			СформироватьОшибку(999, Ответ);
		КонецЕсли;
		
		мКлиентскиеДанные = Неопределено;
		мФискальныеДанные = Неопределено;
		мЭквайринговыеДанные = Неопределено;
		
	Иначе
		Запрос.Вставить("fiscal", ФискальныеДанные);
		Результат = HTTP("POST", ?(SecureConnection, "https", "http"), Host, Port, АдресРесурса, , "JSON", Запрос, Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция HTTP(Метод, Схема, Знач Сервер, Знач Порт = Неопределено, АдресРесурса, ЗаголовкиЗапроса = Неопределено, ТипЗапроса = Неопределено, Запрос = Неопределено, Ответ, Таймаут = 0) Экспорт
	
	Результат = Истина;
	
	Если Не ЗначениеЗаполнено(Порт) Тогда
		Порт = ?(Схема = "http", 80, 443);
	КонецЕсли;
	
	HTTPСоединение = Новый HTTPСоединение(Сервер, Порт, , , , Таймаут, ?(Схема = "http", Неопределено, Новый ЗащищенноеСоединениеOpenSSL));
	URL = Метод + ": " + Схема + "://" + Сервер + ":" + Порт + АдресРесурса;
	
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса, ?(ЗаголовкиЗапроса = Неопределено, Новый Соответствие, ЗаголовкиЗапроса));
	
	Если ТипЗапроса = "form-data" Тогда
		Разделитель = СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Разделитель);
		
		Файл = Новый Файл(Запрос);
		
		Поток = Новый ПотокВПамяти;
		ЗаписьДанных = Новый ЗаписьДанных(Поток, , , Символы.ВК + Символы.ПС, "");
		ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель);
		ЗаписьДанных.ЗаписатьСтроку("Content-Disposition: form-data; name=""file""; filename=""" + Файл.Имя + """");
		ЗаписьДанных.ЗаписатьСтроку("Content-Type: application/pdf");
		ЗаписьДанных.ЗаписатьСтроку("");
		ЗаписьДанных.Записать(Новый ДвоичныеДанные(Запрос)); 
		ЗаписьДанных.ЗаписатьСтроку("");
		ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель + "--");
		ЗаписьДанных.Закрыть();
		
		Данные = Поток.ЗакрытьИПолучитьДвоичныеДанные();	
		HTTPЗапрос.УстановитьТелоИзДвоичныхДанных(Данные);
	ИначеЕсли ТипЗапроса = "Text" Тогда
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "text/plain");
	ИначеЕсли ТипЗапроса = "JavaScript" Тогда
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/javascript");
	ИначеЕсли ТипЗапроса = "JSON" Тогда
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Запрос);
		
		ТелоЗапросаКакСтрока = ЗаписьJSON.Закрыть();
		HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапросаКакСтрока, , ИспользованиеByteOrderMark.НеИспользовать);		
	ИначеЕсли ТипЗапроса = "HTML" Тогда
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "text/html");
	ИначеЕсли ТипЗапроса = "XML" Тогда
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/xml");
	КонецЕсли;
	
	Попытка
		Если Метод = "GET" Тогда
			HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос);
		ИначеЕсли Метод = "POST" Тогда
			HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
		ИначеЕсли Метод = "PUT" Тогда
			HTTPОтвет = HTTPСоединение.Записать(HTTPЗапрос);
		ИначеЕсли Метод = "PATCH" Тогда
			HTTPОтвет = HTTPСоединение.Изменить(HTTPЗапрос);
		ИначеЕсли Метод = "DELETE" Тогда
			HTTPОтвет = HTTPСоединение.Удалить(HTTPЗапрос);
		ИначеЕсли Метод = "HEAD" Тогда
			HTTPОтвет = HTTPСоединение.ПолучитьЗаголовки(HTTPЗапрос);
		Иначе
			HTTPОтвет = HTTPСоединение.ВызватьHTTPМетод(Метод, HTTPЗапрос);
		КонецЕсли;
	Исключение
		Результат = Ложь;
		Ответ = ОписаниеОшибки();		
	КонецПопытки;
	
	Если Результат Тогда
		
		ЗаголовкиОтвета = Новый Соответствие;
		Для Каждого ЗаголовокОтвета Из HTTPОтвет.Заголовки Цикл
			ЗаголовкиОтвета.Вставить(НРег(ЗаголовокОтвета.Ключ), ЗаголовокОтвета.Значение);
		КонецЦикла;
		
		Если HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния <= 299 Тогда
			Если ЗаголовкиОтвета["content-disposition"] <> Неопределено И Найти(ЗаголовкиОтвета["content-disposition"], "Attachment") Тогда
				Ответ = Ответ + "-";
				
				ИмяФайла = ЗаголовкиОтвета["content-disposition"];
				ИмяФайла = СтрЗаменить(ИмяФайла, "Attachment; filename=", "");
				ИмяФайла = СтрЗаменить(ИмяФайла, """", "");
				ИмяФайла = Прав(ИмяФайла, 255 - СтрДлина(Ответ));
				
				Ответ = Ответ + ИмяФайла;
				
				HTTPОтвет.ПолучитьТелоКакДвоичныеДанные().Записать(Ответ);
			ИначеЕсли Найти(ЗаголовкиОтвета["content-type"], "application/json") Тогда
				ТелоОтветаКакСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();
				Если ПустаяСтрока(ТелоОтветаКакСтрока) Тогда
					ТелоОтветаКакСтрока = "{}";
				КонецЕсли;
				
				ЧтениеJSON = Новый ЧтениеJSON;
				ЧтениеJSON.УстановитьСтроку(ТелоОтветаКакСтрока);
				
				Ответ = ПрочитатьJSON(ЧтениеJSON, Истина);
			ИначеЕсли Найти(ЗаголовкиОтвета["content-type"], "text/html") Тогда
				Результат = Ложь;
				Ответ = HTTPОтвет.ПолучитьТелоКакСтроку();
			КонецЕсли; 	
		ИначеЕсли HTTPОтвет.КодСостояния >= 300 И HTTPОтвет.КодСостояния <= 399 Тогда
			Перенаправление = ЗаголовкиОтвета["location"];
			Разделитель = Найти(Перенаправление, "://");
			Схема = Лев(Перенаправление, Разделитель - 1);
			
			Перенаправление = Сред(Перенаправление, Разделитель + 3);
			Разделитель = Найти(Перенаправление, "/");
			АдресРесурса = Сред(Перенаправление, Разделитель);
			
			Перенаправление = Лев(Перенаправление, Разделитель - 1);
			Разделитель = Найти(Перенаправление, ":");
			Если Разделитель Тогда
				Сервер = Лев(Перенаправление, Разделитель - 1);
				Порт = +Сред(Перенаправление, Разделитель + 1);
			Иначе
				Сервер = Перенаправление;
				Порт = Неопределено;
			КонецЕсли;
			
			Возврат HTTP(Метод, Схема, Сервер, Порт, АдресРесурса, ЗаголовкиЗапроса, ТипЗапроса, Запрос, Ответ, Таймаут);		
		Иначе
			Результат = Ложь;
			
			Если Найти(ЗаголовкиОтвета["content-type"], "application/json") Тогда
				ЧтениеJSON = Новый ЧтениеJSON;
				ЧтениеJSON.УстановитьСтроку(HTTPОтвет.ПолучитьТелоКакСтроку());
				
				ЗаписьJSON = Новый ЗаписьJSON;
				ЗаписьJSON.УстановитьСтроку();
				
				ЗаписатьJSON(ЗаписьJSON, ПрочитатьJSON(ЧтениеJSON, Истина));
				Ответ = ЗаписьJSON.Закрыть();
			Иначе
				Ответ = HTTPОтвет.ПолучитьТелоКакСтроку();
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция РазложитьСтрокуВМассивПодстрок(Знач Стр, Разделитель = ",")
	
	МассивСтрок = Новый Массив();
	Если Разделитель = " " Тогда
		Стр = СокрЛП(Стр);
		Пока 1 = 1 Цикл
			Поз = Найти(Стр, Разделитель);
			Если Поз = 0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр, Поз - 1));
			Стр = СокрЛ(Сред(Стр, Поз));
		КонецЦикла;
	Иначе
		ДлинаРазделителя = СтрДлина(Разделитель);
		Пока 1 = 1 Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз = 0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр, Поз - 1));
			Стр = Сред(Стр, Поз + ДлинаРазделителя);
		КонецЦикла;
	КонецЕсли;
	
КонецФункции

