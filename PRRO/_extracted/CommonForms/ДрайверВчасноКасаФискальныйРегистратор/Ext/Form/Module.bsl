&НаКлиенте
Функция УстановитьПараметр(Имя, Значение) Экспорт
	
	Если Имя = "CorrespondenceTable" Тогда
		ЭтотОбъект[Имя].Очистить();
		Если Значение <> Неопределено Тогда			
			Для Каждого Элемент Из Значение Цикл
				Строка = ЭтотОбъект[Имя].Добавить();
				Строка.НалоговаяГруппаРРО = Элемент[0];
				Строка.СтавкаНДС = Элемент[1];
				Строка.ПодакцизныйТовар = Элемент[2]; 
			КонецЦикла;                        
		КонецЕсли;
	ИначеЕсли Имя = "AdvancedOutput" Тогда
		ЭтотОбъект[Имя].Очистить();
		Если Значение <> Неопределено Тогда			
			Для Каждого Элемент Из Значение Цикл
				Строка = ЭтотОбъект[Имя].Добавить();
				Строка.ФискальноеЗадание = Элемент[0];
				Строка.ВыводЧека = Элемент[1];
				Строка.Принтер = Элемент[2]; 
				Строка.Принтер1 = Элемент[3];
				Строка.Принтер2 = Элемент[4];
			КонецЦикла;
		КонецЕсли;
	Иначе
		ЭтотОбъект[Имя] = Значение;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция Подключить(ИДУстройства) Экспорт
	
	Результат = Ложь;
	
	Ответ = Неопределено;
	Заголовки = Новый Соответствие;
	Если UseAuthentication Тогда
		Заголовки.Вставить("X-Api-Key", XApiKey);	
	КонецЕсли;
	Если HTTP("GET", ?(SecureConnection, "https", "http"), Host, Port, "/dm/vchasno-kasa/api/v1/dashboard", Заголовки, , , Ответ) Тогда
		Для Каждого Устройство Из Ответ["devices"] Цикл
			Если Device = Устройство["device"] Тогда
				Результат = Истина;
				ИДУстройства = Устройство["dev_id"];
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не Результат Тогда
			СформироватьОшибку(999, "Пристрою з вказаною в запиті назвою (" + Device + ") не існує в DEVICE MANAGER. Потрібно перевірити коректність назви.");
		КонецЕсли;
	Иначе
		СформироватьОшибку(999, Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

