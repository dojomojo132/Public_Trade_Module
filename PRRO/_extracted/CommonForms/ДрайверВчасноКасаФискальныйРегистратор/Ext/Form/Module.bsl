&НаКлиенте
Функция ТестУстройства(Описание, АктивированДемоРежим) Экспорт
	
	мФискальныеДанные = Новый Структура("task", 18);
		
	Ответ = Неопределено;
	Результат = ВыполнитьФискальноеЗадание(Ответ);
	
	Если Результат Тогда
		Описание = "
		|Назва ПРРО:" + Символы.НПП + Device + "
		|Тип ПРРО:" + Символы.НПП + ?(Ответ["info"]["isFis"], "Фіскальний", "Тестовий") + "
		|Номер ПРРО:" + Символы.НПП + Ответ["info"]["fisid"] + "
		|Стан зміни:" + Символы.НПП + ?(Ответ["info"]["shift_status"], Дата(Ответ["info"]["shift_dt"]), "Закрита") + "
		|Режим роботи:" + Символы.НПП + ?(Ответ["info"]["online_status"], "Offline", "Online");
		
		Если Не Ответ["info"]["isFis"] Тогда
			АктивированДемоРежим = "Тестовий ПРРО";
		КонецЕсли;
	Иначе
		Описание = мОшибка.Описание;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

