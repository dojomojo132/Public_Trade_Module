
#Область ПрограммныйИнтерфейс

Процедура ДобавитьИнструменты(Инструменты) Экспорт
	
	ДобавитьИнструментЗначенияПеречисления(Инструменты);
	ДобавитьИнструментПредопределённыеЭлементы(Инструменты);
	ДобавитьИнструментСтруктураФормы(Инструменты);
	ДобавитьИнструментСоставПодсистемы(Инструменты);
	
КонецПроцедуры

Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт
	
	Если ИмяИнструмента = "list_enum_values" Тогда
		Возврат СписокЗначенийПеречисления(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_predefined_values" Тогда
		Возврат ПредопределённыеЭлементы(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_form_structure" Тогда
		Возврат СтруктураФормы(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_subsystem_content" Тогда
		Возврат СоставПодсистемы(Аргументы);
	Иначе
		ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ОписанияИнструментов

Процедура ДобавитьИнструментЗначенияПеречисления(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name", "string", "Имя перечисления (например, СтавкиНДС, ВидыОплаты)", , Истина));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"list_enum_values",
		"Получить список всех значений перечисления с их именами и синонимами. Используйте ПЕРЕД написанием кода, чтобы не угадывать имена значений.",
		СхемаПараметров);
	
КонецПроцедуры

Процедура ДобавитьИнструментПредопределённыеЭлементы(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	СписокТипов = "Catalogs,ChartsOfCharacteristicTypes,ChartsOfAccounts,ChartsOfCalculationTypes";
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"metaType", "string", "Тип объекта метаданных", , Истина, СписокТипов));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name", "string", "Имя объекта (например, Номенклатура, Склады)", , Истина));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_predefined_values",
		"Получить список предопределённых элементов справочника или плана видов характеристик.",
		СхемаПараметров);
	
КонецПроцедуры

Процедура ДобавитьИнструментСтруктураФормы(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	СписокТипов = "Catalogs,Documents,DataProcessors,Reports,CommonForms,ChartsOfCharacteristicTypes,InformationRegisters,AccumulationRegisters";
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"metaType", "string", "Тип объекта метаданных (для общих форм - CommonForms)", , Истина, СписокТипов));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name", "string", "Имя объекта метаданных (для CommonForms - имя формы)", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"formName", "string", "Имя формы (не нужно для CommonForms)"));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_form_structure",
		"Получить структуру формы: реквизиты формы с типами, элементы (поля, группы, таблицы, кнопки), команды формы. Используйте для анализа существующих форм ПЕРЕД модификацией.",
		СхемаПараметров);
	
КонецПроцедуры

Процедура ДобавитьИнструментСоставПодсистемы(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name", "string", "Имя подсистемы (для вложенных - через точку: РозничнаяТорговля.Касса)", , Истина));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_subsystem_content",
		"Получить состав подсистемы: список включённых объектов метаданных и дочерних подсистем.",
		СхемаПараметров);
	
КонецПроцедуры

#КонецОбласти

#Область РеализацияИнструментов

// list_enum_values - значения перечисления
//
// Параметры:
//  Аргументы - Структура - параметры инструмента
//
// Возвращаемое значение:
//  Строка - список значений перечисления
//
Функция СписокЗначенийПеречисления(Аргументы)
	
	Имя = Аргументы.name;
	
	МДПеречисления = Метаданные.Перечисления.Найти(Имя);
	Если МДПеречисления = Неопределено Тогда
		ВызватьИсключение "Перечисление не найдено: " + Имя;
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("Перечисление: " + МДПеречисления.ПолноеИмя());
	МассивСтрок.Добавить("Синоним: " + МДПеречисления.Синоним);
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("# | Имя | Синоним | Обращение в коде");
	МассивСтрок.Добавить("--- | --- | --- | ---");
	
	Индекс = 1;
	Для Каждого ЗначениеМД Из МДПеречисления.ЗначенияПеречисления Цикл
		ОбращениеВКоде = "Перечисления." + Имя + "." + ЗначениеМД.Имя;
		МассивСтрок.Добавить(
			Формат(Индекс, "ЧН=0; ЧГ=") + " | " +
			ЗначениеМД.Имя + " | " +
			ЗначениеМД.Синоним + " | " +
			ОбращениеВКоде);
		Индекс = Индекс + 1;
	КонецЦикла;
	
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("Всего значений: " + Формат(Индекс - 1, "ЧН=0; ЧГ="));
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

// get_predefined_values - предопределённые элементы справочника
//
// Параметры:
//  Аргументы - Структура - параметры инструмента
//
// Возвращаемое значение:
//  Строка - список предопределённых элементов
//
Функция ПредопределённыеЭлементы(Аргументы)
	
	МетаТип = Аргументы.metaType;
	Имя = Аргументы.name;
	
	// Маппинг английских типов в русские для запроса
	ТипДляЗапроса = "";
	Если МетаТип = "Catalogs" Тогда
		ТипДляЗапроса = "Справочник";
	ИначеЕсли МетаТип = "ChartsOfCharacteristicTypes" Тогда
		ТипДляЗапроса = "ПланВидовХарактеристик";
	ИначеЕсли МетаТип = "ChartsOfAccounts" Тогда
		ТипДляЗапроса = "ПланСчетов";
	ИначеЕсли МетаТип = "ChartsOfCalculationTypes" Тогда
		ТипДляЗапроса = "ПланВидовРасчета";
	Иначе
		ВызватьИсключение "Тип '" + МетаТип + "' не поддерживает предопределённые элементы.";
	КонецЕсли;
	
	// Проверяем существование объекта в метаданных
	Попытка
		КоллекцияМД = Метаданные[МетаТип];
	Исключение
		ВызватьИсключение "Неизвестный тип метаданных: " + МетаТип;
	КонецПопытки;
	
	МДОбъекта = КоллекцияМД.Найти(Имя);
	Если МДОбъекта = Неопределено Тогда
		ВызватьИсключение "Объект не найден: " + МетаТип + "." + Имя;
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("Объект: " + МДОбъекта.ПолноеИмя());
	МассивСтрок.Добавить("Синоним: " + МДОбъекта.Синоним);
	МассивСтрок.Добавить("");
	
	// Используем запрос для получения предопределённых элементов
	Запрос = Новый Запрос;
	// BSLLS:IncorrectQueryText-off
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ИмяПредопределенныхДанных КАК ИмяПредопр,
		|	Наименование КАК Наименование,
		|	Код КАК Код
		|ИЗ
		|	" + ТипДляЗапроса + "." + Имя + "
		|ГДЕ
		|	Предопределенный = ИСТИНА
		|	И ИмяПредопределенныхДанных <> """"
		|УПОРЯДОЧИТЬ ПО
		|	ИмяПредопределенныхДанных";
	
	Результат = Запрос.Выполнить(); // BSLLS:QueryInLoop-off
	Выборка = Результат.Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		МассивСтрок.Добавить("Предопределённых элементов нет.");
		Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	КонецЕсли;
	
	МассивСтрок.Добавить("# | Имя | Наименование | Код | Обращение в коде");
	МассивСтрок.Добавить("--- | --- | --- | --- | ---");
	
	Индекс = 1;
	Пока Выборка.Следующий() Цикл
		ОбращениеВКоде = "Справочники." + Имя + "." + Выборка.ИмяПредопр;
		МассивСтрок.Добавить(
			Формат(Индекс, "ЧН=0; ЧГ=") + " | " +
			Выборка.ИмяПредопр + " | " +
			Выборка.Наименование + " | " +
			Выборка.Код + " | " +
			ОбращениеВКоде);
		Индекс = Индекс + 1;
	КонецЦикла;
	
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("Всего предопределённых: " + Формат(Индекс - 1, "ЧН=0; ЧГ="));
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

// get_form_structure - структура формы
//
// Параметры:
//  Аргументы - Структура - параметры инструмента
//
// Возвращаемое значение:
//  Строка - описание структуры формы
//
Функция СтруктураФормы(Аргументы)
	
	МетаТип = Аргументы.metaType;
	Имя = Аргументы.name;
	
	// Для общих форм
	Если МетаТип = "CommonForms" Тогда
		МДФормы = Метаданные.ОбщиеФормы.Найти(Имя);
		Если МДФормы = Неопределено Тогда
			ВызватьИсключение "Общая форма не найдена: " + Имя;
		КонецЕсли;
		Возврат ОписатьФорму(МДФормы, "ОбщаяФорма." + Имя);
	КонецЕсли;
	
	// Для объектных форм
	Попытка
		КоллекцияМД = Метаданные[МетаТип];
	Исключение
		ВызватьИсключение "Неизвестный тип метаданных: " + МетаТип;
	КонецПопытки;
	
	МДОбъекта = КоллекцияМД.Найти(Имя);
	Если МДОбъекта = Неопределено Тогда
		ВызватьИсключение "Объект не найден: " + МетаТип + "." + Имя;
	КонецЕсли;
	
	ИмяФормы = "";
	Если Аргументы.Свойство("formName") И ЗначениеЗаполнено(Аргументы.formName) Тогда
		ИмяФормы = Аргументы.formName;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИмяФормы) Тогда
		// Если имя формы не указано - вернуть список форм объекта
		МассивСтрок = Новый Массив;
		МассивСтрок.Добавить("## Формы объекта " + МДОбъекта.ПолноеИмя());
		МассивСтрок.Добавить("");
		
		Если МДОбъекта.Формы.Количество() = 0 Тогда
			МассивСтрок.Добавить("Форм нет.");
			Возврат СтрСоединить(МассивСтрок, Символы.ПС);
		КонецЕсли;
		
		МассивСтрок.Добавить("# | Имя формы");
		МассивСтрок.Добавить("--- | ---");
		Индекс = 1;
		Для Каждого ФормаМД Из МДОбъекта.Формы Цикл
			МассивСтрок.Добавить(Формат(Индекс, "ЧН=0; ЧГ=") + " | " + ФормаМД.Имя);
			Индекс = Индекс + 1;
		КонецЦикла;
		
		МассивСтрок.Добавить("");
		МассивСтрок.Добавить("> Укажите параметр formName для детальной структуры конкретной формы.");
		
		Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	КонецЕсли;
	
	// Ищем конкретную форму
	МДФормы = МДОбъекта.Формы.Найти(ИмяФормы);
	Если МДФормы = Неопределено Тогда
		ВызватьИсключение "Форма не найдена: " + ИмяФормы
			+ " в объекте " + МДОбъекта.ПолноеИмя();
	КонецЕсли;
	
	Возврат ОписатьФорму(МДФормы, МДОбъекта.ПолноеИмя() + ".Форма." + ИмяФормы, МДОбъекта);
	
КонецФункции

// get_subsystem_content - состав подсистемы
//
// Параметры:
//  Аргументы - Структура - параметры инструмента
//
// Возвращаемое значение:
//  Строка - состав подсистемы
//
Функция СоставПодсистемы(Аргументы)
	
	Имя = Аргументы.name;
	
	// Поддержка вложенных подсистем через точку
	ЧастиИмени = СтрРазделить(Имя, ".");
	
	МДПодсистемы = Неопределено;
	ТекущаяКоллекция = Метаданные.Подсистемы;
	
	Для Индекс = 0 По ЧастиИмени.ВГраница() Цикл
		ЧастьИмени = ЧастиИмени[Индекс];
		МДПодсистемы = ТекущаяКоллекция.Найти(ЧастьИмени);
		Если МДПодсистемы = Неопределено Тогда
			ВызватьИсключение "Подсистема не найдена: " + ЧастьИмени
				+ " (полный путь: " + Имя + ")";
		КонецЕсли;
		ТекущаяКоллекция = МДПодсистемы.Подсистемы;
	КонецЦикла;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("## Подсистема: " + МДПодсистемы.ПолноеИмя());
	МассивСтрок.Добавить("Синоним: " + МДПодсистемы.Синоним);
	МассивСтрок.Добавить("");
	
	// Дочерние подсистемы
	Если МДПодсистемы.Подсистемы.Количество() > 0 Тогда
		МассивСтрок.Добавить("### Дочерние подсистемы");
		Для Каждого ДочерняяПС Из МДПодсистемы.Подсистемы Цикл
			МассивСтрок.Добавить("- " + ДочерняяПС.Имя + " (" + ДочерняяПС.Синоним + ")");
		КонецЦикла;
		МассивСтрок.Добавить("");
	КонецЕсли;
	
	// Состав подсистемы
	МассивСтрок.Добавить("### Объекты метаданных в составе");
	
	Если МДПодсистемы.Состав.Количество() = 0 Тогда
		МассивСтрок.Добавить("Состав пуст.");
	Иначе
		МассивСтрок.Добавить("");
		МассивСтрок.Добавить("# | Полное имя");
		МассивСтрок.Добавить("--- | ---");
		Индекс = 1;
		Для Каждого ЭлементСостава Из МДПодсистемы.Состав Цикл
			МассивСтрок.Добавить(Формат(Индекс, "ЧН=0; ЧГ=") + " | " + ЭлементСостава.ПолноеИмя());
			Индекс = Индекс + 1;
		КонецЦикла;
		МассивСтрок.Добавить("");
		МассивСтрок.Добавить("Всего объектов: " + Формат(Индекс - 1, "ЧН=0; ЧГ="));
	КонецЕсли;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сформировать описание формы
// Возвращает структуру объекта-владельца и пути к файлам формы.
// Метаданные формы не содержат свойств Реквизиты/Команды — они доступны только в runtime-форме.
//
// Параметры:
//  МДФормы - ОбъектМетаданных - метаданные формы
//  ПолноеИмяФормы - Строка - полное имя для заголовка
//  МДОбъекта - ОбъектМетаданных - метаданные объекта-владельца (Неопределено для общих форм)
//
// Возвращаемое значение:
//  Строка - описание структуры формы
//
Функция ОписатьФорму(МДФормы, ПолноеИмяФормы, МДОбъекта = Неопределено)
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("## Форма: " + ПолноеИмяФормы);
	МассивСтрок.Добавить("");
	
	// Если есть объект-владелец — описать его реквизиты и табличные части
	Если МДОбъекта <> Неопределено Тогда
		
		// Реквизиты объекта
		Попытка
			Реквизиты = МДОбъекта.Реквизиты;
			Если Реквизиты.Количество() > 0 Тогда
				МассивСтрок.Добавить("### Реквизиты объекта");
				МассивСтрок.Добавить("");
				МассивСтрок.Добавить("# | Имя | Тип");
				МассивСтрок.Добавить("--- | --- | ---");
				Индекс = 1;
				Для Каждого Реквизит Из Реквизиты Цикл
					МассивСтрок.Добавить(
						Формат(Индекс, "ЧН=0; ЧГ=") + " | " +
						Реквизит.Имя + " | " +
						ОписаниеТиповСтрокой(Реквизит.Тип));
					Индекс = Индекс + 1;
				КонецЦикла;
				МассивСтрок.Добавить("");
			КонецЕсли;
		Исключение
			// Объект может не иметь коллекции Реквизиты (например, перечисления)
		КонецПопытки;
		
		// Табличные части
		Попытка
			ТабличныеЧасти = МДОбъекта.ТабличныеЧасти;
			Если ТабличныеЧасти.Количество() > 0 Тогда
				МассивСтрок.Добавить("### Табличные части");
				МассивСтрок.Добавить("");
				Для Каждого ТЧ Из ТабличныеЧасти Цикл
					МассивСтрок.Добавить("#### " + ТЧ.Имя);
					МассивСтрок.Добавить("# | Имя | Тип");
					МассивСтрок.Добавить("--- | --- | ---");
					Индекс = 1;
					Для Каждого КолТЧ Из ТЧ.Реквизиты Цикл
						МассивСтрок.Добавить(
							Формат(Индекс, "ЧН=0; ЧГ=") + " | " +
							КолТЧ.Имя + " | " +
							ОписаниеТиповСтрокой(КолТЧ.Тип));
						Индекс = Индекс + 1;
					КонецЦикла;
					МассивСтрок.Добавить("");
				КонецЦикла;
			КонецЕсли;
		Исключение
			// Тип может не иметь ТЧ
		КонецПопытки;
		
	КонецЕсли;
	
	// Пути к файлам формы
	МассивСтрок.Добавить("### Файлы формы");
	МассивСтрок.Добавить("");
	
	// BSLLS:UsingHardcodePath-off
	БазовыйПуть = "D:\Git\Public_Trade_Module\";
	// BSLLS:UsingHardcodePath-on
	
	Если МДОбъекта = Неопределено Тогда
		// Общая форма
		ОтнПуть = "Конфигурация/Проверка/CommonForms/" + МДФормы.Имя;
	Иначе
		// Объектная форма — определяем папку по типу
		ПолноеИмяОбъекта = МДОбъекта.ПолноеИмя();
		ТипПапки = "";
		Если СтрНачинаетсяС(ПолноеИмяОбъекта, "Справочник.") Тогда
			ТипПапки = "Catalogs";
		ИначеЕсли СтрНачинаетсяС(ПолноеИмяОбъекта, "Документ.") Тогда
			ТипПапки = "Documents";
		ИначеЕсли СтрНачинаетсяС(ПолноеИмяОбъекта, "Обработка.") Тогда
			ТипПапки = "DataProcessors";
		ИначеЕсли СтрНачинаетсяС(ПолноеИмяОбъекта, "Отчет.") Тогда
			ТипПапки = "Reports";
		Иначе
			ТипПапки = "Unknown";
		КонецЕсли;
		ОтнПуть = "Конфигурация/Проверка/" + ТипПапки + "/" + МДОбъекта.Имя + "/Forms/" + МДФормы.Имя;
	КонецЕсли;
	
	МассивСтрок.Добавить("- **Form.xml:** " + БазовыйПуть + ОтнПуть + "/Ext/Form.xml");
	МассивСтрок.Добавить("- **Module.bsl:** " + БазовыйПуть + ОтнПуть + "/Ext/Form/Module.bsl");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("Относительный путь: " + ОтнПуть);
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("> Используйте `read_file` для чтения Form.xml (элементы, реквизиты, команды) и Module.bsl (обработчики формы).");
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

// Получить строковое описание типов
//
// Параметры:
//  ОписаниеТипов - ОписаниеТипов - описание типов реквизита
//
// Возвращаемое значение:
//  Строка - названия типов через запятую
//
Функция ОписаниеТиповСтрокой(ОписаниеТипов)
	
	МассивТипов = ОписаниеТипов.Типы();
	
	Если МассивТипов.Количество() = 0 Тогда
		Возврат "Произвольный";
	КонецЕсли;
	
	МассивИмён = Новый Массив;
	Для Каждого Тип Из МассивТипов Цикл
		Попытка
			МассивИмён.Добавить(Строка(Тип));
		Исключение
			МассивИмён.Добавить("?");
		КонецПопытки;
	КонецЦикла;
	
	Возврат СтрСоединить(МассивИмён, ", ");
	
КонецФункции

#КонецОбласти
