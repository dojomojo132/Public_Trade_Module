#Область ГенерацияОбработчиковФормы

// BSLLS:CognitiveComplexity-off
Функция ПромптГенерацияОбработчиковФормы(Аргументы)
	
	ТипОбъекта = ВРег(Аргументы.metaType);
	ИмяОбъекта = Аргументы.objectName;
	
	МДОбъект = Неопределено;
	Если ТипОбъекта = "CATALOGS" Тогда
		МДОбъект = Метаданные.Справочники.Найти(ИмяОбъекта);
	ИначеЕсли ТипОбъекта = "DOCUMENTS" Тогда
		МДОбъект = Метаданные.Документы.Найти(ИмяОбъекта);
	ИначеЕсли ТипОбъекта = "DATAPROCESSORS" Тогда
		МДОбъект = Метаданные.Обработки.Найти(ИмяОбъекта);
	ИначеЕсли ТипОбъекта = "REPORTS" Тогда
		МДОбъект = Метаданные.Отчеты.Найти(ИмяОбъекта);
	КонецЕсли;
	Если МДОбъект = Неопределено Тогда
		ВызватьИсключение "Объект '" + ИмяОбъекта + "' типа " + Аргументы.metaType + " не найден";
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("Сгенерируй модуль формы для " + МДОбъект.ПолноеИмя() + ".");
	МассивСтрок.Добавить("");
	
	// Реквизиты
	МассивСтрок.Добавить("## Реквизиты объекта");
	Если МДОбъект.Реквизиты.Количество() > 0 Тогда
		Для Каждого Рекв Из МДОбъект.Реквизиты Цикл
			МассивСтрок.Добавить("- " + Рекв.Имя + ": " + ОписаниеТипаКоротко(Рекв.Тип));
		КонецЦикла;
	Иначе
		МассивСтрок.Добавить("(нет реквизитов)");
	КонецЕсли;
	МассивСтрок.Добавить("");
	
	// Табличные части
	Если МДОбъект.ТабличныеЧасти.Количество() > 0 Тогда
		МассивСтрок.Добавить("## Табличные части");
		Для Каждого ТЧ Из МДОбъект.ТабличныеЧасти Цикл
			МассивСтрок.Добавить("### ТЧ: " + ТЧ.Имя);
			Для Каждого Кол Из ТЧ.Реквизиты Цикл
				МассивСтрок.Добавить("- " + Кол.Имя + ": " + ОписаниеТипаКоротко(Кол.Тип));
			КонецЦикла;
		КонецЦикла;
		МассивСтрок.Добавить("");
	КонецЕсли;
	
	// Требования
	МассивСтрок.Добавить("## Требуемые обработчики");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("### Обязательные");
	МассивСтрок.Добавить("- `&НаСервере` `ПриСозданииНаСервере()` — заполнение формы начальными данными");
	МассивСтрок.Добавить("- `&НаКлиенте` `ПриОткрытии()` — инициализация на клиенте");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("### Для каждого реквизита-ссылки");
	МассивСтрок.Добавить("- `ПриИзменении()` — пересчёт зависимых полей");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("### Для табличных частей");
	МассивСтрок.Добавить("- `ПриНачалеРедактирования()` — заполнение по умолчанию");
	МассивСтрок.Добавить("- `ПриОкончанииРедактирования()` — пересчёт итогов");
	МассивСтрок.Добавить("- `ПослеУдаления()` — пересчёт итогов");
	МассивСтрок.Добавить("");
	
	МассивСтрок.Добавить("## Стандарты BSL");
	МассивСтрок.Добавить("- Директивы: `&НаКлиенте`, `&НаСервере`, `&НаСервереБезКонтекста`");
	МассивСтрок.Добавить("- Области: `#Область ОбработчикиСобытийФормы`, `#Область ОбработчикиСобытийЭлементовШапки`, `#Область ОбработчикиСобытийТабличнойЧасти`, `#Область СлужебныеПроцедурыИФункции`");
	МассивСтрок.Добавить("- Все вызовы — асинхронные (`Асинх`/`Ждать`)");
	МассивСтрок.Добавить("- `Новый` (не `Новая`), `ТекущаяДатаСеанса()`");
	
	Возврат СформироватьОтветПромпта(
		"Генерация обработчиков формы " + МДОбъект.ПолноеИмя(),
		СтрСоединить(МассивСтрок, Символы.ПС));
	
КонецФункции

