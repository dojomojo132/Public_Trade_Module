#Область ДиагностикаЦелостностиДанных

// BSLLS:CognitiveComplexity-off
Функция ПромптДиагностикаЦелостностиДанных(Аргументы)
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("Составь план расследования нарушения целостности данных.");
	МассивСтрок.Добавить("");
	
	// Симптом
	Если Аргументы.Свойство("symptom") И ЗначениеЗаполнено(Аргументы.symptom) Тогда
		МассивСтрок.Добавить("## Симптом");
		МассивСтрок.Добавить(Аргументы.symptom);
		МассивСтрок.Добавить("");
	КонецЕсли;
	
	// Регистр (если указан)
	ИмяРегистра = "";
	Если Аргументы.Свойство("registerName") И ЗначениеЗаполнено(Аргументы.registerName) Тогда
		ИмяРегистра = Аргументы.registerName;
		
		// Ищем в регистрах накопления
		МДРег = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
		Если МДРег <> Неопределено Тогда
			МассивСтрок.Добавить("## Регистр накопления: " + МДРег.Имя);
			
			// Измерения
			ИзмСтр = Новый Массив;
			Для Каждого Изм Из МДРег.Измерения Цикл
				ИзмСтр.Добавить(Изм.Имя + ":" + ОписаниеТипаКоротко(Изм.Тип));
			КонецЦикла;
			МассивСтрок.Добавить("Измерения: " + СтрСоединить(ИзмСтр, ", "));
			
			// Ресурсы
			РесСтр = Новый Массив;
			Для Каждого Рес Из МДРег.Ресурсы Цикл
				РесСтр.Добавить(Рес.Имя + ":" + ОписаниеТипаКоротко(Рес.Тип));
			КонецЦикла;
			МассивСтрок.Добавить("Ресурсы: " + СтрСоединить(РесСтр, ", "));
			
			// Регистраторы
			РегСтр = Новый Массив;
			Для Каждого СтдРекв Из МДРег.СтандартныеРеквизиты Цикл
				Если СтдРекв.Имя = "Регистратор" Тогда
					Для Каждого ТекТип Из СтдРекв.Тип.Типы() Цикл
						МДТипа = Метаданные.НайтиПоТипу(ТекТип);
						Если МДТипа <> Неопределено Тогда
							РегСтр.Добавить(МДТипа.Имя);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			Если РегСтр.Количество() > 0 Тогда
				МассивСтрок.Добавить("Регистраторы: " + СтрСоединить(РегСтр, ", "));
			КонецЕсли;
			МассивСтрок.Добавить("");
		Иначе
			// Ищем в регистрах сведений
			МДРегС = Метаданные.РегистрыСведений.Найти(ИмяРегистра);
			Если МДРегС <> Неопределено Тогда
				МассивСтрок.Добавить("## Регистр сведений: " + МДРегС.Имя);
				МассивСтрок.Добавить("Периодичность: " + Строка(МДРегС.ПериодичностьРегистраСведений));
				МассивСтрок.Добавить("");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	МассивСтрок.Добавить("## План расследования");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("### Шаг 1: Проверка текущих остатков/данных");
	МассивСтрок.Добавить("Используй `get_register_data` с mode=Balance или SliceLast для получения текущих данных.");
	МассивСтрок.Добавить("Выяви аномалии: отрицательные значения, NULL, пустые ссылки.");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("### Шаг 2: Анализ движений");
	МассивСтрок.Добавить("Используй `get_register_data` с mode=All для всех записей.");
	МассивСтрок.Добавить("Найди документы-регистраторы, создавшие проблемные записи.");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("### Шаг 3: Проверка документов-регистраторов");
	МассивСтрок.Добавить("Используй `get_document_movements` для каждого подозрительного документа.");
	МассивСтрок.Добавить("Проверь: все ли ТЧ обрабатываются, правильны ли знаки (Приход/Расход).");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("### Шаг 4: Проверка модуля проведения");
	МассивСтрок.Добавить("Используй `get_object_module` для проверки кода ОбработкаПроведения.");
	МассивСтрок.Добавить("Проверь: замещение движений, условия записи, обработку Сторно.");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("### Шаг 5: Журнал регистрации");
	МассивСтрок.Добавить("Используй `get_data_history` для отслеживания изменений объекта.");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("### Шаг 6: Перепроведение");
	МассивСтрок.Добавить("Используй `post_document` для перепроведения проблемных документов.");
	МассивСтрок.Добавить("Сравни остатки до и после через `compare_periods`.");
	
	ОписаниеПромпта = "Диагностика целостности данных";
	Если ЗначениеЗаполнено(ИмяРегистра) Тогда
		ОписаниеПромпта = ОписаниеПромпта + " (" + ИмяРегистра + ")";
	КонецЕсли;
	
	Возврат СформироватьОтветПромпта(
		ОписаниеПромпта,
		СтрСоединить(МассивСтрок, Символы.ПС));
	
КонецФункции

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

Функция СформироватьОтветПромпта(Описание, Текст)
	
	Результат = Новый Структура;
	Результат.Вставить("description", Описание);
	
	СодержимоеСообщения = Новый Структура;
	СодержимоеСообщения.Вставить("type", "text");
	СодержимоеСообщения.Вставить("text", Текст);
	
	Сообщение = Новый Структура;
	Сообщение.Вставить("role", "user");
	Сообщение.Вставить("content", СодержимоеСообщения);
	
	Сообщения = Новый Массив;
	Сообщения.Добавить(Сообщение);
	
	Результат.Вставить("messages", Сообщения);
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеТипаКоротко(ОписаниеТипов)
	
	МассивТипов = ОписаниеТипов.Типы();
	
	Если МассивТипов.Количество() = 0 Тогда
		Возврат "?";
	КонецЕсли;
	
	Если МассивТипов.Количество() = 1 Тогда
		Возврат ИмяТипаКоротко(МассивТипов[0]);
	КонецЕсли;
	
	ИменаТипов = Новый Массив;
	Для Каждого ТекТип Из МассивТипов Цикл
		ИменаТипов.Добавить(ИмяТипаКоротко(ТекТип));
	КонецЦикла;
	
	Возврат СтрСоединить(ИменаТипов, "|");
	
КонецФункции

Функция ИмяТипаКоротко(ТекТип)
	
	Если ТекТип = Тип("Строка") Тогда
		Возврат "Строка";
	ИначеЕсли ТекТип = Тип("Число") Тогда
		Возврат "Число";
	ИначеЕсли ТекТип = Тип("Дата") Тогда
		Возврат "Дата";
	ИначеЕсли ТекТип = Тип("Булево") Тогда
		Возврат "Булево";
	Иначе
		МДТипа = Метаданные.НайтиПоТипу(ТекТип);
		Если МДТипа <> Неопределено Тогда
			Возврат МДТипа.ПолноеИмя();
		КонецЕсли;
		Возврат Строка(ТекТип);
	КонецЕсли;
	
КонецФункции

