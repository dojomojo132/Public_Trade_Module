#Область ПрограммныйИнтерфейс

Процедура ДобавитьПромпты(ТаблицаПромптов) Экспорт
	
	ДобавитьПромптГенерацияМодуляПроведения(ТаблицаПромптов);
	ДобавитьПромптСозданиеОбъектаМетаданных(ТаблицаПромптов);
	ДобавитьПромптДиагностикаПроведения(ТаблицаПромптов);
	ДобавитьПромптГенерацияМодуляОтчета(ТаблицаПромптов);
	ДобавитьПромптГенерацияОбработчиковФормы(ТаблицаПромптов);
	ДобавитьПромптДиагностикаЦелостностиДанных(ТаблицаПромптов);
	
КонецПроцедуры

Функция ПолучитьПромпт(ИмяПромпта, Аргументы) Экспорт
	
	Если ИмяПромпта = "generate_posting_module" Тогда
		Возврат ПромптГенерацияМодуляПроведения(Аргументы);
	ИначеЕсли ИмяПромпта = "create-metadata-object" Тогда
		Возврат ПромптСозданиеОбъектаМетаданных(Аргументы);
	ИначеЕсли ИмяПромпта = "diagnose-posting-error" Тогда
		Возврат ПромптДиагностикаПроведения(Аргументы);
	ИначеЕсли ИмяПромпта = "generate_report_module" Тогда
		Возврат ПромптГенерацияМодуляОтчета(Аргументы);
	ИначеЕсли ИмяПромпта = "generate_form_handlers" Тогда
		Возврат ПромптГенерацияОбработчиковФормы(Аргументы);
	ИначеЕсли ИмяПромпта = "diagnose_data_integrity" Тогда
		Возврат ПромптДиагностикаЦелостностиДанных(Аргументы);
	Иначе
		ВызватьИсключение "Неизвестный промпт: " + ИмяПромпта;
	КонецЕсли;
	
КонецФункции

#КонецОбласти


#Область РегистрацияПромптов

Процедура ДобавитьПромптГенерацияМодуляПроведения(ТаблицаПромптов)
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрПромпта(
		"documentName", "Имя документа (например: ПриходТовара, ЧекККМ)", Истина));
	
	mcp_Метаданные.ДобавитьПромпт(
		ТаблицаПромптов,
		"generate_posting_module",
		"Генерация модуля проведения документа: анализирует метаданные документа, его регистры движений и формирует шаблон кода обработки проведения",
		mcp_Метаданные.ПараметрыПромпта(МассивПараметров)
	);
	
КонецПроцедуры

Процедура ДобавитьПромптСозданиеОбъектаМетаданных(ТаблицаПромптов)
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрПромпта(
		"objectType", "Тип объекта: Catalog, Document, InformationRegister, AccumulationRegister, DataProcessor, Report", Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрПромпта(
		"objectName", "Имя объекта метаданных (русский CamelCase, например: НовыйДокумент)", Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрПромпта(
		"description", "Краткое описание назначения объекта"));
	
	mcp_Метаданные.ДобавитьПромпт(
		ТаблицаПромптов,
		"create-metadata-object",
		"Пошаговая инструкция создания нового объекта метаданных 1С: генерация XML, BSL-модулей, регистрация в Configuration.xml и ConfigDumpInfo.xml",
		mcp_Метаданные.ПараметрыПромпта(МассивПараметров)
	);
	
КонецПроцедуры

Процедура ДобавитьПромптДиагностикаПроведения(ТаблицаПромптов)
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрПромпта(
