		mcp_Метаданные.ПараметрыПромпта(МассивПараметров)
	);
	
КонецПроцедуры

#КонецОбласти


#Область ГенерацияМодуляПроведения

Функция ПромптГенерацияМодуляПроведения(Аргументы)
	
	ИмяДокумента = Аргументы.documentName;
	
	МДДокумент = Метаданные.Документы.Найти(ИмяДокумента);
	Если МДДокумент = Неопределено Тогда
		ВызватьИсключение "Документ не найден в метаданных: " + ИмяДокумента;
	КонецЕсли;
	
	// Собираем информацию о документе
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("Сгенерируй модуль проведения (ОбработкаПроведения) для документа " + ИмяДокумента + ".");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("## Структура документа");
	МассивСтрок.Добавить("");
	
	// Реквизиты
	МассивСтрок.Добавить("### Реквизиты шапки:");
	Для Каждого Реквизит Из МДДокумент.Реквизиты Цикл
		МассивСтрок.Добавить("- " + Реквизит.Имя + " (" + ОписаниеТипаКоротко(Реквизит.Тип) + ")");
	КонецЦикла;
	МассивСтрок.Добавить("");
	
	// Табличные части
	Для Каждого ТабЧасть Из МДДокумент.ТабличныеЧасти Цикл
		МассивСтрок.Добавить("### ТЧ " + ТабЧасть.Имя + ":");
		Для Каждого Колонка Из ТабЧасть.Реквизиты Цикл
			МассивСтрок.Добавить("- " + Колонка.Имя + " (" + ОписаниеТипаКоротко(Колонка.Тип) + ")");
		КонецЦикла;
		МассивСтрок.Добавить("");
	КонецЦикла;
	
	// Регистры движений
	МассивСтрок.Добавить("### Регистры движений:");
	Для Каждого МДРегистр Из МДДокумент.Движения Цикл
		МассивСтрок.Добавить("");
		МассивСтрок.Добавить("#### " + МДРегистр.ПолноеИмя());
		
		// Для регистров накопления
		Попытка
			МассивСтрок.Добавить("Измерения:");
			Для Каждого Измерение Из МДРегистр.Измерения Цикл
				МассивСтрок.Добавить("  - " + Измерение.Имя + " (" + ОписаниеТипаКоротко(Измерение.Тип) + ")");
			КонецЦикла;
			МассивСтрок.Добавить("Ресурсы:");
			Для Каждого Ресурс Из МДРегистр.Ресурсы Цикл
				МассивСтрок.Добавить("  - " + Ресурс.Имя + " (" + ОписаниеТипаКоротко(Ресурс.Тип) + ")");
			КонецЦикла;
		Исключение
			МассивСтрок.Добавить("  (не удалось прочитать структуру)");
		КонецПопытки;
	КонецЦикла;
	
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("## Требования к коду");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("1. Используй Запрос для получения данных из табличных частей документа");
	МассивСтрок.Добавить("2. Обертывай в НачатьТранзакцию/ЗафиксироватьТранзакцию/ОтменитьТранзакцию");
	МассивСтрок.Добавить("3. Используй БлокировкаДанных перед записью в регистры");
	МассивСтрок.Добавить("4. Сначала очищай движения: Движения.ИмяРегистра.Записать()");
	МассивСтрок.Добавить("5. Затем заполняй и записывай: Движения.ИмяРегистра.Записать(Истина)");
	МассивСтрок.Добавить("6. Помни: ключевое слово Новый (не Новая, не Новое)");
	МассивСтрок.Добавить("7. Используй ТекущаяДатаСеанса() вместо ТекущаяДата()");
	МассивСтрок.Добавить("8. Используй ЕСТЬNULL() для составных типов в запросах");
	МассивСтрок.Добавить("9. Не используй запросы в циклах - получай все одним запросом");
	
	// Формируем MCP-ответ
	Возврат СформироватьОтветПромпта(
		"Генерация модуля проведения для " + ИмяДокумента,
		СтрСоединить(МассивСтрок, Символы.ПС));
	
КонецФункции

#КонецОбласти


#Область СозданиеОбъектаМетаданных

Функция ПромптСозданиеОбъектаМетаданных(Аргументы)
	
	ТипОбъекта = Аргументы.objectType;
	ИмяОбъекта = Аргументы.objectName;
	
	Описание = "";
	Если Аргументы.Свойство("description") Тогда
		Описание = Аргументы.description;
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("Создай объект метаданных 1С:");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("- Тип: " + ТипОбъекта);
	МассивСтрок.Добавить("- Имя: " + ИмяОбъекта);
	
	Если ЗначениеЗаполнено(Описание) Тогда
		МассивСтрок.Добавить("- Назначение: " + Описание);
	КонецЕсли;
	
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("## Обязательные шаги (checklist)");
	МассивСтрок.Добавить("");
	
	// Маппинг типа → папки
	Папка = "";
	ТипConfiguration = "";
	
	Если ТипОбъекта = "Catalog" Тогда
		Папка = "Catalogs";
		ТипConfiguration = "Catalog";
	ИначеЕсли ТипОбъекта = "Document" Тогда
		Папка = "Documents";
		ТипConfiguration = "Document";
	ИначеЕсли ТипОбъекта = "InformationRegister" Тогда
		Папка = "InformationRegisters";
		ТипConfiguration = "InformationRegister";
	ИначеЕсли ТипОбъекта = "AccumulationRegister" Тогда
		Папка = "AccumulationRegisters";
		ТипConfiguration = "AccumulationRegister";
	ИначеЕсли ТипОбъекта = "DataProcessor" Тогда
		Папка = "DataProcessors";
		ТипConfiguration = "DataProcessor";
	ИначеЕсли ТипОбъекта = "Report" Тогда
		Папка = "Reports";
		ТипConfiguration = "Report";
	Иначе
		Папка = ТипОбъекта;
		ТипConfiguration = ТипОбъекта;
	КонецЕсли;
	
	МассивСтрок.Добавить("1. Создать `" + Папка + "/" + ИмяОбъекта + ".xml` из шаблона `Документация/Шаблоны/template-*.xml`");
	МассивСтрок.Добавить("2. Добавить `<" + ТипConfiguration + ">" + ИмяОбъекта + "</" + ТипConfiguration + ">` в `Configuration.xml` → `<ChildObjects>`");
	МассивСтрок.Добавить("3. Добавить `<Metadata name=""" + ТипConfiguration + "." + ИмяОбъекта + """ id=""UUID"">` в `ConfigDumpInfo.xml`");
	МассивСтрок.Добавить("4. Добавить в подсистему: `<xr:Item>" + ТипConfiguration + "." + ИмяОбъекта + "</xr:Item>`");
	
	Если ТипОбъекта = "Document" ИЛИ ТипОбъекта = "Catalog" ИЛИ ТипОбъекта = "DataProcessor" Тогда
		МассивСтрок.Добавить("5. Создать форму: `" + Папка + "/" + ИмяОбъекта + "/Forms/Форма/Ext/Form.xml` + `Module.bsl`");
		МассивСтрок.Добавить("6. Создать модуль объекта: `" + Папка + "/" + ИмяОбъекта + "/Ext/ObjectModule.bsl`");
	КонецЕсли;
	
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("## Правила генерации XML");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("- Взять шаблон из Документация/Шаблоны/ и заменить плейсхолдеры {{...}}");
	МассивСтрок.Добавить("- UUID формат: xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx (lowercase hex)");
	МассивСтрок.Добавить("- Заголовок MetaDataObject: скопировать ПОЛНОСТЬЮ все xmlns из шаблона");
	МассивСтрок.Добавить("- version=""2.20"" (не 2.0!)");
	МассивСтрок.Добавить("- InternalInfo/GeneratedType обязательны для справочников, документов, регистров");
	МассивСтрок.Добавить("- configVersion в ConfigDumpInfo: 32 hex + 00000000");
	МассивСтрок.Добавить("- ID элементов формы: AutoCommandBar=-1, остальные от 1 последовательно");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("## Правила BSL-кода");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("- Ключевое слово `Новый` (не Новая, не Новое) - единственная допустимая форма");
	МассивСтрок.Добавить("- Директивы компиляции: &НаКлиенте, &НаСервере, &НаСервереБезКонтекста");
	МассивСтрок.Добавить("- Области: весь код внутри #Область / #КонецОбласти");
	МассивСтрок.Добавить("- Асинхронность: на клиенте только Асинх/Ждать, никаких модальных");
	МассивСтрок.Добавить("- ТекущаяДатаСеанса() вместо ТекущаяДата()");
	МассивСтрок.Добавить("- ЗначениеВСтрокуВнутр() / ЗначениеИзСтрокиВнутр() (не ЗначениеВСтроку)");
	
	// Текущий состав конфигурации для контекста
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("## Текущие объекты конфигурации (для связей)");
	МассивСтрок.Добавить("");
	
	МассивСтрок.Добавить("Справочники: ");
	СписокОбъектов = Новый Массив;
	Для Каждого МД Из Метаданные.Справочники Цикл
		СписокОбъектов.Добавить(МД.Имя);
	КонецЦикла;
	МассивСтрок.Добавить(СтрСоединить(СписокОбъектов, ", "));
	
	СписокОбъектов = Новый Массив;
	МассивСтрок.Добавить("Документы: ");
	Для Каждого МД Из Метаданные.Документы Цикл
		СписокОбъектов.Добавить(МД.Имя);
	КонецЦикла;
	МассивСтрок.Добавить(СтрСоединить(СписокОбъектов, ", "));
	
	СписокОбъектов = Новый Массив;
	МассивСтрок.Добавить("Перечисления: ");
	Для Каждого МД Из Метаданные.Перечисления Цикл
		СписокОбъектов.Добавить(МД.Имя);
	КонецЦикла;
	МассивСтрок.Добавить(СтрСоединить(СписокОбъектов, ", "));
	
	Возврат СформироватьОтветПромпта(
		"Создание объекта метаданных " + ТипОбъекта + "." + ИмяОбъекта,
		СтрСоединить(МассивСтрок, Символы.ПС));
	
КонецФункции

#КонецОбласти


#Область ДиагностикаПроведения

Функция ПромптДиагностикаПроведения(Аргументы)
	
	ТипДокумента = Аргументы.documentType;
	
	ТекстОшибки = "";
	Если Аргументы.Свойство("errorText") Тогда
		ТекстОшибки = Аргументы.errorText;
	КонецЕсли;
	
	МДДокумент = Метаданные.Документы.Найти(ТипДокумента);
	Если МДДокумент = Неопределено Тогда
		ВызватьИсключение "Документ не найден в метаданных: " + ТипДокумента;
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("Проведи диагностику ошибки проведения документа " + ТипДокумента + ".");
	МассивСтрок.Добавить("");
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		МассивСтрок.Добавить("## Ошибка");
		МассивСтрок.Добавить("``" + "`");
		МассивСтрок.Добавить(ТекстОшибки);
		МассивСтрок.Добавить("`" + "``");
		МассивСтрок.Добавить("");
	КонецЕсли;
	
	МассивСтрок.Добавить("## Структура документа");
	МассивСтрок.Добавить("");
	
	// Реквизиты
	МассивСтрок.Добавить("### Реквизиты:");
	Для Каждого Реквизит Из МДДокумент.Реквизиты Цикл
		МассивСтрок.Добавить("- " + Реквизит.Имя + " (" + ОписаниеТипаКоротко(Реквизит.Тип) + ")");
	КонецЦикла;
	МассивСтрок.Добавить("");
	
	// Табличные части
	Для Каждого ТабЧасть Из МДДокумент.ТабличныеЧасти Цикл
		МассивСтрок.Добавить("### ТЧ " + ТабЧасть.Имя + ":");
		Для Каждого Колонка Из ТабЧасть.Реквизиты Цикл
			МассивСтрок.Добавить("- " + Колонка.Имя + " (" + ОписаниеТипаКоротко(Колонка.Тип) + ")");
		КонецЦикла;
		МассивСтрок.Добавить("");
	КонецЦикла;
	
	// Регистры движений
	МассивСтрок.Добавить("### Регистры движений:");
	Для Каждого МДРегистр Из МДДокумент.Движения Цикл
		МассивСтрок.Добавить("- " + МДРегистр.ПолноеИмя());
		
		Попытка
			СтрокиИзмерений = Новый Массив;
			Для Каждого Измерение Из МДРегистр.Измерения Цикл
				СтрокиИзмерений.Добавить(Измерение.Имя + ":" + ОписаниеТипаКоротко(Измерение.Тип));
			КонецЦикла;
			МассивСтрок.Добавить("  Измерения: " + СтрСоединить(СтрокиИзмерений, ", "));
			
			СтрокиРесурсов = Новый Массив;
			Для Каждого Ресурс Из МДРегистр.Ресурсы Цикл
				СтрокиРесурсов.Добавить(Ресурс.Имя + ":" + ОписаниеТипаКоротко(Ресурс.Тип));
			КонецЦикла;
			МассивСтрок.Добавить("  Ресурсы: " + СтрСоединить(СтрокиРесурсов, ", "));
		Исключение
			// Нет свойства Измерения/Ресурсы у данного типа регистра
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("## План диагностики");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("1. Прочитай модуль объекта документа через `get_object_module` → `read_file`");
	МассивСтрок.Добавить("2. Найди процедуру ОбработкаПроведения");
	МассивСтрок.Добавить("3. Проверь соответствие полей запроса реквизитам документа и табличных частей");
	МассивСтрок.Добавить("4. Проверь соответствие записей движений структуре регистров (измерения, ресурсы)");
	МассивСтрок.Добавить("5. Проверь правильность типов: ссылочные реквизиты должны быть заполнены");
	МассивСтрок.Добавить("6. Проверь наличие НачатьТранзакцию/ЗафиксироватьТранзакцию с Попытка/Исключение");
	МассивСтрок.Добавить("7. Используй `check_document_posting` для проверки фактического проведения");
	МассивСтрок.Добавить("8. Используй `get_event_log` для поиска ошибок в Журнале регистрации");
	
	Возврат СформироватьОтветПромпта(
		"Диагностика проведения " + ТипДокумента,
		СтрСоединить(МассивСтрок, Символы.ПС));
	
КонецФункции

#КонецОбласти


#Область ГенерацияМодуляОтчета

// BSLLS:CognitiveComplexity-off
Функция ПромптГенерацияМодуляОтчета(Аргументы)
	
	ИмяОтчета = Аргументы.reportName;
	МДОтчет = Метаданные.Отчеты.Найти(ИмяОтчета);
	Если МДОтчет = Неопределено Тогда
		// Список доступных отчётов
		СписокОтчетов = Новый Массив;
		Для Каждого ОтчетМД Из Метаданные.Отчеты Цикл
			СписокОтчетов.Добавить(ОтчетМД.Имя);
		КонецЦикла;
		ВызватьИсключение "Отчёт '" + ИмяОтчета + "' не найден. Доступные: " + СтрСоединить(СписокОтчетов, ", ");
	КонецЕсли;
	
	Режим = "СКД";
	Если Аргументы.Свойство("mode") И ЗначениеЗаполнено(Аргументы.mode) Тогда
		Режим = Аргументы.mode;
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("Сгенерируй модуль отчёта " + ИмяОтчета + " (режим: " + Режим + ").");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("## Метаданные отчёта");
	МассивСтрок.Добавить("- Имя: " + МДОтчет.Имя);
	МассивСтрок.Добавить("- Синоним: " + МДОтчет.Синоним);
	МассивСтрок.Добавить("");
	
	// Реквизиты отчёта
	Если МДОтчет.Реквизиты.Количество() > 0 Тогда
		МассивСтрок.Добавить("## Реквизиты отчёта");
		Для Каждого Рекв Из МДОтчет.Реквизиты Цикл
			МассивСтрок.Добавить("- " + Рекв.Имя + ": " + ОписаниеТипаКоротко(Рекв.Тип));
		КонецЦикла;
		МассивСтрок.Добавить("");
	КонецЕсли;
	
	// Все регистры для контекста
	МассивСтрок.Добавить("## Доступные регистры");
	Для Каждого РегН Из Метаданные.РегистрыНакопления Цикл
		ИзмСтр = Новый Массив;
		Для Каждого Изм Из РегН.Измерения Цикл
			ИзмСтр.Добавить(Изм.Имя);
		КонецЦикла;
		РесСтр = Новый Массив;
		Для Каждого Рес Из РегН.Ресурсы Цикл
			РесСтр.Добавить(Рес.Имя);
		КонецЦикла;
		МассивСтрок.Добавить("- **РН." + РегН.Имя + "** | Изм: " + СтрСоединить(ИзмСтр, ",") + " | Рес: " + СтрСоединить(РесСтр, ","));
	КонецЦикла;
	Для Каждого РегС Из Метаданные.РегистрыСведений Цикл
		ИзмСтр = Новый Массив;
		Для Каждого Изм Из РегС.Измерения Цикл
			ИзмСтр.Добавить(Изм.Имя);
		КонецЦикла;
		РесСтр = Новый Массив;
		Для Каждого Рес Из РегС.Ресурсы Цикл
			РесСтр.Добавить(Рес.Имя);
		КонецЦикла;
		МассивСтрок.Добавить("- **РС." + РегС.Имя + "** | Изм: " + СтрСоединить(ИзмСтр, ",") + " | Рес: " + СтрСоединить(РесСтр, ","));
	КонецЦикла;
	МассивСтрок.Добавить("");
	
	МассивСтрок.Добавить("## Требования к генерации");
	Если ВРег(Режим) = "СКД" Тогда
		МассивСтрок.Добавить("1. Использовать СКД (СхемаКомпоновкиДанных)");
		МассивСтрок.Добавить("2. Определить набор данных (запрос к виртуальным таблицам)");
		МассивСтрок.Добавить("3. Определить поля, группировки, отборы");
		МассивСтрок.Добавить("4. Использовать параметры для периода и фильтров");
		МассивСтрок.Добавить("5. В модуле: ПриКомпоновкеРезультата — установка параметров");
	Иначе
		МассивСтрок.Добавить("1. Программная генерация табличного документа");
		МассивСтрок.Добавить("2. Запрос к регистрам с параметрами");
		МассивСтрок.Добавить("3. Вывод результатов через макет");
	КонецЕсли;
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("## Стандарты BSL");
	МассивСтрок.Добавить("- Только `Новый` (не `Новая`/`Новое`)");
	МассивСтрок.Добавить("- `ТекущаяДатаСеанса()` вместо `ТекущаяДата()`");
	МассивСтрок.Добавить("- Области `#Область / #КонецОбласти`");
	МассивСтрок.Добавить("- Запросы: ЕСТЬNULL, псевдонимы, параметры");
	
	Возврат СформироватьОтветПромпта(
		"Генерация модуля отчёта " + ИмяОтчета,
		СтрСоединить(МассивСтрок, Символы.ПС));
	
КонецФункции

