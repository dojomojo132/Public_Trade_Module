Функция ИнформацияОБлокировках(Аргументы)
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("## Информация о соединениях и блокировках ИБ");
	МассивСтрок.Добавить("");
	
	// Текущий сеанс
	МассивСтрок.Добавить("### Текущий сеанс");
	МассивСтрок.Добавить("- Номер сеанса: " + Формат(НомерСеансаИнформационнойБазы(), "ЧН=0; ЧГ="));
	МассивСтрок.Добавить("- Пользователь: " + ИмяПользователя());
	МассивСтрок.Добавить("- Компьютер: " + ИмяКомпьютера());
	МассивСтрок.Добавить("- Дата сеанса: " + Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy HH:mm:ss"));
	МассивСтрок.Добавить("");
	
	// Строка соединения
	Попытка
		МассивСтрок.Добавить("### Соединение");
		МассивСтрок.Добавить("- Строка соединения: " + СтрокаСоединенияИнформационнойБазы());
	Исключение
		МассивСтрок.Добавить("### Соединение");
		МассивСтрок.Добавить("- Строка соединения: (недоступна)");
	КонецПопытки;
	МассивСтрок.Добавить("");
	
	// Попробуем получить соединения
	МассивСтрок.Добавить("### Соединения ИБ");
	Попытка
		Соединения = ПолучитьСоединенияИнформационнойБазы();
		МассивСтрок.Добавить("Всего соединений: " + Формат(Соединения.Количество(), "ЧН=0; ЧГ="));
		МассивСтрок.Добавить("");
		
		Если Соединения.Количество() > 0 Тогда
			МассивСтрок.Добавить("№ | Приложение | Пользователь | Компьютер | Начало");
			МассивСтрок.Добавить("--- | --- | --- | --- | ---");
			
			Номер = 0;
			Для Каждого Соединение Из Соединения Цикл
				Номер = Номер + 1;
				Попытка
					СтрПриложение = Строка(Соединение.ИмяПриложения);
					СтрПользователь = Строка(Соединение.Пользователь);
					СтрКомпьютер = Строка(Соединение.ИмяКомпьютера);
					СтрНачало = Формат(Соединение.НачалоСеанса, "ДФ=dd.MM.yyyy HH:mm:ss");
					МассивСтрок.Добавить(Формат(Номер, "ЧН=0; ЧГ=") + " | " + СтрПриложение + " | " + СтрПользователь + " | " + СтрКомпьютер + " | " + СтрНачало);
				Исключение
					МассивСтрок.Добавить(Формат(Номер, "ЧН=0; ЧГ=") + " | (свойства недоступны)");
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
	Исключение
		МассивСтрок.Добавить("Соединения: недоступно (файловый режим или ограничение прав)");
	КонецПопытки;
	
	МассивСтрок.Добавить("");
	
	// Монопольный режим
	МассивСтрок.Добавить("### Режим блокировки");
	Попытка
		РежимМонопольный = МонопольныйРежим();
		МассивСтрок.Добавить("- Монопольный режим: " + ?(РежимМонопольный, "Да", "Нет"));
	Исключение
		МассивСтрок.Добавить("- Монопольный режим: (проверка недоступна)");
	КонецПопытки;
	
	// Пользователи ИБ
	МассивСтрок.Добавить("");
	Пользователи = ПользователиИнформационнойБазы.ПолучитьПользователей();
	МассивСтрок.Добавить("### Пользователи ИБ: " + Формат(Пользователи.Количество(), "ЧН=0; ЧГ="));
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

#КонецОбласти

#Область ИнструментУдалениеПомеченных

Процедура ДобавитьИнструментУдалениеПомеченных(Инструменты)
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"metaType", "string", "Тип: Catalogs, Documents (пусто = все)"));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"dryRun", "boolean", "Только показать что будет удалено, не удалять (по умолчанию true)", Истина));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	mcp_Метаданные.ДобавитьИнструмент(Инструменты, "clear_deleted",
		"Удаление объектов, помеченных на удаление. По умолчанию dryRun=true (только показывает). Проверяет ссылочную целостность.", СхемаПараметров);
	
КонецПроцедуры

// BSLLS:CognitiveComplexity-off
// BSLLS:CyclomaticComplexity-off
Функция УдалениеПомеченных(Аргументы)
	
	ТолькоПоказать = Истина;
	Если Аргументы.Свойство("dryRun") Тогда
		ТолькоПоказать = НЕ (Аргументы.dryRun = Ложь ИЛИ Аргументы.dryRun = "false");
	КонецЕсли;
	
	ФильтрТип = "";
	Если Аргументы.Свойство("metaType") И ЗначениеЗаполнено(Аргументы.metaType) Тогда
		ФильтрТип = ВРег(Аргументы.metaType);
	КонецЕсли;
	
	// Собираем все помеченные на удаление
	ПомеченныеВсе = Новый Массив;
	
	Если ФильтрТип = "" ИЛИ ФильтрТип = "CATALOGS" Тогда
		Для Каждого МДСпр Из Метаданные.Справочники Цикл
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ Ссылка ИЗ Справочник." + МДСпр.Имя + " ГДЕ ПометкаУдаления = ИСТИНА";
			Попытка
				Рез = Запрос.Выполнить().Выгрузить();
				Для Каждого Стр Из Рез Цикл
					ПомеченныеВсе.Добавить(Стр.Ссылка);
				КонецЦикла;
			Исключение
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
	Если ФильтрТип = "" ИЛИ ФильтрТип = "DOCUMENTS" Тогда
		Для Каждого МДДок Из Метаданные.Документы Цикл
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ Ссылка ИЗ Документ." + МДДок.Имя + " ГДЕ ПометкаУдаления = ИСТИНА";
			Попытка
				Рез = Запрос.Выполнить().Выгрузить();
				Для Каждого Стр Из Рез Цикл
					ПомеченныеВсе.Добавить(Стр.Ссылка);
				КонецЦикла;
			Исключение
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	Если ТолькоПоказать Тогда
		МассивСтрок.Добавить("## Помечено на удаление (dryRun)");
	Иначе
		МассивСтрок.Добавить("## Удаление помеченных объектов");
	КонецЕсли;
	МассивСтрок.Добавить("Найдено: " + Формат(ПомеченныеВсе.Количество(), "ЧН=0; ЧГ="));
	
	Если ПомеченныеВсе.Количество() = 0 Тогда
		МассивСтрок.Добавить("Нет объектов, помеченных на удаление.");
		Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	КонецЕсли;
	
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("| # | Тип | Представление | Ссылки | Статус |");
	МассивСтрок.Добавить("|---|-----|---------------|--------|--------|");
	
	Удалено = 0; ЕстьСсылки = 0; ОшибокКол = 0;
	Лимит = 100;
	
	Для Индекс = 0 По Мин(ПомеченныеВсе.ВГраница(), Лимит - 1) Цикл
		Ссылка = ПомеченныеВсе[Индекс];
		Нмр = Формат(Индекс + 1, "ЧН=0; ЧГ=");
		ИмяТипа = Ссылка.Метаданные().ПолноеИмя();
		Предст = Строка(Ссылка);
		
		// Проверяем ссылочную целостность
		МассивСсылок = Новый Массив;
		МассивСсылок.Добавить(Ссылка);
		ТаблицаСсылок = НайтиПоСсылкам(МассивСсылок);
		КолСсылок = ТаблицаСсылок.Количество();
		
		Если КолСсылок > 0 Тогда
			ЕстьСсылки = ЕстьСсылки + 1;
			МассивСтрок.Добавить("| " + Нмр + " | " + ИмяТипа + " | " + Предст + " | " + Формат(КолСсылок, "ЧН=0; ЧГ=") + " | Есть ссылки |");
		ИначеЕсли ТолькоПоказать Тогда
			МассивСтрок.Добавить("| " + Нмр + " | " + ИмяТипа + " | " + Предст + " | 0 | Можно удалить |");
		Иначе
			Попытка
				Объект = Ссылка.ПолучитьОбъект();
				Объект.Удалить();
				Удалено = Удалено + 1;
				МассивСтрок.Добавить("| " + Нмр + " | " + ИмяТипа + " | " + Предст + " | 0 | Удалён |");
			Исключение
				ОшибокКол = ОшибокКол + 1;
				МассивСтрок.Добавить("| " + Нмр + " | " + ИмяТипа + " | " + Предст + " | 0 | Ошибка: " + ОписаниеОшибки() + " |");
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	Если ПомеченныеВсе.Количество() > Лимит Тогда
		МассивСтрок.Добавить("");
		МассивСтрок.Добавить("_(показано первые " + Формат(Лимит, "ЧН=0; ЧГ=") + " из " + Формат(ПомеченныеВсе.Количество(), "ЧН=0; ЧГ=") + ")_");
	КонецЕсли;
	
	МассивСтрок.Добавить("");
	Если ТолькоПоказать Тогда
		МассивСтрок.Добавить("**Итого:** помечено " + Формат(ПомеченныеВсе.Количество(), "ЧН=0; ЧГ=") + ", можно удалить " + Формат(ПомеченныеВсе.Количество() - ЕстьСсылки, "ЧН=0; ЧГ=") + ", есть ссылки " + Формат(ЕстьСсылки, "ЧН=0; ЧГ="));
		МассивСтрок.Добавить("_Запустите с dryRun=false для реального удаления_");
	Иначе
		МассивСтрок.Добавить("**Итого:** удалено " + Формат(Удалено, "ЧН=0; ЧГ=") + ", пропущено (ссылки) " + Формат(ЕстьСсылки, "ЧН=0; ЧГ=") + ", ошибок " + Формат(ОшибокКол, "ЧН=0; ЧГ="));
	КонецЕсли;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

#КонецОбласти

#Область ИнструментИсторияИзменений

Процедура ДобавитьИнструментИсторияИзменений(Инструменты)
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"metaType", "string", "Тип: Catalogs, Documents", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name", "string", "Имя объекта (например: Номенклатура)", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"searchValue", "string", "Наименование или номер для поиска конкретного элемента"));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"lastMinutes", "number", "За последние N минут (по умолчанию 1440 = 24 часа)", 1440));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"maxRows", "number", "Максимум записей (по умолчанию 50)", 50));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	mcp_Метаданные.ДобавитьИнструмент(Инструменты, "get_data_history",
		"История изменений объектов из Журнала регистрации. Показывает кто, когда и как менял данные.", СхемаПараметров);
	
КонецПроцедуры

// BSLLS:CognitiveComplexity-off
// BSLLS:CyclomaticComplexity-off
Функция ИсторияИзменений(Аргументы)
	
	ТипОбъекта = ВРег(Аргументы.metaType);
	ИмяОбъекта = Аргументы.name;
	
	МаксСтрок = 50;
	Если Аргументы.Свойство("maxRows") И ЗначениеЗаполнено(Аргументы.maxRows) Тогда
		Попытка МаксСтрок = Число(Аргументы.maxRows); Исключение КонецПопытки;
	КонецЕсли;
	
	ПоследнихМинут = 1440;
	Если Аргументы.Свойство("lastMinutes") И ЗначениеЗаполнено(Аргументы.lastMinutes) Тогда
		Попытка ПоследнихМинут = Число(Аргументы.lastMinutes); Исключение КонецПопытки;
	КонецЕсли;
	
	// Определяем полное имя метаданных
	ТипМД = "";
	МДОбъект = Неопределено;
	Если ТипОбъекта = "CATALOGS" Тогда
		МДОбъект = Метаданные.Справочники.Найти(ИмяОбъекта);
		ТипМД = "Справочник." + ИмяОбъекта;
	ИначеЕсли ТипОбъекта = "DOCUMENTS" Тогда
		МДОбъект = Метаданные.Документы.Найти(ИмяОбъекта);
		ТипМД = "Документ." + ИмяОбъекта;
	Иначе
		Возврат "Ошибка: поддерживаются типы Catalogs и Documents";
	КонецЕсли;
	Если МДОбъект = Неопределено Тогда
		Возврат "Ошибка: объект '" + ИмяОбъекта + "' не найден";
	КонецЕсли;
	
	// Ищем конкретный элемент если указан searchValue
	СсылкаОбъекта = Неопределено;
	Если Аргументы.Свойство("searchValue") И ЗначениеЗаполнено(Аргументы.searchValue) Тогда
		Если ТипОбъекта = "CATALOGS" Тогда
			СсылкаОбъекта = Справочники[ИмяОбъекта].НайтиПоНаименованию(Аргументы.searchValue, Истина);
		ИначеЕсли ТипОбъекта = "DOCUMENTS" Тогда
			СсылкаОбъекта = Документы[ИмяОбъекта].НайтиПоНомеру(Аргументы.searchValue);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СсылкаОбъекта) Тогда
			Возврат "Ошибка: '" + Аргументы.searchValue + "' не найден в " + ТипМД;
		КонецЕсли;
	КонецЕсли;
	
	// Формируем фильтр журнала регистрации
	Фильтр = Новый Структура;
	ДатаНачала = ТекущаяДатаСеанса() - ПоследнихМинут * 60;
	Фильтр.Вставить("ДатаНачала", ДатаНачала);
	
	// Фильтр по метаданным
	МассивМД = Новый Массив;
	МассивМД.Добавить(МДОбъект);
	Фильтр.Вставить("МетаданныеОтбора", МассивМД);
	
	Если СсылкаОбъекта <> Неопределено Тогда
		Фильтр.Вставить("Данные", СсылкаОбъекта);
	КонецЕсли;
	
	// Читаем журнал регистрации
	Журнал = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Журнал, Фильтр);
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("## История: " + ТипМД);
	Если СсылкаОбъекта <> Неопределено Тогда
		МассивСтрок.Добавить("Объект: " + Строка(СсылкаОбъекта));
	КонецЕсли;
	МассивСтрок.Добавить("Период: последние " + Формат(ПоследнихМинут, "ЧН=0; ЧГ=") + " мин.");
	МассивСтрок.Добавить("Записей: " + Формат(Журнал.Количество(), "ЧН=0; ЧГ="));
	
	Если Журнал.Количество() = 0 Тогда
		МассивСтрок.Добавить("");
		МассивСтрок.Добавить("Нет записей за указанный период.");
		Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	КонецЕсли;
	
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("| # | Дата | Событие | Данные | Пользователь | Комментарий |");
	МассивСтрок.Добавить("|---|------|---------|--------|-------------|-------------|");
	
	КолВывода = Мин(Журнал.Количество(), МаксСтрок);
	Для Индекс = 0 По КолВывода - 1 Цикл
		СтрЖ = Журнал[Индекс];
		Нмр = Формат(Индекс + 1, "ЧН=0; ЧГ=");
		ДатаСтр = Формат(СтрЖ.Дата, "ДФ=yyyy-MM-dd HH:mm:ss");
		Событие = Строка(СтрЖ.Событие);
		Данные = "";
		Попытка Данные = Строка(СтрЖ.Данные); Исключение КонецПопытки;
		Если СтрДлина(Данные) > 40 Тогда Данные = Лев(Данные, 40) + "..."; КонецЕсли;
		Пользователь = "";
		Попытка Пользователь = Строка(СтрЖ.ИмяПользователя); Исключение КонецПопытки;
		Комментарий = "";
		Попытка Комментарий = Строка(СтрЖ.Комментарий); Исключение КонецПопытки;
		Если СтрДлина(Комментарий) > 30 Тогда Комментарий = Лев(Комментарий, 30) + "..."; КонецЕсли;
		
		МассивСтрок.Добавить("| " + Нмр + " | " + ДатаСтр + " | " + Событие + " | " + Данные + " | " + Пользователь + " | " + Комментарий + " |");
	КонецЦикла;
	
	Если Журнал.Количество() > МаксСтрок Тогда
		МассивСтрок.Добавить("");
		МассивСтрок.Добавить("_(показано " + Формат(МаксСтрок, "ЧН=0; ЧГ=") + " из " + Формат(Журнал.Количество(), "ЧН=0; ЧГ=") + ")_");
	КонецЕсли;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

#КонецОбласти