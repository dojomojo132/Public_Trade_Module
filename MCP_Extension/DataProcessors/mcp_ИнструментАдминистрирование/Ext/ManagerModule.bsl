
#Область ПрограммныйИнтерфейс

// Регистрация инструментов обработки
//
// Параметры:
//  Инструменты - ТаблицаЗначений - таблица инструментов для заполнения
//
Процедура ДобавитьИнструменты(Инструменты) Экспорт
	
	ДобавитьИнструментСписокПользователей(Инструменты);
	ДобавитьИнструментЖурналРегистрации(Инструменты);
	ДобавитьИнструментПроведениеДокумента(Инструменты);
	ДобавитьИнструментПолучитьКонстанту(Инструменты);
	ДобавитьИнструментУстановитьКонстанту(Инструменты);
	ДобавитьИнструментРегламентныеЗадания(Инструменты);
	ДобавитьИнструментИнформацияОСеансах(Инструменты);
	ДобавитьИнструментПраваДоступа(Инструменты);
	ДобавитьИнструментБлокировки(Инструменты);
	ДобавитьИнструментУдалениеПомеченных(Инструменты);
	ДобавитьИнструментИсторияИзменений(Инструменты);
	
КонецПроцедуры

// Диспетчер выполнения инструментов
//
// Параметры:
//  ИмяИнструмента - Строка - имя вызываемого инструмента
//  Аргументы - Структура - параметры инструмента
//
// Возвращаемое значение:
//  Строка - результат выполнения
//
Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт
	
	Если ИмяИнструмента = "get_users_list" Тогда
		Возврат СписокПользователей(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_event_log" Тогда
		Возврат ПрочитатьЖурналРегистрации(Аргументы);
	ИначеЕсли ИмяИнструмента = "post_document" Тогда
		Возврат ПровестиДокумент(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_constant_value" Тогда
		Возврат ПолучитьЗначениеКонстанты(Аргументы);
	ИначеЕсли ИмяИнструмента = "set_constant_value" Тогда
		Возврат УстановитьЗначениеКонстанты(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_scheduled_jobs" Тогда
		Возврат ПолучитьРегламентныеЗадания(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_session_info" Тогда
		Возврат ИнформацияОСеансах(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_rights_info" Тогда
		Возврат ПраваДоступа(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_locks_info" Тогда
		Возврат ИнформацияОБлокировках(Аргументы);
	ИначеЕсли ИмяИнструмента = "clear_deleted" Тогда
		Возврат УдалениеПомеченных(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_data_history" Тогда
		Возврат ИсторияИзменений(Аргументы);
	Иначе
		ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ОписанияИнструментов

Процедура ДобавитьИнструментСписокПользователей(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	// Параметров нет - возвращает всех пользователей
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_users_list",
		"Получить список пользователей информационной базы с ролями и настройками аутентификации. Используйте для мониторинга безопасности и проверки после деплоя.",
		СхемаПараметров);
	
КонецПроцедуры

Процедура ДобавитьИнструментЖурналРегистрации(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"level", "string", "Уровень событий", "Error", , "Error,Warning,Information,Note"));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"lastMinutes", "number", "За последние N минут (по умолчанию 30)", 30));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"maxRows", "number", "Максимальное количество записей (по умолчанию 50)", 50));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"eventFilter", "string", "Фильтр по имени события (подстрока)"));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_event_log",
		"Прочитать журнал регистрации 1С. Возвращает ошибки, предупреждения и другие события за указанный период. Прямой доступ к ЖР без monitor-errors.ps1.",
		СхемаПараметров);
	
КонецПроцедуры

Процедура ДобавитьИнструментПроведениеДокумента(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"documentType", "string", "Имя типа документа (например, ЧекККМ, ПриходТовара)", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"documentNumber", "string", "Номер документа", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"action", "string", "Действие: post (провести) или unpost (отменить проведение)", "post", Истина, "post,unpost"));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"post_document",
		"Провести или отменить проведение документа. Используйте для тестирования модулей проведения и исправления данных.",
		СхемаПараметров);
	
КонецПроцедуры

#КонецОбласти

#Область РеализацияИнструментов

// get_users_list - список пользователей ИБ
//
// Параметры:
//  Аргументы - Структура - параметры инструмента (не используются)
//
// Возвращаемое значение:
//  Строка - таблица пользователей
//
Функция СписокПользователей(Аргументы)
	
	Пользователи = ПользователиИнформационнойБазы.ПолучитьПользователей();
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("Пользователи информационной базы");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("# | Имя | ПолноеИмя | АутОС | АутСтд | Роли");
	МассивСтрок.Добавить("--- | --- | --- | --- | --- | ---");
	
	Индекс = 1;
	Для Каждого Польз Из Пользователи Цикл
		СписокРолей = Новый Массив;
		Для Каждого Роль Из Польз.Роли Цикл
			СписокРолей.Добавить(Роль.Имя);
		КонецЦикла;
		
		МассивСтрок.Добавить(
			Формат(Индекс, "ЧН=0; ЧГ=") + " | " +
			Польз.Имя + " | " +
			Польз.ПолноеИмя + " | " +
			?(Польз.АутентификацияОС, "Да", "Нет") + " | " +
			?(Польз.АутентификацияСтандартная, "Да", "Нет") + " | " +
			СтрСоединить(СписокРолей, ", ")
		);
		Индекс = Индекс + 1;
	КонецЦикла;
	
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("Всего пользователей: " + Формат(Пользователи.Количество(), "ЧН=0; ЧГ="));
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

// get_event_log - чтение журнала регистрации
//
// Параметры:
//  Аргументы - Структура - параметры инструмента
//
// Возвращаемое значение:
//  Строка - записи журнала регистрации
//
// BSLLS:CognitiveComplexity-off
// BSLLS:CyclomaticComplexity-off
Функция ПрочитатьЖурналРегистрации(Аргументы)
	
	// Параметры с значениями по умолчанию
	Уровень = "Error";
	Если Аргументы.Свойство("level") И ЗначениеЗаполнено(Аргументы.level) Тогда
		Уровень = Аргументы.level;
	КонецЕсли;
	
	ЗаМинут = 30;
	Если Аргументы.Свойство("lastMinutes") И Аргументы.lastMinutes <> Неопределено Тогда
		ЗаМинут = Аргументы.lastMinutes;
	КонецЕсли;
	
	Лимит = 50;
	Если Аргументы.Свойство("maxRows") И Аргументы.maxRows <> Неопределено Тогда
		Лимит = Аргументы.maxRows;
	КонецЕсли;
	
	ФильтрСобытия = "";
	Если Аргументы.Свойство("eventFilter") И ЗначениеЗаполнено(Аргументы.eventFilter) Тогда
		ФильтрСобытия = Аргументы.eventFilter;
	КонецЕсли;
	
	// Формируем отбор
	Отбор = Новый Структура;
	
	Если Уровень = "Error" Тогда
		Отбор.Вставить("Уровень", УровеньЖурналаРегистрации.Ошибка);
	ИначеЕсли Уровень = "Warning" Тогда
		Отбор.Вставить("Уровень", УровеньЖурналаРегистрации.Предупреждение);
	ИначеЕсли Уровень = "Information" Тогда
		Отбор.Вставить("Уровень", УровеньЖурналаРегистрации.Информация);
	ИначеЕсли Уровень = "Note" Тогда
		Отбор.Вставить("Уровень", УровеньЖурналаРегистрации.Примечание);
	Иначе
		Отбор.Вставить("Уровень", УровеньЖурналаРегистрации.Ошибка);
	КонецЕсли;
	
	Отбор.Вставить("ДатаНачала", ТекущаяДатаСеанса() - ЗаМинут * 60);
	Отбор.Вставить("ДатаОкончания", ТекущаяДатаСеанса());
	
	// Фильтр по событию
	Если ЗначениеЗаполнено(ФильтрСобытия) Тогда
		Отбор.Вставить("Событие", ФильтрСобытия);
	КонецЕсли;
	
	// Выгрузка журнала
	СобытияЖР = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(СобытияЖР, Отбор, , , Лимит);
	
	Если СобытияЖР.Количество() = 0 Тогда
		Возврат "Записей в Журнале регистрации не найдено"
			+ Символы.ПС + "Период: последние " + Формат(ЗаМинут, "ЧН=0; ЧГ=") + " мин."
			+ Символы.ПС + "Уровень: " + Уровень
			+ ?(ЗначениеЗаполнено(ФильтрСобытия), Символы.ПС + "Фильтр: " + ФильтрСобытия, "");
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("Журнал регистрации: "
		+ Формат(СобытияЖР.Количество(), "ЧН=0; ЧГ=") + " записей"
		+ " | Уровень: " + Уровень
		+ " | Период: последние " + Формат(ЗаМинут, "ЧН=0; ЧГ=") + " мин.");
	МассивСтрок.Добавить("");
	
	Для Каждого СтрокаЖР Из СобытияЖР Цикл
		
		МассивСтрок.Добавить("---");
		МассивСтрок.Добавить("**" + Формат(СтрокаЖР.Дата, "ДФ=dd.MM.yyyy HH:mm:ss") + "** | "
			+ Строка(СтрокаЖР.Уровень));
		
		Если ЗначениеЗаполнено(СтрокаЖР.Событие) Тогда
			МассивСтрок.Добавить("Событие: " + Строка(СтрокаЖР.Событие));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаЖР.Комментарий) Тогда
			// Ограничиваем длину комментария
			Комментарий = Строка(СтрокаЖР.Комментарий);
			Если СтрДлина(Комментарий) > 500 Тогда
				Комментарий = Лев(Комментарий, 500) + "... (обрезано)";
			КонецЕсли;
			МассивСтрок.Добавить("Комментарий: " + Комментарий);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаЖР.Данные) Тогда
			МассивСтрок.Добавить("Данные: " + Строка(СтрокаЖР.Данные));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаЖР.Метаданные) Тогда
			МассивСтрок.Добавить("Метаданные: " + Строка(СтрокаЖР.Метаданные));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаЖР.Пользователь) Тогда
			МассивСтрок.Добавить("Пользователь: " + Строка(СтрокаЖР.Пользователь));
		КонецЕсли;
		
		МассивСтрок.Добавить("");
	КонецЦикла;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

// post_document - провести/отменить проведение документа
//
// Параметры:
//  Аргументы - Структура - параметры инструмента
//
// Возвращаемое значение:
//  Строка - результат операции
//
Функция ПровестиДокумент(Аргументы)
	
	ТипДокумента = Аргументы.documentType;
	НомерДокумента = Аргументы.documentNumber;
	Действие = "post";
	Если Аргументы.Свойство("action") И ЗначениеЗаполнено(Аргументы.action) Тогда
		Действие = Аргументы.action;
	КонецЕсли;
	
	// Проверяем тип документа
	МДДокумента = Метаданные.Документы.Найти(ТипДокумента);
	Если МДДокумента = Неопределено Тогда
		ВызватьИсключение "Тип документа не найден: " + ТипДокумента;
	КонецЕсли;
	
	// Ищем документ по номеру
	Менеджер = Документы[ТипДокумента];
	ДокСсылка = Менеджер.НайтиПоНомеру(НомерДокумента);
	
	Если ДокСсылка.Пустая() Тогда
		ВызватьИсключение "Документ не найден: " + ТипДокумента + " N " + НомерДокумента;
	КонецЕсли;
	
	ДокОбъект = ДокСсылка.ПолучитьОбъект();
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("Документ: " + Строка(ДокСсылка));
	МассивСтрок.Добавить("Дата: " + Формат(ДокСсылка.Дата, "ДФ=dd.MM.yyyy HH:mm:ss"));
	МассивСтрок.Добавить("Проведён до операции: " + ?(ДокСсылка.Проведен, "Да", "Нет"));
	МассивСтрок.Добавить("");
	
	Если Действие = "post" Тогда
		// Проведение
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			МассивСтрок.Добавить("Результат: документ ПРОВЕДЁН успешно.");
		Исключение
			МассивСтрок.Добавить("ОШИБКА проведения: " + ОписаниеОшибки());
		КонецПопытки;
	ИначеЕсли Действие = "unpost" Тогда
		// Отмена проведения
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			МассивСтрок.Добавить("Результат: проведение документа ОТМЕНЕНО.");
		Исключение
			МассивСтрок.Добавить("ОШИБКА отмены проведения: " + ОписаниеОшибки());
		КонецПопытки;
	Иначе
		ВызватьИсключение "Неизвестное действие: " + Действие
			+ ". Допустимые: post, unpost";
	КонецЕсли;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

#КонецОбласти

#Область ИнструментКонстанты

Процедура ДобавитьИнструментПолучитьКонстанту(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name", "string", "Имя константы (например: ОсновнойСклад, КонтролироватьОстаткиПриСписании)", , Истина));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_constant_value",
		"Получить текущее значение константы конфигурации. Возвращает имя, тип и значение.",
		СхемаПараметров);
	
КонецПроцедуры

Процедура ДобавитьИнструментУстановитьКонстанту(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name", "string", "Имя константы", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"value", "string", "Новое значение (строка, число, булево). Для ссылочных типов - код или наименование.", , Истина));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"set_constant_value",
		"Установить значение константы конфигурации. Для ссылочных типов (справочники) выполняет поиск по коду или наименованию.",
		СхемаПараметров);
	
КонецПроцедуры

// BSLLS:CognitiveComplexity-off
Функция ПолучитьЗначениеКонстанты(Аргументы)
	
	ИмяКонстанты = Аргументы.name;
	
	МДКонстанты = Метаданные.Константы.Найти(ИмяКонстанты);
	Если МДКонстанты = Неопределено Тогда
		// Пробуем вывести список доступных
		МассивИмен = Новый Массив;
		Для Каждого МДК Из Метаданные.Константы Цикл
			МассивИмен.Добавить(МДК.Имя);
		КонецЦикла;
		ВызватьИсключение "Константа не найдена: " + ИмяКонстанты
			+ ". Доступные: " + СтрСоединить(МассивИмен, ", ");
	КонецЕсли;
	
	Значение = Константы[ИмяКонстанты].Получить();
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("## Константа: " + ИмяКонстанты);
	МассивСтрок.Добавить("Синоним: " + МДКонстанты.Синоним);
	
	// Определяем тип
	МассивТипов = МДКонстанты.Тип.Типы();
	Если МассивТипов.Количество() > 0 Тогда
		ИмяТипа = Строка(МассивТипов[0]);
		МДТипа = Метаданные.НайтиПоТипу(МассивТипов[0]);
		Если МДТипа <> Неопределено Тогда
			ИмяТипа = МДТипа.ПолноеИмя();
		КонецЕсли;
		МассивСтрок.Добавить("Тип: " + ИмяТипа);
	КонецЕсли;
	
	МассивСтрок.Добавить("Значение: " + Строка(Значение));
	МассивСтрок.Добавить("Заполнено: " + ?(ЗначениеЗаполнено(Значение), "Да", "Нет"));
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

// BSLLS:CognitiveComplexity-off
// BSLLS:CyclomaticComplexity-off
Функция УстановитьЗначениеКонстанты(Аргументы)
	
	ИмяКонстанты = Аргументы.name;
	СтрокаЗначения = Аргументы.value;
	
	МДКонстанты = Метаданные.Константы.Найти(ИмяКонстанты);
	Если МДКонстанты = Неопределено Тогда
		ВызватьИсключение "Константа не найдена: " + ИмяКонстанты;
	КонецЕсли;
	
	СтароеЗначение = Константы[ИмяКонстанты].Получить();
	
	// Определяем тип и приводим значение
	МассивТипов = МДКонстанты.Тип.Типы();
	НовоеЗначение = СтрокаЗначения;
	
	Если МассивТипов.Количество() > 0 Тогда
		ПервыйТип = МассивТипов[0];
		МДТипа = Метаданные.НайтиПоТипу(ПервыйТип);
		
		Если ПервыйТип = Тип("Число") Тогда
			НовоеЗначение = Число(СтрокаЗначения);
		ИначеЕсли ПервыйТип = Тип("Булево") Тогда
			ЗначениеВРег = ВРег(СтрокаЗначения);
			НовоеЗначение = (ЗначениеВРег = "TRUE"
				ИЛИ ЗначениеВРег = "ИСТИНА"
				ИЛИ ЗначениеВРег = "ДА"
				ИЛИ ЗначениеВРег = "YES"
				ИЛИ СтрокаЗначения = "1");
		ИначеЕсли ПервыйТип = Тип("Дата") Тогда
			Если СтрДлина(СтрокаЗначения) >= 10 Тогда
				Год = Число(Лев(СтрокаЗначения, 4));
				Месяц = Число(Сред(СтрокаЗначения, 6, 2));
				День = Число(Сред(СтрокаЗначения, 9, 2));
				НовоеЗначение = Дата(Год, Месяц, День);
			КонецЕсли;
		ИначеЕсли МДТипа <> Неопределено Тогда
			// Ссылочный тип
			ПолноеИмя = МДТипа.ПолноеИмя();
			Если СтрНачинаетсяС(ПолноеИмя, "Справочник.") Тогда
				ИмяСпр = Сред(ПолноеИмя, 13);
				Менеджер = Справочники[ИмяСпр];
				НовоеЗначение = Менеджер.НайтиПоКоду(СтрокаЗначения);
				Если НовоеЗначение.Пустая() Тогда
					НовоеЗначение = Менеджер.НайтиПоНаименованию(СтрокаЗначения, Истина);
				КонецЕсли;
				Если НовоеЗначение.Пустая() Тогда
					ВызватьИсключение "Элемент справочника не найден: " + ИмяСпр + " = '" + СтрокаЗначения + "'";
				КонецЕсли;
			ИначеЕсли СтрНачинаетсяС(ПолноеИмя, "Перечисление.") Тогда
				ИмяПеречисления = Сред(ПолноеИмя, 14);
				Попытка
					НовоеЗначение = Перечисления[ИмяПеречисления][СтрокаЗначения];
				Исключение
					ВызватьИсключение "Значение перечисления не найдено: " + ПолноеИмя + "." + СтрокаЗначения;
				КонецПопытки;
			Иначе
				ВызватьИсключение "Установка значений типа '" + ПолноеИмя + "' не поддерживается";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Константы[ИмяКонстанты].Установить(НовоеЗначение);
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("OK: Константа " + ИмяКонстанты + " обновлена");
	МассивСтрок.Добавить("Старое значение: " + Строка(СтароеЗначение));
	МассивСтрок.Добавить("Новое значение: " + Строка(НовоеЗначение));
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

#КонецОбласти


