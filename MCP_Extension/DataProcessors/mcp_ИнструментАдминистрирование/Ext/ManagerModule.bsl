		СхемаПараметров);
	
КонецПроцедуры

Функция ПраваДоступа(Аргументы)
	
	ТипОбъекта = Аргументы.metaType;
	ИмяОбъекта = Аргументы.name;
	
	// Определяем пользователя
	ПользовательИБ = Неопределено;
	Если Аргументы.Свойство("userName") И ЗначениеЗаполнено(Аргументы.userName) Тогда
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Аргументы.userName);
		Если ПользовательИБ = Неопределено Тогда
			Возврат "Ошибка: пользователь '" + Аргументы.userName + "' не найден в ИБ";
		КонецЕсли;
	КонецЕсли;
	
	// Находим объект метаданных
	МДОбъект = Неопределено;
	ТипВРег = ВРег(ТипОбъекта);
	
	Если ТипВРег = "CATALOGS" Тогда
		МДОбъект = Метаданные.Справочники.Найти(ИмяОбъекта);
	ИначеЕсли ТипВРег = "DOCUMENTS" Тогда
		МДОбъект = Метаданные.Документы.Найти(ИмяОбъекта);
	ИначеЕсли ТипВРег = "DATAPROCESSORS" Тогда
		МДОбъект = Метаданные.Обработки.Найти(ИмяОбъекта);
	ИначеЕсли ТипВРег = "REPORTS" Тогда
		МДОбъект = Метаданные.Отчеты.Найти(ИмяОбъекта);
	ИначеЕсли ТипВРег = "INFORMATIONREGISTERS" Тогда
		МДОбъект = Метаданные.РегистрыСведений.Найти(ИмяОбъекта);
	ИначеЕсли ТипВРег = "ACCUMULATIONREGISTERS" Тогда
		МДОбъект = Метаданные.РегистрыНакопления.Найти(ИмяОбъекта);
	КонецЕсли;
	
	Если МДОбъект = Неопределено Тогда
		Возврат "Ошибка: объект " + ТипОбъекта + "." + ИмяОбъекта + " не найден";
	КонецЕсли;
	
	// Список всех возможных прав
	ВсеПрава = Новый Массив;
	ВсеПрава.Добавить("Чтение");
	ВсеПрава.Добавить("Добавление");
	ВсеПрава.Добавить("Изменение");
	ВсеПрава.Добавить("Удаление");
	ВсеПрава.Добавить("Просмотр");
	ВсеПрава.Добавить("ИнтерактивноеДобавление");
	ВсеПрава.Добавить("Редактирование");
	ВсеПрава.Добавить("ИнтерактивноеУдаление");
	ВсеПрава.Добавить("ИнтерактивнаяПометкаУдаления");
	ВсеПрава.Добавить("ИнтерактивноеСнятиеПометкиУдаления");
	ВсеПрава.Добавить("Проведение");
	ВсеПрава.Добавить("ОтменаПроведения");
	ВсеПрава.Добавить("ИнтерактивноеПроведение");
	ВсеПрава.Добавить("ИнтерактивнаяОтменаПроведения");
	ВсеПрава.Добавить("ИнтерактивноеИзменениеПроведенных");
	ВсеПрава.Добавить("Использование");
	ВсеПрава.Добавить("ВводПоСтроке");
	
	МассивСтрок = Новый Массив;
	
	ИмяПользователяТекст = ?(ПользовательИБ = Неопределено, ИмяПользователя(), Аргументы.userName);
	МассивСтрок.Добавить("## Права доступа: " + ТипОбъекта + "." + ИмяОбъекта);
	МассивСтрок.Добавить("**Пользователь:** " + ИмяПользователяТекст);
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("Право | Доступ");
	МассивСтрок.Добавить("--- | ---");
	
	КоличествоДоступных = 0;
	
	Для Каждого ИмяПрава Из ВсеПрава Цикл
		Попытка
			Если ПользовательИБ = Неопределено Тогда
				ЕстьПраво = ПравоДоступа(ИмяПрава, МДОбъект);
			Иначе
				ЕстьПраво = ПравоДоступа(ИмяПрава, МДОбъект, ПользовательИБ);
			КонецЕсли;
			
			МассивСтрок.Добавить(ИмяПрава + " | " + ?(ЕстьПраво, "Да", "Нет"));
			
			Если ЕстьПраво Тогда
				КоличествоДоступных = КоличествоДоступных + 1;
			КонецЕсли;
		Исключение
			// Право не применимо к данному типу объекта - пропускаем
		КонецПопытки;
	КонецЦикла;
	
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("**Итого:** доступно прав: " + Формат(КоличествоДоступных, "ЧН=0; ЧГ="));
	
	// Роли пользователя
	Если ПользовательИБ <> Неопределено Тогда
		МассивСтрок.Добавить("");
		МассивСтрок.Добавить("### Роли пользователя");
		Для Каждого ТекРоль Из ПользовательИБ.Роли Цикл
			МассивСтрок.Добавить("- " + ТекРоль.Имя);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

#КонецОбласти

