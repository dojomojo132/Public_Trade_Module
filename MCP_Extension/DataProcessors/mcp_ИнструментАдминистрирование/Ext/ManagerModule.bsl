Функция ПолучитьРегламентныеЗадания(Аргументы)
	
	Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания();
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("## Регламентные задания (" + Формат(Задания.Количество(), "ЧН=0; ЧГ=") + ")");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("# | Имя | Использование | Предопределённое | ПоследнийЗапуск");
	МассивСтрок.Добавить("--- | --- | --- | --- | ---");
	
	Индекс = 1;
	Для Каждого Задание Из Задания Цикл
		
		ИмяЗадания = "";
		Если Задание.Метаданные <> Неопределено Тогда
			ИмяЗадания = Задание.Метаданные.Имя;
		Иначе
			ИмяЗадания = Строка(Задание.Наименование);
		КонецЕсли;
		
		ДатаПоследнегоЗапуска = "";
		Попытка
			Если Задание.ПоследнийЗапуск <> '00010101' Тогда
				ДатаПоследнегоЗапуска = Формат(Задание.ПоследнийЗапуск, "ДФ=dd.MM.yyyy HH:mm:ss");
			КонецЕсли;
		Исключение
			ДатаПоследнегоЗапуска = "(ошибка)";
		КонецПопытки;
		
		МассивСтрок.Добавить(
			Формат(Индекс, "ЧН=0; ЧГ=") + " | " +
			ИмяЗадания + " | " +
			?(Задание.Использование, "Включено", "Выключено") + " | " +
			?(Задание.Предопределенное, "Да", "Нет") + " | " +
			ДатаПоследнегоЗапуска);
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

