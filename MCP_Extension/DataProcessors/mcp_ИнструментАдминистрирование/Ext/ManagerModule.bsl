Процедура ДобавитьИнструментПраваДоступа(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"metaType", "string", "Тип объекта: Catalogs, Documents, DataProcessors, Reports, InformationRegisters, AccumulationRegisters", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name", "string", "Имя объекта метаданных", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
