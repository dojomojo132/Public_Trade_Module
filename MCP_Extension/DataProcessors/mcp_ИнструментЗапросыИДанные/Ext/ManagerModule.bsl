#Область РеализацияИнструментов

// execute_query - выполнение произвольного запроса 1С
//
// Параметры:
//  Аргументы - Структура - параметры инструмента
//
// Возвращаемое значение:
//  Строка - результат в формате Markdown-таблицы
//
Функция ВыполнитьЗапрос(Аргументы)
	
	ТекстЗапроса = Аргументы.queryText;
	Лимит = 100;
	Если Аргументы.Свойство("maxRows") И Аргументы.maxRows <> Неопределено Тогда
		Лимит = Аргументы.maxRows;
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Попытка
		Результат = Запрос.Выполнить();
	Исключение
		ВызватьИсключение "Ошибка выполнения запроса: " + ОписаниеОшибки();
	КонецПопытки;
	
	Если Результат.Пустой() Тогда
		Возврат "Запрос вернул пустой результат (0 строк).";
	КонецЕсли;
	
	Возврат ТаблицаВТекст(Результат.Выгрузить(), Лимит);
	
КонецФункции

// get_register_data - чтение данных регистра
//
// Параметры:
//  Аргументы - Структура - параметры инструмента
//
// Возвращаемое значение:
//  Строка - результат в формате Markdown-таблицы
//
// BSLLS:CognitiveComplexity-off
// BSLLS:CyclomaticComplexity-off
Функция ПолучитьДанныеРегистра(Аргументы)
	
	ТипРегистра = Аргументы.registerType;
	ИмяРегистра = Аргументы.name;
	
	Режим = "All";
	Если Аргументы.Свойство("mode") И Аргументы.mode <> Неопределено Тогда
		Режим = Аргументы.mode;
	КонецЕсли;
	
	Лимит = 100;
	Если Аргументы.Свойство("maxRows") И Аргументы.maxRows <> Неопределено Тогда
		Лимит = Аргументы.maxRows;
	КонецЕсли;
	
	// Проверяем существование регистра
	Попытка
		КоллекцияМД = Метаданные[ТипРегистра];
	Исключение
		ВызватьИсключение "Неизвестный тип регистра: " + ТипРегистра;
	КонецПопытки;
	
	МДРегистра = КоллекцияМД.Найти(ИмяРегистра);
	Если МДРегистра = Неопределено Тогда
		ВызватьИсключение "Регистр не найден: " + ТипРегистра + "." + ИмяРегистра;
	КонецЕсли;
	
	// Строим текст запроса в зависимости от режима
	ПолноеИмяРегистра = МДРегистра.ПолноеИмя();
	СтрокаЛимит = Формат(Лимит, "ЧН=; ЧГ=");
	
	Если Режим = "Balance" И ТипРегистра = "AccumulationRegisters" Тогда
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + СтрокаЛимит + " * ИЗ " + ПолноеИмяРегистра + ".Остатки()";
	ИначеЕсли Режим = "Turnovers" И ТипРегистра = "AccumulationRegisters" Тогда
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + СтрокаЛимит + " * ИЗ " + ПолноеИмяРегистра + ".Обороты()";
	ИначеЕсли Режим = "SliceLast" И ТипРегистра = "InformationRegisters" Тогда
		// Проверяем периодичность регистра - СрезПоследних доступен только для периодических
		Если МДРегистра.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
			// Непериодический регистр - СрезПоследних не поддерживается, возвращаем все записи
			ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + СтрокаЛимит + " * ИЗ " + ПолноеИмяРегистра;
			Режим = "All (fallback из SliceLast: регистр непериодический)";
		Иначе
			ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + СтрокаЛимит + " * ИЗ " + ПолноеИмяРегистра + ".СрезПоследних()";
		КонецЕсли;
	ИначеЕсли Режим = "Balance" И ТипРегистра = "InformationRegisters" Тогда
		// Balance не поддерживается для регистров сведений
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + СтрокаЛимит + " * ИЗ " + ПолноеИмяРегистра;
		Режим = "All (fallback из Balance: регистр сведений не имеет остатков)";
	ИначеЕсли Режим = "Turnovers" И ТипРегистра = "InformationRegisters" Тогда
		// Turnovers не поддерживается для регистров сведений
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + СтрокаЛимит + " * ИЗ " + ПолноеИмяРегистра;
		Режим = "All (fallback из Turnovers: регистр сведений не имеет оборотов)";
	ИначеЕсли Режим = "SliceLast" И ТипРегистра = "AccumulationRegisters" Тогда
		// SliceLast не поддерживается для регистров накопления
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + СтрокаЛимит + " * ИЗ " + ПолноеИмяРегистра;
		Режим = "All (fallback из SliceLast: регистр накопления)";
	Иначе
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + СтрокаЛимит + " * ИЗ " + ПолноеИмяРегистра;
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Попытка
		Результат = Запрос.Выполнить();
	Исключение
		ВызватьИсключение "Ошибка запроса к регистру " + ИмяРегистра + " (режим " + Режим + "): " + ОписаниеОшибки();
	КонецПопытки;
	
	Если Результат.Пустой() Тогда
		Возврат "Регистр " + ИмяРегистра + " (режим " + Режим + "): нет данных.";
	КонецЕсли;
	
	Заголовок = "Регистр: " + ПолноеИмяРегистра + " | Режим: " + Режим + Символы.ПС + Символы.ПС;
	Возврат Заголовок + ТаблицаВТекст(Результат.Выгрузить(), Лимит);
	
КонецФункции

// get_document_movements - движения документа по всем регистрам
//
// Параметры:
//  Аргументы - Структура - параметры инструмента
//
// Возвращаемое значение:
//  Строка - результат с движениями по регистрам
//
Функция ПолучитьДвиженияДокумента(Аргументы)
	
	ТипДокумента = Аргументы.documentType;
	НомерДокумента = Аргументы.documentNumber;
	
	Лимит = 50;
	Если Аргументы.Свойство("maxRows") И Аргументы.maxRows <> Неопределено Тогда
		Лимит = Аргументы.maxRows;
	КонецЕсли;
	
	// Найти метаданные документа
	МДДокумента = Метаданные.Документы.Найти(ТипДокумента);
	Если МДДокумента = Неопределено Тогда
		ВызватьИсключение "Тип документа не найден: " + ТипДокумента;
	КонецЕсли;
	
	// Найти документ по номеру
	Менеджер = Документы[ТипДокумента];
	ДокСсылка = Менеджер.НайтиПоНомеру(НомерДокумента);
	
	Если ДокСсылка.Пустая() Тогда
		ВызватьИсключение "Документ не найден: " + ТипДокумента + " №" + НомерДокумента;
	КонецЕсли;
	
	РезультатМассив = Новый Массив;
	РезультатМассив.Добавить("Документ: " + Строка(ДокСсылка) + " от " + Формат(ДокСсылка.Дата, "ДФ=dd.MM.yyyy HH:mm:ss"));
	РезультатМассив.Добавить("Проведён: " + ?(ДокСсылка.Проведен, "Да", "Нет"));
	РезультатМассив.Добавить("");
	
	// Обойти все регистры, в которых документ может делать движения
	// BSLLS:QueryInLoop-off - каждый запрос к разному регистру, батчинг невозможен
	Для Каждого РегМД Из МДДокумента.Движения Цикл
		
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧН=; ЧГ=") +
			" * ИЗ " + РегМД.ПолноеИмя() +
			" ГДЕ Регистратор = &Регистратор";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Регистратор", ДокСсылка);
		
		Попытка
			Результат = Запрос.Выполнить(); // BSLLS:QueryInLoop-off
		Исключение
			РезультатМассив.Добавить("--- " + РегМД.ПолноеИмя() + " ---");
			РезультатМассив.Добавить("Ошибка чтения: " + ОписаниеОшибки());
			РезультатМассив.Добавить("");
			Продолжить;
		КонецПопытки;
		
		Если Результат.Пустой() Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаДвижений = Результат.Выгрузить();
		
		РезультатМассив.Добавить("=== " + РегМД.ПолноеИмя() + " (" + Формат(ТаблицаДвижений.Количество(), "ЧН=0; ЧГ=") + " записей) ===");
		РезультатМассив.Добавить(ТаблицаВТекст(ТаблицаДвижений, Лимит));
		РезультатМассив.Добавить("");
		
	КонецЦикла;
	
	Если РезультатМассив.Количество() = 3 Тогда
		РезультатМассив.Добавить("Движений не найдено.");
	КонецЕсли;
	
	Возврат СтрСоединить(РезультатМассив, Символы.ПС);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Преобразует таблицу значений в текстовое представление (Markdown-таблица)
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений - таблица для преобразования
//  Лимит - Число - максимальное количество строк
//
// Возвращаемое значение:
//  Строка - текстовое представление таблицы
//
Функция ТаблицаВТекст(ТаблицаЗначений, Лимит)
	
	Колонки = ТаблицаЗначений.Колонки;
	
	Если Колонки.Количество() = 0 Тогда
		Возврат "(Нет колонок)";
	КонецЕсли;
	
	// Формируем заголовок
	МассивКолонок = Новый Массив;
	МассивРазделителей = Новый Массив;
	Для Каждого Колонка Из Колонки Цикл
		МассивКолонок.Добавить(Колонка.Имя);
		МассивРазделителей.Добавить("---");
	КонецЦикла;
	
	СтрокиРезультата = Новый Массив;
	СтрокиРезультата.Добавить(СтрСоединить(МассивКолонок, " | "));
	СтрокиРезультата.Добавить(СтрСоединить(МассивРазделителей, " | "));
	
	// Данные
	Счетчик = 0;
	Для Каждого Строка Из ТаблицаЗначений Цикл
		
		Если Счетчик >= Лимит Тогда
			Прервать;
		КонецЕсли;
		
		МассивЗначений = Новый Массив;
		Для Каждого Колонка Из Колонки Цикл
			Значение = Строка[Колонка.Имя];
			Если Значение = Неопределено ИЛИ Значение = NULL Тогда
				МассивЗначений.Добавить("");
			Иначе
				ТекстЗначения = Строка(Значение);
				// Экранируем символ | в значениях
				ТекстЗначения = СтрЗаменить(ТекстЗначения, "|", "\|");
				МассивЗначений.Добавить(ТекстЗначения);
			КонецЕсли;
		КонецЦикла;
		
		СтрокиРезультата.Добавить(СтрСоединить(МассивЗначений, " | "));
		Счетчик = Счетчик + 1;
		
	КонецЦикла;
	
	ВсегоСтрок = ТаблицаЗначений.Количество();
	Если ВсегоСтрок > Лимит Тогда
		СтрокиРезультата.Добавить("... ещё " + Формат(ВсегоСтрок - Лимит, "ЧН=0; ЧГ=") + " строк (ограничение maxRows=" + Формат(Лимит, "ЧН=0; ЧГ=") + ")");
	КонецЕсли;
	
	СтрокиРезультата.Добавить("");
	СтрокиРезультата.Добавить("Всего строк: " + Формат(ВсегоСтрок, "ЧН=0; ЧГ="));
	
	Возврат СтрСоединить(СтрокиРезультата, Символы.ПС);
	
КонецФункции

#КонецОбласти


#Область ИнструментПоискДанных

Процедура ДобавитьИнструментПоискДанных(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"metaType", "string", "Тип объекта: Catalogs, Documents", , Истина,
		"Catalogs,Documents"));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name", "string", "Имя объекта (например: Номенклатура, ПриходТовара)", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"searchText", "string", "Текст для поиска (ищет в Наименовании/Коде/Номере)", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"maxRows", "number", "Максимум результатов (по умолчанию 50)", 50));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"search_data",
		"Полнотекстовый поиск элементов справочника или документов по подстроке в Наименовании/Коде/Номере. Быстрый способ найти объект.",
		СхемаПараметров);
	
КонецПроцедуры

// BSLLS:CognitiveComplexity-off
Функция ПоискДанных(Аргументы)
	
	ТипМета = Аргументы.metaType;
	ИмяОбъекта = Аргументы.name;
	ТекстПоиска = Аргументы.searchText;
	
	Лимит = 50;
	Если Аргументы.Свойство("maxRows") Тогда
		Лимит = Аргументы.maxRows;
	КонецЕсли;
	
	СтрокаЛимит = Формат(Лимит, "ЧН=0; ЧГ=");
	
	ТекстЗапроса = "";
	
	Если ТипМета = "Catalogs" Тогда
		МД = Метаданные.Справочники.Найти(ИмяОбъекта);
		Если МД = Неопределено Тогда
			ВызватьИсключение "Справочник не найден: " + ИмяОбъекта;
		КонецЕсли;
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + СтрокаЛимит
			+ " Ссылка КАК Ссылка, Код КАК Код, Наименование КАК Наименование, ПометкаУдаления КАК ПометкаУдаления"
			+ " ИЗ Справочник." + ИмяОбъекта
			+ " ГДЕ Наименование ПОДОБНО &Текст ИЛИ Код ПОДОБНО &Текст";
	ИначеЕсли ТипМета = "Documents" Тогда
		МД = Метаданные.Документы.Найти(ИмяОбъекта);
		Если МД = Неопределено Тогда
			ВызватьИсключение "Документ не найден: " + ИмяОбъекта;
		КонецЕсли;
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + СтрокаЛимит
			+ " Ссылка КАК Ссылка, Номер КАК Номер, Дата КАК Дата, Проведен КАК Проведен"
			+ " ИЗ Документ." + ИмяОбъекта
			+ " ГДЕ Номер ПОДОБНО &Текст"
			+ " УПОРЯДОЧИТЬ ПО Дата УБЫВ";
	Иначе
		ВызватьИсключение "Поддерживаемые типы: Catalogs, Documents. Получено: " + ТипМета;
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Текст", "%" + ТекстПоиска + "%");
	
	ТаблицаРезультата = Запрос.Выполнить().Выгрузить();
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("## Поиск в " + ТипМета + "." + ИмяОбъекта + ": '" + ТекстПоиска + "'");
	МассивСтрок.Добавить("Найдено: " + Формат(ТаблицаРезультата.Количество(), "ЧН=0; ЧГ="));
	МассивСтрок.Добавить("");
	
	Если ТаблицаРезультата.Количество() = 0 Тогда
		Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	КонецЕсли;
	
	// Заголовок таблицы
	МассивКолонок = Новый Массив;
	Для Каждого Колонка Из ТаблицаРезультата.Колонки Цикл
		МассивКолонок.Добавить(Колонка.Имя);
	КонецЦикла;
	МассивСтрок.Добавить(СтрСоединить(МассивКолонок, " | "));
	
	// Разделитель
	МассивРазделителей = Новый Массив;
	Для Каждого Колонка Из ТаблицаРезультата.Колонки Цикл
		МассивРазделителей.Добавить("---");
	КонецЦикла;
	МассивСтрок.Добавить(СтрСоединить(МассивРазделителей, " | "));
	
	// Данные
	Для Каждого Строка Из ТаблицаРезультата Цикл
		МассивЗначений = Новый Массив;
		Для Каждого Колонка Из ТаблицаРезультата.Колонки Цикл
			МассивЗначений.Добавить(Строка(Строка[Колонка.Имя]));
		КонецЦикла;
		МассивСтрок.Добавить(СтрСоединить(МассивЗначений, " | "));
	КонецЦикла;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

#КонецОбласти

#Область ИнструментСравнениеПериодов

Процедура ДобавитьИнструментСравнениеПериодов(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"registerType", "string", "Тип регистра: AccumulationRegisters или InformationRegisters", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name", "string", "Имя регистра", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"period1", "string", "Дата первого периода в формате ГГГГММДД или ГГГГММДДЧЧММСС", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"period2", "string", "Дата второго периода в формате ГГГГММДД или ГГГГММДДЧЧММСС", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"maxRows", "number", "Максимум строк результата (по умолчанию 50)", 50));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"compare_periods",
		"Сравнить данные регистра между двумя периодами. Для регистров накопления - сравнение остатков на две даты. Для регистров сведений - сравнение срезов последних на две даты.",
		СхемаПараметров);
	
КонецПроцедуры

Функция СравнениеПериодов(Аргументы)
	
	ТипРегистра = Аргументы.registerType;
	ИмяРегистра = Аргументы.name;
	
	// Парсинг дат
	Дата1 = ДатаИзСтрокиСравнения(Аргументы.period1);
	Дата2 = ДатаИзСтрокиСравнения(Аргументы.period2);
	
	Если Дата1 = Неопределено Тогда
		Возврат "Ошибка: некорректный формат period1. Используйте ГГГГММДД или ГГГГММДДЧЧММСС";
	КонецЕсли;
	Если Дата2 = Неопределено Тогда
		Возврат "Ошибка: некорректный формат period2. Используйте ГГГГММДД или ГГГГММДДЧЧММСС";
	КонецЕсли;
	
	МаксСтрок = 50;
	Если Аргументы.Свойство("maxRows") И ЗначениеЗаполнено(Аргументы.maxRows) Тогда
		МаксСтрок = Число(Аргументы.maxRows);
	КонецЕсли;
	
	ТипВРег = ВРег(ТипРегистра);
	
	Если ТипВРег = "ACCUMULATIONREGISTERS" Тогда
		Возврат СравнитьОстаткиРегистраНакопления(ИмяРегистра, Дата1, Дата2, МаксСтрок);
	ИначеЕсли ТипВРег = "INFORMATIONREGISTERS" Тогда
		Возврат СравнитьСрезыРегистраСведений(ИмяРегистра, Дата1, Дата2, МаксСтрок);
	Иначе
		Возврат "Ошибка: поддерживаются типы AccumulationRegisters и InformationRegisters";
	КонецЕсли;
	
КонецФункции

Функция ДатаИзСтрокиСравнения(СтрДата)
	
	Попытка
		ЧистаяСтрока = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрДата, "-", ""), ".", ""), "/", "");
		Если СтрДлина(ЧистаяСтрока) = 8 Тогда
			Возврат Дата(ЧистаяСтрока + "000000");
		ИначеЕсли СтрДлина(ЧистаяСтрока) >= 14 Тогда
			Возврат Дата(Лев(ЧистаяСтрока, 14));
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция СравнитьОстаткиРегистраНакопления(ИмяРегистра, Дата1, Дата2, МаксСтрок)
	
	МДРегистр = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	Если МДРегистр = Неопределено Тогда
		Возврат "Ошибка: регистр накопления '" + ИмяРегистра + "' не найден";
	КонецЕсли;
	
	// Собираем измерения и ресурсы
	МассивИзмерений = Новый Массив;
	Для Каждого Изм Из МДРегистр.Измерения Цикл
		МассивИзмерений.Добавить(Изм.Имя);
	КонецЦикла;
	
	МассивРесурсов = Новый Массив;
	Для Каждого Рес Из МДРегистр.Ресурсы Цикл
		МассивРесурсов.Добавить(Рес.Имя);
	КонецЦикла;
	
	// Измерения с ЕСТЬNULL для FULL JOIN
	МассивПолейИзмерений = Новый Массив;
	Для Каждого Изм Из МассивИзмерений Цикл
		МассивПолейИзмерений.Добавить("ЕСТЬNULL(Т1." + Изм + ", Т2." + Изм + ") КАК " + Изм);
	КонецЦикла;
	СтрИзмерений = СтрСоединить(МассивПолейИзмерений, ", ");
	
	// Строим FULL JOIN запрос
	// В виртуальной таблице .Остатки() ресурсы имеют суффикс "Остаток"
	СтрРесурсов1 = "";
	СтрРесурсов2 = "";
	СтрРесурсовРазницы = "";
	Для Каждого Рес Из МассивРесурсов Цикл
		ИмяПоля = Рес + "Остаток";
		СтрРесурсов1 = СтрРесурсов1 + ", ЕСТЬNULL(Т1." + ИмяПоля + ", 0) КАК " + Рес + "1";
		СтрРесурсов2 = СтрРесурсов2 + ", ЕСТЬNULL(Т2." + ИмяПоля + ", 0) КАК " + Рес + "2";
		СтрРесурсовРазницы = СтрРесурсовРазницы + ", ЕСТЬNULL(Т2." + ИмяПоля + ", 0) - ЕСТЬNULL(Т1." + ИмяПоля + ", 0) КАК " + Рес + "Разн";
	КонецЦикла;
	
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(МаксСтрок, "ЧН=0; ЧГ=") + "
	|" + СтрИзмерений + СтрРесурсов1 + СтрРесурсов2 + СтрРесурсовРазницы + "
	|ИЗ РегистрНакопления." + ИмяРегистра + ".Остатки(&Дата1) КАК Т1
	|ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления." + ИмяРегистра + ".Остатки(&Дата2) КАК Т2
	|ПО ";
	
	// Условия соединения по измерениям
	УсловияСоединения = Новый Массив;
	Для Каждого Изм Из МассивИзмерений Цикл
		УсловияСоединения.Добавить("Т1." + Изм + " = Т2." + Изм);
	КонецЦикла;
	ТекстЗапроса = ТекстЗапроса + СтрСоединить(УсловияСоединения, " И ");
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Дата1", Дата1);
	Запрос.УстановитьПараметр("Дата2", Дата2);
	
	Попытка
		Результат = Запрос.Выполнить();
	Исключение
		Возврат "Ошибка выполнения запроса: " + ОписаниеОшибки();
	КонецПопытки;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("## Сравнение остатков: " + ИмяРегистра);
	МассивСтрок.Добавить("**Период 1:** " + Формат(Дата1, "ДФ=dd.MM.yyyy HH:mm:ss"));
	МассивСтрок.Добавить("**Период 2:** " + Формат(Дата2, "ДФ=dd.MM.yyyy HH:mm:ss"));
	МассивСтрок.Добавить("");
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС) + Символы.ПС + ТаблицаВТекст(Результат.Выгрузить(), МаксСтрок);
	
КонецФункции

Функция СравнитьСрезыРегистраСведений(ИмяРегистра, Дата1, Дата2, МаксСтрок)
	
	МДРегистр = Метаданные.РегистрыСведений.Найти(ИмяРегистра);
	Если МДРегистр = Неопределено Тогда
		Возврат "Ошибка: регистр сведений '" + ИмяРегистра + "' не найден";
	КонецЕсли;
	
	// Проверяем периодичность
	Если МДРегистр.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
		Возврат "Ошибка: регистр '" + ИмяРегистра + "' непериодический - сравнение срезов невозможно";
	КонецЕсли;
	
	// Собираем измерения и ресурсы
	МассивИзмерений = Новый Массив;
	Для Каждого Изм Из МДРегистр.Измерения Цикл
		МассивИзмерений.Добавить(Изм.Имя);
	КонецЦикла;
	
	МассивРесурсов = Новый Массив;
	Для Каждого Рес Из МДРегистр.Ресурсы Цикл
		МассивРесурсов.Добавить(Рес.Имя);
	КонецЦикла;
	
	// Измерения с ЕСТЬNULL для FULL JOIN
	МассивПолейИзмерений = Новый Массив;
	Для Каждого Изм Из МассивИзмерений Цикл
		МассивПолейИзмерений.Добавить("ЕСТЬNULL(Т1." + Изм + ", Т2." + Изм + ") КАК " + Изм);
	КонецЦикла;
	СтрИзмерений = СтрСоединить(МассивПолейИзмерений, ", ");
	
	// Ресурсы из двух срезов
	СтрРесурсов1 = "";
	СтрРесурсов2 = "";
	Для Каждого Рес Из МассивРесурсов Цикл
		СтрРесурсов1 = СтрРесурсов1 + ", Т1." + Рес + " КАК " + Рес + "1";
		СтрРесурсов2 = СтрРесурсов2 + ", Т2." + Рес + " КАК " + Рес + "2";
	КонецЦикла;
	
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(МаксСтрок, "ЧН=0; ЧГ=") + "
	|" + СтрИзмерений + СтрРесурсов1 + СтрРесурсов2 + "
	|ИЗ РегистрСведений." + ИмяРегистра + ".СрезПоследних(&Дата1) КАК Т1
	|ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений." + ИмяРегистра + ".СрезПоследних(&Дата2) КАК Т2
	|ПО ";
	
	// Условия соединения
	УсловияСоединения = Новый Массив;
	Для Каждого Изм Из МассивИзмерений Цикл
		УсловияСоединения.Добавить("Т1." + Изм + " = Т2." + Изм);
	КонецЦикла;
	ТекстЗапроса = ТекстЗапроса + СтрСоединить(УсловияСоединения, " И ");
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Дата1", Дата1);
	Запрос.УстановитьПараметр("Дата2", Дата2);
	
	Попытка
		Результат = Запрос.Выполнить();
	Исключение
		Возврат "Ошибка выполнения запроса: " + ОписаниеОшибки();
	КонецПопытки;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("## Сравнение срезов: " + ИмяРегистра);
	МассивСтрок.Добавить("**Период 1:** " + Формат(Дата1, "ДФ=dd.MM.yyyy HH:mm:ss"));
	МассивСтрок.Добавить("**Период 2:** " + Формат(Дата2, "ДФ=dd.MM.yyyy HH:mm:ss"));
	МассивСтрок.Добавить("");
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС) + Символы.ПС + ТаблицаВТекст(Результат.Выгрузить(), МаксСтрок);
	
КонецФункции

