#Область ИнструментЭкспортДанных

Процедура ДобавитьИнструментЭкспортДанных(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"metaType", "string", "Тип объекта: Catalogs, Documents, InformationRegisters, AccumulationRegisters", , Истина,
		"Catalogs,Documents,InformationRegisters,AccumulationRegisters"));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name", "string", "Имя объекта (например: Номенклатура, ПриходТовара)", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"format", "string", "Формат: json или csv", "json",, "json,csv"));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"maxRows", "number", "Максимум строк (по умолчанию 100)", 100));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"fields", "string", "Список полей через запятую (если не указан - все поля)"));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"export_data",
		"Экспорт данных объекта в формате JSON или CSV. Поддерживает справочники, документы, регистры сведений и накопления.",
		СхемаПараметров);
	
КонецПроцедуры

// BSLLS:CognitiveComplexity-off
// BSLLS:CyclomaticComplexity-off
Функция ЭкспортДанных(Аргументы)
	
	ТипМета = Аргументы.metaType;
	ИмяОбъекта = Аргументы.name;
	
	ФорматВывода = "json";
	Если Аргументы.Свойство("format") Тогда
		ФорматВывода = НРег(Аргументы.format);
	КонецЕсли;
	
	Лимит = 100;
	Если Аргументы.Свойство("maxRows") Тогда
		Лимит = Аргументы.maxRows;
	КонецЕсли;
	
	СтрокаЛимит = Формат(Лимит, "ЧН=0; ЧГ=");
	
	// Определяем поля
	СписокПолей = "*";
	Если Аргументы.Свойство("fields") И ЗначениеЗаполнено(Аргументы.fields) Тогда
		СписокПолей = Аргументы.fields;
	КонецЕсли;
	
	// Маппинг типов
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("Catalogs", "Справочник.");
	Соответствие.Вставить("Documents", "Документ.");
	Соответствие.Вставить("InformationRegisters", "РегистрСведений.");
	Соответствие.Вставить("AccumulationRegisters", "РегистрНакопления.");
	
	Префикс = Соответствие.Получить(ТипМета);
	Если Префикс = Неопределено Тогда
		ВызватьИсключение "Неподдерживаемый тип: " + ТипМета;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + СтрокаЛимит + " " + СписокПолей + " ИЗ " + Префикс + ИмяОбъекта;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	ТаблицаРезультата = Запрос.Выполнить().Выгрузить();
	
	Если ФорматВывода = "csv" Тогда
		Возврат ТаблицаВCSV(ТаблицаРезультата, ТипМета + "." + ИмяОбъекта);
	Иначе
		Возврат ТаблицаВJSON(ТаблицаРезультата, ТипМета + "." + ИмяОбъекта);
	КонецЕсли;
	
КонецФункции

Функция ТаблицаВCSV(ТаблицаЗначений, ИмяИсточника)
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("## Экспорт CSV: " + ИмяИсточника + " (" + Формат(ТаблицаЗначений.Количество(), "ЧН=0; ЧГ=") + " строк)");
	МассивСтрок.Добавить("");
	
	// Заголовок
	МассивКолонок = Новый Массив;
	Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
		МассивКолонок.Добавить(Колонка.Имя);
	КонецЦикла;
	МассивСтрок.Добавить(СтрСоединить(МассивКолонок, ";"));
	
	// Данные
	Для Каждого СтрокаТЗ Из ТаблицаЗначений Цикл
		МассивЗначений = Новый Массив;
		Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
			ТекстЗначения = Строка(СтрокаТЗ[Колонка.Имя]);
			ТекстЗначения = СтрЗаменить(ТекстЗначения, """", """""");
			Если СтрНайти(ТекстЗначения, ";") > 0 ИЛИ СтрНайти(ТекстЗначения, """") > 0 Тогда
				ТекстЗначения = """" + ТекстЗначения + """";
			КонецЕсли;
			МассивЗначений.Добавить(ТекстЗначения);
		КонецЦикла;
		МассивСтрок.Добавить(СтрСоединить(МассивЗначений, ";"));
	КонецЦикла;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

Функция ТаблицаВJSON(ТаблицаЗначений, ИмяИсточника)
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("## Экспорт JSON: " + ИмяИсточника + " (" + Формат(ТаблицаЗначений.Количество(), "ЧН=0; ЧГ=") + " строк)");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("[");
	
	Индекс = 0;
	Для Каждого СтрокаТЗ Из ТаблицаЗначений Цикл
		МассивПолей = Новый Массив;
		Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
			ТекстЗначения = Строка(СтрокаТЗ[Колонка.Имя]);
			ТекстЗначения = СтрЗаменить(ТекстЗначения, "\", "\\");
			ТекстЗначения = СтрЗаменить(ТекстЗначения, """", "\""");
			МассивПолей.Добавить("""" + Колонка.Имя + """: """ + ТекстЗначения + """");
		КонецЦикла;
		
		Разделитель = ?(Индекс < ТаблицаЗначений.Количество() - 1, ",", "");
		МассивСтрок.Добавить("  {" + СтрСоединить(МассивПолей, ", ") + "}" + Разделитель);
		Индекс = Индекс + 1;
	КонецЦикла;
	
	МассивСтрок.Добавить("]");
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

#КонецОбласти
#Область ИнструментВыполнениеОтчета

Процедура ДобавитьИнструментВыполнитьОтчет(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"reportName", "string", "Имя отчета (например: ОстаткиТоваров, Продажи)", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"parameters", "string", "JSON с параметрами отчета: {""Период"": ""20260101"", ""Склад"": ""Основной""}"));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"maxRows", "number", "Максимум строк результата (по умолчанию 100)", 100));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"run_report",
		"Выполнить отчет по имени с параметрами и получить результат. Используется СхемаКомпоновкиДанных отчета с настройками по умолчанию.",
		СхемаПараметров);
	
КонецПроцедуры

// BSLLS:CognitiveComplexity-off
// BSLLS:CyclomaticComplexity-off
Функция ВыполнитьОтчет(Аргументы)
	
	ИмяОтчета = Аргументы.reportName;
	
	МДОтчет = Метаданные.Отчеты.Найти(ИмяОтчета);
	Если МДОтчет = Неопределено Тогда
		// Выводим список доступных отчетов
		МассивСтрок = Новый Массив;
		МассивСтрок.Добавить("Ошибка: отчет '" + ИмяОтчета + "' не найден");
		МассивСтрок.Добавить("");
		МассивСтрок.Добавить("Доступные отчеты:");
		Для Каждого МДОтч Из Метаданные.Отчеты Цикл
			Если СтрНачинаетсяС(МДОтч.Имя, "mcp_") Тогда
				Продолжить;
			КонецЕсли;
			МассивСтрок.Добавить("- " + МДОтч.Имя + " (" + МДОтч.Синоним + ")");
		КонецЦикла;
		Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	КонецЕсли;
	
	// Создаем отчет
	Отчет = Отчеты[ИмяОтчета].Создать();
	
	// Получаем СКД через макет
	Попытка
		Схема = Отчет.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Исключение
		Возврат "Ошибка: отчет '" + ИмяОтчета + "' не имеет СхемыКомпоновкиДанных: " + ОписаниеОшибки();
	КонецПопытки;
	
	Если Схема = Неопределено Тогда
		Возврат "Ошибка: отчет '" + ИмяОтчета + "' не имеет СхемыКомпоновкиДанных";
	КонецЕсли;
	
	// Компоновщик настроек
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(
		Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	КомпоновщикНастроек.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	
	// Устанавливаем параметры из JSON
	Если Аргументы.Свойство("parameters") И ЗначениеЗаполнено(Аргументы.parameters) Тогда
		Попытка
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(Аргументы.parameters);
			ПараметрыОтчета = ПрочитатьJSON(ЧтениеJSON);
			
			Для Каждого КлючЗначение Из ПараметрыОтчета Цикл
				ИмяПараметра = КлючЗначение.Ключ;
				ЗначениеПараметра = КлючЗначение.Значение;
				
				// Ищем параметр в настройках
				Для Каждого ПараметрДанных Из КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы Цикл
					Если Строка(ПараметрДанных.Параметр) = ИмяПараметра Тогда
						// Попытка преобразовать дату
						Если ТипЗнч(ЗначениеПараметра) = Тип("Строка") И СтрДлина(ЗначениеПараметра) >= 8 Тогда
							ДатаПопытка = ДатаИзСтрокиСравнения(ЗначениеПараметра);
							Если ДатаПопытка <> Неопределено Тогда
								ЗначениеПараметра = ДатаПопытка;
							КонецЕсли;
						КонецЕсли;
						ПараметрДанных.Значение = ЗначениеПараметра;
						ПараметрДанных.Использование = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		Исключение
			Возврат "Ошибка разбора параметров JSON: " + ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли;
	
	// Компоновка макета
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	Попытка
		МакетКомпоновки = КомпоновщикМакета.Выполнить(
			Схема, КомпоновщикНастроек.ПолучитьНастройки());
	Исключение
		Возврат "Ошибка компоновки макета: " + ОписаниеОшибки();
	КонецПопытки;
	
	// Процессор компоновки
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	
	// Вывод в табличный документ
	ТабДок = Новый ТабличныйДокумент;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабДок);
	
	Попытка
		ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	Исключение
		Возврат "Ошибка формирования отчета: " + ОписаниеОшибки();
	КонецПопытки;
	
	// Ограничение строк
	МаксСтрок = 100;
	Если Аргументы.Свойство("maxRows") И ЗначениеЗаполнено(Аргументы.maxRows) Тогда
		МаксСтрок = Число(Аргументы.maxRows);
	КонецЕсли;
	
	// Читаем табличный документ
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("## Отчет: " + ИмяОтчета + " (" + МДОтчет.Синоним + ")");
	МассивСтрок.Добавить("**Размер:** " + Формат(ТабДок.ВысотаТаблицы, "ЧН=0; ЧГ=") + " строк x " + Формат(ТабДок.ШиринаТаблицы, "ЧН=0; ЧГ=") + " колонок");
	МассивСтрок.Добавить("");
	
	КоличествоСтрок = Мин(ТабДок.ВысотаТаблицы, МаксСтрок);
	
	Для НомерСтроки = 1 По КоличествоСтрок Цикл
		МассивЯчеек = Новый Массив;
		Для НомерКолонки = 1 По ТабДок.ШиринаТаблицы Цикл
			Ячейка = ТабДок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
			ТекстЯчейки = СокрЛП(Строка(Ячейка.Текст));
			МассивЯчеек.Добавить(ТекстЯчейки);
		КонецЦикла;
		МассивСтрок.Добавить(СтрСоединить(МассивЯчеек, " | "));
		
		// Добавляем разделитель после первой строки (заголовок)
		Если НомерСтроки = 1 Тогда
			МассивРазделителей = Новый Массив;
			Для НомерКолонки = 1 По ТабДок.ШиринаТаблицы Цикл
				МассивРазделителей.Добавить("---");
			КонецЦикла;
			МассивСтрок.Добавить(СтрСоединить(МассивРазделителей, " | "));
		КонецЕсли;
	КонецЦикла;
	
	Если ТабДок.ВысотаТаблицы > МаксСтрок Тогда
		МассивСтрок.Добавить("");
		МассивСтрок.Добавить("... показано " + Формат(МаксСтрок, "ЧН=0; ЧГ=") + " из " + Формат(ТабДок.ВысотаТаблицы, "ЧН=0; ЧГ=") + " строк");
	КонецЕсли;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

#КонецОбласти