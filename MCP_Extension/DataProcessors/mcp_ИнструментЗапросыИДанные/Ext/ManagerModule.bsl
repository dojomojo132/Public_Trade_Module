
#Область ПрограммныйИнтерфейс

Процедура ДобавитьИнструменты(Инструменты) Экспорт
	
	ДобавитьИнструментВыполнитьЗапрос(Инструменты);
	ДобавитьИнструментДанныеРегистра(Инструменты);
	ДобавитьИнструментДвиженияДокумента(Инструменты);
	ДобавитьИнструментПоискДанных(Инструменты);
	ДобавитьИнструментЭкспортДанных(Инструменты);
	ДобавитьИнструментСравнениеПериодов(Инструменты);
	ДобавитьИнструментВыполнитьОтчет(Инструменты);
	
КонецПроцедуры

Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт
	
	Если ИмяИнструмента = "execute_query" Тогда
		Возврат ВыполнитьЗапрос(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_register_data" Тогда
		Возврат ПолучитьДанныеРегистра(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_document_movements" Тогда
		Возврат ПолучитьДвиженияДокумента(Аргументы);
	ИначеЕсли ИмяИнструмента = "search_data" Тогда
		Возврат ПоискДанных(Аргументы);
	ИначеЕсли ИмяИнструмента = "export_data" Тогда
		Возврат ЭкспортДанных(Аргументы);
	ИначеЕсли ИмяИнструмента = "compare_periods" Тогда
		Возврат СравнениеПериодов(Аргументы);
	ИначеЕсли ИмяИнструмента = "run_report" Тогда
		Возврат ВыполнитьОтчет(Аргументы);
	Иначе
		ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ОписанияИнструментов

Процедура ДобавитьИнструментВыполнитьЗапрос(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"queryText", "string", "Текст запроса на языке 1С", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"maxRows", "number", "Максимальное количество строк результата (по умолчанию 100)", 100));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"execute_query",
		"Выполнить запрос на языке 1С и получить результат в виде таблицы. Используйте для проверки данных в регистрах, остатков, движений документов, анализа справочников.",
		СхемаПараметров);
	
КонецПроцедуры

Процедура ДобавитьИнструментДанныеРегистра(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"registerType", "string", "Тип регистра", , Истина, "AccumulationRegisters,InformationRegisters"));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name", "string", "Имя регистра", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"mode", "string", "Режим чтения: Balance (остатки), Turnovers (обороты), SliceLast (срез последних), All (все записи)", "All", , "Balance,Turnovers,SliceLast,All"));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"maxRows", "number", "Максимальное количество строк результата (по умолчанию 100)", 100));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_register_data",
		"Получить данные регистра накопления (остатки, обороты) или регистра сведений (срез последних, все записи). Удобно для проверки остатков товаров, цен, настроек.",
		СхемаПараметров);
	
КонецПроцедуры

Процедура ДобавитьИнструментДвиженияДокумента(Инструменты)
	
