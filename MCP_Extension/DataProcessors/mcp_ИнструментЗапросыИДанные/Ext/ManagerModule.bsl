
#Область ПрограммныйИнтерфейс

Процедура ДобавитьИнструменты(Инструменты) Экспорт
	
	ДобавитьИнструментВыполнитьЗапрос(Инструменты);
	ДобавитьИнструментДанныеРегистра(Инструменты);
	ДобавитьИнструментДвиженияДокумента(Инструменты);
	
КонецПроцедуры

Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт
	
	Если ИмяИнструмента = "execute_query" Тогда
		Возврат ВыполнитьЗапрос(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_register_data" Тогда
		Возврат ПолучитьДанныеРегистра(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_document_movements" Тогда
		Возврат ПолучитьДвиженияДокумента(Аргументы);
	Иначе
		ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ОписанияИнструментов

Процедура ДобавитьИнструментВыполнитьЗапрос(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"queryText", "string", "Текст запроса на языке 1С", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"maxRows", "number", "Максимальное количество строк результата (по умолчанию 100)", 100));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"execute_query",
		"Выполнить запрос на языке 1С и получить результат в виде таблицы. Используйте для проверки данных в регистрах, остатков, движений документов, анализа справочников.",
		СхемаПараметров);
	
КонецПроцедуры

Процедура ДобавитьИнструментДанныеРегистра(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"registerType", "string", "Тип регистра", , Истина, "AccumulationRegisters,InformationRegisters"));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name", "string", "Имя регистра", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"mode", "string", "Режим чтения: Balance (остатки), Turnovers (обороты), SliceLast (срез последних), All (все записи)", "All", , "Balance,Turnovers,SliceLast,All"));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"maxRows", "number", "Максимальное количество строк результата (по умолчанию 100)", 100));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_register_data",
		"Получить данные регистра накопления (остатки, обороты) или регистра сведений (срез последних, все записи). Удобно для проверки остатков товаров, цен, настроек.",
		СхемаПараметров);
	
КонецПроцедуры

Процедура ДобавитьИнструментДвиженияДокумента(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"documentType", "string", "Имя типа документа (например, ЧекККМ, ПриходТовара)", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"documentNumber", "string", "Номер документа", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"maxRows", "number", "Максимальное количество строк на каждый регистр (по умолчанию 50)", 50));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_document_movements",
		"Получить все движения (записи регистров) конкретного документа. Показывает по каким регистрам и какие записи создал документ при проведении.",
		СхемаПараметров);
	
КонецПроцедуры

#КонецОбласти

#Область РеализацияИнструментов

// execute_query - выполнение произвольного запроса 1С
//
// Параметры:
//  Аргументы - Структура - параметры инструмента
//
// Возвращаемое значение:
//  Строка - результат в формате Markdown-таблицы
//
Функция ВыполнитьЗапрос(Аргументы)
	
	ТекстЗапроса = Аргументы.queryText;
	Лимит = 100;
	Если Аргументы.Свойство("maxRows") И Аргументы.maxRows <> Неопределено Тогда
		Лимит = Аргументы.maxRows;
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Попытка
		Результат = Запрос.Выполнить();
	Исключение
		ВызватьИсключение "Ошибка выполнения запроса: " + ОписаниеОшибки();
	КонецПопытки;
	
	Если Результат.Пустой() Тогда
		Возврат "Запрос вернул пустой результат (0 строк).";
	КонецЕсли;
	
	Возврат ТаблицаВТекст(Результат.Выгрузить(), Лимит);
	
КонецФункции

// get_register_data - чтение данных регистра
//
// Параметры:
//  Аргументы - Структура - параметры инструмента
//
// Возвращаемое значение:
//  Строка - результат в формате Markdown-таблицы
//
Функция ПолучитьДанныеРегистра(Аргументы)
	
	ТипРегистра = Аргументы.registerType;
	ИмяРегистра = Аргументы.name;
	
	Режим = "All";
	Если Аргументы.Свойство("mode") И Аргументы.mode <> Неопределено Тогда
		Режим = Аргументы.mode;
	КонецЕсли;
	
	Лимит = 100;
	Если Аргументы.Свойство("maxRows") И Аргументы.maxRows <> Неопределено Тогда
		Лимит = Аргументы.maxRows;
	КонецЕсли;
	
	// Проверяем существование регистра
	Попытка
		КоллекцияМД = Метаданные[ТипРегистра];
	Исключение
		ВызватьИсключение "Неизвестный тип регистра: " + ТипРегистра;
	КонецПопытки;
	
	МДРегистра = КоллекцияМД.Найти(ИмяРегистра);
	Если МДРегистра = Неопределено Тогда
		ВызватьИсключение "Регистр не найден: " + ТипРегистра + "." + ИмяРегистра;
	КонецЕсли;
	
	// Строим текст запроса в зависимости от режима
	ПолноеИмяРегистра = МДРегистра.ПолноеИмя();
	
	Если Режим = "Balance" И ТипРегистра = "AccumulationRegisters" Тогда
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧН=; ЧГ=") + " * ИЗ " + ПолноеИмяРегистра + ".Остатки()";
	ИначеЕсли Режим = "Turnovers" И ТипРегистра = "AccumulationRegisters" Тогда
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧН=; ЧГ=") + " * ИЗ " + ПолноеИмяРегистра + ".Обороты()";
	ИначеЕсли Режим = "SliceLast" И ТипРегистра = "InformationRegisters" Тогда
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧН=; ЧГ=") + " * ИЗ " + ПолноеИмяРегистра + ".СрезПоследних()";
	Иначе
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧН=; ЧГ=") + " * ИЗ " + ПолноеИмяРегистра;
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Попытка
		Результат = Запрос.Выполнить();
	Исключение
		ВызватьИсключение "Ошибка запроса к регистру " + ИмяРегистра + " (режим " + Режим + "): " + ОписаниеОшибки();
	КонецПопытки;
	
	Если Результат.Пустой() Тогда
		Возврат "Регистр " + ИмяРегистра + " (режим " + Режим + "): нет данных.";
	КонецЕсли;
	
	Заголовок = "Регистр: " + ПолноеИмяРегистра + " | Режим: " + Режим + Символы.ПС + Символы.ПС;
	Возврат Заголовок + ТаблицаВТекст(Результат.Выгрузить(), Лимит);
	
КонецФункции

// get_document_movements - движения документа по всем регистрам
//
// Параметры:
//  Аргументы - Структура - параметры инструмента
//
// Возвращаемое значение:
//  Строка - результат с движениями по регистрам
//
Функция ПолучитьДвиженияДокумента(Аргументы)
	
	ТипДокумента = Аргументы.documentType;
	НомерДокумента = Аргументы.documentNumber;
	
	Лимит = 50;
	Если Аргументы.Свойство("maxRows") И Аргументы.maxRows <> Неопределено Тогда
		Лимит = Аргументы.maxRows;
	КонецЕсли;
	
	// Найти метаданные документа
	МДДокумента = Метаданные.Документы.Найти(ТипДокумента);
	Если МДДокумента = Неопределено Тогда
		ВызватьИсключение "Тип документа не найден: " + ТипДокумента;
	КонецЕсли;
	
	// Найти документ по номеру
	Менеджер = Документы[ТипДокумента];
	ДокСсылка = Менеджер.НайтиПоНомеру(НомерДокумента);
	
	Если ДокСсылка.Пустая() Тогда
		ВызватьИсключение "Документ не найден: " + ТипДокумента + " №" + НомерДокумента;
	КонецЕсли;
	
	РезультатМассив = Новый Массив;
	РезультатМассив.Добавить("Документ: " + Строка(ДокСсылка) + " от " + Формат(ДокСсылка.Дата, "ДФ=dd.MM.yyyy HH:mm:ss"));
	РезультатМассив.Добавить("Проведён: " + ?(ДокСсылка.Проведен, "Да", "Нет"));
	РезультатМассив.Добавить("");
	
	// Обойти все регистры, в которых документ может делать движения
	// BSLLS:QueryInLoop-off - каждый запрос к разному регистру, батчинг невозможен
	Для Каждого РегМД Из МДДокумента.Движения Цикл
		
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧН=; ЧГ=") +
			" * ИЗ " + РегМД.ПолноеИмя() +
			" ГДЕ Регистратор = &Регистратор";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Регистратор", ДокСсылка);
		
		Попытка
			Результат = Запрос.Выполнить(); // BSLLS:QueryInLoop-off
		Исключение
			РезультатМассив.Добавить("--- " + РегМД.ПолноеИмя() + " ---");
			РезультатМассив.Добавить("Ошибка чтения: " + ОписаниеОшибки());
			РезультатМассив.Добавить("");
			Продолжить;
		КонецПопытки;
		
		Если Результат.Пустой() Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаДвижений = Результат.Выгрузить();
		
		РезультатМассив.Добавить("=== " + РегМД.ПолноеИмя() + " (" + Формат(ТаблицаДвижений.Количество(), "ЧН=0; ЧГ=") + " записей) ===");
		РезультатМассив.Добавить(ТаблицаВТекст(ТаблицаДвижений, Лимит));
		РезультатМассив.Добавить("");
		
	КонецЦикла;
	
	Если РезультатМассив.Количество() = 3 Тогда
		РезультатМассив.Добавить("Движений не найдено.");
	КонецЕсли;
	
	Возврат СтрСоединить(РезультатМассив, Символы.ПС);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Преобразует таблицу значений в текстовое представление (Markdown-таблица)
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений - таблица для преобразования
//  Лимит - Число - максимальное количество строк
//
// Возвращаемое значение:
//  Строка - текстовое представление таблицы
//
Функция ТаблицаВТекст(ТаблицаЗначений, Лимит)
	
	Колонки = ТаблицаЗначений.Колонки;
	
	Если Колонки.Количество() = 0 Тогда
		Возврат "(Нет колонок)";
	КонецЕсли;
	
	// Формируем заголовок
	МассивКолонок = Новый Массив;
	МассивРазделителей = Новый Массив;
	Для Каждого Колонка Из Колонки Цикл
		МассивКолонок.Добавить(Колонка.Имя);
		МассивРазделителей.Добавить("---");
	КонецЦикла;
	
	СтрокиРезультата = Новый Массив;
	СтрокиРезультата.Добавить(СтрСоединить(МассивКолонок, " | "));
	СтрокиРезультата.Добавить(СтрСоединить(МассивРазделителей, " | "));
	
	// Данные
	Счетчик = 0;
	Для Каждого Строка Из ТаблицаЗначений Цикл
		
		Если Счетчик >= Лимит Тогда
			Прервать;
		КонецЕсли;
		
		МассивЗначений = Новый Массив;
		Для Каждого Колонка Из Колонки Цикл
			Значение = Строка[Колонка.Имя];
			Если Значение = Неопределено ИЛИ Значение = NULL Тогда
				МассивЗначений.Добавить("");
			Иначе
				ТекстЗначения = Строка(Значение);
				// Экранируем символ | в значениях
				ТекстЗначения = СтрЗаменить(ТекстЗначения, "|", "\|");
				МассивЗначений.Добавить(ТекстЗначения);
			КонецЕсли;
		КонецЦикла;
		
		СтрокиРезультата.Добавить(СтрСоединить(МассивЗначений, " | "));
		Счетчик = Счетчик + 1;
		
	КонецЦикла;
	
	ВсегоСтрок = ТаблицаЗначений.Количество();
	Если ВсегоСтрок > Лимит Тогда
		СтрокиРезультата.Добавить("... ещё " + Формат(ВсегоСтрок - Лимит, "ЧН=0; ЧГ=") + " строк (ограничение maxRows=" + Формат(Лимит, "ЧН=0; ЧГ=") + ")");
	КонецЕсли;
	
	СтрокиРезультата.Добавить("");
	СтрокиРезультата.Добавить("Всего строк: " + Формат(ВсегоСтрок, "ЧН=0; ЧГ="));
	
	Возврат СтрСоединить(СтрокиРезультата, Символы.ПС);
	
КонецФункции

#КонецОбласти
