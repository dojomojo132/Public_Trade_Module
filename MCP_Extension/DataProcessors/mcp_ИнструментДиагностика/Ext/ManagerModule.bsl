#Область ПрограммныйИнтерфейс

Процедура ДобавитьИнструменты(Инструменты) Экспорт
	
	ДобавитьИнструментПроверкаЦелостности(Инструменты);
	ДобавитьИнструментПроверкаПроведения(Инструменты);
	ДобавитьИнструментSmokeТест(Инструменты);
	ДобавитьИнструментСводкаДанных(Инструменты);
	ДобавитьИнструментТехЖурнал(Инструменты);
	
КонецПроцедуры

Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт
	
	Если ИмяИнструмента = "validate_metadata_integrity" Тогда
		Возврат ПроверкаЦелостностиМетаданных(Аргументы);
	ИначеЕсли ИмяИнструмента = "check_document_posting" Тогда
		Возврат ПроверкаПроведенияДокумента(Аргументы);
	ИначеЕсли ИмяИнструмента = "run_smoke_test" Тогда
		Возврат SmokeТестФорм(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_data_summary" Тогда
		Возврат СводкаДанных(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_tech_journal" Тогда
		Возврат ТехЖурнал(Аргументы);
	Иначе
		ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;
	КонецЕсли;
	
КонецФункции

#КонецОбласти


#Область ИнструментПроверкаЦелостности

Процедура ДобавитьИнструментПроверкаЦелостности(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"metaType", "string",
		"Тип метаданных для проверки (Catalogs, Documents, InformationRegisters, AccumulationRegisters). Если не указан - проверяются все типы."));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"validate_metadata_integrity",
		"Проверка целостности метаданных: для каждого объекта выполняет тестовый запрос к БД, проверяет доступность таблиц и табличных частей. Выявляет неконсистентные состояния.",
		СхемаПараметров);
	
КонецПроцедуры

Функция ПроверкаЦелостностиМетаданных(Аргументы)
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("=== Проверка целостности метаданных ===");
	МассивСтрок.Добавить("");
	
	ОшибокВсего = 0;
	ПроверокВсего = 0;
	
	ФильтрТипа = "";
	Если Аргументы.Свойство("metaType") Тогда
		ФильтрТипа = Аргументы.metaType;
	КонецЕсли;
	
	Если ФильтрТипа = "" ИЛИ ФильтрТипа = "Catalogs" Тогда
		ПроверитьКоллекциюОбъектов(МассивСтрок, Метаданные.Справочники, "Справочник", ОшибокВсего, ПроверокВсего);
	КонецЕсли;
	
	Если ФильтрТипа = "" ИЛИ ФильтрТипа = "Documents" Тогда
		ПроверитьКоллекциюОбъектов(МассивСтрок, Метаданные.Документы, "Документ", ОшибокВсего, ПроверокВсего);
	КонецЕсли;
	
	Если ФильтрТипа = "" ИЛИ ФильтрТипа = "InformationRegisters" Тогда
		ПроверитьКоллекциюОбъектов(МассивСтрок, Метаданные.РегистрыСведений, "РегистрСведений", ОшибокВсего, ПроверокВсего);
	КонецЕсли;
	
	Если ФильтрТипа = "" ИЛИ ФильтрТипа = "AccumulationRegisters" Тогда
		ПроверитьКоллекциюОбъектов(МассивСтрок, Метаданные.РегистрыНакопления, "РегистрНакопления", ОшибокВсего, ПроверокВсего);
	КонецЕсли;
	
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("=== Итого: проверок=" + Формат(ПроверокВсего, "ЧН=0; ЧГ=")
		+ ", ошибок=" + Формат(ОшибокВсего, "ЧН=0; ЧГ=") + " ===");
	
	Если ОшибокВсего = 0 Тогда
		МассивСтрок.Добавить("OK: Все проверки пройдены успешно");
	Иначе
		МассивСтрок.Добавить("FAIL: Обнаружены проблемы!");
	КонецЕсли;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

Процедура ПроверитьКоллекциюОбъектов(МассивСтрок, КоллекцияМД, ПрефиксТипа, ОшибокВсего, ПроверокВсего)
	
	Для Каждого МДОбъект Из КоллекцияМД Цикл
		ПроверокВсего = ПроверокВсего + 1;
		
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1 ИСТИНА КАК Проверка ИЗ " + ПрефиксТипа + "." + МДОбъект.Имя;
		Попытка
			Запрос = Новый Запрос(ТекстЗапроса);
			Запрос.Выполнить();
		Исключение
			МассивСтрок.Добавить("  FAIL " + МДОбъект.ПолноеИмя() + ": ошибка запроса - " + ОписаниеОшибки());
			ОшибокВсего = ОшибокВсего + 1;
			Продолжить;
		КонецПопытки;
		
		// Проверка табличных частей
		Попытка
			Для Каждого ТабЧасть Из МДОбъект.ТабличныеЧасти Цикл
				ПроверокВсего = ПроверокВсего + 1;
				ТекстЗапросаТЧ = "ВЫБРАТЬ ПЕРВЫЕ 1 ИСТИНА КАК Проверка ИЗ "
					+ ПрефиксТипа + "." + МДОбъект.Имя + "." + ТабЧасть.Имя;
				Попытка
					ЗапросТЧ = Новый Запрос(ТекстЗапросаТЧ);
					ЗапросТЧ.Выполнить();
				Исключение
					МассивСтрок.Добавить("  FAIL " + МДОбъект.ПолноеИмя() + "." + ТабЧасть.Имя
						+ ": ошибка ТЧ - " + ОписаниеОшибки());
					ОшибокВсего = ОшибокВсего + 1;
				КонецПопытки;
			КонецЦикла;
		Исключение
			// Нет табличных частей у данного типа объектов
			ПроверокВсего = ПроверокВсего + 0;
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область ИнструментПроверкаПроведения

Процедура ДобавитьИнструментПроверкаПроведения(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"documentType", "string", "Тип документа (имя, например: ПриходТовара)", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"number", "string", "Номер документа для проверки. Если не указан - берётся последний."));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"check_document_posting",
		"Проверка проведения документа: находит документ, показывает регистры движений, считает количество записей в каждом регистре. Определяет статус проведения.",
		СхемаПараметров);
	
КонецПроцедуры

Функция ПроверкаПроведенияДокумента(Аргументы)
	
	ТипДокумента = Аргументы.documentType;
	
	МДДокумент = Метаданные.Документы.Найти(ТипДокумента);
	Если МДДокумент = Неопределено Тогда
		ВызватьИсключение "Документ не найден: " + ТипДокумента;
	КонецЕсли;
	
	// Проверяем поддержку проведения
	Если МДДокумент.Проведение = Метаданные.СвойстваОбъектов.Проведение.Запретить Тогда
		Возврат "Документ " + ТипДокумента + " не поддерживает проведение (Проведение=Запретить)";
	КонецЕсли;
	
	// Поиск документа
	Номер = "";
	Если Аргументы.Свойство("number") Тогда
		Номер = Аргументы.number;
	КонецЕсли;
	
	ДокументСсылка = НайтиДокумент(ТипДокумента, Номер);
	Если ДокументСсылка = Неопределено Тогда
		Возврат "Документы типа " + ТипДокумента + " не найдены в базе";
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("=== Проверка проведения: " + Строка(ДокументСсылка) + " ===");
	МассивСтрок.Добавить("Тип: " + ТипДокумента);
	МассивСтрок.Добавить("Дата: " + Формат(ДокументСсылка.Дата, "ДЛФ=ДВ"));
	МассивСтрок.Добавить("Номер: " + ДокументСсылка.Номер);
	МассивСтрок.Добавить("Проведен: " + ?(ДокументСсылка.Проведен, "Да", "Нет"));
	МассивСтрок.Добавить("");
	
	// Регистры движений из метаданных
	МассивСтрок.Добавить("--- Зарегистрированные регистры движений ---");
	Если МДДокумент.Движения.Количество() = 0 Тогда
		МассивСтрок.Добавить("  (нет регистров движений)");
	Иначе
		Для Каждого МДРегистр Из МДДокумент.Движения Цикл
			МассивСтрок.Добавить("  " + МДРегистр.ПолноеИмя());
		КонецЦикла;
	КонецЕсли;
	МассивСтрок.Добавить("");
	
	// Фактические движения в БД
	МассивСтрок.Добавить("--- Фактические движения в БД ---");
	Если МДДокумент.Движения.Количество() = 0 Тогда
		МассивСтрок.Добавить("  (нет регистров)");
	Иначе
		Для Каждого МДРегистр Из МДДокумент.Движения Цикл
			КоличествоЗаписей = ПолучитьКоличествоДвижений(МДРегистр, ДокументСсылка);
			Если КоличествоЗаписей < 0 Тогда
				МассивСтрок.Добавить("  " + МДРегистр.ПолноеИмя() + ": ошибка чтения");
			Иначе
				МассивСтрок.Добавить("  " + МДРегистр.ПолноеИмя() + ": "
					+ Формат(КоличествоЗаписей, "ЧН=0; ЧГ=") + " записей");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	МассивСтрок.Добавить("");
	
	// Итог
	Если НЕ ДокументСсылка.Проведен Тогда
		МассивСтрок.Добавить("WARN: Документ не проведен. Движений быть не должно.");
	Иначе
		МассивСтрок.Добавить("OK: Документ проведен");
	КонецЕсли;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

Функция НайтиДокумент(ТипДокумента, Номер)
	
	Запрос = Новый Запрос;
	Если Номер = "" Тогда
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ." + ТипДокумента + " УПОРЯДОЧИТЬ ПО Дата УБЫВ";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ." + ТипДокумента + " ГДЕ Номер = &Номер";
		Запрос.УстановитьПараметр("Номер", Номер);
	КонецЕсли;
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;
	
КонецФункции

Функция ПолучитьКоличествоДвижений(МДРегистр, ДокументСсылка)
	
	Попытка
		ТекстЗапроса = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Кол ИЗ " + МДРегистр.ПолноеИмя() + " ГДЕ Регистратор = &Ссылка";
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
		Результат = Запрос.Выполнить().Выгрузить();
		Возврат Результат[0].Кол;
	Исключение
		Возврат -1;
	КонецПопытки;
	
КонецФункции

#КонецОбласти


#Область ИнструментSmokeТест

Процедура ДобавитьИнструментSmokeТест(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"metaType", "string",
		"Тип метаданных: Catalogs, Documents, DataProcessors, Reports. Если не указан - проверяются все."));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name", "string",
		"Имя конкретного объекта (опционально). Если не указан - проверяются все объекты выбранного типа."));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"run_smoke_test",
		"Smoke-тестирование форм: для каждого объекта метаданных пробует программно получить форму через ПолучитьФорму(). Возвращает OK или текст ошибки для каждой формы. Быстрая post-deploy проверка работоспособности.",
		СхемаПараметров);
	
КонецПроцедуры

// BSLLS:CognitiveComplexity-off
// BSLLS:CyclomaticComplexity-off
Функция SmokeТестФорм(Аргументы)
	
	ФильтрТипа = "";
	Если Аргументы.Свойство("metaType") Тогда
		ФильтрТипа = Аргументы.metaType;
	КонецЕсли;
	
	ФильтрИмени = "";
	Если Аргументы.Свойство("name") Тогда
		ФильтрИмени = Аргументы.name;
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("## Smoke-тест форм");
	МассивСтрок.Добавить("");
	
	ВсегоФорм = 0;
	ОшибокФорм = 0;
	
	Если ФильтрТипа = "" ИЛИ ФильтрТипа = "Catalogs" Тогда
		SmokeТестКоллекции(МассивСтрок, Метаданные.Справочники, "Справочник", ФильтрИмени, ВсегоФорм, ОшибокФорм);
	КонецЕсли;
	
	Если ФильтрТипа = "" ИЛИ ФильтрТипа = "Documents" Тогда
		SmokeТестКоллекции(МассивСтрок, Метаданные.Документы, "Документ", ФильтрИмени, ВсегоФорм, ОшибокФорм);
	КонецЕсли;
	
	Если ФильтрТипа = "" ИЛИ ФильтрТипа = "DataProcessors" Тогда
		SmokeТестКоллекции(МассивСтрок, Метаданные.Обработки, "Обработка", ФильтрИмени, ВсегоФорм, ОшибокФорм);
	КонецЕсли;
	
	Если ФильтрТипа = "" ИЛИ ФильтрТипа = "Reports" Тогда
		SmokeТестКоллекции(МассивСтрок, Метаданные.Отчеты, "Отчет", ФильтрИмени, ВсегоФорм, ОшибокФорм);
	КонецЕсли;
	
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("---");
	МассивСтрок.Добавить("**Итого:** форм=" + Формат(ВсегоФорм, "ЧН=0; ЧГ=")
		+ ", ошибок=" + Формат(ОшибокФорм, "ЧН=0; ЧГ="));
	
	Если ОшибокФорм = 0 Тогда
		МассивСтрок.Добавить("**Результат:** OK - все формы открываются");
	Иначе
		МассивСтрок.Добавить("**Результат:** FAIL - " + Формат(ОшибокФорм, "ЧН=0; ЧГ=") + " форм с ошибками");
	КонецЕсли;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

Процедура SmokeТестКоллекции(МассивСтрок, КоллекцияМД, ПрефиксТипа, ФильтрИмени, ВсегоФорм, ОшибокФорм)
	
	Для Каждого МДОбъект Из КоллекцияМД Цикл
		
		// Пропускаем mcp_ объекты (расширение)
		Если СтрНачинаетсяС(МДОбъект.Имя, "mcp_") Тогда
			Продолжить;
		КонецЕсли;
		
		// Если указан конкретный объект - фильтруем
		Если ФильтрИмени <> "" И МДОбъект.Имя <> ФильтрИмени Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоФорм = МДОбъект.Формы.Количество();
		Если КоличествоФорм = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСтрок.Добавить("### " + ПрефиксТипа + "." + МДОбъект.Имя);
		
		Для Каждого МДФорма Из МДОбъект.Формы Цикл
			ВсегоФорм = ВсегоФорм + 1;
			
			ПолноеИмяФормы = МДОбъект.ПолноеИмя() + ".Форма." + МДФорма.Имя;
			
			Попытка
				ПолучитьФорму(ПолноеИмяФормы);
				МассивСтрок.Добавить("- " + МДФорма.Имя + ": OK");
			Исключение
				ОшибокФорм = ОшибокФорм + 1;
				ТекстОшибки = ОписаниеОшибки();
				// Укорачиваем текст ошибки
				Если СтрДлина(ТекстОшибки) > 200 Тогда
					ТекстОшибки = Лев(ТекстОшибки, 200) + "...";
				КонецЕсли;
				МассивСтрок.Добавить("- " + МДФорма.Имя + ": **FAIL** - " + ТекстОшибки);
			КонецПопытки;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область ИнструментСводкаДанных

Процедура ДобавитьИнструментСводкаДанных(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"metaType", "string",
		"Фильтр по типу: Catalogs, Documents, InformationRegisters, AccumulationRegisters. Если не указан - все типы."));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_data_summary",
		"Сводка по количеству записей в каждом справочнике, документе и регистре. Полезно для диагностики состояния базы данных.",
		СхемаПараметров);
	
КонецПроцедуры

// BSLLS:CognitiveComplexity-off
Функция СводкаДанных(Аргументы)
	
	ФильтрТипа = "";
	Если Аргументы.Свойство("metaType") Тогда
		ФильтрТипа = Аргументы.metaType;
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("## Сводка данных ИБ");
	МассивСтрок.Добавить("");
	
	ВсегоЗаписей = 0;
	
	Если ФильтрТипа = "" ИЛИ ФильтрТипа = "Catalogs" Тогда
		МассивСтрок.Добавить("### Справочники");
		МассивСтрок.Добавить("Имя | Записей");
		МассивСтрок.Добавить("--- | ---");
		СводкаКоллекции(МассивСтрок, Метаданные.Справочники, "Справочник", ВсегоЗаписей);
		МассивСтрок.Добавить("");
	КонецЕсли;
	
	Если ФильтрТипа = "" ИЛИ ФильтрТипа = "Documents" Тогда
		МассивСтрок.Добавить("### Документы");
		МассивСтрок.Добавить("Имя | Записей | Проведённых");
		МассивСтрок.Добавить("--- | --- | ---");
		СводкаДокументов(МассивСтрок, ВсегоЗаписей);
		МассивСтрок.Добавить("");
	КонецЕсли;
	
	Если ФильтрТипа = "" ИЛИ ФильтрТипа = "InformationRegisters" Тогда
		МассивСтрок.Добавить("### Регистры сведений");
		МассивСтрок.Добавить("Имя | Записей");
		МассивСтрок.Добавить("--- | ---");
		СводкаКоллекции(МассивСтрок, Метаданные.РегистрыСведений, "РегистрСведений", ВсегоЗаписей);
		МассивСтрок.Добавить("");
	КонецЕсли;
	
	Если ФильтрТипа = "" ИЛИ ФильтрТипа = "AccumulationRegisters" Тогда
		МассивСтрок.Добавить("### Регистры накопления");
		МассивСтрок.Добавить("Имя | Записей");
		МассивСтрок.Добавить("--- | ---");
		СводкаКоллекции(МассивСтрок, Метаданные.РегистрыНакопления, "РегистрНакопления", ВсегоЗаписей);
		МассивСтрок.Добавить("");
	КонецЕсли;
	
	МассивСтрок.Добавить("---");
	МассивСтрок.Добавить("**Всего записей:** " + Формат(ВсегоЗаписей, "ЧН=0; ЧГ="));
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

Процедура СводкаКоллекции(МассивСтрок, КоллекцияМД, ПрефиксТипа, ВсегоЗаписей)
	
	Для Каждого МДОбъект Из КоллекцияМД Цикл
		
		// Пропускаем mcp_ объекты
		Если СтрНачинаетсяС(МДОбъект.Имя, "mcp_") Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ТекстЗапроса = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Кол ИЗ " + ПрефиксТипа + "." + МДОбъект.Имя;
			Запрос = Новый Запрос(ТекстЗапроса);
			Результат = Запрос.Выполнить().Выгрузить();
			Количество = Результат[0].Кол;
			ВсегоЗаписей = ВсегоЗаписей + Количество;
			
			Если Количество > 0 Тогда
				МассивСтрок.Добавить(МДОбъект.Имя + " | " + Формат(Количество, "ЧН=0; ЧГ="));
			КонецЕсли;
		Исключение
			МассивСтрок.Добавить(МДОбъект.Имя + " | ошибка");
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Процедура СводкаДокументов(МассивСтрок, ВсегоЗаписей)
	
	Для Каждого МДДок Из Метаданные.Документы Цикл
		
		Если СтрНачинаетсяС(МДДок.Имя, "mcp_") Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ТекстЗапроса = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего, СУММА(ВЫБОР КОГДА Проведен ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Проведенных ИЗ Документ." + МДДок.Имя;
			Запрос = Новый Запрос(ТекстЗапроса);
			Результат = Запрос.Выполнить().Выгрузить();
			КолВсего = Результат[0].Всего;
			КолПроведенных = Результат[0].Проведенных;
			ВсегоЗаписей = ВсегоЗаписей + КолВсего;
			
			Если КолВсего > 0 Тогда
				МассивСтрок.Добавить(МДДок.Имя + " | " + Формат(КолВсего, "ЧН=0; ЧГ=")
					+ " | " + Формат(КолПроведенных, "ЧН=0; ЧГ="));
			КонецЕсли;
		Исключение
			МассивСтрок.Добавить(МДДок.Имя + " | ошибка | -");
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область ИнструментТехЖурнал

Процедура ДобавитьИнструментТехЖурнал(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"action", "string",
		"Действие: Check (чтение ошибок, default), Setup (включить ТЖ), Stop (выключить ТЖ), Status (статус ТЖ).", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"lastMinutes", "number",
		"Период в минутах для чтения (default: 30). Используется при action=Check."));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"maxRows", "number",
		"Максимум записей (default: 50). Используется при action=Check."));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"eventFilter", "string",
		"Фильтр по типу события: EXCP, SDBL, CALL, SCALL, CONN. Если не указан - все."));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_tech_journal",
		"Технологический журнал 1С (ТЖ): чтение runtime-ошибок (EXCP, SDBL, CALL, SCALL, CONN). "
			+ "ТЖ ловит исключения, которые НЕ попадают в Журнал регистрации (get_event_log). "
			+ "Действия: Check (получить ошибки), Setup (включить ТЖ, создать logcfg.xml), "
			+ "Stop (выключить ТЖ, удалить logcfg.xml), Status (проверить включён ли ТЖ). "
			+ "ВАЖНО: после Setup/Stop нужно ПЕРЕЗАПУСТИТЬ все процессы 1С!",
		СхемаПараметров);
	
КонецПроцедуры

// BSLLS:CognitiveComplexity-off
// BSLLS:CyclomaticComplexity-off
// BSLLS:MethodSize-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:CodeOutOfRegion-off
Функция ТехЖурнал(Аргументы)
	
	// Определяем пути
	// BSLLS:UsingHardcodedFilePath-off
	КонфДиректория = "C:\Program Files\1cv8\conf";
	ПутьLogcfg = КонфДиректория + "\logcfg.xml";
	ПутьЛогов = "D:\Git\Public_Trade_Module\Документация\Валидация\logs\tj";
	// BSLLS:UsingHardcodedFilePath-on
	
	// Действие
	Действие = "Check";
	Если Аргументы.Свойство("action") И ЗначениеЗаполнено(Аргументы.action) Тогда
		Действие = Аргументы.action;
	КонецЕсли;
	
	Если ВРег(Действие) = "SETUP" Тогда
		Возврат ТЖ_Настроить(ПутьLogcfg, ПутьЛогов);
	ИначеЕсли ВРег(Действие) = "STOP" Тогда
		Возврат ТЖ_Остановить(ПутьLogcfg);
	ИначеЕсли ВРег(Действие) = "STATUS" Тогда
		Возврат ТЖ_Статус(ПутьLogcfg, ПутьЛогов);
	Иначе
		Возврат ТЖ_Проверить(Аргументы, ПутьLogcfg, ПутьЛогов);
	КонецЕсли;
	
КонецФункции


// ========== Setup: Включить ТЖ ==========

Функция ТЖ_Настроить(ПутьLogcfg, ПутьЛогов)
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("=== Настройка Технологического журнала ===");
	МассивСтрок.Добавить("");
	
	// Создать папку для логов
	ДирЛогов = Новый Файл(ПутьЛогов);
	Если НЕ ДирЛогов.Существует() Тогда
		Попытка
			СоздатьКаталог(ПутьЛогов);
			МассивСтрок.Добавить("OK: Папка логов создана: " + ПутьЛогов);
		Исключение
			МассивСтрок.Добавить("FAIL: Не удалось создать папку: " + ОписаниеОшибки());
			Возврат СтрСоединить(МассивСтрок, Символы.ПС);
		КонецПопытки;
	Иначе
		МассивСтрок.Добавить("OK: Папка логов существует: " + ПутьЛогов);
	КонецЕсли;
	
	// Содержимое logcfg.xml
	ТекстКонфигурации =
		"<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<config xmlns=""http://v8.1c.ru/v8/tech-log"">" + Символы.ПС
		+ "    <log location=""" + ПутьЛогов + """ history=""24"">" + Символы.ПС
		+ "        <event>" + Символы.ПС
		+ "            <eq property=""name"" value=""EXCP""/>" + Символы.ПС
		+ "        </event>" + Символы.ПС
		+ "        <event>" + Символы.ПС
		+ "            <eq property=""name"" value=""EXCPCNTX""/>" + Символы.ПС
		+ "        </event>" + Символы.ПС
		+ "        <event>" + Символы.ПС
		+ "            <eq property=""name"" value=""SDBL""/>" + Символы.ПС
		+ "            <like property=""Descr"" value=""%""/>" + Символы.ПС
		+ "        </event>" + Символы.ПС
		+ "        <event>" + Символы.ПС
		+ "            <eq property=""name"" value=""CALL""/>" + Символы.ПС
		+ "            <like property=""Descr"" value=""%""/>" + Символы.ПС
		+ "        </event>" + Символы.ПС
		+ "        <event>" + Символы.ПС
		+ "            <eq property=""name"" value=""SCALL""/>" + Символы.ПС
		+ "            <like property=""Descr"" value=""%""/>" + Символы.ПС
		+ "        </event>" + Символы.ПС
		+ "        <event>" + Символы.ПС
		+ "            <eq property=""name"" value=""CONN""/>" + Символы.ПС
		+ "            <like property=""Descr"" value=""%""/>" + Символы.ПС
		+ "        </event>" + Символы.ПС
		+ "        <property name=""all""/>" + Символы.ПС
		+ "    </log>" + Символы.ПС
		+ "</config>";
	
	// Проверяем conf директорию
	ДирКонф = Новый Файл(ТЖ_КаталогФайла(ПутьLogcfg));
	Если НЕ ДирКонф.Существует() Тогда
		Попытка
			СоздатьКаталог(ТЖ_КаталогФайла(ПутьLogcfg));
		Исключение
			МассивСтрок.Добавить("FAIL: Не удалось создать директорию conf: " + ОписаниеОшибки());
			МассивСтрок.Добавить("");
			МассивСтрок.Добавить("РУЧНАЯ НАСТРОЙКА:");
			МассивСтрок.Добавить("Создайте файл: " + ПутьLogcfg);
			МассивСтрок.Добавить("Содержимое:");
			МассивСтрок.Добавить(ТекстКонфигурации);
			Возврат СтрСоединить(МассивСтрок, Символы.ПС);
		КонецПопытки;
	КонецЕсли;
	
	// Записываем logcfg.xml
	Попытка
		ЗаписьТекста = Новый ЗаписьТекста(ПутьLogcfg, КодировкаТекста.UTF8);
		ЗаписьТекста.Записать(ТекстКонфигурации);
		ЗаписьТекста.Закрыть();
		МассивСтрок.Добавить("OK: logcfg.xml создан: " + ПутьLogcfg);
	Исключение
		МассивСтрок.Добавить("FAIL: Не удалось записать logcfg.xml: " + ОписаниеОшибки());
		МассивСтрок.Добавить("");
		МассивСтрок.Добавить("РУЧНАЯ НАСТРОЙКА (нужны права администратора):");
		МассивСтрок.Добавить("Создайте файл: " + ПутьLogcfg);
		МассивСтрок.Добавить("Содержимое:");
		МассивСтрок.Добавить(ТекстКонфигурации);
		Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	КонецПопытки;
	
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("ВАЖНО: ПЕРЕЗАПУСТИТЕ все процессы 1С для активации ТЖ!");
	МассивСтрок.Добавить("  - Закройте конфигуратор и/или предприятие");
	МассивСтрок.Добавить("  - Откройте заново");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("События: EXCP, EXCPCNTX, SDBL, CALL, SCALL, CONN");
	МассивСтрок.Добавить("Логи: " + ПутьЛогов);
	МассивСтрок.Добавить("Хранение: 24 часа");
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

Функция ТЖ_КаталогФайла(ПутьФайла)
	Ф = Новый Файл(ПутьФайла);
	Возврат Ф.Путь;
КонецФункции


// ========== Stop: Выключить ТЖ ==========

Функция ТЖ_Остановить(ПутьLogcfg)
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("=== Остановка Технологического журнала ===");
	МассивСтрок.Добавить("");
	
	ФайлLogcfg = Новый Файл(ПутьLogcfg);
	Если ФайлLogcfg.Существует() Тогда
		Попытка
			УдалитьФайлы(ПутьLogcfg);
			МассивСтрок.Добавить("OK: logcfg.xml удалён");
		Исключение
			МассивСтрок.Добавить("FAIL: Не удалось удалить logcfg.xml: " + ОписаниеОшибки());
			МассивСтрок.Добавить("Удалите файл вручную: " + ПутьLogcfg);
		КонецПопытки;
	Иначе
		МассивСтрок.Добавить("INFO: logcfg.xml не найден (ТЖ уже выключен)");
	КонецЕсли;
	
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("ВАЖНО: Перезапустите процессы 1С для применения!");
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции


// ========== Status: Статус ТЖ ==========

Функция ТЖ_Статус(ПутьLogcfg, ПутьЛогов)
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("=== Статус Технологического журнала ===");
	МассивСтрок.Добавить("");
	
	// Проверка logcfg.xml
	ФайлLogcfg = Новый Файл(ПутьLogcfg);
	Если ФайлLogcfg.Существует() Тогда
		МассивСтрок.Добавить("logcfg.xml: ВКЛЮЧЁН (" + ПутьLogcfg + ")");
		
		// Читаем содержимое
		Попытка
			ЧтениеТекста = Новый ЧтениеТекста(ПутьLogcfg, КодировкаТекста.UTF8);
			Содержимое = ЧтениеТекста.Прочитать();
			ЧтениеТекста.Закрыть();
			
			// Подсчитываем события
			КолСобытий = СтрЧислоВхождений(Содержимое, "<event>");
			МассивСтрок.Добавить("Событий в фильтре: " + Формат(КолСобытий, "ЧН=0; ЧГ="));
			
			// Ищем location
			ПозНачала = СтрНайти(Содержимое, "location=""");
			Если ПозНачала > 0 Тогда
				Фрагмент = Сред(Содержимое, ПозНачала + 10);
				ПозКонца = СтрНайти(Фрагмент, """");
				Если ПозКонца > 0 Тогда
					ЛокацияЛогов = Лев(Фрагмент, ПозКонца - 1);
					МассивСтрок.Добавить("Папка логов (из logcfg): " + ЛокацияЛогов);
				КонецЕсли;
			КонецЕсли;
		Исключение
			МассивСтрок.Добавить("WARN: Не удалось прочитать logcfg.xml: " + ОписаниеОшибки());
		КонецПопытки;
	Иначе
		МассивСтрок.Добавить("logcfg.xml: НЕ НАЙДЕН (ТЖ выключен)");
		МассивСтрок.Добавить("Для включения: get_tech_journal с action=Setup");
	КонецЕсли;
	
	МассивСтрок.Добавить("");
	
	// Проверка папки логов
	ДирЛогов = Новый Файл(ПутьЛогов);
	Если ДирЛогов.Существует() Тогда
		Файлы = НайтиФайлы(ПутьЛогов, "*.log", Истина);
		МассивСтрок.Добавить("Папка логов: " + ПутьЛогов);
		МассивСтрок.Добавить(".log файлов: " + Формат(Файлы.Количество(), "ЧН=0; ЧГ="));
		
		// Размер всех файлов
		ОбщийРазмер = 0;
		ДатаПоследнего = '00010101';
		Для Каждого Ф Из Файлы Цикл
			ОбщийРазмер = ОбщийРазмер + Ф.Размер();
			Если Ф.ПолучитьВремяИзменения() > ДатаПоследнего Тогда
				ДатаПоследнего = Ф.ПолучитьВремяИзменения();
			КонецЕсли;
		КонецЦикла;
		
		Если ОбщийРазмер > 1048576 Тогда
			МассивСтрок.Добавить("Общий размер: " + Формат(ОбщийРазмер / 1048576, "ЧДЦ=1; ЧН=0; ЧГ=") + " МБ");
		ИначеЕсли ОбщийРазмер > 1024 Тогда
			МассивСтрок.Добавить("Общий размер: " + Формат(ОбщийРазмер / 1024, "ЧДЦ=1; ЧН=0; ЧГ=") + " КБ");
		Иначе
			МассивСтрок.Добавить("Общий размер: " + Формат(ОбщийРазмер, "ЧН=0; ЧГ=") + " байт");
		КонецЕсли;
		
		Если ДатаПоследнего > '00010101' Тогда
			МассивСтрок.Добавить("Последнее обновление: " + Формат(ДатаПоследнего, "ДФ=dd.MM.yyyy HH:mm:ss"));
		КонецЕсли;
		
		// Показать подпапки (процессы 1С)
		Подпапки = НайтиФайлы(ПутьЛогов, "*", Ложь);
		ПроцессыСтр = "";
		Для Каждого Подпапка Из Подпапки Цикл
			Если Подпапка.ЭтоКаталог() Тогда
				Если ЗначениеЗаполнено(ПроцессыСтр) Тогда
					ПроцессыСтр = ПроцессыСтр + ", ";
				КонецЕсли;
				ПроцессыСтр = ПроцессыСтр + Подпапка.Имя;
			КонецЕсли;
		КонецЦикла;
		Если ЗначениеЗаполнено(ПроцессыСтр) Тогда
			МассивСтрок.Добавить("Процессы: " + ПроцессыСтр);
		КонецЕсли;
	Иначе
		МассивСтрок.Добавить("Папка логов: НЕТ (" + ПутьЛогов + ")");
	КонецЕсли;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции


// ========== Check: Чтение ошибок из ТЖ ==========

Функция ТЖ_Проверить(Аргументы, ПутьLogcfg, ПутьЛогов)
	
	// Параметры
	ЗаМинут = 30;
	Если Аргументы.Свойство("lastMinutes") И Аргументы.lastMinutes <> Неопределено Тогда
		ЗаМинут = Число(Аргументы.lastMinutes);
	КонецЕсли;
	
	Лимит = 50;
	Если Аргументы.Свойство("maxRows") И Аргументы.maxRows <> Неопределено Тогда
		Лимит = Число(Аргументы.maxRows);
	КонецЕсли;
	
	ФильтрСобытия = "";
	Если Аргументы.Свойство("eventFilter") И ЗначениеЗаполнено(Аргументы.eventFilter) Тогда
		ФильтрСобытия = ВРег(Аргументы.eventFilter);
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	
	// Проверка logcfg.xml
	ФайлLogcfg = Новый Файл(ПутьLogcfg);
	Если НЕ ФайлLogcfg.Существует() Тогда
		МассивСтрок.Добавить("WARN: ТЖ не настроен (logcfg.xml отсутствует)");
		МассивСтрок.Добавить("Для включения: get_tech_journal с action=Setup");
		МассивСтрок.Добавить("");
		МассивСтрок.Добавить("Примечание: всё равно проверяем существующие лог-файлы.");
		МассивСтрок.Добавить("");
	КонецЕсли;
	
	// Проверка папки логов
	ДирЛогов = Новый Файл(ПутьЛогов);
	Если НЕ ДирЛогов.Существует() Тогда
		МассивСтрок.Добавить("Папка логов ТЖ не найдена: " + ПутьЛогов);
		МассивСтрок.Добавить("ТЖ не активирован или не создавались логи.");
		Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	КонецЕсли;
	
	// Находим .log файлы
	ВсеЛоги = НайтиФайлы(ПутьЛогов, "*.log", Истина);
	
	Если ВсеЛоги.Количество() = 0 Тогда
		МассивСтрок.Добавить("=== Технологический журнал: проверка ===");
		МассивСтрок.Добавить("Период: последние " + Формат(ЗаМинут, "ЧН=0; ЧГ=") + " мин.");
		МассивСтрок.Добавить("");
		МассивСтрок.Добавить("Лог-файлов не найдено. Возможные причины:");
		МассивСтрок.Добавить("1. ТЖ не включён (action=Setup)");
		МассивСтрок.Добавить("2. Процессы 1С не перезапущены после Setup");
		МассивСтрок.Добавить("3. Ошибок не было (хорошо!)");
		Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	КонецЕсли;
	
	// Фильтруем по дате модификации
	ГраницаВремени = ТекущаяДатаСеанса() - ЗаМинут * 60;
	СвежиеЛоги = Новый Массив;
	Для Каждого ФайлЛога Из ВсеЛоги Цикл
		Если ФайлЛога.ПолучитьВремяИзменения() >= ГраницаВремени Тогда
			СвежиеЛоги.Добавить(ФайлЛога);
		КонецЕсли;
	КонецЦикла;
	
	Если СвежиеЛоги.Количество() = 0 Тогда
		МассивСтрок.Добавить("=== Технологический журнал: проверка ===");
		МассивСтрок.Добавить("Период: последние " + Формат(ЗаМинут, "ЧН=0; ЧГ=") + " мин.");
		МассивСтрок.Добавить("");
		МассивСтрок.Добавить("OK: Нет свежих логов за указанный период.");
		МассивСтрок.Добавить("Всего .log файлов: " + Формат(ВсеЛоги.Количество(), "ЧН=0; ЧГ="));
		Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	КонецЕсли;
	
	// Читаем и парсим логи
	МассивОшибок = Новый Массив;
	ФайловПрочитано = 0;
	ФайловОшибок = 0;
	
	Для Каждого ФайлЛога Из СвежиеЛоги Цикл
		Попытка
			// Копируем во временный файл (обход блокировки 1С)
			ВремФайл = ПолучитьИмяВременногоФайла("log");
			Попытка
				КопироватьФайл(ФайлЛога.ПолноеИмя, ВремФайл);
			Исключение
				// Файл заблокирован - пропускаем
				ФайловОшибок = ФайловОшибок + 1;
				Продолжить;
			КонецПопытки;
			
			ЧтениеТекста = Новый ЧтениеТекста(ВремФайл, КодировкаТекста.UTF8);
			Содержимое = ЧтениеТекста.Прочитать();
			ЧтениеТекста.Закрыть();
			
			// Удаляем временный файл
			Попытка
				УдалитьФайлы(ВремФайл);
			Исключение
				// Удаление временного файла не критично, ОС очистит %TEMP%
				ВремФайл = ВремФайл; // BSLLS:SelfAssign-off
			КонецПопытки;
			
			Если НЕ ЗначениеЗаполнено(Содержимое) Тогда
				Продолжить;
			КонецЕсли;
			
			ФайловПрочитано = ФайловПрочитано + 1;
			
			// Парсим записи
			ТЖ_РаспарситьЛогФайл(Содержимое, ФайлЛога.Имя, МассивОшибок, ФильтрСобытия, Лимит);
			
			Если МассивОшибок.Количество() >= Лимит Тогда
				Прервать;
			КонецЕсли;
			
		Исключение
			ФайловОшибок = ФайловОшибок + 1;
		КонецПопытки;
	КонецЦикла;
	
	// Формируем отчёт
	МассивСтрок.Добавить("=== Технологический журнал: проверка ===");
	МассивСтрок.Добавить("Период: последние " + Формат(ЗаМинут, "ЧН=0; ЧГ=") + " мин."
		+ " | Прочитано файлов: " + Формат(ФайловПрочитано, "ЧН=0; ЧГ=") + "/" + Формат(СвежиеЛоги.Количество(), "ЧН=0; ЧГ=")
		+ ?(ЗначениеЗаполнено(ФильтрСобытия), " | Фильтр: " + ФильтрСобытия, ""));
	МассивСтрок.Добавить("");
	
	Если ФайловОшибок > 0 Тогда
		МассивСтрок.Добавить("WARN: " + Формат(ФайловОшибок, "ЧН=0; ЧГ=") + " файлов не прочитаны (заблокированы процессами 1С)");
		МассивСтрок.Добавить("");
	КонецЕсли;
	
	Если МассивОшибок.Количество() = 0 Тогда
		МассивСтрок.Добавить("OK: Ошибок не обнаружено в ТЖ за последние " + Формат(ЗаМинут, "ЧН=0; ЧГ=") + " мин.");
	Иначе
		МассивСтрок.Добавить("НАЙДЕНО ОШИБОК: " + Формат(МассивОшибок.Количество(), "ЧН=0; ЧГ="));
		МассивСтрок.Добавить("");
		
		Для Инд = 0 По МассивОшибок.ВГраница() Цикл
			Событие = МассивОшибок[Инд];
			НомерОшибки = Инд + 1;
			
			МассивСтрок.Добавить("--- [" + Формат(НомерОшибки, "ЧН=0; ЧГ=") + "] " + Событие.ТипСобытия + " ---");
			МассивСтрок.Добавить("Время: " + Событие.Время);
			
			Если ЗначениеЗаполнено(Событие.Модуль) Тогда
				МассивСтрок.Добавить("Модуль: " + Событие.Модуль);
			КонецЕсли;
			
			МассивСтрок.Добавить("Описание: " + Событие.Описание);
			
			Если ЗначениеЗаполнено(Событие.Контекст) Тогда
				МассивСтрок.Добавить("Контекст: " + Событие.Контекст);
			КонецЕсли;
			
			МассивСтрок.Добавить("");
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции


// ========== Парсинг содержимого одного .log файла ==========

// BSLLS:CognitiveComplexity-off
// BSLLS:CyclomaticComplexity-off
Процедура ТЖ_РаспарситьЛогФайл(Содержимое, ИмяФайла, МассивОшибок, ФильтрСобытия, Лимит)
	
	// Типы событий-ошибок
	ТипыОшибок = "EXCP,SDBL,CALL,SCALL,CONN";
	
	Строки = СтрРазделить(Содержимое, Символы.ПС);
	
	ТекущийТип = "";
	ТекущийТекст = "";
	
	Для Каждого ТекСтрока Из Строки Цикл
		
		// Проверяем: начало нового события?
		НовоеСобытие = Ложь;
		ИмяСобытия = "";
		Если СтрДлина(ТекСтрока) > 15 Тогда
			ИмяСобытия = ТЖ_ИзвлечьИмяСобытия(ТекСтрока);
			НовоеСобытие = ЗначениеЗаполнено(ИмяСобытия);
		КонецЕсли;
		
		Если НовоеСобытие Тогда
			// Обработать предыдущее событие
			Если ЗначениеЗаполнено(ТекущийТип) Тогда
				ТЖ_ОбработатьСобытие(ТекущийТип, ТекущийТекст, ИмяФайла, МассивОшибок, ФильтрСобытия, ТипыОшибок);
			КонецЕсли;
			
			Если МассивОшибок.Количество() >= Лимит Тогда
				Возврат;
			КонецЕсли;
			
			ТекущийТип = ИмяСобытия;
			ТекущийТекст = ТекСтрока;
		Иначе
			// Продолжение многострочного события
			Если ЗначениеЗаполнено(ТекущийТекст) Тогда
				ТекущийТекст = ТекущийТекст + Символы.ПС + ТекСтрока;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Последнее событие
	Если ЗначениеЗаполнено(ТекущийТип) И МассивОшибок.Количество() < Лимит Тогда
		ТЖ_ОбработатьСобытие(ТекущийТип, ТекущийТекст, ИмяФайла, МассивОшибок, ФильтрСобытия, ТипыОшибок);
	КонецЕсли;
	
КонецПроцедуры


Процедура ТЖ_ОбработатьСобытие(ТипСобытия, ТекстСобытия, ИмяФайла, МассивОшибок, ФильтрСобытия, ТипыОшибок)
	
	// Проверяем тип события
	Если СтрНайти(ТипыОшибок, ТипСобытия) = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Фильтр по конкретному типу
	Если ЗначениеЗаполнено(ФильтрСобытия) И ВРег(ТипСобытия) <> ВРег(ФильтрСобытия) Тогда
		Возврат;
	КонецЕсли;
	
	// Извлекаем Descr
	Описание = ТЖ_ИзвлечьСвойство(ТекстСобытия, "Descr");
	Если НЕ ЗначениеЗаполнено(Описание) Тогда
		Возврат; // Нет описания - не ошибка
	КонецЕсли;
	
	// Фильтрация по processName (только наша ИБ)
	ПроцессИмя = ТЖ_ИзвлечьСвойство(ТекстСобытия, "p:processName");
	Если ЗначениеЗаполнено(ПроцессИмя) И СтрНайти(ВРег(ПроцессИмя), "PUBLIC TRADE MODULE") = 0 Тогда
		Возврат; // Не наша ИБ
	КонецЕсли;
	
	// Извлекаем Module
	Модуль = ТЖ_ИзвлечьСвойство(ТекстСобытия, "Module");
	
	// Извлекаем Func
	ИмяФункции = ТЖ_ИзвлечьСвойство(ТекстСобытия, "Func");
	
	// Время: из имени файла + из записи
	ВремяСтр = "";
	// Имя файла: YYMMDDhh.log
	Если СтрДлина(ИмяФайла) >= 8 Тогда
		ВремяФайла = Лев(ИмяФайла, 8);
		Попытка
			ВремяСтр = "20" + Сред(ВремяФайла, 1, 2) + "-" + Сред(ВремяФайла, 3, 2) + "-"
				+ Сред(ВремяФайла, 5, 2) + " " + Сред(ВремяФайла, 7, 2) + ":";
		Исключение
			ВремяСтр = "";
		КонецПопытки;
	КонецЕсли;
	// Время из записи: mm:ss.ffffff
	ПозТире = СтрНайти(ТекстСобытия, "-");
	Если ПозТире > 5 Тогда
		ВремяЗаписи = Лев(ТекстСобытия, ПозТире - 1);
		ВремяСтр = ВремяСтр + ВремяЗаписи;
	КонецЕсли;
	
	// Формируем контекст
	МассивКонтекста = Новый Массив;
	Если ЗначениеЗаполнено(ПроцессИмя) Тогда
		МассивКонтекста.Добавить(ПроцессИмя);
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяФункции) Тогда
		МассивКонтекста.Добавить("Func=" + ИмяФункции);
	КонецЕсли;
	
	// SQL для SDBL
	Если ТипСобытия = "SDBL" Тогда
		SQLТекст = ТЖ_ИзвлечьСвойство(ТекстСобытия, "Sql");
		Если ЗначениеЗаполнено(SQLТекст) Тогда
			Если СтрДлина(SQLТекст) > 200 Тогда
				SQLТекст = Лев(SQLТекст, 200) + "...";
			КонецЕсли;
			МассивКонтекста.Добавить("SQL: " + SQLТекст);
		КонецЕсли;
	КонецЕсли;
	
	// Ограничиваем описание
	Если СтрДлина(Описание) > 500 Тогда
		Описание = Лев(Описание, 500) + "... (обрезано)";
	КонецЕсли;
	
	// Добавляем в массив
	СтруктураОшибки = Новый Структура;
	СтруктураОшибки.Вставить("ТипСобытия", ТипСобытия);
	СтруктураОшибки.Вставить("Время", ВремяСтр);
	СтруктураОшибки.Вставить("Модуль", Модуль);
	СтруктураОшибки.Вставить("Описание", Описание);
	СтруктураОшибки.Вставить("Контекст", СтрСоединить(МассивКонтекста, " | "));
	
	МассивОшибок.Добавить(СтруктураОшибки);
	
КонецПроцедуры


// ========== Извлечение свойства из текста события ТЖ ==========

Функция ТЖ_ИзвлечьСвойство(ТекстСобытия, ИмяСвойства)
	
	// Ищем свойство в формате: ИмяСвойства='значение' или ИмяСвойства=значение
	Искать = ИмяСвойства + "='";
	Позиция = СтрНайти(ТекстСобытия, Искать);
	
	Если Позиция > 0 Тогда
		// Формат: ИмяСвойства='значение_с_экранированием_одинарных_кавычек'
		Начало = Позиция + СтрДлина(Искать);
		Фрагмент = Сред(ТекстСобытия, Начало);
		
		// Ищем закрывающую одинарную кавычку (не удвоённую)
		Результат = "";
		Инд = 1;
		Пока Инд <= СтрДлина(Фрагмент) Цикл
			ТекСимвол = Сред(Фрагмент, Инд, 1);
			Если ТекСимвол = "'" Тогда
				// Проверяем: это удвоённая кавычка?
				Если Инд < СтрДлина(Фрагмент) И Сред(Фрагмент, Инд + 1, 1) = "'" Тогда
					Результат = Результат + "'";
					Инд = Инд + 2;
				Иначе
					// Конец значения
					Возврат Результат;
				КонецЕсли;
			Иначе
				Результат = Результат + ТекСимвол;
				Инд = Инд + 1;
			КонецЕсли;
		КонецЦикла;
		
		Возврат Результат;
	КонецЕсли;
	
	// Формат без кавычек: ИмяСвойства=значение
	Искать = ИмяСвойства + "=";
	Позиция = СтрНайти(ТекстСобытия, Искать);
	
	Если Позиция > 0 Тогда
		Начало = Позиция + СтрДлина(Искать);
		Фрагмент = Сред(ТекстСобытия, Начало);
		
		// Значение до запятой или конца строки
		ПозЗапятой = СтрНайти(Фрагмент, ",");
		ПозПС = СтрНайти(Фрагмент, Символы.ПС);
		ПозВК = СтрНайти(Фрагмент, Символы.ВК);
		
		КонецЗначения = СтрДлина(Фрагмент);
		Если ПозЗапятой > 0 И ПозЗапятой < КонецЗначения Тогда
			КонецЗначения = ПозЗапятой - 1;
		КонецЕсли;
		Если ПозПС > 0 И ПозПС < КонецЗначения Тогда
			КонецЗначения = ПозПС - 1;
		КонецЕсли;
		Если ПозВК > 0 И ПозВК < КонецЗначения Тогда
			КонецЗначения = ПозВК - 1;
		КонецЕсли;
		
		Возврат СокрЛП(Лев(Фрагмент, КонецЗначения));
	КонецЕсли;
	
	Возврат "";
	
КонецФункции


// ========== Извлечение имени события для уменьшения вложенности ==========

Функция ТЖ_ИзвлечьИмяСобытия(СтрокаЛога)
	
	// Паттерн: mm:ss.ffffff-duration,EventName,Level,...
	Символ3 = Сред(СтрокаЛога, 3, 1);
	Символ6 = Сред(СтрокаЛога, 6, 1);
	Если Символ3 <> ":" ИЛИ Символ6 <> "." Тогда
		Возврат "";
	КонецЕсли;
	
	ПозТире = СтрНайти(СтрокаЛога, "-");
	Если ПозТире <= 6 Тогда
		Возврат "";
	КонецЕсли;
	
	ПозЗапятой1 = СтрНайти(СтрокаЛога, ",", , ПозТире);
	Если ПозЗапятой1 = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ПозЗапятой2 = СтрНайти(СтрокаЛога, ",", , ПозЗапятой1 + 1);
	Если ПозЗапятой2 = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Сред(СтрокаЛога, ПозЗапятой1 + 1, ПозЗапятой2 - ПозЗапятой1 - 1);
	
КонецФункции

#КонецОбласти
