Функция ОбновитьЭлементСправочника(Аргументы)
	
	ИмяСправочника = Аргументы.catalogName;
	ЗначениеПоиска = Аргументы.searchValue;
	
	МДСправочник = Метаданные.Справочники.Найти(ИмяСправочника);
	Если МДСправочник = Неопределено Тогда
		ВызватьИсключение "Справочник не найден: " + ИмяСправочника;
	КонецЕсли;
	
	Менеджер = Справочники[ИмяСправочника];
	Ссылка = Менеджер.НайтиПоКоду(ЗначениеПоиска);
	Если Ссылка.Пустая() Тогда
		Ссылка = Менеджер.НайтиПоНаименованию(ЗначениеПоиска, Истина);
	КонецЕсли;
	Если Ссылка.Пустая() Тогда
		ВызватьИсключение "Элемент не найден: " + ИмяСправочника + " = '" + ЗначениеПоиска + "'";
	КонецЕсли;
	
	ОбъектДанных = Ссылка.ПолучитьОбъект();
	
	// Обновляем наименование если указано
	Если Аргументы.Свойство("newDescription") Тогда
		ОбъектДанных.Наименование = Аргументы.newDescription;
	КонецЕсли;
	
	// Обновляем код если указан
	Если Аргументы.Свойство("newCode") Тогда
		ОбъектДанных.Код = Аргументы.newCode;
	КонецЕсли;
	
	// Обновляем реквизиты
	Если Аргументы.Свойство("attributes") Тогда
		ЗаполнитьРеквизитыИзJSON(ОбъектДанных, Аргументы.attributes, МДСправочник);
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		ОбъектДанных.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение "Ошибка обновления справочника: " + ОписаниеОшибки();
	КонецПопытки;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("OK: Элемент обновлён — " + ИмяСправочника);
	МассивСтрок.Добавить("Ссылка: " + Строка(Ссылка));
	МассивСтрок.Добавить("Код: " + ОбъектДанных.Код);
	МассивСтрок.Добавить("Наименование: " + ОбъектДанных.Наименование);
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

