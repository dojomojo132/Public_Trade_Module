// BSLLS:CognitiveComplexity-off
// BSLLS:CyclomaticComplexity-off
Функция ПакетноеСоздание(Аргументы)
	
	ИмяСправочника = Аргументы.catalogName;
	
	// Проверяем справочник
	МДСправочник = Метаданные.Справочники.Найти(ИмяСправочника);
	Если МДСправочник = Неопределено Тогда
		Возврат "Ошибка: справочник '" + ИмяСправочника + "' не найден";
	КонецЕсли;
	
	// Парсим JSON-массив
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Аргументы.items);
		МассивЭлементов = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		Возврат "Ошибка разбора JSON: " + ОписаниеОшибки();
	КонецПопытки;
	
	Если ТипЗнч(МассивЭлементов) <> Тип("Массив") Тогда
		Возврат "Ошибка: items должен быть JSON-массивом [...]";
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("## Пакетное создание: " + ИмяСправочника);
	МассивСтрок.Добавить("Элементов для создания: " + Формат(МассивЭлементов.Количество(), "ЧН=0; ЧГ="));
	МассивСтрок.Добавить("");
	
	СоздаНОУспешно = 0;
	СозданоОшибок = 0;
	
	Для Индекс = 0 По МассивЭлементов.ВГраница() Цикл
		
		ОписаниеЭлемента = МассивЭлементов[Индекс];
		НомерЭлемента = Формат(Индекс + 1, "ЧН=0; ЧГ=");
		
		Попытка
			НовыйЭлемент = Справочники[ИмяСправочника].СоздатьЭлемент();
			
			Если ТипЗнч(ОписаниеЭлемента) = Тип("Структура") ИЛИ ТипЗнч(ОписаниеЭлемента) = Тип("Соответствие") Тогда
				// Наименование
				ОписаниеНаименование = Неопределено;
				Если ТипЗнч(ОписаниеЭлемента) = Тип("Структура") Тогда
					ОписаниеЭлемента.Свойство("description", ОписаниеНаименование);
				Иначе
					ОписаниеНаименование = ОписаниеЭлемента.Получить("description");
				КонецЕсли;
				Если ОписаниеНаименование <> Неопределено Тогда
					НовыйЭлемент.Наименование = ОписаниеНаименование;
				КонецЕсли;
				
				// Код
				ОписаниеКод = Неопределено;
				Если ТипЗнч(ОписаниеЭлемента) = Тип("Структура") Тогда
					ОписаниеЭлемента.Свойство("code", ОписаниеКод);
				Иначе
					ОписаниеКод = ОписаниеЭлемента.Получить("code");
				КонецЕсли;
				Если ОписаниеКод <> Неопределено Тогда
					НовыйЭлемент.Код = ОписаниеКод;
				КонецЕсли;
				
				// Реквизиты
				ОписаниеАтрибуты = Неопределено;
				Если ТипЗнч(ОписаниеЭлемента) = Тип("Структура") Тогда
					ОписаниеЭлемента.Свойство("attributes", ОписаниеАтрибуты);
				Иначе
					ОписаниеАтрибуты = ОписаниеЭлемента.Получить("attributes");
				КонецЕсли;
				Если ТипЗнч(ОписаниеАтрибуты) = Тип("Соответствие") ИЛИ ТипЗнч(ОписаниеАтрибуты) = Тип("Структура") Тогда
					Для Каждого КлючЗначение Из ОписаниеАтрибуты Цикл
						Попытка
							НовыйЭлемент[КлючЗначение.Ключ] = ПривестиЗначение(
								КлючЗначение.Значение, МДСправочник.Реквизиты.Найти(КлючЗначение.Ключ));
						Исключение
							// Пропускаем неизвестные реквизиты
						КонецПопытки;
					КонецЦикла;
				КонецЕсли;
			ИначеЕсли ТипЗнч(ОписаниеЭлемента) = Тип("Строка") Тогда
				// Простая строка - используем как наименование
				НовыйЭлемент.Наименование = ОписаниеЭлемента;
			КонецЕсли;
			
			НовыйЭлемент.Записать();
			СоздаНОУспешно = СоздаНОУспешно + 1;
			МассивСтрок.Добавить(НомерЭлемента + ". OK: " + НовыйЭлемент.Наименование + " (Код: " + НовыйЭлемент.Код + ")");
		Исключение
			СозданоОшибок = СозданоОшибок + 1;
			МассивСтрок.Добавить(НомерЭлемента + ". ОШИБКА: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("**Итого:** создано " + Формат(СоздаНОУспешно, "ЧН=0; ЧГ=") + ", ошибок " + Формат(СозданоОшибок, "ЧН=0; ЧГ="));
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

#КонецОбласти

#Область ИнструментИмпортДанных

Процедура ДобавитьИнструментИмпортДанных(Инструменты)
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"metaType", "string", "Тип: Catalogs, Documents", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name", "string", "Имя объекта (например: Номенклатура)", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"data", "string", "JSON-массив: [{""description"":""Имя"",""attributes"":{...},""tabularSections"":{""ТЧ"":[{...}]}}]", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"updateExisting", "boolean", "Обновлять существующие при совпадении по Наименованию/Номеру (по умолчанию false)", Ложь));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	mcp_Метаданные.ДобавитьИнструмент(Инструменты, "import_data",
		"Массовая загрузка данных из JSON. Поддерживает справочники и документы с реквизитами и табличными частями.", СхемаПараметров);
	
КонецПроцедуры

// BSLLS:CognitiveComplexity-off
// BSLLS:CyclomaticComplexity-off
Функция ИмпортДанных(Аргументы)
	
	ТипОбъекта = ВРег(Аргументы.metaType);
	ИмяОбъекта = Аргументы.name;
	ОбновлятьСуществующие = Ложь;
	Если Аргументы.Свойство("updateExisting") Тогда
		ОбновлятьСуществующие = (Аргументы.updateExisting = Истина ИЛИ Аргументы.updateExisting = "true");
	КонецЕсли;
	
	МДОбъект = Неопределено;
	Если ТипОбъекта = "CATALOGS" Тогда
		МДОбъект = Метаданные.Справочники.Найти(ИмяОбъекта);
	ИначеЕсли ТипОбъекта = "DOCUMENTS" Тогда
		МДОбъект = Метаданные.Документы.Найти(ИмяОбъекта);
	Иначе
		Возврат "Ошибка: поддерживаются типы Catalogs и Documents";
	КонецЕсли;
	Если МДОбъект = Неопределено Тогда
		Возврат "Ошибка: объект '" + ИмяОбъекта + "' не найден";
	КонецЕсли;
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Аргументы.data);
		МассивДанных = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		Возврат "Ошибка разбора JSON: " + ОписаниеОшибки();
	КонецПопытки;
	Если ТипЗнч(МассивДанных) <> Тип("Массив") Тогда
		Возврат "Ошибка: data должен быть JSON-массивом";
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("## Импорт: " + ИмяОбъекта + " (" + Формат(МассивДанных.Количество(), "ЧН=0; ЧГ=") + " эл.)");
	Создано = 0; ОбновленоКол = 0; Ошибок = 0;
	
	Для Индекс = 0 По МассивДанных.ВГраница() Цикл
		Элт = МассивДанных[Индекс];
		Нмр = Формат(Индекс + 1, "ЧН=0; ЧГ=");
		Попытка
			ЭтоОбн = Ложь;
			Объект = Неопределено;
			Если ОбновлятьСуществующие Тогда
				Объект = НайтиСуществующийИмпорт(ТипОбъекта, ИмяОбъекта, Элт);
			КонецЕсли;
			Если Объект = Неопределено Тогда
				Если ТипОбъекта = "CATALOGS" Тогда
					Объект = Справочники[ИмяОбъекта].СоздатьЭлемент();
				Иначе
					Объект = Документы[ИмяОбъекта].СоздатьДокумент();
				КонецЕсли;
			Иначе
				ЭтоОбн = Истина;
			КонецЕсли;
			
			ЗначОпис = СвойствоИмпорта(Элт, "description");
			Если ЗначОпис <> Неопределено И ТипОбъекта = "CATALOGS" Тогда
				Объект.Наименование = ЗначОпис;
			КонецЕсли;
			
			ЗначДат = СвойствоИмпорта(Элт, "date");
			Если ЗначДат <> Неопределено И ТипОбъекта = "DOCUMENTS" И ТипЗнч(ЗначДат) = Тип("Строка") Тогда
				ЧистД = СтрЗаменить(СтрЗаменить(СтрЗаменить(ЗначДат, "-", ""), ".", ""), "/", "");
				Если СтрДлина(ЧистД) >= 8 Тогда
					Объект.Дата = Дата(Лев(ЧистД, 8) + "000000");
				КонецЕсли;
			КонецЕсли;
			
			АтрЭл = СвойствоИмпорта(Элт, "attributes");
			Если ТипЗнч(АтрЭл) = Тип("Структура") ИЛИ ТипЗнч(АтрЭл) = Тип("Соответствие") Тогда
				Для Каждого КЗ Из АтрЭл Цикл
					Попытка
						Объект[КЗ.Ключ] = ПривестиЗначение(КЗ.Значение, МДОбъект.Реквизиты.Найти(КЗ.Ключ));
					Исключение
					КонецПопытки;
				КонецЦикла;
			КонецЕсли;
			
			ТЧД = СвойствоИмпорта(Элт, "tabularSections");
			Если ТипЗнч(ТЧД) = Тип("Структура") ИЛИ ТипЗнч(ТЧД) = Тип("Соответствие") Тогда
				Для Каждого КлТЧ Из ТЧД Цикл
					МДТЧ = МДОбъект.ТабличныеЧасти.Найти(КлТЧ.Ключ);
					Если МДТЧ <> Неопределено И ТипЗнч(КлТЧ.Значение) = Тип("Массив") Тогда
						Объект[КлТЧ.Ключ].Очистить();
						Для Каждого СтрТЧ Из КлТЧ.Значение Цикл
							НовСтр = Объект[КлТЧ.Ключ].Добавить();
							Если ТипЗнч(СтрТЧ) = Тип("Структура") ИЛИ ТипЗнч(СтрТЧ) = Тип("Соответствие") Тогда
								Для Каждого КЗ2 Из СтрТЧ Цикл
									Попытка
										НовСтр[КЗ2.Ключ] = ПривестиЗначение(КЗ2.Значение, МДТЧ.Реквизиты.Найти(КЗ2.Ключ));
									Исключение
									КонецПопытки;
								КонецЦикла;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Объект.Записать();
			Если ЭтоОбн Тогда
				ОбновленоКол = ОбновленоКол + 1;
				МассивСтрок.Добавить(Нмр + ". Обновлён: " + Строка(Объект.Ссылка));
			Иначе
				Создано = Создано + 1;
				МассивСтрок.Добавить(Нмр + ". Создан: " + Строка(Объект.Ссылка));
			КонецЕсли;
		Исключение
			Ошибок = Ошибок + 1;
			МассивСтрок.Добавить(Нмр + ". ОШИБКА: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("**Итого:** создано " + Формат(Создано, "ЧН=0; ЧГ=") + ", обновлено " + Формат(ОбновленоКол, "ЧН=0; ЧГ=") + ", ошибок " + Формат(Ошибок, "ЧН=0; ЧГ="));
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

Функция СвойствоИмпорта(Элемент, ИмяСвойства)
	Если ТипЗнч(Элемент) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Элемент.Свойство(ИмяСвойства, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Элемент) = Тип("Соответствие") Тогда
		Возврат Элемент.Получить(ИмяСвойства);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция НайтиСуществующийИмпорт(ТипОбъекта, ИмяОбъекта, ОписаниеЭлемента)
	Если ТипОбъекта = "CATALOGS" Тогда
		Наим = СвойствоИмпорта(ОписаниеЭлемента, "description");
		Если Наим <> Неопределено Тогда
			Ссылка = Справочники[ИмяОбъекта].НайтиПоНаименованию(Наим, Истина);
			Если ЗначениеЗаполнено(Ссылка) Тогда
				Возврат Ссылка.ПолучитьОбъект();
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипОбъекта = "DOCUMENTS" Тогда
		Ном = СвойствоИмпорта(ОписаниеЭлемента, "number");
		Если Ном <> Неопределено Тогда
			Ссылка = Документы[ИмяОбъекта].НайтиПоНомеру(Ном);
			Если ЗначениеЗаполнено(Ссылка) Тогда
				Возврат Ссылка.ПолучитьОбъект();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

#КонецОбласти