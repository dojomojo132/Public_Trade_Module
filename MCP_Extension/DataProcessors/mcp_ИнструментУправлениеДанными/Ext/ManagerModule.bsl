#Область ПрограммныйИнтерфейс

Процедура ДобавитьИнструменты(Инструменты) Экспорт
	
	ДобавитьИнструментСозданиеЭлементаСправочника(Инструменты);
	ДобавитьИнструментСозданиеДокумента(Инструменты);
	ДобавитьИнструментОбновлениеЗаписиРегистра(Инструменты);
	ДобавитьИнструментУдалениеОбъекта(Инструменты);
	ДобавитьИнструментОбновлениеСправочника(Инструменты);
	ДобавитьИнструментОбновлениеДокумента(Инструменты);
	ДобавитьИнструментПакетноеСоздание(Инструменты);
	ДобавитьИнструментИмпортДанных(Инструменты);
	
КонецПроцедуры

Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт
	
	Если ИмяИнструмента = "create_catalog_item" Тогда
		Возврат СоздатьЭлементСправочника(Аргументы);
	ИначеЕсли ИмяИнструмента = "create_document" Тогда
		Возврат СоздатьДокумент(Аргументы);
	ИначеЕсли ИмяИнструмента = "update_register_record" Тогда
		Возврат ОбновитьЗаписьРегистра(Аргументы);
	ИначеЕсли ИмяИнструмента = "delete_object" Тогда
		Возврат УдалитьОбъект(Аргументы);
	ИначеЕсли ИмяИнструмента = "update_catalog_item" Тогда
		Возврат ОбновитьЭлементСправочника(Аргументы);
	ИначеЕсли ИмяИнструмента = "update_document" Тогда
		Возврат ОбновитьДокумент(Аргументы);
	ИначеЕсли ИмяИнструмента = "bulk_create" Тогда
		Возврат ПакетноеСоздание(Аргументы);
	ИначеЕсли ИмяИнструмента = "import_data" Тогда
		Возврат ИмпортДанных(Аргументы);
	Иначе
		ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;
	КонецЕсли;
	
КонецФункции

#КонецОбласти


#Область ИнструментСозданиеЭлементаСправочника

Процедура ДобавитьИнструментСозданиеЭлементаСправочника(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"catalogName", "string", "Имя справочника (например: Номенклатура, Контрагенты)", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"description", "string", "Наименование элемента", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"code", "string", "Код элемента. Если не указан - назначается автоматически."));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"attributes", "string", "JSON-строка с реквизитами: {""ИмяРеквизита"": ""Значение"", ...}"));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"isFolder", "boolean", "Создать группу (папку) вместо элемента", Ложь));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"create_catalog_item",
		"Создание нового элемента или группы справочника. Позволяет установить наименование, код и произвольные реквизиты.",
		СхемаПараметров);
	
КонецПроцедуры

Функция СоздатьЭлементСправочника(Аргументы)
	
	ИмяСправочника = Аргументы.catalogName;
	
	МДСправочник = Метаданные.Справочники.Найти(ИмяСправочника);
	Если МДСправочник = Неопределено Тогда
		ВызватьИсключение "Справочник не найден: " + ИмяСправочника;
	КонецЕсли;
	
	// Создаем элемент или группу
	ЭтоГруппа = Ложь;
	Если Аргументы.Свойство("isFolder") Тогда
		ЭтоГруппа = Аргументы.isFolder;
	КонецЕсли;
	
	Менеджер = Справочники[ИмяСправочника];
	Если ЭтоГруппа Тогда
		НовыйОбъект = Менеджер.СоздатьГруппу();
	Иначе
		НовыйОбъект = Менеджер.СоздатьЭлемент();
	КонецЕсли;
	
	НовыйОбъект.Наименование = Аргументы.description;
	
	// Код
	Если Аргументы.Свойство("code") Тогда
		НовыйОбъект.Код = Аргументы.code;
	КонецЕсли;
	
	// Дополнительные реквизиты из JSON
	Если Аргументы.Свойство("attributes") Тогда
		ЗаполнитьРеквизитыИзJSON(НовыйОбъект, Аргументы.attributes, МДСправочник);
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		НовыйОбъект.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение "Ошибка записи справочника: " + ОписаниеОшибки();
	КонецПопытки;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("OK: Создан элемент справочника " + ИмяСправочника);
	МассивСтрок.Добавить("Ссылка: " + Строка(НовыйОбъект.Ссылка));
	МассивСтрок.Добавить("Код: " + НовыйОбъект.Код);
	МассивСтрок.Добавить("Наименование: " + НовыйОбъект.Наименование);
	МассивСтрок.Добавить("Тип: " + ?(ЭтоГруппа, "Группа", "Элемент"));
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

#КонецОбласти


#Область ИнструментСозданиеДокумента

Процедура ДобавитьИнструментСозданиеДокумента(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"documentType", "string", "Тип документа (например: ПриходТовара)", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"date", "string", "Дата документа в формате YYYY-MM-DD. Если не указана - текущая дата."));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"attributes", "string", "JSON-строка с реквизитами: {""ИмяРеквизита"": ""Значение"", ...}"));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"post", "boolean", "Провести документ после создания", Ложь));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"create_document",
		"Создание нового документа указанного типа. Позволяет установить дату, реквизиты и опционально провести.",
		СхемаПараметров);
	
КонецПроцедуры

Функция СоздатьДокумент(Аргументы)
	
	ТипДокумента = Аргументы.documentType;
	
	МДДокумент = Метаданные.Документы.Найти(ТипДокумента);
	Если МДДокумент = Неопределено Тогда
		ВызватьИсключение "Документ не найден: " + ТипДокумента;
	КонецЕсли;
	
	НовыйДокумент = Документы[ТипДокумента].СоздатьДокумент();
	
	// Дата
	Если Аргументы.Свойство("date") Тогда
		НовыйДокумент.Дата = ДатаИзСтроки(Аргументы.date);
	Иначе
		НовыйДокумент.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	// Реквизиты
	Если Аргументы.Свойство("attributes") Тогда
		ЗаполнитьРеквизитыИзJSON(НовыйДокумент, Аргументы.attributes, МДДокумент);
	КонецЕсли;
	
	// Запись
	Проводить = Ложь;
	Если Аргументы.Свойство("post") Тогда
		Проводить = Аргументы.post;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		Если Проводить Тогда
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение "Ошибка записи документа: " + ОписаниеОшибки();
	КонецПопытки;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("OK: Создан документ " + ТипДокумента);
	МассивСтрок.Добавить("Ссылка: " + Строка(НовыйДокумент.Ссылка));
	МассивСтрок.Добавить("Номер: " + НовыйДокумент.Номер);
	МассивСтрок.Добавить("Дата: " + Формат(НовыйДокумент.Дата, "ДЛФ=ДВ"));
	МассивСтрок.Добавить("Проведен: " + ?(НовыйДокумент.Проведен, "Да", "Нет"));
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

Функция ДатаИзСтроки(СтрокаДаты)
	
	// Формат YYYY-MM-DD
	Если СтрДлина(СтрокаДаты) >= 10 Тогда
		Год = Число(Лев(СтрокаДаты, 4));
		Месяц = Число(Сред(СтрокаДаты, 6, 2));
		День = Число(Сред(СтрокаДаты, 9, 2));
		Возврат Дата(Год, Месяц, День);
	КонецЕсли;
	
	Возврат ТекущаяДатаСеанса();
	
КонецФункции

#КонецОбласти


#Область ИнструментОбновлениеЗаписиРегистра

Процедура ДобавитьИнструментОбновлениеЗаписиРегистра(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"registerType", "string", "Тип регистра: InformationRegisters или AccumulationRegisters", , Истина,
		"InformationRegisters,AccumulationRegisters"));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"registerName", "string", "Имя регистра (например: Цены)", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"dimensions", "string", "JSON-строка с измерениями: {""Номенклатура"": ""Код123"", ...}", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"resources", "string", "JSON-строка с ресурсами: {""Цена"": 100, ...}", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"period", "string", "Период записи в формате YYYY-MM-DD (для периодических регистров)."));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"update_register_record",
		"Запись данных в независимый регистр сведений. Устанавливает измерения и ресурсы. Для периодических регистров можно указать период.",
		СхемаПараметров);
	
КонецПроцедуры

Функция ОбновитьЗаписьРегистра(Аргументы)
	
	ТипРегистра = Аргументы.registerType;
	ИмяРегистра = Аргументы.registerName;
	
	Если ТипРегистра <> "InformationRegisters" Тогда
		ВызватьИсключение "Прямая запись поддерживается только для регистров сведений (InformationRegisters). Регистры накопления пишутся через проведение документов.";
	КонецЕсли;
	
	МДРегистр = Метаданные.РегистрыСведений.Найти(ИмяРегистра);
	Если МДРегистр = Неопределено Тогда
		ВызватьИсключение "Регистр сведений не найден: " + ИмяРегистра;
	КонецЕсли;
	
	// Проверяем что регистр независимый
	Если МДРегистр.РежимЗаписи <> Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.Независимый Тогда
		ВызватьИсключение "Регистр " + ИмяРегистра + " не является независимым. Записи подчинённых регистров создаются через проведение документов.";
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
	
	// Период
	Если Аргументы.Свойство("period") Тогда
		МенеджерЗаписи.Период = ДатаИзСтрокиРег(Аргументы.period);
	КонецЕсли;
	
	// Измерения из JSON
	ИзмеренияJSON = Аргументы.dimensions;
	ЗаполнитьИзмеренияРегистра(МенеджерЗаписи, ИзмеренияJSON, МДРегистр);
	
	// Ресурсы из JSON
	РесурсыJSON = Аргументы.resources;
	ЗаполнитьРесурсыРегистра(МенеджерЗаписи, РесурсыJSON, МДРегистр);
	
	НачатьТранзакцию();
	Попытка
		МенеджерЗаписи.Записать(Истина);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение "Ошибка записи регистра: " + ОписаниеОшибки();
	КонецПопытки;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("OK: Запись в регистр " + ИмяРегистра + " выполнена");
	
	// Показываем что записали
	Для Каждого Измерение Из МДРегистр.Измерения Цикл
		Попытка
			МассивСтрок.Добавить("  Измерение." + Измерение.Имя + " = " + Строка(МенеджерЗаписи[Измерение.Имя]));
		Исключение
			МассивСтрок.Добавить("  Измерение." + Измерение.Имя + " = (ошибка чтения)");
		КонецПопытки;
	КонецЦикла;
	Для Каждого Ресурс Из МДРегистр.Ресурсы Цикл
		Попытка
			МассивСтрок.Добавить("  Ресурс." + Ресурс.Имя + " = " + Строка(МенеджерЗаписи[Ресурс.Имя]));
		Исключение
			МассивСтрок.Добавить("  Ресурс." + Ресурс.Имя + " = (ошибка чтения)");
		КонецПопытки;
	КонецЦикла;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

Функция ДатаИзСтрокиРег(СтрокаДаты)
	
	Если СтрДлина(СтрокаДаты) >= 10 Тогда
		Год = Число(Лев(СтрокаДаты, 4));
		Месяц = Число(Сред(СтрокаДаты, 6, 2));
		День = Число(Сред(СтрокаДаты, 9, 2));
		Возврат Дата(Год, Месяц, День);
	КонецЕсли;
	
	Возврат ТекущаяДатаСеанса();
	
КонецФункции

Процедура ЗаполнитьИзмеренияРегистра(МенеджерЗаписи, ИзмеренияJSON, МДРегистр)
	
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ИзмеренияJSON);
		Данные = ПрочитатьJSON(Чтение);
	Исключение
		ВызватьИсключение "Ошибка разбора JSON измерений: " + ОписаниеОшибки();
	КонецПопытки;
	
	Для Каждого КлючЗначение Из Данные Цикл
		ИмяИзмерения = КлючЗначение.Ключ;
		Значение = КлючЗначение.Значение;
		
		МДИзмерение = МДРегистр.Измерения.Найти(ИмяИзмерения);
		Если МДИзмерение = Неопределено Тогда
			ВызватьИсключение "Измерение не найдено: " + ИмяИзмерения;
		КонецЕсли;
		
		МенеджерЗаписи[ИмяИзмерения] = ПривестиЗначение(Значение, МДИзмерение.Тип);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьРесурсыРегистра(МенеджерЗаписи, РесурсыJSON, МДРегистр)
	
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(РесурсыJSON);
		Данные = ПрочитатьJSON(Чтение);
	Исключение
		ВызватьИсключение "Ошибка разбора JSON ресурсов: " + ОписаниеОшибки();
	КонецПопытки;
	
	Для Каждого КлючЗначение Из Данные Цикл
		ИмяРесурса = КлючЗначение.Ключ;
		Значение = КлючЗначение.Значение;
		
		МДРесурс = МДРегистр.Ресурсы.Найти(ИмяРесурса);
		Если МДРесурс = Неопределено Тогда
			ВызватьИсключение "Ресурс не найден: " + ИмяРесурса;
		КонецЕсли;
		
		МенеджерЗаписи[ИмяРесурса] = ПривестиЗначение(Значение, МДРесурс.Тип);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область ИнструментУдалениеОбъекта

Процедура ДобавитьИнструментУдалениеОбъекта(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"metaType", "string", "Тип объекта: Catalogs или Documents", , Истина,
		"Catalogs,Documents"));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name", "string", "Имя справочника или документа (например: Контрагенты, ПриходТовара)", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"searchValue", "string", "Код/Наименование справочника или Номер документа для поиска", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"force", "boolean", "Непосредственное удаление (true) или пометка удаления (false, по умолчанию)", Ложь));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"delete_object",
		"Удаление элемента справочника или документа. По умолчанию ставит пометку удаления. С force=true — физическое удаление.",
		СхемаПараметров);
	
КонецПроцедуры

// BSLLS:CognitiveComplexity-off
Функция УдалитьОбъект(Аргументы)
	
	ТипМета = Аргументы.metaType;
	ИмяОбъекта = Аргументы.name;
	ЗначениеПоиска = Аргументы.searchValue;
	
	Физически = Ложь;
	Если Аргументы.Свойство("force") Тогда
		Физически = Аргументы.force;
	КонецЕсли;
	
	Ссылка = Неопределено;
	
	Если ТипМета = "Catalogs" Тогда
		МД = Метаданные.Справочники.Найти(ИмяОбъекта);
		Если МД = Неопределено Тогда
			ВызватьИсключение "Справочник не найден: " + ИмяОбъекта;
		КонецЕсли;
		Менеджер = Справочники[ИмяОбъекта];
		Ссылка = Менеджер.НайтиПоКоду(ЗначениеПоиска);
		Если Ссылка.Пустая() Тогда
			Ссылка = Менеджер.НайтиПоНаименованию(ЗначениеПоиска, Истина);
		КонецЕсли;
		Если Ссылка.Пустая() Тогда
			ВызватьИсключение "Элемент не найден: " + ИмяОбъекта + " = '" + ЗначениеПоиска + "'";
		КонецЕсли;
	ИначеЕсли ТипМета = "Documents" Тогда
		МД = Метаданные.Документы.Найти(ИмяОбъекта);
		Если МД = Неопределено Тогда
			ВызватьИсключение "Документ не найден: " + ИмяОбъекта;
		КонецЕсли;
		Менеджер = Документы[ИмяОбъекта];
		Ссылка = Менеджер.НайтиПоНомеру(ЗначениеПоиска);
		Если Ссылка.Пустая() Тогда
			ВызватьИсключение "Документ не найден: " + ИмяОбъекта + " №" + ЗначениеПоиска;
		КонецЕсли;
	Иначе
		ВызватьИсключение "Поддерживаемые типы: Catalogs, Documents. Получено: " + ТипМета;
	КонецЕсли;
	
	ОбъектДанных = Ссылка.ПолучитьОбъект();
	ОписаниеОбъекта = Строка(Ссылка);
	
	НачатьТранзакцию();
	Попытка
		Если Физически Тогда
			ОбъектДанных.Удалить();
		Иначе
			ОбъектДанных.УстановитьПометкуУдаления(Истина);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение "Ошибка удаления: " + ОписаниеОшибки();
	КонецПопытки;
	
	МассивСтрок = Новый Массив;
	Если Физически Тогда
		МассивСтрок.Добавить("OK: Объект УДАЛЁН физически: " + ОписаниеОбъекта);
	Иначе
		МассивСтрок.Добавить("OK: Пометка удаления установлена: " + ОписаниеОбъекта);
	КонецЕсли;
	МассивСтрок.Добавить("Тип: " + ТипМета + "." + ИмяОбъекта);
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

