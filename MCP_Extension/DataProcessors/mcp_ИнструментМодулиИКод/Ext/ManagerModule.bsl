
#Область ПрограммныйИнтерфейс

// Регистрация инструментов обработки
//
// Параметры:
//  Инструменты - ТаблицаЗначений - таблица инструментов для заполнения
//
Процедура ДобавитьИнструменты(Инструменты) Экспорт
	
	ДобавитьИнструментПолучитьМодуль(Инструменты);
	ДобавитьИнструментВыполнитьКод(Инструменты);
	ДобавитьИнструментАнализМодуля(Инструменты);
	
КонецПроцедуры

// Диспетчер выполнения инструментов
//
// Параметры:
//  ИмяИнструмента - Строка - имя вызываемого инструмента
//  Аргументы - Структура - параметры инструмента
//
// Возвращаемое значение:
//  Строка - результат выполнения
//
Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт
	
	Если ИмяИнструмента = "get_object_module" Тогда
		Возврат ПолучитьТекстМодуля(Аргументы);
	ИначеЕсли ИмяИнструмента = "execute_code" Тогда
		Возврат ВыполнитьКод(Аргументы);
	ИначеЕсли ИмяИнструмента = "analyze_module" Тогда
		Возврат АнализМодуля(Аргументы);
	Иначе
		ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ОписанияИнструментов

Процедура ДобавитьИнструментПолучитьМодуль(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	СписокТипов = "Catalogs,Documents,DataProcessors,Reports,CommonModules,InformationRegisters,AccumulationRegisters,ChartsOfCharacteristicTypes";
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"metaType", "string", "Тип объекта метаданных", , Истина, СписокТипов));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name", "string", "Имя объекта метаданных", , Истина));
	
	СписокТиповМодулей = "ObjectModule,ManagerModule,FormModule,RecordSetModule";
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"moduleType", "string", "Тип модуля (по умолчанию ObjectModule)", "ObjectModule", , СписокТиповМодулей));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"formName", "string", "Имя формы (обязательно если moduleType=FormModule)"));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_object_module",
		"Возвращает путь к файлу BSL-модуля объекта метаданных на диске. Для CommonModules параметр moduleType игнорируется. Для FormModule необходим параметр formName. Используйте read_file для чтения содержимого по возвращённому пути.",
		СхемаПараметров);
	
КонецПроцедуры

Процедура ДобавитьИнструментВыполнитьКод(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"code", "string", "BSL-код для выполнения на сервере 1С. Должен присваивать результат переменной Результат.", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"safeMode", "boolean", "Безопасный режим (ограничивает доступ к ОС и файлам). По умолчанию true.", Истина));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"execute_code",
		"Выполнить произвольный BSL-код на сервере 1С. Код должен присвоить результат переменной Результат. Пример: Результат = Справочники.Номенклатура.НайтиПоКоду(""000001"").Наименование;",
		СхемаПараметров);
	
КонецПроцедуры

#КонецОбласти

#Область РеализацияИнструментов

// get_object_module - чтение текста BSL-модуля с диска
//
// Параметры:
//  Аргументы - Структура - параметры инструмента
//
// Возвращаемое значение:
//  Строка - текст модуля BSL
//
Функция ПолучитьТекстМодуля(Аргументы)
	
	МетаТип = Аргументы.metaType;
	Имя = Аргументы.name;
	ТипМодуля = "ObjectModule";
	Если Аргументы.Свойство("moduleType") И ЗначениеЗаполнено(Аргументы.moduleType) Тогда
		ТипМодуля = Аргументы.moduleType;
	КонецЕсли;
	
	// Базовые пути к конфигурации на диске
	// BSLLS:UsingHardcodePath-off
	БазовыйПуть1 = "D:\Git\Public_Trade_Module\Конфигурация\Проверка\";
	БазовыйПуть2 = "D:\Git\Public_Trade_Module\Конфигурация\";
	// BSLLS:UsingHardcodePath-on
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("## Путь к модулю: " + МетаТип + "." + Имя + " (" + ТипМодуля + ")");
	МассивСтрок.Добавить("");
	
	// Построить относительный путь к файлу модуля
	ОтносительныйПуть = ПостроитьОтносительныйПутьМодуля(МетаТип, Имя, ТипМодуля, Аргументы);
	
	// Основной путь (Проверка)
	ПолныйПуть1 = БазовыйПуть1 + ОтносительныйПуть;
	// Альтернативный путь
	ПолныйПуть2 = БазовыйПуть2 + ОтносительныйПуть;
	
	МассивСтрок.Добавить("**Основной путь:** " + ПолныйПуть1);
	МассивСтрок.Добавить("**Альтернативный путь:** " + ПолныйПуть2);
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("**Относительный путь (workspace):** Конфигурация/Проверка/" + СтрЗаменить(ОтносительныйПуть, "\", "/"));
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("> Используйте `read_file` для чтения содержимого.");
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

// execute_code - выполнение произвольного BSL-кода
//
// Параметры:
//  Аргументы - Структура - параметры инструмента
//
// Возвращаемое значение:
//  Строка - результат выполнения (значение переменной Результат)
//
Функция ВыполнитьКод(Аргументы)
	
	Код = Аргументы.code;
	
	// safeMode=false по умолчанию: безопасный режим блокирует Выполнить()/Вычислить()
	// при проведении документов с вызовом модулей расширений, что крашит сеанс HTTP-сервиса
	БезопасныйРежим = Ложь;
	Если Аргументы.Свойство("safeMode") И Аргументы.safeMode = Истина Тогда
		БезопасныйРежим = Истина;
	КонецЕсли;
	
	Если БезопасныйРежим Тогда
		УстановитьБезопасныйРежим(Истина);
	КонецЕсли;
	
	Результат = Неопределено;
	
	Попытка
		Выполнить(Код);
	Исключение
		ИнфоОшибки = ИнформацияОбОшибке();
		ВызватьИсключение "Ошибка выполнения BSL-кода: " + ПодробноеПредставлениеОшибки(ИнфоОшибки);
	КонецПопытки;
	
	Если Результат = Неопределено Тогда
		Возврат "Код выполнен успешно. Переменная Результат не была установлена.";
	КонецЕсли;
	
	Возврат Строка(Результат);
	
КонецФункции

Процедура ДобавитьИнструментАнализМодуля(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"code", "string", "Текст BSL-модуля для анализа. Передайте содержимое .bsl файла.", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"moduleName", "string", "Имя модуля (для отображения в результатах)"));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"analyze_module",
		"Анализ структуры BSL-модуля: извлекает список процедур/функций с директивами компиляции (&НаКлиенте, &НаСервере и т.д.), параметрами, экспортностью, областями (#Область). Передайте текст модуля в параметре code.",
		СхемаПараметров);
	
КонецПроцедуры

// BSLLS:CognitiveComplexity-off
// BSLLS:CyclomaticComplexity-off
Функция АнализМодуля(Аргументы)
	
	ТекстМодуля = Аргументы.code;
	ИмяМодуля = "";
	Если Аргументы.Свойство("moduleName") Тогда
		ИмяМодуля = Аргументы.moduleName;
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	Если ИмяМодуля <> "" Тогда
		МассивСтрок.Добавить("## Анализ модуля: " + ИмяМодуля);
	Иначе
		МассивСтрок.Добавить("## Анализ BSL-модуля");
	КонецЕсли;
	МассивСтрок.Добавить("");
	
	// Разбиваем на строки
	СтрокиМодуля = СтрРазделить(ТекстМодуля, Символы.ПС);
	ВсегоСтрок = СтрокиМодуля.Количество();
	
	МассивСтрок.Добавить("**Всего строк:** " + Формат(ВсегоСтрок, "ЧН=0; ЧГ="));
	МассивСтрок.Добавить("");
	
	// Собираем области
	МассивОбластей = Новый Массив;
	// Собираем процедуры/функции
	МассивМетодов = Новый Массив;
	
	ТекущаяДиректива = "";
	ТекущаяОбласть = "";
	
	Для Н = 0 По ВсегоСтрок - 1 Цикл
		Строка = СокрЛП(СтрокиМодуля[Н]);
		НомерСтроки = Н + 1;
		
		// Области
		Если СтрНачинаетсяС(Строка, "#Область ") ИЛИ СтрНачинаетсяС(Строка, "#область ") Тогда
			ИмяОбласти = СокрЛП(Сред(Строка, 10));
			ТекущаяОбласть = ИмяОбласти;
			МассивОбластей.Добавить(Формат(НомерСтроки, "ЧН=0; ЧГ=") + ": " + ИмяОбласти);
			Продолжить;
		КонецЕсли;
		
		// Директивы компиляции
		Если СтрНачинаетсяС(Строка, "&") Тогда
			ТекущаяДиректива = Строка;
			Продолжить;
		КонецЕсли;
		
		// Процедура/Функция
		СтрокаВРег = ВРег(Строка);
		ЭтоПроцедура = СтрНачинаетсяС(СтрокаВРег, "ПРОЦЕДУРА ") ИЛИ СтрНачинаетсяС(СтрокаВРег, "PROCEDURE ");
		ЭтоФункция = СтрНачинаетсяС(СтрокаВРег, "ФУНКЦИЯ ") ИЛИ СтрНачинаетсяС(СтрокаВРег, "FUNCTION ");
		
		Если ЭтоПроцедура ИЛИ ЭтоФункция Тогда
			ТипМетода = ?(ЭтоФункция, "Функция", "Процедура");
			
			// Извлекаем имя и параметры
			ПозОткр = СтрНайти(Строка, "(");
			ПозЗакр = СтрНайти(Строка, ")");
			
			ИмяМетода = "";
			ПараметрыМетода = "";
			Если ПозОткр > 0 Тогда
				ЧастьДоСкобки = Лев(Строка, ПозОткр - 1);
				// Убираем Процедура/Функция/Procedure/Function
				ПозПробела = СтрНайти(ЧастьДоСкобки, " ");
				Если ПозПробела > 0 Тогда
					ИмяМетода = СокрЛП(Сред(ЧастьДоСкобки, ПозПробела + 1));
				КонецЕсли;
				Если ПозЗакр > ПозОткр Тогда
					ПараметрыМетода = Сред(Строка, ПозОткр + 1, ПозЗакр - ПозОткр - 1);
				КонецЕсли;
			КонецЕсли;
			
			ЭтоЭкспорт = СтрНайти(ВРег(Строка), "ЭКСПОРТ") > 0 ИЛИ СтрНайти(ВРег(Строка), "EXPORT") > 0;
			
			ОписаниеМетода = Новый Структура;
			ОписаниеМетода.Вставить("Тип", ТипМетода);
			ОписаниеМетода.Вставить("Имя", ИмяМетода);
			ОписаниеМетода.Вставить("Параметры", ПараметрыМетода);
			ОписаниеМетода.Вставить("Директива", ТекущаяДиректива);
			ОписаниеМетода.Вставить("ЭкспортМетода", ЭтоЭкспорт);
			ОписаниеМетода.Вставить("Строка", НомерСтроки);
			ОписаниеМетода.Вставить("Область", ТекущаяОбласть);
			МассивМетодов.Добавить(ОписаниеМетода);
			
			ТекущаяДиректива = "";
		КонецЕсли;
	КонецЦикла;
	
	// Выводим области
	Если МассивОбластей.Количество() > 0 Тогда
		МассивСтрок.Добавить("### Области (#Область)");
		Для Каждого Обл Из МассивОбластей Цикл
			МассивСтрок.Добавить("- L" + Обл);
		КонецЦикла;
		МассивСтрок.Добавить("");
	КонецЕсли;
	
	// Выводим методы
	МассивСтрок.Добавить("### Процедуры и функции (" + Формат(МассивМетодов.Количество(), "ЧН=0; ЧГ=") + ")");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("# | Тип | Имя | Директива | Экспорт | Строка | Параметры");
	МассивСтрок.Добавить("--- | --- | --- | --- | --- | --- | ---");
	
	Счетчик = 0;
	Для Каждого М Из МассивМетодов Цикл
		Счетчик = Счетчик + 1;
		СтрЭкспорт = ?(М.ЭкспортМетода, "Да", "");
		ДирективаВывод = ?(М.Директива = "", "-", М.Директива);
		ПарамВывод = ?(М.Параметры = "", "-", М.Параметры);
		МассивСтрок.Добавить(Формат(Счетчик, "ЧН=0; ЧГ=") + " | " + М.Тип + " | " + М.Имя
			+ " | " + ДирективаВывод + " | " + СтрЭкспорт
			+ " | L" + Формат(М.Строка, "ЧН=0; ЧГ=") + " | " + ПарамВывод);
	КонецЦикла;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Построить относительный путь к файлу модуля на диске
//
// Параметры:
//  МетаТип - Строка - тип метаданных (Catalogs, Documents и т.д.)
//  Имя - Строка - имя объекта
//  ТипМодуля - Строка - тип модуля (ObjectModule, ManagerModule и т.д.)
//  Аргументы - Структура - все аргументы (для formName)
//
// Возвращаемое значение:
//  Строка - относительный путь к файлу BSL
//
Функция ПостроитьОтносительныйПутьМодуля(МетаТип, Имя, ТипМодуля, Аргументы)
	
	// Для общих модулей - структура CommonModules/Имя/Ext/Module.bsl
	Если МетаТип = "CommonModules" Тогда
		Возврат "CommonModules\" + Имя + "\Ext\Module.bsl";
	КонецЕсли;
	
	// Для остальных типов
	ПутьОбъекта = МетаТип + "\" + Имя;
	
	Если ТипМодуля = "ObjectModule" Тогда
		Возврат ПутьОбъекта + "\Ext\ObjectModule.bsl";
	ИначеЕсли ТипМодуля = "ManagerModule" Тогда
		Возврат ПутьОбъекта + "\Ext\ManagerModule.bsl";
	ИначеЕсли ТипМодуля = "RecordSetModule" Тогда
		Возврат ПутьОбъекта + "\Ext\RecordSetModule.bsl";
	ИначеЕсли ТипМодуля = "FormModule" Тогда
		ИмяФормы = "";
		Если Аргументы.Свойство("formName") Тогда
			ИмяФормы = Аргументы.formName;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ИмяФормы) Тогда
			ВызватьИсключение "Для FormModule необходимо указать параметр formName";
		КонецЕсли;
		Возврат ПутьОбъекта + "\Forms\" + ИмяФормы + "\Ext\Form\Module.bsl";
	Иначе
		ВызватьИсключение "Неизвестный тип модуля: " + ТипМодуля
			+ ". Допустимые: ObjectModule, ManagerModule, FormModule, RecordSetModule";
	КонецЕсли;
	
КонецФункции

#КонецОбласти
