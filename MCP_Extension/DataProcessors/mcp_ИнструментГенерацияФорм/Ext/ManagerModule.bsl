	С.Добавить("				<v8:Type>v8:DynamicList</v8:Type>");
	С.Добавить("			</Type>");
	С.Добавить("			<CustomQuery>false</CustomQuery>");
	С.Добавить("			<DynamicDataRead>true</DynamicDataRead>");
	С.Добавить("			<AutoFillAvailableFields>true</AutoFillAvailableFields>");
	С.Добавить("			<GetInvisibleFieldPresentations>true</GetInvisibleFieldPresentations>");
	С.Добавить("		</Attribute>");
	С.Добавить("	</Attributes>");
	
КонецПроцедуры

