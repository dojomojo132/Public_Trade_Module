// Добавить InputField для реквизита
//
// Возвращаемое значение:
//  Число - обновлённый счётчик id
//
Функция ДобавитьInputField(С, Реквизит, НачальныйID)
	
	Счетчик = НачальныйID + 1;
	IDПоля = Счетчик;
	
	ИмяЭлемента = Реквизит.Имя;
	// Для стандартных реквизитов используем синоним как имя элемента формы
	Если Реквизит.ЭтоСтандартный Тогда
		ИмяЭлемента = Реквизит.Синоним;
	КонецЕсли;
	
	// DataPath: "Объект.ИмяРеквизита"
	ПутьДанных = "Объект." + Реквизит.Имя;
	
	С.Добавить("		<InputField name=""" + ИмяЭлемента + """ id=""" + Формат(IDПоля, "ЧН=0; ЧГ=") + """>");
	С.Добавить("			<DataPath>" + ПутьДанных + "</DataPath>");
	С.Добавить("			<EditMode>EnterOnInput</EditMode>");
	С.Добавить("			<Width>25</Width>");
	
	// ContextMenu
	Счетчик = Счетчик + 1;
	С.Добавить("			<ContextMenu name=""" + ИмяЭлемента + "КонтекстноеМеню"" id=""" + Формат(Счетчик, "ЧН=0; ЧГ=") + """/>");
	
	// ExtendedTooltip
	Счетчик = Счетчик + 1;
	С.Добавить("			<ExtendedTooltip name=""" + ИмяЭлемента + "РасширеннаяПодсказка"" id=""" + Формат(Счетчик, "ЧН=0; ЧГ=") + """/>");
	
	С.Добавить("		</InputField>");
	
	Возврат Счетчик;
	
КонецФункции

// Добавить Table для табличной части
Функция ДобавитьТаблицу(С, ТЧ, НачальныйID)
	
	Счетчик = НачальныйID + 1;
	IDТаблицы = Счетчик;
	
	С.Добавить("		<Table name=""" + ТЧ.Имя + """ id=""" + Формат(IDТаблицы, "ЧН=0; ЧГ=") + """>");
	С.Добавить("			<DataPath>Объект." + ТЧ.Имя + "</DataPath>");
	С.Добавить("			<Width>60</Width>");
	С.Добавить("			<Height>8</Height>");
	С.Добавить("			<Header>true</Header>");
	С.Добавить("			<HeaderHeight>1</HeaderHeight>");
	С.Добавить("			<HorizontalLines>true</HorizontalLines>");
	С.Добавить("			<VerticalLines>true</VerticalLines>");
	С.Добавить("			<AutoInsertNewRow>true</AutoInsertNewRow>");
	С.Добавить("			<ChangeRowOrder>true</ChangeRowOrder>");
	С.Добавить("			<ChangeRowSet>true</ChangeRowSet>");
	
	// ContextMenu
	Счетчик = Счетчик + 1;
	С.Добавить("			<ContextMenu name=""" + ТЧ.Имя + "КонтекстноеМеню"" id=""" + Формат(Счетчик, "ЧН=0; ЧГ=") + """/>");
	
	// AutoCommandBar
	Счетчик = Счетчик + 1;
	С.Добавить("			<AutoCommandBar name=""" + ТЧ.Имя + "КоманднаяПанель"" id=""" + Формат(Счетчик, "ЧН=0; ЧГ=") + """/>");
	
	// ExtendedTooltip
	Счетчик = Счетчик + 1;
	С.Добавить("			<ExtendedTooltip name=""" + ТЧ.Имя + "РасширеннаяПодсказка"" id=""" + Формат(Счетчик, "ЧН=0; ЧГ=") + """/>");
	
	// SearchStringAddition
	Счетчик = Счетчик + 1;
	С.Добавить("			<SearchStringAddition name=""" + ТЧ.Имя + "СтрокаПоиска"" id=""" + Формат(Счетчик, "ЧН=0; ЧГ=") + """/>");
	
	// ViewStatusAddition
	Счетчик = Счетчик + 1;
	С.Добавить("			<ViewStatusAddition name=""" + ТЧ.Имя + "СостояниеПросмотра"" id=""" + Формат(Счетчик, "ЧН=0; ЧГ=") + """/>");
	
	// SearchControlAddition
	Счетчик = Счетчик + 1;
	С.Добавить("			<SearchControlAddition name=""" + ТЧ.Имя + "УправлениеПоиском"" id=""" + Формат(Счетчик, "ЧН=0; ЧГ=") + """/>");
	
	// Колонки ТЧ как InputField внутри Table
	Для Каждого Колонка Из ТЧ.Колонки Цикл
		Счетчик = Счетчик + 1;
		IDКолонки = Счетчик;
		
		ИмяЭлемента = ТЧ.Имя + Колонка.Имя;
		
		С.Добавить("			<InputField name=""" + ИмяЭлемента + """ id=""" + Формат(IDКолонки, "ЧН=0; ЧГ=") + """>");
		С.Добавить("				<DataPath>Объект." + ТЧ.Имя + "." + Колонка.Имя + "</DataPath>");
		С.Добавить("				<EditMode>EnterOnInput</EditMode>");
		
		// ContextMenu
		Счетчик = Счетчик + 1;
		С.Добавить("				<ContextMenu name=""" + ИмяЭлемента + "КонтекстноеМеню"" id=""" + Формат(Счетчик, "ЧН=0; ЧГ=") + """/>");
		
		// ExtendedTooltip
		Счетчик = Счетчик + 1;
		С.Добавить("				<ExtendedTooltip name=""" + ИмяЭлемента + "РасширеннаяПодсказка"" id=""" + Формат(Счетчик, "ЧН=0; ЧГ=") + """/>");
		
		С.Добавить("			</InputField>");
	КонецЦикла;
	
	С.Добавить("		</Table>");
	
	Возврат Счетчик;
	
КонецФункции

