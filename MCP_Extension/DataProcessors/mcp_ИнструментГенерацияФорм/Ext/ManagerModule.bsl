Функция СгенерироватьДескриптор(УИД, ИмяФормы, СинонимФормы)
	
	// Минимальный набор xmlns для дескриптора
	С = Новый Массив;
	С.Добавить("<?xml version=""1.0"" encoding=""UTF-8""?>");
	С.Добавить("<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses""");
	С.Добавить("	xmlns:xr=""http://v8.1c.ru/8.3/xcf/readable""");
	С.Добавить("	xmlns:xs=""http://www.w3.org/2001/XMLSchema""");
	С.Добавить("	xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance""");
	С.Добавить("	version=""2.20"">");
	С.Добавить("	<Form uuid=""" + УИД + """ owner=""{{PARENT_UUID}}"">");
	С.Добавить("		<Properties>");
	С.Добавить("			<Name>" + ИмяФормы + "</Name>");
	С.Добавить("			<Synonym>");
	С.Добавить("				<v8:item>");
	С.Добавить("					<v8:lang>ru</v8:lang>");
	С.Добавить("					<v8:content>" + СинонимФормы + "</v8:content>");
	С.Добавить("				</v8:item>");
	С.Добавить("			</Synonym>");
	С.Добавить("		</Properties>");
	С.Добавить("	</Form>");
	С.Добавить("</MetaDataObject>");
	
	Возврат СтрСоединить(С, Символы.ПС);
	
КонецФункции

// ============================================================
// ГЕНЕРАЦИЯ FORM.XML
// ============================================================

Функция СгенерироватьFormXML(МассивРеквизитов, МассивТЧ, ТипФормы, ТипОбъектаДляФормы)
	
	С = Новый Массив;
	ТекущийID = 0; // Счётчик id элементов, AutoCommandBar = -1
	
	// XML-заголовок
	С.Добавить("<?xml version=""1.0"" encoding=""UTF-8""?>");
	ДобавитьЗаголовокFormXML(С);
	
	// WindowOpeningMode
	С.Добавить("	<WindowOpeningMode>LockOwnerWindow</WindowOpeningMode>");
	
	// UseForFoldersAndItems
	Если ТипФормы = "group" Тогда
		С.Добавить("	<UseForFoldersAndItems>Folders</UseForFoldersAndItems>");
	ИначеЕсли ТипФормы = "element" Тогда
		С.Добавить("	<UseForFoldersAndItems>Items</UseForFoldersAndItems>");
	КонецЕсли;
	
	// AutoTime для документов
	Если ТипФормы = "document" Тогда
		С.Добавить("	<AutoTime>DontUse</AutoTime>");
	КонецЕсли;
	
	// AutoCommandBar
	С.Добавить("	<AutoCommandBar name=""ФормаКоманднаяПанель"" id=""-1""/>");
	
	// ChildItems - основной контент формы
	С.Добавить("	<ChildItems>");
	
	Если ТипФормы = "list" Тогда
		// Для формы списка - DynamicList Table
		ТекущийID = ДобавитьТаблицуСписка(С, ТекущийID);
	Иначе
		// Для элемента/документа/группы - InputField для реквизитов
		Для Каждого Реквизит Из МассивРеквизитов Цикл
			ТекущийID = ДобавитьInputField(С, Реквизит, ТекущийID);
		КонецЦикла;
		
		// Табличные части
		Для Каждого ТЧ Из МассивТЧ Цикл
			ТекущийID = ДобавитьТаблицу(С, ТЧ, ТекущийID);
		КонецЦикла;
	КонецЕсли;
	
	С.Добавить("	</ChildItems>");
	
	// Attributes формы
	Если ТипФормы = "list" Тогда
		ДобавитьАтрибутДинамическийСписок(С, ТипОбъектаДляФормы);
	ИначеЕсли ЗначениеЗаполнено(ТипОбъектаДляФормы) Тогда
		ДобавитьАтрибутОбъект(С, ТипОбъектаДляФормы);
	КонецЕсли;
	
	С.Добавить("</Form>");
	
	Возврат СтрСоединить(С, Символы.ПС);
	
КонецФункции

