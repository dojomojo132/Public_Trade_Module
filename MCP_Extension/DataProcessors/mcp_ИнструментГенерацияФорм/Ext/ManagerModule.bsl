	С.Добавить("	<Attributes>");
	С.Добавить("		<Attribute name=""Объект"" id=""1"">");
	С.Добавить("			<Type>");
	С.Добавить("				<v8:Type>cfg:" + ТипОбъектаДляФормы + "</v8:Type>");
	С.Добавить("			</Type>");
	С.Добавить("			<MainAttribute>true</MainAttribute>");
	С.Добавить("			<SavedData>true</SavedData>");
	С.Добавить("		</Attribute>");
	С.Добавить("	</Attributes>");
	
КонецПроцедуры

