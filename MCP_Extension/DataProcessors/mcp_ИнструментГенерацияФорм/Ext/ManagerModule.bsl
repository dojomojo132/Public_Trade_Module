#Область ПрограммныйИнтерфейс

// Регистрация инструментов обработки
//
// Параметры:
//  Инструменты - ТаблицаЗначений - таблица инструментов для заполнения
//
Процедура ДобавитьИнструменты(Инструменты) Экспорт
	
	ДобавитьИнструментГенерацияФормы(Инструменты);
	
КонецПроцедуры

// Диспетчер выполнения инструментов
//
// Параметры:
//  ИмяИнструмента - Строка - имя вызываемого инструмента
//  Аргументы - Структура - параметры инструмента
//
// Возвращаемое значение:
//  Массив - результат выполнения (массив содержимого MCP)
//
Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт
	
	Если ИмяИнструмента = "generate_form" Тогда
		Возврат СгенерироватьФорму(Аргументы);
	Иначе
		ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ОписанияИнструментов

Процедура ДобавитьИнструментГенерацияФормы(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	СписокТипов = "Catalogs,Documents,DataProcessors,Reports,ChartsOfCharacteristicTypes";
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"metaType", "string", "Тип объекта метаданных (Catalogs, Documents, DataProcessors, Reports)", , Истина, СписокТипов));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name", "string", "Имя объекта метаданных", , Истина));
	
	СписокТиповФорм = "element,group,list,document,dataprocessor";
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"formType", "string",
		"Тип формы: element (форма элемента справочника), group (форма группы справочника), list (форма списка), document (форма документа), dataprocessor (форма обработки/отчёта)",
		"element", Истина, СписокТиповФорм));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"formName", "string", "Имя формы (по умолчанию генерируется автоматически: ФормаЭлемента, ФормаГруппы, ФормаСписка, ФормаДокумента)"));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"formSynonym", "string", "Синоним формы (по умолчанию генерируется из имени формы)"));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"generate_form",
		"Генерирует XML-код формы 1С на основе метаданных объекта. "
			+ "Возвращает 3 блока: descriptor XML, Form.xml и Module.bsl. "
			+ "Агент ОБЯЗАН сохранить файлы через create_file в оба пути (Конфигурация/Проверка/ и Конфигурация/). "
			+ "Form.xml содержит элементы InputField для реквизитов и Table для табличных частей. "
			+ "Все id элементов, xmlns, BOM, CRLF - корректны.",
		СхемаПараметров);
	
КонецПроцедуры

#КонецОбласти

#Область РеализацияИнструментов

// BSLLS:CognitiveComplexity-off
// BSLLS:CyclomaticComplexity-off
// BSLLS:MethodSize-off
// BSLLS:DuplicateStringLiteral-off

// Генерация формы по метаданным объекта
//
// Параметры:
//  Аргументы - Структура - параметры инструмента
//
// Возвращаемое значение:
//  Массив - массив содержимого MCP (текстовое)
//
Функция СгенерироватьФорму(Аргументы)
	
	МетаТип = Аргументы.metaType;
	ИмяОбъекта = Аргументы.name;
	ТипФормы = НРег(Аргументы.formType);
	
	// Определить имя формы
	ИмяФормы = "";
	Если Аргументы.Свойство("formName") И ЗначениеЗаполнено(Аргументы.formName) Тогда
		ИмяФормы = Аргументы.formName;
	Иначе
		ИмяФормы = ИмяФормыПоУмолчанию(ТипФормы);
	КонецЕсли;
	
	// Определить синоним формы
	СинонимФормы = "";
	Если Аргументы.Свойство("formSynonym") И ЗначениеЗаполнено(Аргументы.formSynonym) Тогда
		СинонимФормы = Аргументы.formSynonym;
	Иначе
		СинонимФормы = СинонимФормыПоУмолчанию(ТипФормы);
	КонецЕсли;
	
	// Получить метаданные объекта
	Попытка
		КоллекцияМД = Метаданные[МетаТип];
	Исключение
		ВызватьИсключение "Неизвестный тип метаданных: " + МетаТип;
	КонецПопытки;
	
	МетаданныеОбъекта = КоллекцияМД.Найти(ИмяОбъекта);
	Если МетаданныеОбъекта = Неопределено Тогда
		ВызватьИсключение "Объект метаданных не найден: " + МетаТип + "." + ИмяОбъекта;
	КонецЕсли;
	
	// Определить тип объекта для MainAttribute
	ТипОбъектаДляФормы = ТипОбъектаФормы(МетаТип, ИмяОбъекта, ТипФормы);
	
	// Генерировать UUID формы
	НовыйUUID = Строка(Новый УникальныйИдентификатор);
	
	// Собрать реквизиты и ТЧ
	МассивРеквизитов = СобратьРеквизиты(МетаданныеОбъекта, ТипФормы, МетаТип);
	МассивТЧ = СобратьТабличныеЧасти(МетаданныеОбъекта, ТипФормы, МетаТип);
	
	// Сгенерировать 3 файла
	ТекстДескриптора = СгенерироватьДескриптор(НовыйUUID, ИмяФормы, СинонимФормы);
	ТекстФормы = СгенерироватьFormXML(МассивРеквизитов, МассивТЧ, ТипФормы, ТипОбъектаДляФормы);
	ТекстМодуля = СгенерироватьМодуль(МассивРеквизитов, МассивТЧ, ТипФормы);
	
	// Сформировать пути
	ПутьОтносительный = ПостроитьОтносительныйПутьФормы(МетаТип, ИмяОбъекта, ИмяФормы);
	
	// Собрать результат
	МассивСтрок = Новый Массив;
	Разделитель = "---";
	НачалоБлокаXml = "``" + "`xml";
	НачалоБлокаBsl = "``" + "`bsl";
	КонецБлока = "``" + "`";
	
	МассивСтрок.Добавить("## Генерация формы: " + МетаТип + "." + ИмяОбъекта + "." + ИмяФормы);
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("**UUID формы:** " + НовыйUUID);
	МассивСтрок.Добавить("**Тип формы:** " + ТипФормы);
	МассивСтрок.Добавить("**MainAttribute type:** " + ТипОбъектаДляФормы);
	МассивСтрок.Добавить("");
	
	// Относительные пути файлов
	МассивСтрок.Добавить("### Файлы для сохранения");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("**Путь 1 (Проверка):** Конфигурация/Проверка/" + ПутьОтносительный);
	МассивСтрок.Добавить("**Путь 2 (Конфигурация):** Конфигурация/" + ПутьОтносительный);
	МассивСтрок.Добавить("");
	
	// ФАЙЛ 1: Дескриптор
	МассивСтрок.Добавить(Разделитель);
	МассивСтрок.Добавить("### ФАЙЛ 1: Дескриптор формы");
	МассивСтрок.Добавить("**Имя файла:** " + ИмяФормы + ".xml");
	МассивСтрок.Добавить("**Путь:** Forms/" + ИмяФормы + ".xml");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить(НачалоБлокаXml);
	МассивСтрок.Добавить(ТекстДескриптора);
	МассивСтрок.Добавить(КонецБлока);
	МассивСтрок.Добавить("");
	
	// ФАЙЛ 2: Form.xml
	МассивСтрок.Добавить(Разделитель);
	МассивСтрок.Добавить("### ФАЙЛ 2: Form.xml");
	МассивСтрок.Добавить("**Имя файла:** Form.xml");
	МассивСтрок.Добавить("**Путь:** Forms/" + ИмяФормы + "/Ext/Form.xml");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить(НачалоБлокаXml);
	МассивСтрок.Добавить(ТекстФормы);
	МассивСтрок.Добавить(КонецБлока);
	МассивСтрок.Добавить("");
	
	// ФАЙЛ 3: Module.bsl
	МассивСтрок.Добавить(Разделитель);
	МассивСтрок.Добавить("### ФАЙЛ 3: Module.bsl");
	МассивСтрок.Добавить("**Имя файла:** Module.bsl");
	МассивСтрок.Добавить("**Путь:** Forms/" + ИмяФормы + "/Ext/Form/Module.bsl");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить(НачалоБлокаBsl);
	МассивСтрок.Добавить(ТекстМодуля);
	МассивСтрок.Добавить(КонецБлока);
	МассивСтрок.Добавить("");
	
	// Чеклист
	МассивСтрок.Добавить(Разделитель);
	МассивСтрок.Добавить("### Чеклист после сохранения");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("1. Сохранить 3 файла в ОБА пути (Конфигурация/Проверка/ и Конфигурация/)");
	МассивСтрок.Добавить("2. Обновить родительский XML объекта: добавить `<Form>" + ИмяФормы + "</Form>` в `<ChildObjects>`");
	МассивСтрок.Добавить("3. Обновить ConfigDumpInfo.xml: добавить записи для формы");
	МассивСтрок.Добавить("4. Все файлы ОБЯЗАТЕЛЬНО с BOM (ef bb bf) и CRLF");
	МассивСтрок.Добавить("5. Запустить validate-config.ps1 перед деплоем");
	
	Результат = СтрСоединить(МассивСтрок, Символы.ПС);
	
	МассивСодержимого = Новый Массив;
	МассивСодержимого.Добавить(mcp_Содержимое.ТекстовоеСодержимое(Результат));
	Возврат МассивСодержимого;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// BSLLS:MissingReturnedValueDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:IfElseIfEndsWithElse-off
// BSLLS:EmptyCodeBlock-off

// Имя формы по умолчанию из типа
//
// Параметры:
//  ТипФормы - Строка - тип формы (element, group, list, document, dataprocessor)
//
// Возвращаемое значение:
//  Строка - имя формы по умолчанию
//
Функция ИмяФормыПоУмолчанию(ТипФормы)
	
	Если ТипФормы = "element" Тогда
		Возврат "ФормаЭлемента";
	ИначеЕсли ТипФормы = "group" Тогда
		Возврат "ФормаГруппы";
	ИначеЕсли ТипФормы = "list" Тогда
		Возврат "ФормаСписка";
	ИначеЕсли ТипФормы = "document" Тогда
		Возврат "ФормаДокумента";
	ИначеЕсли ТипФормы = "dataprocessor" Тогда
		Возврат "Форма";
	Иначе
		Возврат "Форма";
	КонецЕсли;
	
КонецФункции

// Синоним формы по умолчанию
Функция СинонимФормыПоУмолчанию(ТипФормы)
	
	Если ТипФормы = "element" Тогда
		Возврат "Форма элемента";
	ИначеЕсли ТипФормы = "group" Тогда
		Возврат "Форма группы";
	ИначеЕсли ТипФормы = "list" Тогда
		Возврат "Форма списка";
	ИначеЕсли ТипФормы = "document" Тогда
		Возврат "Форма документа";
	ИначеЕсли ТипФормы = "dataprocessor" Тогда
		Возврат "Форма";
	Иначе
		Возврат "Форма";
	КонецЕсли;
	
КонецФункции

// Тип объекта для MainAttribute формы
Функция ТипОбъектаФормы(МетаТип, ИмяОбъекта, ТипФормы)
	
	Если ТипФормы = "list" Тогда
		Возврат ""; // У формы списка нет MainAttribute типа объекта
	КонецЕсли;
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("Catalogs", "CatalogObject");
	Соответствие.Вставить("Documents", "DocumentObject");
	Соответствие.Вставить("DataProcessors", "DataProcessorObject");
	Соответствие.Вставить("Reports", "ReportObject");
	Соответствие.Вставить("ChartsOfCharacteristicTypes", "ChartOfCharacteristicTypesObject");
	
	Префикс = Соответствие[МетаТип];
	Если Префикс = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Префикс + "." + ИмяОбъекта;
	
КонецФункции

// Построить относительный путь формы
Функция ПостроитьОтносительныйПутьФормы(МетаТип, ИмяОбъекта, ИмяФормы)
	
	Возврат МетаТип + "/" + ИмяОбъекта + "/Forms/" + ИмяФормы;
	
КонецФункции

// Собрать реквизиты объекта для формы
//
// Возвращаемое значение:
//  Массив - массив структур {Имя, Синоним, СтрокаТипа, ЭтоСсылочный, ПолноеИмяТипаМД}
//
Функция СобратьРеквизиты(МетаданныеОбъекта, ТипФормы, МетаТип)

	МассивРеквизитов = Новый Массив;
	
	// Для формы списка реквизиты не нужны (динамический список)
	Если ТипФормы = "list" Тогда
		Возврат МассивРеквизитов;
	КонецЕсли;
	
	// Стандартные реквизиты
	ДобавитьСтандартныеРеквизиты(МассивРеквизитов, МетаданныеОбъекта, ТипФормы, МетаТип);
	
	// Пользовательские реквизиты
	СтруктураПроверки = Новый Структура("Реквизиты");
	ЗаполнитьЗначенияСвойств(СтруктураПроверки, МетаданныеОбъекта);
	
	Если СтруктураПроверки.Реквизиты <> Неопределено Тогда
		Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
			ОписаниеРеквизита = Новый Структура;
			ОписаниеРеквизита.Вставить("Имя", Реквизит.Имя);
			ОписаниеРеквизита.Вставить("Синоним", Строка(Реквизит.Синоним));
			ОписаниеРеквизита.Вставить("СтрокаТипа", ПолучитьСтрокуТипа(Реквизит.Тип));
			ОписаниеРеквизита.Вставить("ЭтоСтандартный", Ложь);
			МассивРеквизитов.Добавить(ОписаниеРеквизита);
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивРеквизитов;
	
КонецФункции

// Добавить стандартные реквизиты (Код, Наименование, Дата, Номер и т.д.)
Процедура ДобавитьСтандартныеРеквизиты(МассивРеквизитов, МетаданныеОбъекта, ТипФормы, МетаТип)
	
	// Для справочника: Наименование (Description) + Код (Code) + Родитель (Parent)
	Если МетаТип = "Catalogs" Тогда
		
		// Проверка иерархичности
		ЭтоИерархический = Ложь;
		Попытка
			ЭтоИерархический = МетаданныеОбъекта.Иерархический;
		Исключение
			ЭтоИерархический = Ложь;
		КонецПопытки;
		
		// Для формы группы - только Наименование и Родитель (если иерархический)
		Если ТипФормы = "group" Тогда
			ОписаниеРеквизита = Новый Структура;
			ОписаниеРеквизита.Вставить("Имя", "Description");
			ОписаниеРеквизита.Вставить("Синоним", "Наименование");
			ОписаниеРеквизита.Вставить("СтрокаТипа", "Строка");
			ОписаниеРеквизита.Вставить("ЭтоСтандартный", Истина);
			МассивРеквизитов.Добавить(ОписаниеРеквизита);
			
			Если ЭтоИерархический Тогда
				ОписаниеРодителя = Новый Структура;
				ОписаниеРодителя.Вставить("Имя", "Parent");
				ОписаниеРодителя.Вставить("Синоним", "Родитель");
				ОписаниеРодителя.Вставить("СтрокаТипа", "Справочник");
				ОписаниеРодителя.Вставить("ЭтоСтандартный", Истина);
				МассивРеквизитов.Добавить(ОписаниеРодителя);
			КонецЕсли;
			
			Возврат;
		КонецЕсли;
		
		// Для формы элемента - Наименование
		ОписаниеРеквизита = Новый Структура;
		ОписаниеРеквизита.Вставить("Имя", "Description");
		ОписаниеРеквизита.Вставить("Синоним", "Наименование");
		ОписаниеРеквизита.Вставить("СтрокаТипа", "Строка");
		ОписаниеРеквизита.Вставить("ЭтоСтандартный", Истина);
		МассивРеквизитов.Добавить(ОписаниеРеквизита);
		
		// Код (если длина кода > 0)
		ЕстьКод = Ложь;
		Попытка
			ЕстьКод = МетаданныеОбъекта.ДлинаКода > 0;
		Исключение
			ЕстьКод = Ложь;
		КонецПопытки;
		Если ЕстьКод Тогда
			ОписаниеКода = Новый Структура;
			ОписаниеКода.Вставить("Имя", "Code");
			ОписаниеКода.Вставить("Синоним", "Код");
			ОписаниеКода.Вставить("СтрокаТипа", "Строка");
			ОписаниеКода.Вставить("ЭтоСтандартный", Истина);
			МассивРеквизитов.Добавить(ОписаниеКода);
		КонецЕсли;
		
		// Родитель (если иерархический)
		Если ЭтоИерархический Тогда
			ОписаниеРодителя = Новый Структура;
			ОписаниеРодителя.Вставить("Имя", "Parent");
			ОписаниеРодителя.Вставить("Синоним", "Родитель");
			ОписаниеРодителя.Вставить("СтрокаТипа", "Справочник");
			ОписаниеРодителя.Вставить("ЭтоСтандартный", Истина);
			МассивРеквизитов.Добавить(ОписаниеРодителя);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Собрать табличные части объекта
//
// Возвращаемое значение:
//  Массив - массив структур {Имя, Синоним, Колонки}
//         где Колонки - Массив структур {Имя, Синоним, СтрокаТипа}
//
Функция СобратьТабличныеЧасти(МетаданныеОбъекта, ТипФормы, МетаТип)
	
	МассивТЧ = Новый Массив;
	
	// Для формы списка и формы группы ТЧ не нужны
	Если ТипФормы = "list" ИЛИ ТипФормы = "group" Тогда
		Возврат МассивТЧ;
	КонецЕсли;
	
	СтруктураПроверки = Новый Структура("ТабличныеЧасти");
	ЗаполнитьЗначенияСвойств(СтруктураПроверки, МетаданныеОбъекта);
	
	Если СтруктураПроверки.ТабличныеЧасти = Неопределено Тогда
		Возврат МассивТЧ;
	КонецЕсли;
	
	Для Каждого ТЧ Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		ОписаниеТЧ = Новый Структура;
		ОписаниеТЧ.Вставить("Имя", ТЧ.Имя);
		ОписаниеТЧ.Вставить("Синоним", Строка(ТЧ.Синоним));
		
		Колонки = Новый Массив;
		Для Каждого КолонкаТЧ Из ТЧ.Реквизиты Цикл
			ОписаниеКолонки = Новый Структура;
			ОписаниеКолонки.Вставить("Имя", КолонкаТЧ.Имя);
			ОписаниеКолонки.Вставить("Синоним", Строка(КолонкаТЧ.Синоним));
			ОписаниеКолонки.Вставить("СтрокаТипа", ПолучитьСтрокуТипа(КолонкаТЧ.Тип));
			Колонки.Добавить(ОписаниеКолонки);
		КонецЦикла;
		
		ОписаниеТЧ.Вставить("Колонки", Колонки);
		МассивТЧ.Добавить(ОписаниеТЧ);
	КонецЦикла;
	
	Возврат МассивТЧ;
	
КонецФункции

// Получить строковое описание типа
Функция ПолучитьСтрокуТипа(ОписаниеТипов)
	
	МассивТипов = Новый Массив;
	
	Для Каждого Тип Из ОписаниеТипов.Типы() Цикл
		ТипМД = Метаданные.НайтиПоТипу(Тип);
		Если ТипМД = Неопределено Тогда
			МассивТипов.Добавить(Строка(Тип));
		Иначе
			МассивТипов.Добавить(ТипМД.ПолноеИмя());
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(МассивТипов, ", ");
	
КонецФункции

