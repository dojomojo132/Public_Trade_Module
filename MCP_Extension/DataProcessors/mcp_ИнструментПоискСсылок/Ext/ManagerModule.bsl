
#Область ПрограммныйИнтерфейс

// Регистрация инструментов обработки
//
// Параметры:
//  Инструменты - ТаблицаЗначений - таблица инструментов для заполнения
//
Процедура ДобавитьИнструменты(Инструменты) Экспорт
	
	ДобавитьИнструментПоискСсылок(Инструменты);
	ДобавитьИнструментСвязанныеОбъекты(Инструменты);
КонецПроцедуры

// Диспетчер выполнения инструментов
//
// Параметры:
//  ИмяИнструмента - Строка - имя вызываемого инструмента
//  Аргументы - Структура - параметры инструмента
//
// Возвращаемое значение:
//  Строка - результат выполнения
//
Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт
	
	Если ИмяИнструмента = "find_references" Тогда
		Возврат НайтиСсылки(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_connected_objects" Тогда
		Возврат СвязанныеОбъекты(Аргументы);
	Иначе
		ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ОписанияИнструментов

Процедура ДобавитьИнструментПоискСсылок(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"metaType", "string", "Тип объекта (Catalogs, Documents и т.д.)", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name", "string", "Имя объекта (например, Номенклатура)", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"searchValue", "string", "Значение для поиска: код, наименование или номер элемента. Если не указано - ищет ВСЕ ссылки на тип."));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"maxResults", "number", "Максимум результатов (по умолчанию 50)", 50));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"find_references",
		"Найти все ссылки на конкретный элемент справочника/документа в информационной базе. Показывает где используется объект. Полезно для рефакторинга и проверки зависимостей.",
		СхемаПараметров);
	
КонецПроцедуры

#КонецОбласти

#Область РеализацияИнструментов

// find_references - поиск ссылок на объект
//
// Параметры:
//  Аргументы - Структура - параметры инструмента
//
// Возвращаемое значение:
//  Строка - таблица найденных ссылок
//
// BSLLS:CognitiveComplexity-off
// BSLLS:CyclomaticComplexity-off
Функция НайтиСсылки(Аргументы)
	
	МетаТип = Аргументы.metaType;
	Имя = Аргументы.name;
	
	Лимит = 50;
	Если Аргументы.Свойство("maxResults") И Аргументы.maxResults <> Неопределено Тогда
		Лимит = Аргументы.maxResults;
	КонецЕсли;
	
	// Определяем тип для русского маппинга
	ТипДляЗапроса = "";
	Если МетаТип = "Catalogs" Тогда
		ТипДляЗапроса = "Справочник";
	ИначеЕсли МетаТип = "Documents" Тогда
		ТипДляЗапроса = "Документ";
	ИначеЕсли МетаТип = "ChartsOfCharacteristicTypes" Тогда
		ТипДляЗапроса = "ПланВидовХарактеристик";
	Иначе
		ВызватьИсключение "Тип '" + МетаТип + "' не поддерживается для поиска ссылок. "
			+ "Допустимые: Catalogs, Documents, ChartsOfCharacteristicTypes";
	КонецЕсли;
	
	// Проверяем метаданные
	Попытка
		КоллекцияМД = Метаданные[МетаТип];
	Исключение
		ВызватьИсключение "Неизвестный тип метаданных: " + МетаТип;
	КонецПопытки;
	
	МДОбъекта = КоллекцияМД.Найти(Имя);
	Если МДОбъекта = Неопределено Тогда
		ВызватьИсключение "Объект не найден: " + МетаТип + "." + Имя;
	КонецЕсли;
	
	// Ищем конкретный элемент или все ссылки типа
	ЗначениеПоиска = "";
	Если Аргументы.Свойство("searchValue") И ЗначениеЗаполнено(Аргументы.searchValue) Тогда
		ЗначениеПоиска = Аргументы.searchValue;
	КонецЕсли;
	
	МассивСсылок = Новый Массив;
	
	Если ЗначениеЗаполнено(ЗначениеПоиска) Тогда
		// Ищем конкретный элемент
		Если МетаТип = "Catalogs" Тогда
			// Пробуем найти по коду, потом по наименованию
			Менеджер = Справочники[Имя];
			Ссылка = Менеджер.НайтиПоКоду(ЗначениеПоиска);
			Если Ссылка.Пустая() Тогда
				Ссылка = Менеджер.НайтиПоНаименованию(ЗначениеПоиска, Истина);
			КонецЕсли;
			Если Ссылка.Пустая() Тогда
				ВызватьИсключение "Элемент не найден по коду/наименованию: " + ЗначениеПоиска;
			КонецЕсли;
			МассивСсылок.Добавить(Ссылка);
		ИначеЕсли МетаТип = "Documents" Тогда
			Менеджер = Документы[Имя];
			Ссылка = Менеджер.НайтиПоНомеру(ЗначениеПоиска);
			Если Ссылка.Пустая() Тогда
				ВызватьИсключение "Документ не найден по номеру: " + ЗначениеПоиска;
			КонецЕсли;
			МассивСсылок.Добавить(Ссылка);
		Иначе
			ВызватьИсключение "Тип '" + МетаТип + "' не поддерживает поиск по значению";
		КонецЕсли;
	Иначе
		// Если searchValue не указан, берём первые N элементов для поиска ссылок
		Запрос = Новый Запрос;
		// BSLLS:IncorrectQueryText-off
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 5 Ссылка ИЗ " + ТипДляЗапроса + "." + Имя;
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			МассивСсылок.Добавить(Выборка.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат "Объекты типа " + МетаТип + "." + Имя + " не найдены в ИБ.";
	КонецЕсли;
	
	// Поиск ссылок на каждый найденный объект
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("## Поиск ссылок: " + МетаТип + "." + Имя);
	МассивСтрок.Добавить("");
	
	ОбщийСчётчик = 0;
	
	Для Каждого Ссылка Из МассивСсылок Цикл
		
		МассивСтрок.Добавить("### " + Строка(Ссылка));
		МассивСтрок.Добавить("");
		
		// НайтиПоСсылкам - стандартный метод 1С
		МассивДляПоиска = Новый Массив;
		МассивДляПоиска.Добавить(Ссылка);
		
		ТаблицаСсылок = НайтиПоСсылкам(МассивДляПоиска);
		
		Если ТаблицаСсылок.Количество() = 0 Тогда
			МассивСтрок.Добавить("Ссылки не найдены.");
			МассивСтрок.Добавить("");
			Продолжить;
		КонецЕсли;
		
		МассивСтрок.Добавить("# | Объект | Метаданные");
		МассивСтрок.Добавить("--- | --- | ---");
		
		Индекс = 1;
		Для Каждого СтрокаТаблицы Из ТаблицаСсылок Цикл
			Если Индекс > Лимит Тогда
				МассивСтрок.Добавить("... ещё " + Формат(ТаблицаСсылок.Количество() - Лимит, "ЧН=0; ЧГ=") + " записей");
				Прервать;
			КонецЕсли;
			
			МДСсылки = "";
			Если СтрокаТаблицы.Метаданные <> Неопределено Тогда
				МДСсылки = СтрокаТаблицы.Метаданные.ПолноеИмя();
			КонецЕсли;
			
			МассивСтрок.Добавить(
				Формат(Индекс, "ЧН=0; ЧГ=") + " | " +
				Строка(СтрокаТаблицы.Данные) + " | " +
				МДСсылки);
			Индекс = Индекс + 1;
			ОбщийСчётчик = ОбщийСчётчик + 1;
		КонецЦикла;
		
		МассивСтрок.Добавить("");
	КонецЦикла;
	
	МассивСтрок.Добавить("Всего найдено ссылок: " + Формат(ОбщийСчётчик, "ЧН=0; ЧГ="));
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

#КонецОбласти


#Область ИнструментСвязанныеОбъекты

Процедура ДобавитьИнструментСвязанныеОбъекты(Инструменты)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"metaType", "string", "Тип объекта метаданных (Catalogs, Documents, InformationRegisters, AccumulationRegisters, Enums, ChartsOfCharacteristicTypes)", , Истина));
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name", "string", "Имя объекта метаданных (например: Номенклатура, ПриходТовара)", , Истина));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_connected_objects",
		"Анализ связей объекта метаданных: какие объекты ссылаются на него и на какие объекты он ссылается. Показывает реквизиты, табличные части, измерения/ресурсы регистров.",
		СхемаПараметров);
	
КонецПроцедуры

Функция СвязанныеОбъекты(Аргументы)
	
	МетаТип = Аргументы.metaType;
	ИмяОбъекта = Аргументы.name;
	
	// Маппинг английских имён → коллекции метаданных
	СоответствиеТипов = Новый Соответствие;
	СоответствиеТипов.Вставить("Catalogs", Метаданные.Справочники);
	СоответствиеТипов.Вставить("Documents", Метаданные.Документы);
	СоответствиеТипов.Вставить("InformationRegisters", Метаданные.РегистрыСведений);
	СоответствиеТипов.Вставить("AccumulationRegisters", Метаданные.РегистрыНакопления);
	СоответствиеТипов.Вставить("Enums", Метаданные.Перечисления);
	СоответствиеТипов.Вставить("ChartsOfCharacteristicTypes", Метаданные.ПланыВидовХарактеристик);
	СоответствиеТипов.Вставить("DataProcessors", Метаданные.Обработки);
	СоответствиеТипов.Вставить("Reports", Метаданные.Отчеты);
	СоответствиеТипов.Вставить("Constants", Метаданные.Константы);
	
	Коллекция = СоответствиеТипов.Получить(МетаТип);
	Если Коллекция = Неопределено Тогда
		ВызватьИсключение "Неподдерживаемый тип: " + МетаТип;
	КонецЕсли;
	
	МДОбъект = Коллекция.Найти(ИмяОбъекта);
	Если МДОбъект = Неопределено Тогда
		ВызватьИсключение "Объект не найден: " + МетаТип + "." + ИмяОбъекта;
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("=== Связи объекта: " + МДОбъект.ПолноеИмя() + " ===");
	МассивСтрок.Добавить("");
	
	// --- ИСХОДЯЩИЕ СВЯЗИ (на что ссылается объект) ---
	МассивСтрок.Добавить("--- ИСХОДЯЩИЕ СВЯЗИ (объект ссылается на) ---");
	Исходящие = Новый Соответствие; // ПолноеИмяТипа → Массив реквизитов
	
	// Анализируем реквизиты
	Попытка
		Для Каждого Реквизит Из МДОбъект.Реквизиты Цикл
			АнализТиповРеквизита(Исходящие, Реквизит.Имя, Реквизит.Тип);
		КонецЦикла;
	Исключение
		// Перечисления не имеют реквизитов
	КонецПопытки;
	
	// Анализируем табличные части
	Попытка
		Для Каждого ТабЧасть Из МДОбъект.ТабличныеЧасти Цикл
			Для Каждого Реквизит Из ТабЧасть.Реквизиты Цикл
				АнализТиповРеквизита(Исходящие, ТабЧасть.Имя + "." + Реквизит.Имя, Реквизит.Тип);
			КонецЦикла;
		КонецЦикла;
	Исключение
		// Не все типы имеют табличные части
	КонецПопытки;
	
	// Анализируем измерения и ресурсы регистров
	Попытка
		Для Каждого Измерение Из МДОбъект.Измерения Цикл
			АнализТиповРеквизита(Исходящие, "Измерение." + Измерение.Имя, Измерение.Тип);
		КонецЦикла;
	Исключение
		// Не все типы имеют измерения
	КонецПопытки;
	Попытка
		Для Каждого Ресурс Из МДОбъект.Ресурсы Цикл
			АнализТиповРеквизита(Исходящие, "Ресурс." + Ресурс.Имя, Ресурс.Тип);
		КонецЦикла;
	Исключение
		// Не все типы имеют ресурсы
	КонецПопытки;
	
	Если Исходящие.Количество() = 0 Тогда
		МассивСтрок.Добавить("  (нет исходящих ссылок)");
	Иначе
		Для Каждого КлючЗначение Из Исходящие Цикл
			МассивСтрок.Добавить("  → " + КлючЗначение.Ключ + " (через: " + СтрСоединить(КлючЗначение.Значение, ", ") + ")");
		КонецЦикла;
	КонецЕсли;
	МассивСтрок.Добавить("");
	
	// --- ВХОДЯЩИЕ СВЯЗИ (кто ссылается на объект) ---
	МассивСтрок.Добавить("--- ВХОДЯЩИЕ СВЯЗИ (на объект ссылаются) ---");
	Входящие = Новый Массив;
	ТипОбъекта = МДОбъект.ПолноеИмя();
	
	// Поиск по справочникам
	ПоискВходящихВКоллекции(Входящие, Метаданные.Справочники, ТипОбъекта);
	// Поиск по документам
	ПоискВходящихВКоллекции(Входящие, Метаданные.Документы, ТипОбъекта);
	// Поиск по регистрам сведений
	ПоискВходящихВРегистрах(Входящие, Метаданные.РегистрыСведений, ТипОбъекта);
	// Поиск по регистрам накопления
	ПоискВходящихВРегистрах(Входящие, Метаданные.РегистрыНакопления, ТипОбъекта);
	
	Если Входящие.Количество() = 0 Тогда
		МассивСтрок.Добавить("  (нет входящих ссылок)");
	Иначе
		Для Каждого Стр Из Входящие Цикл
			МассивСтрок.Добавить("  ← " + Стр);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

Процедура АнализТиповРеквизита(Исходящие, ИмяРеквизита, ОписаниеТипов)
	
	Для Каждого Тип Из ОписаниеТипов.Типы() Цикл
		МДТипа = Метаданные.НайтиПоТипу(Тип);
		Если МДТипа <> Неопределено Тогда
			ПолноеИмя = МДТипа.ПолноеИмя();
			МассивРеквизитов = Исходящие.Получить(ПолноеИмя);
			Если МассивРеквизитов = Неопределено Тогда
				МассивРеквизитов = Новый Массив;
				Исходящие.Вставить(ПолноеИмя, МассивРеквизитов);
			КонецЕсли;
			МассивРеквизитов.Добавить(ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПоискВходящихВКоллекции(Входящие, КоллекцияМД, ТипОбъекта)
	
	Для Каждого МДЭлемент Из КоллекцияМД Цикл
		Если МДЭлемент.ПолноеИмя() = ТипОбъекта Тогда
			Продолжить; // Пропускаем сам объект
		КонецЕсли;
		// Проверяем реквизиты
		Для Каждого Реквизит Из МДЭлемент.Реквизиты Цикл
			Если ТипСодержитОбъект(Реквизит.Тип, ТипОбъекта) Тогда
				Входящие.Добавить(МДЭлемент.ПолноеИмя() + "." + Реквизит.Имя);
			КонецЕсли;
		КонецЦикла;
		// Проверяем табличные части
		Для Каждого ТабЧасть Из МДЭлемент.ТабличныеЧасти Цикл
			Для Каждого Реквизит Из ТабЧасть.Реквизиты Цикл
				Если ТипСодержитОбъект(Реквизит.Тип, ТипОбъекта) Тогда
					Входящие.Добавить(МДЭлемент.ПолноеИмя() + "." + ТабЧасть.Имя + "." + Реквизит.Имя);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПоискВходящихВРегистрах(Входящие, КоллекцияРегистров, ТипОбъекта)
	
	Для Каждого МДРегистр Из КоллекцияРегистров Цикл
		// Измерения
		Для Каждого Измерение Из МДРегистр.Измерения Цикл
			Если ТипСодержитОбъект(Измерение.Тип, ТипОбъекта) Тогда
				Входящие.Добавить(МДРегистр.ПолноеИмя() + ".Измерение." + Измерение.Имя);
			КонецЕсли;
		КонецЦикла;
		// Ресурсы
		Для Каждого Ресурс Из МДРегистр.Ресурсы Цикл
			Если ТипСодержитОбъект(Ресурс.Тип, ТипОбъекта) Тогда
				Входящие.Добавить(МДРегистр.ПолноеИмя() + ".Ресурс." + Ресурс.Имя);
			КонецЕсли;
		КонецЦикла;
		// Реквизиты
		Для Каждого Реквизит Из МДРегистр.Реквизиты Цикл
			Если ТипСодержитОбъект(Реквизит.Тип, ТипОбъекта) Тогда
				Входящие.Добавить(МДРегистр.ПолноеИмя() + ".Реквизит." + Реквизит.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция ТипСодержитОбъект(ОписаниеТипов, ТипОбъекта)
	
	Для Каждого Тип Из ОписаниеТипов.Типы() Цикл
		МДТипа = Метаданные.НайтиПоТипу(Тип);
		Если МДТипа <> Неопределено И МДТипа.ПолноеИмя() = ТипОбъекта Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
	
КонецФункции

#КонецОбласти
