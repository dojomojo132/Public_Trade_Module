#Область ПрограммныйИнтерфейс

Процедура ДобавитьРесурсы(ТаблицаРесурсов) Экспорт
	
	mcp_Метаданные.ДобавитьРесурс(
		ТаблицаРесурсов,
		"ptm://datamodel",
		"ptm_datamodel",
		"Полная модель данных конфигурации PTM: все справочники, документы, регистры, перечисления с реквизитами, типами, табличными частями и связями"
	);
	
	mcp_Метаданные.ДобавитьРесурс(
		ТаблицаРесурсов,
		"ptm://registers",
		"ptm_registers",
		"Подробная карта всех регистров: измерения, ресурсы, реквизиты, регистраторы, вид регистра, периодичность"
	);
	
	mcp_Метаданные.ДобавитьРесурс(
		ТаблицаРесурсов,
		"ptm://business-logic",
		"ptm_business_logic",
		"Карта документооборота: документ → движения → отчёты, бизнес-логика проведения"
	);
	
КонецПроцедуры

Функция ПрочитатьРесурс(Адрес) Экспорт
	
	Если Адрес = "ptm://datamodel" Тогда
		Возврат СформироватьМодельДанных();
	ИначеЕсли Адрес = "ptm://registers" Тогда
		Возврат СформироватьКартуРегистров();
	ИначеЕсли Адрес = "ptm://business-logic" Тогда
		Возврат СформироватьКартуДокументооборота();
	КонецЕсли;
	
	ВызватьИсключение СтрШаблон("Неизвестный адрес ресурса: %1", Адрес);
	
КонецФункции

#КонецОбласти


#Область МодельДанных

Функция СформироватьМодельДанных()
	
	МассивСтрок = Новый Массив;
	
	// Заголовок
	МассивСтрок.Добавить("# Модель данных: " + Метаданные.Имя);
	МассивСтрок.Добавить("Синоним: " + Метаданные.Синоним);
	МассивСтрок.Добавить("");
	
	ДобавитьОписаниеОбъектов(МассивСтрок);
	ДобавитьОписаниеРегистровИКонстант(МассивСтрок);
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

Процедура ДобавитьОписаниеОбъектов(МассивСтрок)
	
	// Справочники
	Если Метаданные.Справочники.Количество() > 0 Тогда
		МассивСтрок.Добавить("## Справочники");
		МассивСтрок.Добавить("");
		Для Каждого МДОбъект Из Метаданные.Справочники Цикл
			ОписатьСправочник(МассивСтрок, МДОбъект);
		КонецЦикла;
	КонецЕсли;
	
	// Документы
	Если Метаданные.Документы.Количество() > 0 Тогда
		МассивСтрок.Добавить("## Документы");
		МассивСтрок.Добавить("");
		Для Каждого МДОбъект Из Метаданные.Документы Цикл
			ОписатьДокумент(МассивСтрок, МДОбъект);
		КонецЦикла;
	КонецЕсли;
	
	// Перечисления
	Если Метаданные.Перечисления.Количество() > 0 Тогда
		МассивСтрок.Добавить("## Перечисления");
		МассивСтрок.Добавить("");
		Для Каждого МДОбъект Из Метаданные.Перечисления Цикл
			ОписатьПеречисление(МассивСтрок, МДОбъект);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьОписаниеРегистровИКонстант(МассивСтрок)
	
	// Регистры сведений
	Если Метаданные.РегистрыСведений.Количество() > 0 Тогда
		МассивСтрок.Добавить("## Регистры сведений");
		МассивСтрок.Добавить("");
		Для Каждого МДОбъект Из Метаданные.РегистрыСведений Цикл
			ОписатьРегистрСведений(МассивСтрок, МДОбъект);
		КонецЦикла;
	КонецЕсли;
	
	// Регистры накопления
	Если Метаданные.РегистрыНакопления.Количество() > 0 Тогда
		МассивСтрок.Добавить("## Регистры накопления");
		МассивСтрок.Добавить("");
		Для Каждого МДОбъект Из Метаданные.РегистрыНакопления Цикл
			ОписатьРегистрНакопления(МассивСтрок, МДОбъект);
		КонецЦикла;
	КонецЕсли;
	
	// Константы
	Если Метаданные.Константы.Количество() > 0 Тогда
		МассивСтрок.Добавить("## Константы");
		МассивСтрок.Добавить("");
		Для Каждого МДОбъект Из Метаданные.Константы Цикл
			МассивСтрок.Добавить("- **" + МДОбъект.Имя + "** (" + ОписаниеТипаСтрокой(МДОбъект.Тип) + ")"
			+ ?(ЗначениеЗаполнено(МДОбъект.Синоним), " - " + МДОбъект.Синоним, ""));
		КонецЦикла;
		МассивСтрок.Добавить("");
	КонецЕсли;
	
КонецПроцедуры

Процедура ОписатьСправочник(МассивСтрок, МДОбъект)
	
	МассивСтрок.Добавить("### " + МДОбъект.Имя + ?(ЗначениеЗаполнено(МДОбъект.Синоним), " (" + МДОбъект.Синоним + ")", ""));
	
	// Владельцы
	Если МДОбъект.Владельцы.Количество() > 0 Тогда
		ВладельцыСтр = Новый Массив;
		Для Каждого Владелец Из МДОбъект.Владельцы Цикл
			ВладельцыСтр.Добавить(Владелец.Имя);
		КонецЦикла;
		МассивСтрок.Добавить("Владельцы: " + СтрСоединить(ВладельцыСтр, ", "));
	КонецЕсли;
	
	// Иерархия
	Если МДОбъект.Иерархический Тогда
		МассивСтрок.Добавить("Иерархический: Да");
	КонецЕсли;
	
	// Реквизиты
	ОписатьРеквизиты(МассивСтрок, МДОбъект.Реквизиты, "Реквизиты");
	
	// Табличные части
	ОписатьТабличныеЧасти(МассивСтрок, МДОбъект.ТабличныеЧасти);
	
	МассивСтрок.Добавить("");
	
КонецПроцедуры

Процедура ОписатьДокумент(МассивСтрок, МДОбъект)
	
	МассивСтрок.Добавить("### " + МДОбъект.Имя + ?(ЗначениеЗаполнено(МДОбъект.Синоним), " (" + МДОбъект.Синоним + ")", ""));
	
	// Проведение
	Если МДОбъект.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
		// Регистры движений
		РегистрыСтр = Новый Массив;
		Для Каждого МДРегистр Из МДОбъект.Движения Цикл
			РегистрыСтр.Добавить(МДРегистр.ПолноеИмя());
		КонецЦикла;
		Если РегистрыСтр.Количество() > 0 Тогда
			МассивСтрок.Добавить("Движения: " + СтрСоединить(РегистрыСтр, ", "));
		КонецЕсли;
	ИначеЕсли МДОбъект.Проведение = Метаданные.СвойстваОбъектов.Проведение.Запретить Тогда
		МассивСтрок.Добавить("Проведение: Запрещено");
	Иначе
		МассивСтрок.Добавить("Проведение: Разрешено");
	КонецЕсли;
	
	// Реквизиты
	ОписатьРеквизиты(МассивСтрок, МДОбъект.Реквизиты, "Реквизиты");
	
	// Табличные части
	ОписатьТабличныеЧасти(МассивСтрок, МДОбъект.ТабличныеЧасти);
	
	МассивСтрок.Добавить("");
	
КонецПроцедуры

Процедура ОписатьПеречисление(МассивСтрок, МДОбъект)
	
	МассивСтрок.Добавить("### " + МДОбъект.Имя + ?(ЗначениеЗаполнено(МДОбъект.Синоним), " (" + МДОбъект.Синоним + ")", ""));
	
	ЗначенияСтр = Новый Массив;
	Для Каждого ЗначениеПеречисления Из МДОбъект.ЗначенияПеречисления Цикл
		ЗначенияСтр.Добавить(ЗначениеПеречисления.Имя);
	КонецЦикла;
	
	Если ЗначенияСтр.Количество() > 0 Тогда
		МассивСтрок.Добавить("Значения: " + СтрСоединить(ЗначенияСтр, ", "));
	КонецЕсли;
	
	МассивСтрок.Добавить("");
	
КонецПроцедуры

Процедура ОписатьРегистрСведений(МассивСтрок, МДОбъект)
	
	МассивСтрок.Добавить("### " + МДОбъект.Имя + ?(ЗначениеЗаполнено(МДОбъект.Синоним), " (" + МДОбъект.Синоним + ")", ""));
	
	// Периодичность
	МассивСтрок.Добавить("Периодичность: " + Строка(МДОбъект.ПериодичностьРегистраСведений));
	
	// Измерения
	Если МДОбъект.Измерения.Количество() > 0 Тогда
		МассивСтрок.Добавить("Измерения:");
		Для Каждого Измерение Из МДОбъект.Измерения Цикл
			МассивСтрок.Добавить("  - " + Измерение.Имя + ": " + ОписаниеТипаСтрокой(Измерение.Тип));
		КонецЦикла;
	КонецЕсли;
	
	// Ресурсы
	Если МДОбъект.Ресурсы.Количество() > 0 Тогда
		МассивСтрок.Добавить("Ресурсы:");
		Для Каждого Ресурс Из МДОбъект.Ресурсы Цикл
			МассивСтрок.Добавить("  - " + Ресурс.Имя + ": " + ОписаниеТипаСтрокой(Ресурс.Тип));
		КонецЦикла;
	КонецЕсли;
	
	// Реквизиты
	Если МДОбъект.Реквизиты.Количество() > 0 Тогда
		МассивСтрок.Добавить("Реквизиты:");
		Для Каждого Реквизит Из МДОбъект.Реквизиты Цикл
			МассивСтрок.Добавить("  - " + Реквизит.Имя + ": " + ОписаниеТипаСтрокой(Реквизит.Тип));
		КонецЦикла;
	КонецЕсли;
	
	МассивСтрок.Добавить("");
	
КонецПроцедуры

Процедура ОписатьРегистрНакопления(МассивСтрок, МДОбъект)
	
	МассивСтрок.Добавить("### " + МДОбъект.Имя + ?(ЗначениеЗаполнено(МДОбъект.Синоним), " (" + МДОбъект.Синоним + ")", ""));
	
	// Вид регистра
	Попытка
		МассивСтрок.Добавить("Вид: " + Строка(МДОбъект.ВидРегистраНакопления));
	Исключение
		МассивСтрок.Добавить("Вид: Остатки");
	КонецПопытки;
	
	// Измерения
	Если МДОбъект.Измерения.Количество() > 0 Тогда
		МассивСтрок.Добавить("Измерения:");
		Для Каждого Измерение Из МДОбъект.Измерения Цикл
			МассивСтрок.Добавить("  - " + Измерение.Имя + ": " + ОписаниеТипаСтрокой(Измерение.Тип));
		КонецЦикла;
	КонецЕсли;
	
	// Ресурсы
	Если МДОбъект.Ресурсы.Количество() > 0 Тогда
		МассивСтрок.Добавить("Ресурсы:");
		Для Каждого Ресурс Из МДОбъект.Ресурсы Цикл
			МассивСтрок.Добавить("  - " + Ресурс.Имя + ": " + ОписаниеТипаСтрокой(Ресурс.Тип));
		КонецЦикла;
	КонецЕсли;
	
	// Реквизиты
	Если МДОбъект.Реквизиты.Количество() > 0 Тогда
		МассивСтрок.Добавить("Реквизиты:");
		Для Каждого Реквизит Из МДОбъект.Реквизиты Цикл
			МассивСтрок.Добавить("  - " + Реквизит.Имя + ": " + ОписаниеТипаСтрокой(Реквизит.Тип));
		КонецЦикла;
	КонецЕсли;
	
	МассивСтрок.Добавить("");
	
КонецПроцедуры

#КонецОбласти


#Область ВспомогательныеМетоды

Процедура ОписатьРеквизиты(МассивСтрок, КоллекцияРеквизитов, Заголовок)
	
	Если КоллекцияРеквизитов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивСтрок.Добавить(Заголовок + ":");
	Для Каждого Реквизит Из КоллекцияРеквизитов Цикл
		МассивСтрок.Добавить("  - " + Реквизит.Имя + ": " + ОписаниеТипаСтрокой(Реквизит.Тип)
			+ ?(ЗначениеЗаполнено(Реквизит.Синоним), " - " + Реквизит.Синоним, ""));
	КонецЦикла;
	
КонецПроцедуры

Процедура ОписатьТабличныеЧасти(МассивСтрок, КоллекцияТабличныхЧастей)
	
	Для Каждого ТабЧасть Из КоллекцияТабличныхЧастей Цикл
		
		КолонкиСтр = Новый Массив;
		Для Каждого Колонка Из ТабЧасть.Реквизиты Цикл
			КолонкиСтр.Добавить(Колонка.Имя + ":" + ОписаниеТипаСтрокой(Колонка.Тип));
		КонецЦикла;
		
		МассивСтрок.Добавить("ТЧ " + ТабЧасть.Имя
			+ ?(ЗначениеЗаполнено(ТабЧасть.Синоним), " (" + ТабЧасть.Синоним + ")", "")
			+ ": " + СтрСоединить(КолонкиСтр, ", "));
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОписаниеТипаСтрокой(ОписаниеТипов)
	
	МассивТипов = ОписаниеТипов.Типы();
	
	Если МассивТипов.Количество() = 0 Тогда
		Возврат "Неопределено";
	КонецЕсли;
	
	Если МассивТипов.Количество() = 1 Тогда
		Возврат ИмяТипаСтрокой(МассивТипов[0]);
	КонецЕсли;
	
	ИменаТипов = Новый Массив;
	Для Каждого ТекТип Из МассивТипов Цикл
		ИменаТипов.Добавить(ИмяТипаСтрокой(ТекТип));
	КонецЦикла;
	
	Возврат СтрСоединить(ИменаТипов, "|");
	
КонецФункции

Функция ИмяТипаСтрокой(ТекТип)
	
	Если ТекТип = Тип("Строка") Тогда
		Возврат "Строка";
	ИначеЕсли ТекТип = Тип("Число") Тогда
		Возврат "Число";
	ИначеЕсли ТекТип = Тип("Дата") Тогда
		Возврат "Дата";
	ИначеЕсли ТекТип = Тип("Булево") Тогда
		Возврат "Булево";
	Иначе
		МДТипа = Метаданные.НайтиПоТипу(ТекТип);
		Если МДТипа <> Неопределено Тогда
			Возврат МДТипа.ПолноеИмя();
		КонецЕсли;
		Возврат Строка(ТекТип);
	КонецЕсли;
	
КонецФункции

#КонецОбласти


#Область КартаРегистров

// BSLLS:CognitiveComplexity-off
Функция СформироватьКартуРегистров()
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("# Карта регистров: " + Метаданные.Имя);
	МассивСтрок.Добавить("");
	
	// Регистры накопления
	Если Метаданные.РегистрыНакопления.Количество() > 0 Тогда
		МассивСтрок.Добавить("## Регистры накопления (" + Формат(Метаданные.РегистрыНакопления.Количество(), "ЧН=0; ЧГ=") + ")");
		МассивСтрок.Добавить("");
		Для Каждого МДРег Из Метаданные.РегистрыНакопления Цикл
			МассивСтрок.Добавить("### " + МДРег.Имя + ?(ЗначениеЗаполнено(МДРег.Синоним), " (" + МДРег.Синоним + ")", ""));
			Попытка
				МассивСтрок.Добавить("- Вид: " + Строка(МДРег.ВидРегистраНакопления));
			Исключение
				МассивСтрок.Добавить("- Вид: Остатки");
			КонецПопытки;
			
			Если МДРег.Измерения.Количество() > 0 Тогда
				МассивСтрок.Добавить("- **Измерения:**");
				Для Каждого Изм Из МДРег.Измерения Цикл
					МассивСтрок.Добавить("  - " + Изм.Имя + ": " + ОписаниеТипаСтрокой(Изм.Тип));
				КонецЦикла;
			КонецЕсли;
			
			Если МДРег.Ресурсы.Количество() > 0 Тогда
				МассивСтрок.Добавить("- **Ресурсы:**");
				Для Каждого Рес Из МДРег.Ресурсы Цикл
					МассивСтрок.Добавить("  - " + Рес.Имя + ": " + ОписаниеТипаСтрокой(Рес.Тип));
				КонецЦикла;
			КонецЕсли;
			
			Если МДРег.Реквизиты.Количество() > 0 Тогда
				МассивСтрок.Добавить("- **Реквизиты:**");
				Для Каждого Рекв Из МДРег.Реквизиты Цикл
					МассивСтрок.Добавить("  - " + Рекв.Имя + ": " + ОписаниеТипаСтрокой(Рекв.Тип));
				КонецЦикла;
			КонецЕсли;
			
			РегСтр = Новый Массив;
			Для Каждого СтдРекв Из МДРег.СтандартныеРеквизиты Цикл
				Если СтдРекв.Имя = "Регистратор" Тогда
					Для Каждого ТекТип Из СтдРекв.Тип.Типы() Цикл
						МДТипа = Метаданные.НайтиПоТипу(ТекТип);
						Если МДТипа <> Неопределено Тогда
							РегСтр.Добавить(МДТипа.Имя);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			Если РегСтр.Количество() > 0 Тогда
				МассивСтрок.Добавить("- **Регистраторы:** " + СтрСоединить(РегСтр, ", "));
			КонецЕсли;
			
			МассивСтрок.Добавить("");
		КонецЦикла;
	КонецЕсли;
	
	// Регистры сведений
	Если Метаданные.РегистрыСведений.Количество() > 0 Тогда
		МассивСтрок.Добавить("## Регистры сведений (" + Формат(Метаданные.РегистрыСведений.Количество(), "ЧН=0; ЧГ=") + ")");
		МассивСтрок.Добавить("");
		Для Каждого МДРег Из Метаданные.РегистрыСведений Цикл
			МассивСтрок.Добавить("### " + МДРег.Имя + ?(ЗначениеЗаполнено(МДРег.Синоним), " (" + МДРег.Синоним + ")", ""));
			МассивСтрок.Добавить("- Периодичность: " + Строка(МДРег.ПериодичностьРегистраСведений));
			МассивСтрок.Добавить("- Режим записи: " + Строка(МДРег.РежимЗаписи));
			
			Если МДРег.Измерения.Количество() > 0 Тогда
				МассивСтрок.Добавить("- **Измерения:**");
				Для Каждого Изм Из МДРег.Измерения Цикл
					МассивСтрок.Добавить("  - " + Изм.Имя + ": " + ОписаниеТипаСтрокой(Изм.Тип)
						+ ?(Изм.Ведущее, " (ведущее)", ""));
				КонецЦикла;
			КонецЕсли;
			
			Если МДРег.Ресурсы.Количество() > 0 Тогда
				МассивСтрок.Добавить("- **Ресурсы:**");
				Для Каждого Рес Из МДРег.Ресурсы Цикл
					МассивСтрок.Добавить("  - " + Рес.Имя + ": " + ОписаниеТипаСтрокой(Рес.Тип));
				КонецЦикла;
			КонецЕсли;
			
			Если МДРег.Реквизиты.Количество() > 0 Тогда
				МассивСтрок.Добавить("- **Реквизиты:**");
				Для Каждого Рекв Из МДРег.Реквизиты Цикл
					МассивСтрок.Добавить("  - " + Рекв.Имя + ": " + ОписаниеТипаСтрокой(Рекв.Тип));
				КонецЦикла;
			КонецЕсли;
			
			МассивСтрок.Добавить("");
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

#КонецОбласти


#Область КартаДокументооборота

// BSLLS:CognitiveComplexity-off
Функция СформироватьКартуДокументооборота()
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("# Документооборот: " + Метаданные.Имя);
	МассивСтрок.Добавить("");
	
	Для Каждого МДДок Из Метаданные.Документы Цикл
		МассивСтрок.Добавить("## " + МДДок.Имя + ?(ЗначениеЗаполнено(МДДок.Синоним), " (" + МДДок.Синоним + ")", ""));
		
		Если МДДок.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
			МассивСтрок.Добавить("Проведение: **Разрешено**");
		ИначеЕсли МДДок.Проведение = Метаданные.СвойстваОбъектов.Проведение.Запретить Тогда
			МассивСтрок.Добавить("Проведение: Запрещено");
		КонецЕсли;
		
		Если МДДок.Реквизиты.Количество() > 0 Тогда
			МассивСтрок.Добавить("### Реквизиты");
			Для Каждого Рекв Из МДДок.Реквизиты Цикл
				МассивСтрок.Добавить("- " + Рекв.Имя + ": " + ОписаниеТипаСтрокой(Рекв.Тип));
			КонецЦикла;
		КонецЕсли;
		
		Для Каждого ТЧ Из МДДок.ТабличныеЧасти Цикл
			МассивСтрок.Добавить("### ТЧ: " + ТЧ.Имя);
			Для Каждого Кол Из ТЧ.Реквизиты Цикл
				МассивСтрок.Добавить("- " + Кол.Имя + ": " + ОписаниеТипаСтрокой(Кол.Тип));
			КонецЦикла;
		КонецЦикла;
		
		РегистрыДвижений = Новый Массив;
		Для Каждого МДРегистр Из МДДок.Движения Цикл
			РегистрыДвижений.Добавить(МДРегистр.ПолноеИмя());
		КонецЦикла;
		Если РегистрыДвижений.Количество() > 0 Тогда
			МассивСтрок.Добавить("### Движения");
			Для Каждого ИмяРег Из РегистрыДвижений Цикл
				МассивСтрок.Добавить("- → " + ИмяРег);
			КонецЦикла;
		КонецЕсли;
		
		МассивСтрок.Добавить("");
	КонецЦикла;
	
	МассивСтрок.Добавить("---");
	МассивСтрок.Добавить("");
	МассивСтрок.Добавить("## Отчёты");
	МассивСтрок.Добавить("");
	Для Каждого МДОтчет Из Метаданные.Отчеты Цикл
		МассивСтрок.Добавить("- **" + МДОтчет.Имя + "**"
			+ ?(ЗначениеЗаполнено(МДОтчет.Синоним), " (" + МДОтчет.Синоним + ")", ""));
	КонецЦикла;
	МассивСтрок.Добавить("");
	
	Если Метаданные.Обработки.Количество() > 0 Тогда
		МассивСтрок.Добавить("## Обработки");
		МассивСтрок.Добавить("");
		Для Каждого МДОбр Из Метаданные.Обработки Цикл
			МассивСтрок.Добавить("- **" + МДОбр.Имя + "**"
				+ ?(ЗначениеЗаполнено(МДОбр.Синоним), " (" + МДОбр.Синоним + ")", ""));
		КонецЦикла;
		МассивСтрок.Добавить("");
	КонецЕсли;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

#КонецОбласти