// =============================================================================
// Шаблон тестового модуля YAxUnit для документа ЧекККМ
// Общий модуль: ОМ_ТестыЧекККМ (Сервер, ВызовСервера)
// 
// ИСПОЛЬЗОВАНИЕ:
//   1. Создать расширение конфигурации "ТестыPTM"
//   2. Добавить общий модуль ОМ_ТестыЧекККМ (Сервер, ВызовСервера)
//   3. Скопировать этот код в модуль
//   4. Загрузить расширение YAxUnit
//   5. Запустить тесты
//
// СТРУКТУРА ЧекККМ (из MCP):
//   Реквизиты: КассоваяСмена, Касса, СуммаДокумента, Склад, ДисконтнаяКарта, Статус
//   ТЧ Товары: Номенклатура, Количество, Цена, Сумма, АкцизнаяМарка, СуммаСкидки, НалоговаяГруппа
//   ТЧ Оплата: ВидОплаты, КассаОплаты, Сумма
//   Статус: Пробит | Аннулирован | Отложен | НеФискальный
//   Регистры: ОстаткиТоваров, Продажи, ДенежныеСредства, ПродажиПоДисконтнымКартам
// =============================================================================

#Область ПрограммныйИнтерфейс

// Регистрация тестов — вызывается движком YAxUnit автоматически
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ДобавитьТестовыйНабор("Проведение ЧекККМ — движения по регистрам")
			.ДобавитьТест("ПроведениеСоздаётДвиженияОстатков")
			.ДобавитьТест("ПроведениеСоздаётДвиженияПродаж")
			.ДобавитьТест("ПроведениеСоздаётДвиженияДенежныхСредств")
			.ДобавитьТест("ПроведениеСДисконтнойКартойСоздаётДвиженияПродажПоКартам")
			.ДобавитьТест("АннулированныйЧекНеСоздаётДвижения")
		.ДобавитьТестовыйНабор("Валидация ЧекККМ")
			.ДобавитьТест("ЧекБезТоваровНеПроводится")
			.ДобавитьТест("ЧекБезСкладаНеПроводится")
			.ДобавитьТест("ЧекСНулевымКоличествомНеПроводится")
		.ДобавитьТестовыйНабор("Расчёты в ЧекККМ")
			.ДобавитьТест("СуммаДокументаРавнаСуммеТоваров")
			.ДобавитьТест("СуммаСУчётомСкидкиРассчитываетсяВерно")
	;
	
КонецПроцедуры

#КонецОбласти

#Область Тесты

// --- НАБОР: Проведение ЧекККМ ---

Процедура ПроведениеСоздаётДвиженияОстатков() Экспорт
	
	// Подготовка тестовых данных
	ДанныеТеста = ПодготовитьДанныеЧека();
	
	// Создание и проведение чека
	Ссылка = СоздатьИПровестиЧек(ДанныеТеста);
	
	// Проверка: запись в регистр ОстаткиТоваров (расход)
	ЮТест.ОжидаетЧто(
		ЮТЗапросы.ЗаписиРегистра("РегистрНакопления.ОстаткиТоваров", Ссылка))
		.Заполнено()
		.ИмеетДлину(1);
	
	Движение = ЮТЗапросы.ЗаписиРегистра("РегистрНакопления.ОстаткиТоваров", Ссылка)[0];
	ЮТест.ОжидаетЧто(Движение.ВидДвижения).Равно(ВидДвиженияНакопления.Расход);
	ЮТест.ОжидаетЧто(Движение.Номенклатура).Равно(ДанныеТеста.Товар);
	ЮТест.ОжидаетЧто(Движение.Склад).Равно(ДанныеТеста.Склад);
	ЮТест.ОжидаетЧто(Движение.Количество).Равно(5);
	
КонецПроцедуры

Процедура ПроведениеСоздаётДвиженияПродаж() Экспорт
	
	ДанныеТеста = ПодготовитьДанныеЧека();
	Ссылка = СоздатьИПровестиЧек(ДанныеТеста);
	
	// Проверка: запись в регистр Продажи (приход)
	Движения = ЮТЗапросы.ЗаписиРегистра("РегистрНакопления.Продажи", Ссылка);
	ЮТест.ОжидаетЧто(Движения).Заполнено();
	
	Движение = Движения[0];
	ЮТест.ОжидаетЧто(Движение.Номенклатура).Равно(ДанныеТеста.Товар);
	ЮТест.ОжидаетЧто(Движение.Количество).Равно(5);
	ЮТест.ОжидаетЧто(Движение.Сумма).Равно(500);
	
КонецПроцедуры

Процедура ПроведениеСоздаётДвиженияДенежныхСредств() Экспорт
	
	ДанныеТеста = ПодготовитьДанныеЧека();
	Ссылка = СоздатьИПровестиЧек(ДанныеТеста);
	
	// Проверка: запись в регистр ДенежныеСредства (приход наличных)
	Движения = ЮТЗапросы.ЗаписиРегистра("РегистрНакопления.ДенежныеСредства", Ссылка);
	ЮТест.ОжидаетЧто(Движения).Заполнено();
	
	Движение = Движения[0];
	ЮТест.ОжидаетЧто(Движение.Сумма).Равно(500);
	
КонецПроцедуры

Процедура ПроведениеСДисконтнойКартойСоздаётДвиженияПродажПоКартам() Экспорт
	
	ДанныеТеста = ПодготовитьДанныеЧека();
	
	// Дополнительно: создать дисконтную карту
	ВидКарты = ЮТест.Данные().СоздатьЭлемент("Справочники.ВидыДисконтныхКарт",
		Новый Структура("Наименование", "Тестовый вид карты"));
	ДисконтнаяКарта = ЮТест.Данные().СоздатьЭлемент("Справочники.ДисконтныеКарты",
		Новый Структура("Наименование,Владелец", "ТЕСТ-0001", ВидКарты));
	
	ДанныеТеста.Вставить("ДисконтнаяКарта", ДисконтнаяКарта);
	
	Ссылка = СоздатьИПровестиЧек(ДанныеТеста);
	
	// Проверка: запись в регистр ПродажиПоДисконтнымКартам
	Движения = ЮТЗапросы.ЗаписиРегистра("РегистрНакопления.ПродажиПоДисконтнымКартам", Ссылка);
	ЮТест.ОжидаетЧто(Движения).Заполнено();
	
	Движение = Движения[0];
	ЮТест.ОжидаетЧто(Движение.ДисконтнаяКарта).Равно(ДисконтнаяКарта);
	
КонецПроцедуры

Процедура АннулированныйЧекНеСоздаётДвижения() Экспорт
	
	ДанныеТеста = ПодготовитьДанныеЧека();
	ДанныеТеста.Вставить("Статус", Перечисления.СтатусыЧекаККМ.Аннулирован);
	
	Ссылка = СоздатьИПровестиЧек(ДанныеТеста);
	
	// У аннулированного чека НЕ должно быть движений
	ДвиженияОстатков = ЮТЗапросы.ЗаписиРегистра("РегистрНакопления.ОстаткиТоваров", Ссылка);
	ЮТест.ОжидаетЧто(ДвиженияОстатков).НеЗаполнено();
	
	ДвиженияПродаж = ЮТЗапросы.ЗаписиРегистра("РегистрНакопления.Продажи", Ссылка);
	ЮТест.ОжидаетЧто(ДвиженияПродаж).НеЗаполнено();
	
	ДвиженияДС = ЮТЗапросы.ЗаписиРегистра("РегистрНакопления.ДенежныеСредства", Ссылка);
	ЮТест.ОжидаетЧто(ДвиженияДС).НеЗаполнено();
	
КонецПроцедуры

// --- НАБОР: Валидация ---

Процедура ЧекБезТоваровНеПроводится() Экспорт
	
	ДанныеТеста = ПодготовитьДанныеЧека();
	ДанныеТеста.Вставить("БезТоваров", Истина);
	
	// Проверяем, что при проведении возникнет ошибка
	ЮТест.ОжидаетЧто(
		ЮТест.ВыполнитьСПерехватомИсключения("СоздатьИПровестиЧек", ЭтотОбъект, ДанныеТеста))
		.ИмеетТип("Строка")
		.Заполнено();
	
КонецПроцедуры

Процедура ЧекБезСкладаНеПроводится() Экспорт
	
	ДанныеТеста = ПодготовитьДанныеЧека();
	ДанныеТеста.Вставить("Склад", Справочники.Склады.ПустаяСсылка());
	
	ЮТест.ОжидаетЧто(
		ЮТест.ВыполнитьСПерехватомИсключения("СоздатьИПровестиЧек", ЭтотОбъект, ДанныеТеста))
		.ИмеетТип("Строка")
		.Заполнено();
	
КонецПроцедуры

Процедура ЧекСНулевымКоличествомНеПроводится() Экспорт
	
	ДанныеТеста = ПодготовитьДанныеЧека();
	ДанныеТеста.Вставить("Количество", 0);
	
	ЮТест.ОжидаетЧто(
		ЮТест.ВыполнитьСПерехватомИсключения("СоздатьИПровестиЧек", ЭтотОбъект, ДанныеТеста))
		.ИмеетТип("Строка")
		.Заполнено();
	
КонецПроцедуры

// --- НАБОР: Расчёты ---

Процедура СуммаДокументаРавнаСуммеТоваров() Экспорт
	
	ДанныеТеста = ПодготовитьДанныеЧека();
	Ссылка = СоздатьИПровестиЧек(ДанныеТеста);
	
	ОбъектЧека = Ссылка.ПолучитьОбъект();
	
	ИтогТоваров = 0;
	Для Каждого Строка Из ОбъектЧека.Товары Цикл
		ИтогТоваров = ИтогТоваров + Строка.Сумма;
	КонецЦикла;
	
	ЮТест.ОжидаетЧто(ОбъектЧека.СуммаДокумента).Равно(ИтогТоваров);
	
КонецПроцедуры

Процедура СуммаСУчётомСкидкиРассчитываетсяВерно() Экспорт
	
	ДанныеТеста = ПодготовитьДанныеЧека();
	ДанныеТеста.Вставить("СуммаСкидки", 50);
	
	Ссылка = СоздатьИПровестиЧек(ДанныеТеста);
	ОбъектЧека = Ссылка.ПолучитьОбъект();
	
	// Итого с учётом скидки
	ИтогБезСкидки = 0;
	ИтогСкидки = 0;
	Для Каждого Строка Из ОбъектЧека.Товары Цикл
		ИтогБезСкидки = ИтогБезСкидки + Строка.Сумма;
		ИтогСкидки = ИтогСкидки + Строка.СуммаСкидки;
	КонецЦикла;
	
	ЮТест.ОжидаетЧто(ОбъектЧека.СуммаДокумента).Равно(ИтогБезСкидки - ИтогСкидки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подготовка стандартного набора тестовых данных для чека
Функция ПодготовитьДанныеЧека()
	
	Склад = ЮТест.Данные().СоздатьЭлемент("Справочники.Склады",
		Новый Структура("Наименование", "Тестовый склад"));
	
	Товар = ЮТест.Данные().СоздатьЭлемент("Справочники.Номенклатура",
		Новый Структура("Наименование", "Тестовый товар"));
	
	Касса = ЮТест.Данные().СоздатьЭлемент("Справочники.Кассы",
		Новый Структура("Наименование", "Тестовая касса"));
	
	Результат = Новый Структура;
	Результат.Вставить("Склад", Склад);
	Результат.Вставить("Товар", Товар);
	Результат.Вставить("Касса", Касса);
	Результат.Вставить("Количество", 5);
	Результат.Вставить("Цена", 100);
	Результат.Вставить("Сумма", 500);
	Результат.Вставить("СуммаСкидки", 0);
	Результат.Вставить("Статус", Перечисления.СтатусыЧекаККМ.Пробит);
	Результат.Вставить("БезТоваров", Ложь);
	
	Возврат Результат;
	
КонецФункции

// Создать и провести чек ККМ по данным теста
Функция СоздатьИПровестиЧек(ДанныеТеста) Экспорт
	
	Конструктор = ЮТест.Данные().КонструкторОбъекта("Документы.ЧекККМ")
		.Установить("Дата", ТекущаяДатаСеанса())
		.Установить("Склад", ДанныеТеста.Склад)
		.Установить("Касса", ДанныеТеста.Касса)
		.Установить("Статус", ДанныеТеста.Статус);
	
	// Дисконтная карта (если есть)
	Если ДанныеТеста.Свойство("ДисконтнаяКарта") Тогда
		Конструктор.Установить("ДисконтнаяКарта", ДанныеТеста.ДисконтнаяКарта);
	КонецЕсли;
	
	// Товары (если не "без товаров")
	Если Не ДанныеТеста.БезТоваров Тогда
		Конструктор
			.ТабличнаяЧасть("Товары")
				.ДобавитьСтроку()
				.Установить("Номенклатура", ДанныеТеста.Товар)
				.Установить("Количество", ДанныеТеста.Количество)
				.Установить("Цена", ДанныеТеста.Цена)
				.Установить("Сумма", ДанныеТеста.Сумма)
				.Установить("СуммаСкидки", ДанныеТеста.СуммаСкидки);
	КонецЕсли;
	
	// Оплата
	Если Не ДанныеТеста.БезТоваров Тогда
		Конструктор
			.ТабличнаяЧасть("Оплата")
				.ДобавитьСтроку()
				.Установить("ВидОплаты", Перечисления.ВидыОплаты.Наличные)
				.Установить("КассаОплаты", ДанныеТеста.Касса)
				.Установить("Сумма", ДанныеТеста.Сумма - ДанныеТеста.СуммаСкидки);
	КонецЕсли;
	
	Ссылка = Конструктор.Записать();
	Возврат Ссылка;
	
КонецФункции

#КонецОбласти
