#Область СлужебныеПроцедурыИФункции

Функция DTOНоменклатура(Выборка)

	Данные = Новый Структура;
	Данные.Вставить("id", Апи_Транспорт.ИдСсылки(Выборка.Ссылка));
	Данные.Вставить("code", СокрЛП(Выборка.Код));
	Данные.Вставить("name", СокрЛП(Выборка.Наименование));
	Данные.Вставить("article", СокрЛП(Выборка.Артикул));
	Данные.Вставить("unit", Строка(Выборка.ЕдиницаИзмерения));
	Данные.Вставить("vatRate", Строка(Выборка.СтавкаНДС));
	Данные.Вставить("codeUKTZED", СокрЛП(Выборка.КодУКТЗЕД));
	Данные.Вставить("requiresExciseStamp", Выборка.ТребуетАкцизнуюМарку);
	Данные.Вставить("markupPercent", Выборка.ПроцентНаценки);
	Данные.Вставить("parentId", Апи_Транспорт.ИдСсылки(Выборка.Родитель));
	Данные.Вставить("isFolder", Выборка.ЭтоГруппа);
	Данные.Вставить("deletionMark", Выборка.ПометкаУдаления);
	Возврат Данные;

КонецФункции

Функция ПолучитьПростойСправочник(Менеджер, Параметры, СИерархией = Ложь)

	Пагинация = Апи_Транспорт.ПараметрыПагинации(Параметры);
	DeletionMark = Ложь;
	Если Параметры.Свойство("deletionMark") Тогда
		DeletionMark = Апи_Транспорт.БезопасноБулево(Параметры.deletionMark, Ложь);
	КонецЕсли;

	// Универсальный запрос через метаданные имени
	ИмяСправочника = Менеджер.ПустаяСсылка().Метаданные().Имя;

	Запрос = Новый Запрос;
	Текст =
	"ВЫБРАТЬ
	|	Спр.Ссылка КАК Ссылка,
	|	Спр.Код КАК Код,
	|	Спр.Наименование КАК Наименование,
	|	Спр.ПометкаУдаления КАК ПометкаУдаления";
	Если СИерархией Тогда
		Текст = Текст + ",
	|	Спр.Родитель КАК Родитель,
	|	Спр.ЭтоГруппа КАК ЭтоГруппа";
	КонецЕсли;
	Текст = Текст + "
	|ИЗ
	|	Справочник." + ИмяСправочника + " КАК Спр
	|ГДЕ
	|	Спр.ПометкаУдаления = &DeletionMark
	|	И (&Код = """" ИЛИ Спр.Код = &Код)
	|	И (&Имя = """" ИЛИ Спр.Наименование ПОДОБНО &ИмяПодобно)";
	Если Параметры.Свойство("id") И ЗначениеЗаполнено(Параметры.id) Тогда
		Текст = Текст + "
	|	И Спр.Ссылка = &СсылкаФильтр";
	КонецЕсли;

	Запрос.Текст = Текст;
	Запрос.УстановитьПараметр("DeletionMark", DeletionMark);
	Код = "";
	Имя = "";
	Если Параметры.Свойство("code") И ЗначениеЗаполнено(Параметры.code) Тогда
		Код = СокрЛП(Строка(Параметры.code));
	КонецЕсли;
	Если Параметры.Свойство("name") И ЗначениеЗаполнено(Параметры.name) Тогда
		Имя = СокрЛП(Строка(Параметры.name));
	КонецЕсли;
	Запрос.УстановитьПараметр("Код", Код);
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.УстановитьПараметр("ИмяПодобно", "%" + Имя + "%");
	Если Параметры.Свойство("id") И ЗначениеЗаполнено(Параметры.id) Тогда
		Запрос.УстановитьПараметр("СсылкаФильтр", Апи_Транспорт.СсылкаПоИд(Менеджер, Параметры.id));
	КонецЕсли;

	Все = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Данные = Новый Структура;
		Данные.Вставить("id", Апи_Транспорт.ИдСсылки(Выборка.Ссылка));
		Данные.Вставить("code", СокрЛП(Выборка.Код));
		Данные.Вставить("name", СокрЛП(Выборка.Наименование));
		Данные.Вставить("deletionMark", Выборка.ПометкаУдаления);
		Если СИерархией Тогда
			Данные.Вставить("parentId", Апи_Транспорт.ИдСсылки(Выборка.Родитель));
			Данные.Вставить("isFolder", Выборка.ЭтоГруппа);
		КонецЕсли;
		Все.Добавить(Данные);
	КонецЦикла;

	Возврат Апи_Транспорт.СтраницаСписка(Все, Пагинация.Limit, Пагинация.Offset);

КонецФункции

Функция ПолучитьПростойЭлемент(Менеджер, СтрокаИд, ИмяСущности, СИерархией = Ложь)

	Ссылка = Апи_Транспорт.СсылкаПоИд(Менеджер, СтрокаИд);
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Апи_Транспорт.ОшибкаUseCase("not_found", ИмяСущности + " not found", 404);
	КонецЕсли;

	ИмяСправочника = Менеджер.ПустаяСсылка().Метаданные().Имя;
	Запрос = Новый Запрос;
	Текст =
	"ВЫБРАТЬ
	|	Спр.Ссылка КАК Ссылка,
	|	Спр.Код КАК Код,
	|	Спр.Наименование КАК Наименование,
	|	Спр.ПометкаУдаления КАК ПометкаУдаления";
	Если СИерархией Тогда
		Текст = Текст + ",
	|	Спр.Родитель КАК Родитель,
	|	Спр.ЭтоГруппа КАК ЭтоГруппа";
	КонецЕсли;
	Текст = Текст + "
	|ИЗ
	|	Справочник." + ИмяСправочника + " КАК Спр
	|ГДЕ
	|	Спр.Ссылка = &Ссылка";
	Запрос.Текст = Текст;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Апи_Транспорт.ОшибкаUseCase("not_found", ИмяСущности + " not found", 404);
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("id", Апи_Транспорт.ИдСсылки(Выборка.Ссылка));
	Данные.Вставить("code", СокрЛП(Выборка.Код));
	Данные.Вставить("name", СокрЛП(Выборка.Наименование));
	Данные.Вставить("deletionMark", Выборка.ПометкаУдаления);
	Если СИерархией Тогда
		Данные.Вставить("parentId", Апи_Транспорт.ИдСсылки(Выборка.Родитель));
		Данные.Вставить("isFolder", Выборка.ЭтоГруппа);
	КонецЕсли;
	Возврат Данные;

КонецФункции

