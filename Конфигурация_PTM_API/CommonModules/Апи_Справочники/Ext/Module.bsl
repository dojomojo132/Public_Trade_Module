#Область ПрограммныйИнтерфейс

Функция ПолучитьНоменклатуру(Параметры) Экспорт

	Пагинация = Апи_Транспорт.ПараметрыПагинации(Параметры);
	DeletionMark = Ложь;
	Если Параметры.Свойство("deletionMark") Тогда
		DeletionMark = Апи_Транспорт.БезопасноБулево(Параметры.deletionMark, Ложь);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Код КАК Код,
	|	Номенклатура.Наименование КАК Наименование,
	|	Номенклатура.Артикул КАК Артикул,
	|	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Номенклатура.СтавкаНДС КАК СтавкаНДС,
	|	Номенклатура.КодУКТЗЕД КАК КодУКТЗЕД,
	|	Номенклатура.ТребуетАкцизнуюМарку КАК ТребуетАкцизнуюМарку,
	|	Номенклатура.ПроцентНаценки КАК ПроцентНаценки,
	|	Номенклатура.Родитель КАК Родитель,
	|	Номенклатура.ЭтоГруппа КАК ЭтоГруппа,
	|	Номенклатура.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ПометкаУдаления = &DeletionMark
	|	И (&Код = """" ИЛИ Номенклатура.Код = &Код)
	|	И (&Артикул = """" ИЛИ Номенклатура.Артикул = &Артикул)
	|	И (&Имя = """" ИЛИ Номенклатура.Наименование ПОДОБНО &ИмяПодобно)
	|	И (&ЭтоГруппа = НЕОПРЕДЕЛЕНО ИЛИ Номенклатура.ЭтоГруппа = &ЭтоГруппа)
	|	И (&Родитель = НЕОПРЕДЕЛЕНО ИЛИ Номенклатура.Родитель = &Родитель)";

	Код = "";
	Артикул = "";
	Имя = "";
	ЭтоГруппа = Неопределено;
	Родитель = Неопределено;

	Если Параметры.Свойство("code") И ЗначениеЗаполнено(Параметры.code) Тогда
		Код = СокрЛП(Строка(Параметры.code));
	КонецЕсли;
	Если Параметры.Свойство("article") И ЗначениеЗаполнено(Параметры.article) Тогда
		Артикул = СокрЛП(Строка(Параметры.article));
	КонецЕсли;
	Если Параметры.Свойство("name") И ЗначениеЗаполнено(Параметры.name) Тогда
		Имя = СокрЛП(Строка(Параметры.name));
	КонецЕсли;
	Если Параметры.Свойство("isFolder") Тогда
		ЭтоГруппа = Апи_Транспорт.БезопасноБулево(Параметры.isFolder, Ложь);
	КонецЕсли;
	Если Параметры.Свойство("groupId") И ЗначениеЗаполнено(Параметры.groupId) Тогда
		Родитель = Апи_Транспорт.СсылкаПоИд(Справочники.Номенклатура, Параметры.groupId);
	КонецЕсли;
	Если Параметры.Свойство("id") И ЗначениеЗаполнено(Параметры.id) Тогда
		СсылкаФильтр = Апи_Транспорт.СсылкаПоИд(Справочники.Номенклатура, Параметры.id);
		Запрос.Текст = Запрос.Текст + "
		|	И Номенклатура.Ссылка = &СсылкаФильтр";
		Запрос.УстановитьПараметр("СсылкаФильтр", СсылкаФильтр);
	КонецЕсли;
	Если Параметры.Свойство("barcode") И ЗначениеЗаполнено(Параметры.barcode) Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И Номенклатура.Ссылка В
		|		(ВЫБРАТЬ
		|			Штрихкоды.Номенклатура
		|		ИЗ
		|			РегистрСведений.Штрихкоды КАК Штрихкоды
		|		ГДЕ
		|			Штрихкоды.Штрихкод = &Штрихкод)";
		Запрос.УстановитьПараметр("Штрихкод", СокрЛП(Строка(Параметры.barcode)));
	КонецЕсли;

	Запрос.УстановитьПараметр("DeletionMark", DeletionMark);
	Запрос.УстановитьПараметр("Код", Код);
	Запрос.УстановитьПараметр("Артикул", Артикул);
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.УстановитьПараметр("ИмяПодобно", "%" + Имя + "%");
	Запрос.УстановитьПараметр("ЭтоГруппа", ЭтоГруппа);
	Запрос.УстановитьПараметр("Родитель", Родитель);

	Все = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Все.Добавить(DTOНоменклатура(Выборка));
	КонецЦикла;

	Возврат Апи_Транспорт.СтраницаСписка(Все, Пагинация.Limit, Пагинация.Offset);

КонецФункции

Функция ПолучитьНоменклатуруПоИд(СтрокаИд) Экспорт

	Ссылка = Апи_Транспорт.СсылкаПоИд(Справочники.Номенклатура, СтрокаИд);
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Апи_Транспорт.ОшибкаUseCase("not_found", "Product not found", 404);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Код КАК Код,
	|	Номенклатура.Наименование КАК Наименование,
	|	Номенклатура.Артикул КАК Артикул,
	|	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Номенклатура.СтавкаНДС КАК СтавкаНДС,
	|	Номенклатура.КодУКТЗЕД КАК КодУКТЗЕД,
	|	Номенклатура.ТребуетАкцизнуюМарку КАК ТребуетАкцизнуюМарку,
	|	Номенклатура.ПроцентНаценки КАК ПроцентНаценки,
	|	Номенклатура.Родитель КАК Родитель,
	|	Номенклатура.ЭтоГруппа КАК ЭтоГруппа,
	|	Номенклатура.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Апи_Транспорт.ОшибкаUseCase("not_found", "Product not found", 404);
	КонецЕсли;

	Возврат DTOНоменклатура(Выборка);

КонецФункции

