#Область ПрограммныйИнтерфейс

// Создаёт или обновляет непроведённый документ инвентаризации.
//
// Параметры:
//  Тело - Структура - JSON InventoryWriteRequest
//  ИдПути - Строка - UUID из path для PUT; пусто для POST
//
// Возвращаемое значение:
//  Структура - id, number, externalId, created; либо Ошибка
//
Функция ЗаписатьИнвентаризацию(Тело, ИдПути) Экспорт

	Если ТипЗнч(Тело) <> Тип("Структура") Тогда
		Возврат Апи_Транспорт.ОшибкаUseCase("validation_error", "JSON object body is required", 400);
	КонецЕсли;

	ЭтоЗаменаПоИд = ЗначениеЗаполнено(ИдПути);

	ВнешнийИд = СвойствоСтрокой(Тело, "externalId");
	Если НЕ ЭтоЗаменаПоИд И НЕ ЗначениеЗаполнено(ВнешнийИд) Тогда
		Возврат Апи_Транспорт.ОшибкаUseCase("validation_error", "externalId is required", 400);
	КонецЕсли;
	Если ЗначениеЗаполнено(ВнешнийИд) И СтрДлина(ВнешнийИд) > 36 Тогда
		Возврат Апи_Транспорт.ОшибкаUseCase("validation_error", "externalId must be at most 36 characters", 400);
	КонецЕсли;

	ИдСклада = СвойствоСтрокой(Тело, "warehouseId");
	Если НЕ ЗначениеЗаполнено(ИдСклада) Тогда
		Возврат Апи_Транспорт.ОшибкаUseCase("validation_error", "warehouseId is required", 400);
	КонецЕсли;

	Склад = СсылкаСуществующегоСклада(ИдСклада);
	Если Склад = Неопределено Тогда
		Возврат Апи_Транспорт.ОшибкаUseCase("validation_error", "Unknown warehouseId", 400);
	КонецЕсли;

	Комментарий = Лев(СвойствоСтрокой(Тело, "comment"), 150);
	АвторИмя = Лев(СвойствоСтрокой(Тело, "authorName"), 100);

	СтрокиТоваров = Неопределено;
	Тело.Свойство("items", СтрокиТоваров);
	Если ТипЗнч(СтрокиТоваров) <> Тип("Массив") Тогда
		Возврат Апи_Транспорт.ОшибкаUseCase("validation_error", "items array is required", 400);
	КонецЕсли;

	РазобранныеСтроки = РазобратьСтрокиТоваров(СтрокиТоваров);
	Если РазобранныеСтроки.Ошибка Тогда
		Возврат РазобранныеСтроки;
	КонецЕсли;

	ДокументОбъект = Неопределено;
	Создан = Ложь;

	Если ЭтоЗаменаПоИд Тогда
		ДокументСсылка = Апи_Транспорт.СсылкаПоИд(Документы.ИнвентаризацияТоваров, ИдПути);
		Если ДокументСсылка = Неопределено Тогда
			Возврат Апи_Транспорт.ОшибкаUseCase("validation_error", "Invalid inventory id", 400);
		КонецЕсли;
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		Если ДокументОбъект = Неопределено Тогда
			Возврат Апи_Транспорт.ОшибкаUseCase("not_found", "Inventory not found", 404);
		КонецЕсли;
	Иначе
		ДокументСсылка = НайтиПоВнешнемуИд(ВнешнийИд);
		Если ЗначениеЗаполнено(ДокументСсылка) Тогда
			ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		КонецЕсли;
	КонецЕсли;

	Если ДокументОбъект = Неопределено Тогда
		ДокументОбъект = Документы.ИнвентаризацияТоваров.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		Создан = Истина;
	КонецЕсли;

	Если ДокументОбъект.ПометкаУдаления Тогда
		Возврат Апи_Транспорт.ОшибкаUseCase("conflict", "Inventory is marked for deletion", 409);
	КонецЕсли;
	Если ДокументОбъект.Проведен Тогда
		Возврат Апи_Транспорт.ОшибкаUseCase("conflict", "Posted inventory cannot be changed via API", 409);
	КонецЕсли;

	ДокументОбъект.Склад = Склад;
	ДокументОбъект.Комментарий = Комментарий;
	ДокументОбъект.АвторИмя = АвторИмя;
	Если ЗначениеЗаполнено(ВнешнийИд) Тогда
		ДокументОбъект.ВнешнийИд = ВнешнийИд;
	КонецЕсли;

	ДокументОбъект.Товары.Очистить();
	Для Каждого СтрокаТовара Из РазобранныеСтроки.Строки Цикл
		НоваяСтрока = ДокументОбъект.Товары.Добавить();
		НоваяСтрока.Номенклатура = СтрокаТовара.Номенклатура;
		НоваяСтрока.Штрихкод = СтрокаТовара.Штрихкод;
		НоваяСтрока.ФактическоеКоличество = СтрокаТовара.Количество;
		НоваяСтрока.УчетноеКоличество = 0;
		НоваяСтрока.Отклонение = 0;
		НоваяСтрока.Цена = 0;
		НоваяСтрока.Сумма = 0;
		НоваяСтрока.СуммаНедостачиИзлишков = 0;
	КонецЦикла;

	НачатьТранзакцию();
	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Возврат Апи_Транспорт.ОшибкаUseCase("internal_error", "Failed to write inventory", 500);
	КонецПопытки;

	ИдДокумента = Апи_Транспорт.ИдСсылки(ДокументОбъект.Ссылка);
	Результат = Новый Структура;
	Результат.Вставить("id", ИдДокумента);
	Результат.Вставить("number", СокрЛП(ДокументОбъект.Номер));
	Результат.Вставить("externalId", ?(ЗначениеЗаполнено(ДокументОбъект.ВнешнийИд), СокрЛП(ДокументОбъект.ВнешнийИд), Неопределено));
	Результат.Вставить("created", Создан);
	Если Создан Тогда
		Результат.Вставить("HttpКод", 201);
		Результат.Вставить("Location", "/hs/ptm/v1/inventories/" + ИдДокумента);
	Иначе
		Результат.Вставить("HttpКод", 200);
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СвойствоСтрокой(Данные, Имя)

	Значение = Неопределено;
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Данные.Свойство(Имя, Значение);
	КонецЕсли;
	Если Значение = Неопределено Или Значение = NULL Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция СсылкаСуществующегоСклада(ИдСклада)

	Ссылка = Апи_Транспорт.СсылкаПоИд(Справочники.Склады, ИдСклада);
	Если Ссылка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Склады.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Склады КАК Склады
		|ГДЕ
		|	Склады.Ссылка = &Ссылка
		|	И НЕ Склады.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;

КонецФункции

Функция НайтиПоВнешнемуИд(ВнешнийИд)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИнвентаризацияТоваров.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ИнвентаризацияТоваров КАК ИнвентаризацияТоваров
		|ГДЕ
		|	ИнвентаризацияТоваров.ВнешнийИд = &ВнешнийИд
		|	И НЕ ИнвентаризацияТоваров.ПометкаУдаления";
	Запрос.УстановитьПараметр("ВнешнийИд", ВнешнийИд);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;

КонецФункции

Функция РазобратьСтрокиТоваров(СтрокиТоваров)

	Результат = Новый Структура("Ошибка, Строки", Ложь, Новый Массив);
	Ссылки = Новый Массив;
	Подготовленные = Новый Массив;

	Для Каждого Элемент Из СтрокиТоваров Цикл
		Если ТипЗнч(Элемент) <> Тип("Структура") Тогда
			Возврат Апи_Транспорт.ОшибкаUseCase("validation_error", "Each items entry must be an object", 400);
		КонецЕсли;
		ИдТовара = СвойствоСтрокой(Элемент, "productId");
		Если НЕ ЗначениеЗаполнено(ИдТовара) Тогда
			Возврат Апи_Транспорт.ОшибкаUseCase("validation_error", "items.productId is required", 400);
		КонецЕсли;
		СсылкаТовара = Апи_Транспорт.СсылкаПоИд(Справочники.Номенклатура, ИдТовара);
		Если СсылкаТовара = Неопределено Тогда
			Возврат Апи_Транспорт.ОшибкаUseCase("validation_error", "Invalid productId", 400);
		КонецЕсли;
		Количество = 0;
		Если Элемент.Свойство("qty") Тогда
			Количество = Апи_Транспорт.БезопасноЧисло(Элемент.qty, 0);
		КонецЕсли;
		Если Количество < 0 Тогда
			Возврат Апи_Транспорт.ОшибкаUseCase("validation_error", "qty must be greater than or equal to 0", 400);
		КонецЕсли;
		Ссылки.Добавить(СсылкаТовара);
		СтрокаТовара = Новый Структура;
		СтрокаТовара.Вставить("Номенклатура", СсылкаТовара);
		СтрокаТовара.Вставить("Штрихкод", СвойствоСтрокой(Элемент, "barcode"));
		СтрокаТовара.Вставить("Количество", Количество);
		Подготовленные.Добавить(СтрокаТовара);
	КонецЦикла;

	Существующие = Новый Соответствие;
	Если Ссылки.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Номенклатура.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|	Номенклатура.Ссылка В (&Ссылки)
			|	И НЕ Номенклатура.ПометкаУдаления
			|	И НЕ Номенклатура.ЭтоГруппа";
		Запрос.УстановитьПараметр("Ссылки", Ссылки);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Существующие.Вставить(Выборка.Ссылка, Истина);
		КонецЦикла;
	КонецЕсли;

	Для Каждого СтрокаТовара Из Подготовленные Цикл
		Если Существующие.Получить(СтрокаТовара.Номенклатура) = Неопределено Тогда
			Возврат Апи_Транспорт.ОшибкаUseCase("validation_error", "Unknown productId", 400);
		КонецЕсли;
		Результат.Строки.Добавить(СтрокаТовара);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
