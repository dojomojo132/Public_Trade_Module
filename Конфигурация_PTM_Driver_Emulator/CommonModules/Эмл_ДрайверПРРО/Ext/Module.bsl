#Область ПрограммныйИнтерфейс

// Открывает фискальный чек.
//
// Параметры:
//  ПараметрыОборудования - Структура - параметры кассового оборудования
//  ТипОперации - Строка - тип операции ("Продажа", "Возврат")
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Ошибка (Строка)
//
Функция ОткрытьЧек(ПараметрыОборудования, ТипОперации) Экспорт
	
	Результат = Новый Структура("Успех, Ошибка", Истина, "");
	
	// Эмулятор: чек открыт
	
	Возврат Результат;
	
КонецФункции

// Добавляет позицию в открытый фискальный чек.
//
// Параметры:
//  Номенклатура - Строка - наименование номенклатуры
//  Количество - Число - количество
//  Цена - Число - цена за единицу
//  Сумма - Число - сумма позиции
//  АкцизнаяМарка - Строка - акцизная марка (может быть пустой)
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Ошибка (Строка)
//
Функция ДобавитьПозицию(Номенклатура, Количество, Цена, Сумма, АкцизнаяМарка) Экспорт
	
	Результат = Новый Структура("Успех, Ошибка", Истина, "");
	
	// Эмулятор: позиция добавлена
	
	Возврат Результат;
	
КонецФункции

// Закрывает фискальный чек и возвращает фискальный номер.
//
// Параметры:
//  Сумма - Число - сумма оплаты
//  ВидОплаты - Строка - вид оплаты ("Наличные", "Безналичные")
//
// Возвращаемое значение:
//  Структура - Успех (Булево), ФискальныйНомер (Строка), Ошибка (Строка)
//
Функция ЗакрытьЧек(Сумма, ВидОплаты) Экспорт
	
	ФискальныйНомер = "EMU-" + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss");
	
	Результат = Новый Структура("Успех, ФискальныйНомер, Ошибка", Истина, ФискальныйНомер, "");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
