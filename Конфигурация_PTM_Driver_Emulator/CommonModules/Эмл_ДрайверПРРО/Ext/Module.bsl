#Область ПрограммныйИнтерфейс

// Эмулятор ПРРО — эталонная реализация контракта PTM_Driver_*.
// Контракт: ОткрытьЧек -> ДобавитьПозицию -> ЗакрытьЧек.

// Открывает фискальный чек.
//
// Параметры:
//  ПараметрыОборудования - Структура - параметры кассового оборудования
//  ТипОперации - Строка - тип операции ("Продажа", "Возврат")
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Ошибка (Строка), КонтекстЧека (Структура)
//
Функция ОткрытьЧек(ПараметрыОборудования, ТипОперации) Экспорт
	
	Результат = Новый Структура("Успех, Ошибка, КонтекстЧека", Истина, "", Неопределено);
	
	КонтекстЧека = Новый Структура;
	КонтекстЧека.Вставить("ТипОперации", ТипОперации);
	КонтекстЧека.Вставить("Позиции", Новый Массив);
	КонтекстЧека.Вставить("Открыт", Истина);
	
	Результат.КонтекстЧека = КонтекстЧека;
	
	Возврат Результат;
	
КонецФункции

// Добавляет позицию в открытый фискальный чек.
//
// Параметры:
//  КонтекстЧека - Структура - контекст чека из ОткрытьЧек()
//  ДанныеПозиции - Структура - Номенклатура, Количество, Цена, Сумма, АкцизнаяМарка, НалоговаяГруппа, КодУКТЗЕД
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Ошибка (Строка)
//
Функция ДобавитьПозицию(КонтекстЧека, ДанныеПозиции) Экспорт
	
	Результат = Новый Структура("Успех, Ошибка", Истина, "");
	
	Если КонтекстЧека = Неопределено ИЛИ НЕ КонтекстЧека.Открыт Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = "Чек не открыт. Сначала вызовите ОткрытьЧек().";
		Возврат Результат;
	КонецЕсли;
	
	КонтекстЧека.Позиции.Добавить(ДанныеПозиции);
	
	Возврат Результат;
	
КонецФункции

// Закрывает фискальный чек и возвращает фискальный номер.
//
// Параметры:
//  КонтекстЧека - Структура - контекст чека из ОткрытьЧек()
//  Сумма - Число - сумма оплаты
//  ВидОплаты - Строка - вид оплаты ("Наличные", "Безналичные")
//
// Возвращаемое значение:
//  Структура - Успех (Булево), ФискальныйНомер (Строка), Ошибка (Строка)
//
Функция ЗакрытьЧек(КонтекстЧека, Сумма, ВидОплаты) Экспорт
	
	Результат = Новый Структура("Успех, ФискальныйНомер, Ошибка", Ложь, "", "");
	
	Если КонтекстЧека = Неопределено ИЛИ НЕ КонтекстЧека.Открыт Тогда
		Результат.Ошибка = "Чек не открыт. Сначала вызовите ОткрытьЧек().";
		Возврат Результат;
	КонецЕсли;
	
	СуффиксОплаты = ?(ВРег(ВидОплаты) = "БЕЗНАЛИЧНЫЕ", "CARD", "CASH");
	ФискальныйНомер = "EMU-" + СуффиксОплаты + "-" + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss");
	
	КонтекстЧека.Открыт = Ложь;
	
	Результат.Успех = Истина;
	Результат.ФискальныйНомер = ФискальныйНомер;
	
	Возврат Результат;
	
КонецФункции

// Отменяет открытый чек (заглушка для компенсации при откате проведения).
//
// Параметры:
//  КонтекстЧека - Структура - контекст чека из ОткрытьЧек()
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Ошибка (Строка)
//
Функция ОтменитьЧек(КонтекстЧека) Экспорт
	
	Результат = Новый Структура("Успех, Ошибка", Истина, "");
	
	Если КонтекстЧека <> Неопределено Тогда
		КонтекстЧека.Открыт = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
