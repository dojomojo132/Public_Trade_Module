&НаКлиенте       
Процедура ВывестиСвойства(ОтображаемыеПараметры)
	
	Элементы.Печать.ТекущаяСтраница = Элементы.Параметры;
	
	Если Параметры <> Неопределено Тогда                
		Для Каждого Параметр из ОтображаемыеПараметры Цикл
			Если ТипЗнч(Параметр.Значение) = Тип("Структура") Тогда
				Для Каждого ВложПараметр из Параметр.Значение Цикл
					СтрокаТаблицы = ККТ_Параметры.Добавить();  
					СтрокаТаблицы.Имя = Параметр.Ключ + "." + ВложПараметр.Ключ;    
					СтрокаТаблицы.Значение = ВложПараметр.Значение; 
				КонецЦикла; 
			Иначе
				СтрокаТаблицы = ККТ_Параметры.Добавить();  
				СтрокаТаблицы.Имя = Параметр.Ключ;    
				СтрокаТаблицы.Значение = Параметр.Значение; 
			КонецЕсли;
		КонецЦикла; 
	КонецЕсли
	
КонецПроцедуры

&НаСервере
Функция РасчитатьНДС(Знач Сумма, Знач СтавкаНДС)   
	
	Если СтавкаНДС <> Неопределено И СтавкаНДС > 0 Тогда        
		Если СтавкаНДС > 100 Тогда
			СтавкаНДС = СтавкаНДС - 100;
		КонецЕсли;
		СуммаНДС = Окр(Сумма / (100 + СтавкаНДС) * СтавкаНДС, 2)
	Иначе
		СуммаНДС = 0;
	КонецЕсли;
	
	Возврат СуммаНДС;
	
КонецФункции

