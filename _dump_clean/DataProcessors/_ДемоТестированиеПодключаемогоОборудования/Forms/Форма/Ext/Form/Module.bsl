&НаКлиенте
Процедура ФУ_ПроверитьКМ(Команда)
	
	Элементы.ДекорацияОжидание.Видимость = Истина;
	
	ШтучныйТовар = ККТ_ПланируемыйСтатусТовара = ПредопределенноеЗначение("Перечисление.ПланируемыйСтатусМаркируемогоТовара.ШтучныйТоварРеализован")
		Или ККТ_ПланируемыйСтатусТовара = ПредопределенноеЗначение("Перечисление.ПланируемыйСтатусМаркируемогоТовара.ШтучныйТоварВозвращен");
		
	ФискальноеУстройство = ПолучитьФискальноеУстройство();
	Если Не ЗначениеЗаполнено(ФискальноеУстройство) Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ФискальноеУстройство.Доступность = Ложь;
	ККТ_УникальныйИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор); 
	
	Марки = Новый Массив();
	Если ПустаяСтрока(ККТ_КодКонтрольнойМарки) Тогда
		Марки.Добавить(ОбщегоНазначенияБПОКлиентСервер.ШтрихкодВBase64("(01)04062058711785(21)_BX8=Id(J5x,6"));
		Марки.Добавить(ОбщегоНазначенияБПОКлиентСервер.ШтрихкодВBase64("(01)04062058711785(21)*TH0hYU<FVV1-"));
		Марки.Добавить(ОбщегоНазначенияБПОКлиентСервер.ШтрихкодВBase64("(01)04062058711785(21)0 0 0 &L0'ruoUNpevv"));
		Марки.Добавить(ОбщегоНазначенияБПОКлиентСервер.ШтрихкодВBase64("(01)04062058711785(21)9j9WJEaXW+gLT"));
	Иначе
		Марки.Добавить(ККТ_КодКонтрольнойМарки);
	КонецЕсли;
	
	// Создание структуры параметров
	ПараметрыПакетнойОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыПроверкиКМ();
	ПараметрыПакетнойОперации.ОтображатьФорму = ФУ_ФормаБПО;
#Если ВебКлиент Тогда
	СлучайныеЧисла = СлучайныеЧислаНаСервере(0, 10, Марки.Количество());
#Иначе
	СлучайныеЧисла = СлучайныеЧисла(0, 10, Марки.Количество());
#КонецЕсли
	Для Индекс = 0 По Марки.ВГраница() Цикл
		ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыЗапросКМ();
		ПараметрыОперации.ДополнительныеПараметры = "Какой-то идентификатор";
		ПараметрыОперации.ЗапросПроверкиКМСредствамиККТ = НЕ ЗапросКМФормируетсяЛокально;
		ПараметрыОперации.ВремяЗапросаРазрешения = "1706171074043";
		ПараметрыОперации.Наименование = "Груша";
		ПараметрыОперации.ИгнорироватьРезультатПроверкиКМ = ФУ_ИгнорироватьРезультатПроверкиКМ;
		ПараметрыОперации.ОжидатьПолучениеОтветаОИСМ = ОжидатьПолучениеОтветаОИСМ;      
		СлучайноеЧисло = СлучайныеЧисла[Индекс];
		Если СлучайноеЧисло > 8 Тогда
			ПараметрыОперации.ЗапросРазрешенияПродажиКМ = Ложь;
		Иначе
			ПараметрыОперации.ЗапросРазрешенияПродажиКМ = Истина;
			Если СлучайноеЧисло > 6 Тогда
			ИначеЕсли СлучайноеЧисло > 4 Тогда
				ПараметрыОперации.КодОтветаРазрешения = 203;
				ФУ_ЗаполнитьРезультатЗапросаРазрешения(ПараметрыОперации);
			ИначеЕсли СлучайноеЧисло > 2 Тогда
				ПараметрыОперации.КодОтветаРазрешения = 401;
				ФУ_ЗаполнитьРезультатЗапросаРазрешения(ПараметрыОперации);
			Иначе
				ПараметрыОперации.КодОтветаРазрешения = 400;
				ФУ_ЗаполнитьРезультатЗапросаРазрешения(ПараметрыОперации);
			КонецЕсли;
		КонецЕсли;
		
		Если Не ШтучныйТовар Тогда
			ПараметрыОперации.Количество = ККТ_Количество;  
			ПараметрыОперации.ДробноеКоличество.Числитель   = ККТ_ДробноеКоличествоЧислитель;     
			ПараметрыОперации.ДробноеКоличество.Знаменатель = ККТ_ДробноеКоличествоЗнаменатель;     
			ПараметрыОперации.МераКоличестваПредметаРасчета = ККТ_МераКоличества;
		КонецЕсли;
		ПараметрыОперации.ПланируемыйСтатусТовара = ККТ_ПланируемыйСтатусТовара;
		ПараметрыОперации.КонтрольнаяМарка = Марки[Индекс];
		
		ПараметрыОперации.ПродажаРазрешена = (СлучайноеЧисло % 2) = 0;
		Если Не ПараметрыОперации.ПродажаРазрешена Тогда
			ПараметрыОперации.ПричинаЗапрета = "Запрщена продажа по какой то причине";
		КонецЕсли;
		ДопСведения = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ДополнительноеСведениеЗапросаКМ();
		ДопСведения.Заголовок = "Срок годности";
		ДопСведения.Значение = ДобавитьМесяц(ТекущаяДата(), -2);
		ПараметрыОперации.ДополнительныеСведения.Добавить(ДопСведения);
		ДопСведения = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ДополнительноеСведениеЗапросаКМ();
		ДопСведения.Заголовок = "ИНН поставщика";
		ДопСведения.Значение = "123456789094";
		ПараметрыОперации.ДополнительныеСведения.Добавить(ДопСведения);
		
		
		ПараметрыПакетнойОперации.ЗапросыКМ.Добавить(ПараметрыОперации);
	КонецЦикла;
	
	ОповещениеПриЗавершении = Новый ОписаниеОповещения("ФУ_КомандаВыполнитьЗавершениеКМ", ЭтотОбъект);
	ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПроверкуКМ(ОповещениеПриЗавершении, УникальныйИдентификатор, ФискальноеУстройство, ПараметрыПакетнойОперации, ДополнительныеПараметры);
	Если Не ФУ_ФормаБПО Тогда
		ПодключитьОбработчикОжидания("Подключаемый_СтатусПроверкаКМ", 0.2, Истина);
	КонецЕсли;
	
КонецПроцедуры

