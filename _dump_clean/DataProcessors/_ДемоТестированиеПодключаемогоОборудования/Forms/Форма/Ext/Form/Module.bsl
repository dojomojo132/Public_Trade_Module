		КонецЕсли;
		
		Если РезультатВыполнения.Свойство("АдресСайтаПроверки") Тогда
			СайтПроверкиОФД = РезультатВыполнения.АдресСайтаПроверки;
		КонецЕсли;
		
		Если РезультатВыполнения.Свойство("ИдентификаторСессии") Тогда
			ИдентификаторСессии = РезультатВыполнения.ИдентификаторСессии;
		КонецЕсли;     
		
		Если РезультатВыполнения.Свойство("ПараметрыККТ") Тогда
			ВывестиСвойства(РезультатВыполнения.ПараметрыККТ)
		КонецЕсли;
		
		Если РезультатВыполнения.Свойство("ФискальныеДанные") Тогда
			ВывестиСвойства(РезультатВыполнения.ФискальныеДанные)
		КонецЕсли;                 
		
		Если РезультатВыполнения.Свойство("ФискальныеДанныеСтруктура") Тогда
			ВывестиСвойства(РезультатВыполнения.ФискальныеДанныеСтруктура)
		КонецЕсли;                 
		
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		// Пишем лог
		ОтветОтУстройства = ОтветОтУстройства + ТекстСообщения + Символы.ПС;
	КонецЕсли;
	
	ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

&НаКлиенте
Процедура ФУ_КомандаВыполнитьЗавершениеКМ(РезультатВыполнения, Параметры) Экспорт
	
	//ОчиститьСообщения();
	Элементы.ФискальноеУстройство.Доступность = Истина;
	ККТ_КодМаркировкиПроверенФискальнымНакопителем = Ложь;
	ККТ_РезультатПроверкиФискальнымНакопителемПоложительный = Ложь;
	ККТ_РезультатПроверки = Ложь;
	ККТ_КодМаркировки_Текст = "";
	
	Если РезультатВыполнения.Результат Тогда
		ТекстСообщения = НСтр("ru='Операция завершена.'");
		
		Если РезультатВыполнения.Свойство("КодМаркировкиПроверен") Тогда
			ККТ_КодМаркировкиПроверенФискальнымНакопителем = РезультатВыполнения.КодМаркировкиПроверен;
		КонецЕсли;
		Если РезультатВыполнения.Свойство("РезультатПроверки") Тогда
			ККТ_РезультатПроверкиФискальнымНакопителемПоложительный = РезультатВыполнения.РезультатПроверки;
		КонецЕсли;
		Если РезультатВыполнения.Свойство("РезультатПроверкиОИСМ") Тогда
			ККТ_РезультатПроверки = РезультатВыполнения.РезультатПроверкиОИСМ;
		КонецЕсли;
		Если РезультатВыполнения.Свойство("КодОбработкиЗапроса") Тогда
			ККТ_КодОбработкиЗапроса = РезультатВыполнения.КодОбработкиЗапроса;
		КонецЕсли;
		Если РезультатВыполнения.Свойство("СтатусТовара") Тогда
			ККТ_ОтветОИСМОСтатусеТовара = РезультатВыполнения.СтатусТовара;
		КонецЕсли;
		Если РезультатВыполнения.Свойство("РезультатПроверкиСведенийОТоваре") Тогда
			ККТ_КодМаркировки_Текст = РезультатВыполнения.РезультатПроверкиСведенийОТовареПФ + РезультатВыполнения.РезультатПроверкиСведенийОТоваре;
		КонецЕсли;
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		// Пишем лог
		ОтветОтУстройства = ОтветОтУстройства + ТекстСообщения + Символы.ПС;
	КонецЕсли;
	
	//----------------------------
	
	Если РезультатВыполнения.Свойство("РезультатыОпераций") Тогда
		РезультатОперации = РезультатВыполнения.РезультатыОпераций[0];
		ТекстСообщения = РезультатОперации.ОписаниеОшибки;
	Иначе
		РезультатОперации = РезультатВыполнения;
	КонецЕсли;
	
	Если РезультатОперации.Результат Тогда
		ТекстСообщения = НСтр("ru='Операция завершена.'");
	Иначе
		ТекстСообщения = РезультатОперации.ОписаниеОшибки;
		// Пишем лог
		ОтветОтУстройства = ОтветОтУстройства + ТекстСообщения + Символы.ПС;
	КонецЕсли;
	
	
	Если РезультатОперации.Свойство("КодМаркировкиПроверен") Тогда
		ККТ_КодМаркировкиПроверенФискальнымНакопителем = РезультатОперации.КодМаркировкиПроверен;
	КонецЕсли;
	Если РезультатОперации.Свойство("РезультатПроверки") Тогда
		ККТ_РезультатПроверкиФискальнымНакопителемПоложительный = РезультатОперации.РезультатПроверки;
	КонецЕсли;
	Если РезультатОперации.Свойство("РезультатПроверкиОИСМ") Тогда
		ККТ_РезультатПроверки = РезультатОперации.РезультатПроверкиОИСМ;
	КонецЕсли;
	Если РезультатОперации.Свойство("КодОбработкиЗапроса") Тогда
		ККТ_КодОбработкиЗапроса = РезультатОперации.КодОбработкиЗапроса;
	КонецЕсли;
	Если РезультатОперации.Свойство("СтатусТовара") Тогда
		ККТ_ОтветОИСМОСтатусеТовара = РезультатОперации.СтатусТовара;
	КонецЕсли;
	
	Если РезультатОперации.Результат Тогда
		
		ККТ_РезультатПроверкиТаблица.Очистить();
		Строка = ККТ_РезультатПроверкиТаблица.Добавить();
		Строка.Название = "Результат";
		Строка.Значение = РезультатОперации.Результат;
		
		Строка = ККТ_РезультатПроверкиТаблица.Добавить();
		Строка.Название = "ОписаниеОшибки";
		Строка.Значение = РезультатОперации.ОписаниеОшибки;
		
		Если РезультатОперации.Свойство("Валидация") Тогда
			Строка = ККТ_РезультатПроверкиТаблица.Добавить();
			Строка.Название = "Валидация";
			Строка.Значение = РезультатОперации.Валидация;
		КонецЕсли;
		
		Если РезультатОперации.Свойство("ПродажаРазрешена") Тогда
			Строка = ККТ_РезультатПроверкиТаблица.Добавить();
			Строка.Название = "ПродажаРазрешена";
			Строка.Значение = РезультатОперации.ПродажаРазрешена;
		КонецЕсли;
		
		Если РезультатОперации.Свойство("ПроверкаКМ") Тогда
			Строка = ККТ_РезультатПроверкиТаблица.Добавить();
			Строка.Название = "ПроверкаКМ";   // РезультатПроверкиКМ
			Строка.Значение = РезультатОперации.ПроверкаКМ;
		КонецЕсли;
		
		Если РезультатОперации.Свойство("ПодтверждениеВыполнено") Тогда
			Строка = ККТ_РезультатПроверкиТаблица.Добавить();
			Строка.Название = "ПодтверждениеВыполнено";
			Строка.Значение = РезультатОперации.ПодтверждениеВыполнено;
		КонецЕсли;
		
		Если РезультатОперации.Свойство("РезультатПроверкиСведенийОТоваре") Тогда
			Строка = ККТ_РезультатПроверкиТаблица.Добавить();
			Строка.Название = "РезультатПроверкиСведенийОТоваре";
			Строка.Значение = РезультатОперации.РезультатПроверкиСведенийОТоваре;
		КонецЕсли;
		
		Если РезультатОперации.Свойство("РезультатПроверкиСведенийОТовареПФ") Тогда
			Строка = ККТ_РезультатПроверкиТаблица.Добавить();
			Строка.Название = "РезультатПроверкиСведенийОТовареПФ";
			Строка.Значение = РезультатОперации.РезультатПроверкиСведенийОТовареПФ;
		КонецЕсли;
		
		Если РезультатОперации.Свойство("СтатусТовара") Тогда
			Строка = ККТ_РезультатПроверкиТаблица.Добавить();
			Строка.Название = "СтатусТовара";
			Строка.Значение = РезультатОперации.СтатусТовара;
		КонецЕсли;
	КонецЕсли;
	
	Элементы.ДекорацияОжидание.Видимость = Ложь;
	ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);

КонецПроцедуры

