	Иначе
		ПараметрыОперации.ЗначениеQRКода = "https://qr.nspk.ru/AD10003UOKK4J3J09SO9M1CSQ2U23BQC?type=02&bank=540000000001&sum=10010&cur=RUB&crc=86EE";
	КонецЕсли;            
	
	Колонка = ОборудованиеДисплеиПокупателяКлиент.ПараметрыКолонкиТабличнойЧастиДисплеяПокупателя("Номер", "№", 10, ГоризонтальноеПоложение.Центр);
