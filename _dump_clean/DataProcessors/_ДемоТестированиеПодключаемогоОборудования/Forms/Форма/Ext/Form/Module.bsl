		ПараметрыЗаписи.КодОтветаРазрешения = 203;
		ФУ_ЗаполнитьРезультатЗапросаРазрешения(ПараметрыЗаписи);
	ИначеЕсли СЧ > 3 Тогда
		ПараметрыЗаписи.КодОтветаРазрешения = 401;
		ФУ_ЗаполнитьРезультатЗапросаРазрешения(ПараметрыЗаписи);
	Иначе
		ПараметрыЗаписи.КодОтветаРазрешения = 200;
		ФУ_ЗаполнитьРезультатЗапросаРазрешения(ПараметрыЗаписи);
