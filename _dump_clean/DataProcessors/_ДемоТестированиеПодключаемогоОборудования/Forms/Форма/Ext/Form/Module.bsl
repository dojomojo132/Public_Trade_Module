	Если ЭТ.Пустая() Тогда
		ТекстСообщения = "ЭТ не выбран.";
		ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ФискальноеУстройство = ПолучитьФискальноеУстройство();
	
	ОчиститьСообщения();
	Элементы.РаботаСЭТ.Доступность = Ложь;
	
